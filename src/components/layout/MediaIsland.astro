---
/**
 * 灵动岛媒体指示器 —— 本体已并入导航栏中间的大岛（markup 见 Navbar.astro 的 #media-island）
 *
 * 常态收起不占位；音频播放 / 麦克风 / 相机占用时从导航岛内部挤出那一块，
 * 点击该块 → 在其下方展开详情（当前歌曲、麦克风/相机状态），再点收起。
 * 当前歌曲读自音乐挂件的 .music-title / .music-artist。
 *
 * 本组件保留：状态监测与展开收起脚本、调试台（Ctrl+Shift+E）、
 * 左上角的快捷键提示（进站弹一次，教访客怎么调音量）。
 * 音量反馈统一走导航岛内的音量条（.mi-vol），不再单独弹左上角 HUD。
 */
---

<!-- #media-island 本体已迁移至 Navbar.astro（导航岛内部），见下方样式的内嵌态定义 -->

<!-- 调试台（Ctrl+Shift+E 开关） -->
<div id="mi-debug" hidden>
	<div class="mid-head">
		<span>灵动岛调试台</span>
		<kbd>Ctrl+Shift+E</kbd>
	</div>
	<button type="button" data-mid="audio">模拟音频播放</button>
	<button type="button" data-mid="mic">模拟麦克风占用</button>
	<button type="button" data-mid="cam">模拟摄像头占用</button>
	<div class="mid-real">快捷键 · Ctrl+Shift+↑/↓ 调音量</div>
	<div class="mid-real" data-mid-real></div>
</div>

<!-- 音量反馈已并入导航岛内的音量条（.mi-vol），左上角不再弹 HUD -->

<!-- 快捷键提示（左上角）：进站后弹一次，告诉访客怎么调音量；点击关闭 -->
<div id="kbd-hint" aria-hidden="true">
	<span class="kh-keys"><kbd>Ctrl</kbd><kbd>Shift</kbd><kbd>↑</kbd><kbd>↓</kbd></span>
	<span class="kh-text">调节音量</span>
</div>

<style>
	/* ================= 灵动岛本体（内嵌在导航岛里，从岛内挤出） ================= */
	:global(#media-island) {
		position: relative;
		align-self: center;
		/* grid 0fr → 1fr：零宽收起，展开时从导航岛内平滑挤出 */
		display: grid;
		grid-template-columns: 0fr;
		/* 收起时抵消导航岛行内的 gap-3，完全不占位 */
		margin-left: -0.75rem;
		opacity: 0;
		pointer-events: none;
		cursor: pointer;
		user-select: none;
		color: inherit;
		transition:
			grid-template-columns 0.5s cubic-bezier(0.32, 0.72, 0, 1),
			margin-left 0.5s cubic-bezier(0.32, 0.72, 0, 1),
			opacity 0.32s ease;
	}
	:global(#media-island:not(.mi-hidden)) {
		grid-template-columns: 1fr;
		margin-left: 0;
		opacity: 1;
		pointer-events: auto;
	}
	/* 收起待裁切层：宽度动画的载体 */
	:global(#media-island .mi-slot) {
		overflow: hidden;
		min-width: 0;
	}

	/* ---------- 挤出态胶囊：与导航岛同一份玻璃，只做一层浅槽 ------ */
	:global(#media-island .mi-pill) {
		display: flex;
		align-items: center;
		gap: 8px;
		height: 36px;
		padding: 0 12px;
		border-radius: 9999px;
		background: color-mix(in oklch, var(--card-bg) 55%, transparent);
		border: 1px solid color-mix(in oklch, var(--card-border, #e5e5e5) 35%, transparent);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		white-space: nowrap;
		transform-origin: left center;
		/* 展开方向：从 0.9 弹回 1，跟导航岛的挤出同步 */
		transition: transform 0.5s cubic-bezier(0.32, 0.72, 0, 1);
	}
	:global(:root.dark #media-island .mi-pill) {
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
	}
	:global(#media-island.is-expanded .mi-pill) {
		background: color-mix(in oklch, var(--card-bg) 78%, transparent);
	}

	/* ---------- 音频均衡器 ---------- */
	:global(#media-island .mi-eq) {
		display: none;
		align-items: flex-end;
		gap: 2.5px;
		height: 16px;
	}
	:global(#media-island .mi-eq.show) {
		display: inline-flex;
	}
	:global(#media-island .mi-eq i) {
		width: 3.5px;
		border-radius: 2px;
		background: rgb(52, 211, 153);
		animation: mi-eq-bounce 0.9s ease-in-out infinite;
	}
	:global(#media-island .mi-eq i:nth-child(1)) { height: 55%; animation-delay: 0s; }
	:global(#media-island .mi-eq i:nth-child(2)) { height: 95%; animation-delay: 0.18s; }
	:global(#media-island .mi-eq i:nth-child(3)) { height: 70%; animation-delay: 0.32s; }
	:global(#media-island .mi-eq i:nth-child(4)) { height: 100%; animation-delay: 0.1s; }
	@keyframes mi-eq-bounce {
		0%, 100% { transform: scaleY(0.35); }
		50% { transform: scaleY(1); }
	}

	/* ---------- 歌名标签 ---------- */
	:global(#media-island .mi-label) {
		line-height: 1;
		font-variant-numeric: tabular-nums;
		opacity: 0.9;
		max-width: 170px;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* ---------- 音量条（调节音量时临时显示） ---------- */
	:global(#media-island .mi-vol) {
		display: none;
		align-items: center;
		gap: 7px;
	}
	:global(#media-island .mi-vol.show) {
		display: inline-flex;
	}
	:global(#media-island .mi-vol svg) {
		width: 15px;
		height: 15px;
		flex-shrink: 0;
	}
	:global(#media-island .mi-vol-bar) {
		width: 70px;
		height: 4px;
		border-radius: 2px;
		/* 跟随导航岛文字色，深浅主题自动适配 */
		background: color-mix(in oklch, currentColor 18%, transparent);
		overflow: hidden;
	}
	:global(#media-island .mi-vol-fill) {
		display: block;
		height: 100%;
		background: currentColor;
		border-radius: 2px;
		transition: width 0.15s ease;
	}

	/* ---------- 左上角只保留快捷键提示（进站弹一次，教访客调音量） ----------
	   音量 HUD 已移除：音量反馈统一由导航岛内的音量条（.mi-vol）承担。 */
	:global(#kbd-hint) {
		position: fixed;
		top: 1.25rem;
		left: 1.25rem;
		z-index: 99990;
		display: flex;
		align-items: center;
		gap: 8px;
		height: 40px;
		padding: 0 14px 0 12px;
		border-radius: 9999px;
		background: color-mix(in oklch, var(--card-bg, #fff) 55%, transparent);
		-webkit-backdrop-filter: blur(20px) saturate(180%);
		backdrop-filter: blur(20px) saturate(180%);
		border: 1px solid color-mix(in oklch, var(--card-border, #e5e5e5) 30%, transparent);
		box-shadow: var(--shadow-navbar, 0 4px 16px rgba(0, 0, 0, 0.08));
		color: rgb(23, 23, 23);
		font-size: 0.72rem;
		font-weight: 600;
		line-height: 1;
		cursor: pointer;
		user-select: none;
		opacity: 0;
		transform: translateY(-12px) scale(0.9);
		pointer-events: none;
		transition:
			opacity 0.22s ease,
			transform 0.28s cubic-bezier(0.32, 0.72, 0, 1);
	}
	:global(#kbd-hint.show) {
		opacity: 1;
		transform: translateY(0) scale(1);
		pointer-events: auto;
	}
	:global(#kbd-hint .kh-keys) {
		display: inline-flex;
		align-items: center;
		gap: 3px;
	}
	:global(#kbd-hint kbd) {
		font: inherit;
		font-size: 0.62rem;
		padding: 3px 5px;
		border-radius: 5px;
		background: rgba(0, 0, 0, 0.07);
		border: 1px solid rgba(0, 0, 0, 0.1);
		line-height: 1;
	}
	:global(#kbd-hint .kh-text) {
		white-space: nowrap;
		opacity: 0.85;
	}
	:global(.dark #kbd-hint) {
		color: rgb(245, 245, 247);
	}
	:global(.dark #kbd-hint kbd) {
		background: rgba(255, 255, 255, 0.1);
		border-color: rgba(255, 255, 255, 0.14);
	}

	/* ---------- iOS 风格状态点（麦克风红点 / 摄像头绿点） ---------- */
	:global(#media-island .mi-dot) {
		display: none;
		width: 7px;
		height: 7px;
		border-radius: 9999px;
		flex-shrink: 0;
	}
	:global(#media-island .mi-dot.show) {
		display: inline-block;
	}
	:global(#media-island .mi-dot-mic.show) {
		background: rgb(255, 69, 58);
		box-shadow: 0 0 6px rgba(255, 69, 58, 0.8);
	}
	:global(#media-island .mi-dot-cam.show) {
		background: rgb(48, 209, 88);
		box-shadow: 0 0 6px rgba(48, 209, 88, 0.8);
	}

	/* ---------- 展开态详情：浮在导航岛下方，与导航岛同一份玻璃材质 ---------- */
	:global(#media-island .mi-detail) {
		position: absolute;
		top: calc(100% + 0.85rem);
		right: -0.25rem;
		z-index: 5;
		width: 262px;
		max-width: calc(100vw - 2rem);
		padding: 8px 16px 12px;
		border-radius: 20px;
		/* 透明玻璃：跟随主题（亮色透白 / 暗色透黑），不再是实心黑块 */
		background: color-mix(in oklch, var(--card-bg) calc(var(--opacity-55, 0.55) * 100%), transparent);
		-webkit-backdrop-filter: blur(var(--navbar-glass-blur, 20px)) saturate(180%);
		backdrop-filter: blur(var(--navbar-glass-blur, 20px)) saturate(180%);
		border: 1px solid color-mix(in oklch, var(--card-border, #e5e5e5) 40%, transparent);
		box-shadow: var(--shadow-navbar, 0 4px 16px rgba(0, 0, 0, 0.08));
		color: inherit;
		font-size: 0.74rem;
		opacity: 0;
		transform: translateY(-8px) scale(0.96);
		transform-origin: top right;
		pointer-events: none;
		transition:
			opacity 0.28s ease,
			transform 0.34s cubic-bezier(0.32, 0.72, 0, 1);
	}
	:global(#media-island.is-expanded .mi-detail) {
		opacity: 1;
		transform: translateY(0) scale(1);
		pointer-events: auto;
	}
	/* ProMax 版（桌面端导航岛沉底，768 起生效，与 promax.css 的 md 断点一致）：
	   详情面板改向上浮出，动画方向同步镜像 */
	@media (min-width: 768px) {
		:global(body.site-promax #media-island .mi-detail) {
			top: auto;
			bottom: calc(100% + 0.85rem);
			transform: translateY(8px) scale(0.96);
			transform-origin: bottom right;
		}
		:global(body.site-promax #media-island.is-expanded .mi-detail) {
			transform: translateY(0) scale(1);
		}
	}
	:global(#media-island .mi-row) {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 16px;
		padding: 4px 0;
		border-bottom: 1px solid color-mix(in oklch, currentColor 12%, transparent);
	}
	:global(#media-island .mi-row:last-of-type) {
		border-bottom: none;
	}
	:global(#media-island .mi-k) {
		color: color-mix(in oklch, currentColor 55%, transparent);
		flex-shrink: 0;
	}
	:global(#media-island .mi-v) {
		font-weight: 600;
		text-align: right;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		max-width: 180px;
	}
	:global(#media-island .mi-tip) {
		margin-top: 2px;
		text-align: center;
		font-size: 0.62rem;
		color: color-mix(in oklch, currentColor 45%, transparent);
	}

	/* ---------- 收起：0.34s 被岛吸回去（内容同步淡出，不留空白色块） ----------
	   过渡取自「目标状态」：落到 .mi-hidden 时用下面这套更快的缓出，
	   回到常态时用本体的 0.5s 弹性曲线 → 进慢出快，像被吸回岛里。 */
	:global(#media-island.mi-hidden) {
		transition:
			grid-template-columns 0.34s cubic-bezier(0.45, 0, 0.2, 1),
			margin-left 0.34s cubic-bezier(0.45, 0, 0.2, 1),
			opacity 0.22s ease;
	}
	/* 裁切层等收缩动画走完再隐藏，否则会中断关闭动画 */
	:global(#media-island.mi-hidden .mi-slot) {
		visibility: hidden;
		transition: visibility 0s linear 0.34s;
	}
	/* 胶囊向左微缩 + 整块淡出：0.22s 内就不可见，不会出现停滞的白块 */
	:global(#media-island.mi-hidden .mi-pill) {
		transform: scale(0.9);
		transition: transform 0.34s cubic-bezier(0.45, 0, 0.2, 1);
	}
	:global(#media-island.mi-hidden .mi-detail) {
		opacity: 0 !important;
		pointer-events: none;
		transition:
			opacity 0.18s ease,
			transform 0.18s ease;
	}

	@media (max-width: 1023px) {
		:global(#media-island .mi-pill) {
			height: 30px;
			gap: 6px;
			padding: 0 10px;
			font-size: 0.68rem;
		}
		:global(#media-island .mi-label) {
			max-width: 96px;
		}
		:global(#media-island .mi-vol-bar) {
			width: 48px;
		}
		:global(#media-island .mi-detail) {
			width: 232px;
			right: -0.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		:global(#media-island) {
			transition-duration: 1ms !important;
		}
		:global(#media-island .mi-eq i) {
			animation: none;
		}
	}

	/* ================= 调试台 ================= */
	:global(#mi-debug) {
		position: fixed;
		bottom: 6.5rem;
		right: 1rem;
		z-index: 99990;
		width: 240px;
		padding: 12px 14px;
		border-radius: 16px;
		background: rgba(18, 18, 22, 0.92);
		-webkit-backdrop-filter: blur(16px) saturate(160%);
		backdrop-filter: blur(16px) saturate(160%);
		border: 1px solid rgba(255, 255, 255, 0.1);
		box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
		color: rgb(240, 240, 244);
		font-size: 0.74rem;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	:global(#mi-debug[hidden]) {
		display: none;
	}
	:global(#mi-debug .mid-head) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-weight: 700;
		margin-bottom: 2px;
	}
	:global(#mi-debug kbd) {
		font-size: 0.6rem;
		padding: 2px 6px;
		border-radius: 6px;
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.12);
	}
	:global(#mi-debug button) {
		text-align: left;
		padding: 7px 10px;
		border-radius: 10px;
		border: 1px solid rgba(255, 255, 255, 0.1);
		background: rgba(255, 255, 255, 0.05);
		color: rgb(240, 240, 244);
		font-size: 0.72rem;
		cursor: pointer;
		transition: background 0.2s ease, border-color 0.2s ease;
	}
	:global(#mi-debug button:hover) {
		background: rgba(255, 255, 255, 0.1);
	}
	:global(#mi-debug button.on) {
		background: rgba(52, 211, 153, 0.16);
		border-color: rgba(52, 211, 153, 0.5);
	}
	:global(#mi-debug button.on)::after {
		content: " · ON";
		color: rgb(52, 211, 153);
		font-weight: 700;
	}
	:global(#mi-debug .mid-real) {
		font-size: 0.64rem;
		color: rgba(240, 240, 244, 0.55);
		line-height: 1.5;
	}
</style>

<script>
	/* ============ 灵动岛媒体指示器（幂等，swup 切页安全） ============ */
	function initMediaIsland() {
		const island = document.getElementById("media-island");
		if (!island || (island as any).__miInited) return;
		(island as any).__miInited = true;

		const eqEl = island.querySelector<HTMLElement>("[data-mi-eq]");
		const labelEl = island.querySelector<HTMLElement>("[data-mi-label]");
		const dotMicEl = island.querySelector<HTMLElement>("[data-mi-dot-mic]");
		const dotCamEl = island.querySelector<HTMLElement>("[data-mi-dot-cam]");
		const volEl = island.querySelector<HTMLElement>("[data-mi-vol]");
		const volFillEl = island.querySelector<HTMLElement>("[data-mi-vol-fill]");
		const songEl = island.querySelector<HTMLElement>("[data-mi-song]");
		const micStateEl = island.querySelector<HTMLElement>("[data-mi-mic-state]");
		const camStateEl = island.querySelector<HTMLElement>("[data-mi-cam-state]");

		// 麦克风/相机占用 = 实时遍历所有已捕获流的 live 轨道（track.stop() 不触发 ended，不能缓存状态）
		const streams: MediaStream[] = [];
		// 调试台模拟开关
		const sim = { audio: false, mic: false, cam: false };
		// 站内跳转中（点击任何内部链接后置位，落站清除，8s 兜底）
		let navUntil = 0;
		// 音量显示（调节音量时临时滑入，2s 无操作收回）
		let volUntil = 0;
		let volLevel = 1;
		// 分步退场：红/绿点熄灭后，黑岛再延迟 600ms 收起
		let dotsPrev = false;
		let hideAt = 0;

		const audioPlaying = (): boolean => {
			const audios = Array.from(document.querySelectorAll("audio"));
			return audios.some((a) => !a.paused && !a.ended && !a.muted && a.volume > 0);
		};

		const currentSong = (): string => {
			const t = document.querySelector<HTMLElement>(".music-title")?.innerText?.trim();
			const ar = document.querySelector<HTMLElement>(".music-artist")?.innerText?.trim();
			if (t && ar) return `${t} · ${ar}`;
			return t || "未知曲目";
		};

		const sync = () => {
			const realAudio = audioPlaying();
			const dev = deviceStreamState();
			const a = realAudio || sim.audio;
			const mic = dev.mic || sim.mic;
			const cam = dev.cam || sim.cam;
			const nav = performance.now() < navUntil;
			const vol = performance.now() < volUntil;
			// 点先灭、岛后收：红/绿点从亮到灭时，岛保留 600ms 再退场
			// （仅当岛上还有别的可见内容时才值得停留；否则立即收起，不留空白色块）
			const dotsOn = mic || cam;
			const visible = a || mic || cam || nav || vol;
			if (dotsPrev && !dotsOn) hideAt = visible ? performance.now() + 600 : 0;
			dotsPrev = dotsOn;
			const any = visible || performance.now() < hideAt;
			island!.classList.toggle("mi-hidden", !any);
			// 收起时一并把展开态复位，下次挤出是干净的收起态
			if (!any) island!.classList.remove("is-expanded");
			eqEl?.classList.toggle("show", a && !vol);
			dotMicEl?.classList.toggle("show", mic);
			dotCamEl?.classList.toggle("show", cam);
			volEl?.classList.toggle("show", vol);
			if (volFillEl) volFillEl.style.width = `${Math.round(volLevel * 100)}%`;
			if (labelEl) labelEl.style.display = vol ? "none" : "";
			if (labelEl) {
				// 麦克风/相机占用只亮红/绿状态点，不再显示文字
				labelEl.textContent = nav ? "正在跳转…" : a ? currentSong() : "";
			}
			if (songEl) songEl.textContent = a ? currentSong() : "—";
			if (micStateEl) micStateEl.textContent = mic ? (sim.mic && !dev.mic ? "使用中（模拟）" : "使用中") : "未使用";
			if (camStateEl) camStateEl.textContent = cam ? (sim.cam && !dev.cam ? "使用中（模拟）" : "使用中") : "未使用";
			// 调试台实时状态
			const real = document.querySelector<HTMLElement>("[data-mid-real]");
			if (real) {
				real.textContent = `真实状态 · 音频:${realAudio ? "播放" : "无"} 麦克风:${dev.mic ? "占用" : "无"} 相机:${dev.cam ? "占用" : "无"}`;
			}
		};

		/* --- 麦克风 / 相机占用检测（站点自身 getUserMedia；实时轨道状态，stop 后立即熄灭） --- */
		const deviceStreamState = () => {
			let mic = false;
			let cam = false;
			for (const s of streams) {
				for (const t of s.getTracks()) {
					if (t.readyState !== "live") continue;
					if (t.kind === "audio") mic = true;
					else if (t.kind === "video") cam = true;
				}
			}
			return { mic, cam };
		};
		const watchStream = (stream: MediaStream) => {
			if (!streams.includes(stream)) streams.push(stream);
			stream.getTracks().forEach((t) => {
				t.addEventListener("ended", sync);
				t.addEventListener("mute", sync);
				t.addEventListener("unmute", sync);
			});
			sync();
		};
		const md = navigator.mediaDevices as
			| (MediaDevices & { getUserMedia: (c: MediaStreamConstraints) => Promise<MediaStream> })
			| undefined;
		if (md?.getUserMedia) {
			const orig = md.getUserMedia.bind(md);
			md.getUserMedia = async (constraints) => {
				const stream = await orig(constraints);
				watchStream(stream);
				return stream;
			};
		}

		/* --- 点击展开 / 收起 --- */
		island.addEventListener("click", () => {
			island.classList.toggle("is-expanded");
		});

		/* --- 音频状态监听 --- */
		["play", "pause", "ended"].forEach((evName) => {
			document.addEventListener(evName, sync, true); // 捕获阶段命中所有 <audio>
		});

		/* --- 音量捕获：调节音量 → 岛显示音量条（忽略流预览元素的 muted 噪音） --- */
		const onVolChange = (e: Event) => {
			const t = e.target as HTMLMediaElement | null;
			if (!t || typeof t.volume !== "number" || t.srcObject) return;
			volLevel = t.muted ? 0 : t.volume;
			volUntil = performance.now() + 2000;
			sync();
		};
		document.addEventListener("volumechange", onVolChange, true);
		window.addEventListener("bg-player-state-change", sync);

		/* --- 站内跳转：点击任何内部链接 → 岛显示"正在跳转…"，落站后按媒体状态去留 --- */
		document.addEventListener(
			"click",
			(e) => {
				if (e.defaultPrevented || e.metaKey || e.ctrlKey) return;
				const link = (e.target as HTMLElement | null)?.closest?.("a[href]") as HTMLAnchorElement | null;
				if (!link) return;
				if (link.target === "_blank" || link.hasAttribute("download")) return;
				/* 岛内浏览（ProMax）已经接管这次点击：卡片带 data-no-swup，
				   swup 会被放过、我们自己也 preventDefault —— 根本不会有导航。
				   注意本监听挂在**捕获阶段**（末尾的 true），跑在 <a> 的处理器之前，
				   所以上面那句 e.defaultPrevented 在这里永远是 false，只能靠标记判断，
				   否则「正在跳转…」会亮着空等 4 秒才自己收回去。 */
				if (link.hasAttribute("data-no-swup")) return;
				const href = link.getAttribute("href") || "";
				if (!href || href.startsWith("#") || href.startsWith("javascript:") || href.startsWith("mailto:") || href.startsWith("tel:")) return;
				try {
					const u = new URL(link.href, location.href);
					if (u.origin !== location.origin) return;
					/* 目标就是当前这一页（典型：在主页点「主页」）→ 根本不会发生导航，
					   如果照样置位，岛就永远等不到 astro:page-load / pageshow，
					   「正在跳转…」会一直挂到 8 秒兜底 —— 用户看到的就是「卡住」。 */
					if (u.pathname === location.pathname && u.search === location.search) return;
					if (u.pathname === location.pathname && u.hash && u.hash !== location.hash) return; // 纯锚点
				} catch {
					return;
				}
				navUntil = performance.now() + 4000;
				sync();
			},
			true,
		);
		const arrive = () => {
			navUntil = 0;
			sync();
		};
		document.addEventListener("astro:page-load", arrive);
		document.addEventListener("swup:contentReplaced", arrive);
		window.addEventListener("pageshow", arrive);

		/* --- 快捷键：Ctrl+Shift+↑/↓ 调音量（优先生效于正在播放的媒体，含静音解除） ---
		    反馈统一走导航岛内的音量条（.mi-vol），左上角不再弹音量 HUD。 */
		const clamp01 = (v: number) => Math.min(1, Math.max(0, Math.round(v * 100) / 100));

		/* --- 左上角快捷键提示：进站后弹一次（教不知道快捷键的访客调音量） --- */
		const hints = document.querySelectorAll("#kbd-hint");
		hints.forEach((n, i) => i > 0 && n.remove()); // swup 重建时去重
		const kbdHint = document.getElementById("kbd-hint");
		if (kbdHint) {
			const t0 = performance.now();
			const tryShowHint = () => {
				if (!kbdHint.isConnected) return;
				const gateOpen = !document.getElementById("version-gate")?.hidden;
				if (!gateOpen) {
					kbdHint.classList.add("show");
					window.setTimeout(() => kbdHint.classList.remove("show"), 6000);
				} else if (performance.now() - t0 < 15000) {
					// 版本门还开着（首次进站）：等它关了再提示
					window.setTimeout(tryShowHint, 600);
				}
			};
			window.setTimeout(tryShowHint, 2500);
			kbdHint.addEventListener("click", () => kbdHint.classList.remove("show"));
		}
		const adjustVolume = (delta: number) => {
			const media = Array.from(document.querySelectorAll<HTMLMediaElement>("audio,video")).filter((m) => !m.srcObject);
			const playing = media.filter((m) => !m.paused && !m.ended);
			const list = playing.length ? playing : media;
			list.forEach((m) => {
				if (m.muted && delta > 0) m.muted = false;
				m.volume = clamp01(m.volume + delta); // 触发 volumechange → 岛内音量条自动挤出
			});
			// 页面没有任何媒体、或音量已到边界（不触发 volumechange）时，直接驱动岛内音量条
			volLevel = list.length ? (list[0].muted ? 0 : list[0].volume) : clamp01(volLevel + delta);
			volUntil = performance.now() + 2000;
			document.getElementById("kbd-hint")?.classList.remove("show"); // 会用快捷键了，提示让位
			sync();
		};

		/* --- 调试台（Ctrl+Shift+E 开关）；键监听全局唯一，防止 swup 重建岛后重复触发 --- */
		const dbg = document.getElementById("mi-debug");
		const prevKey = (window as any).__miKeydown as ((e: KeyboardEvent) => void) | undefined;
		if (prevKey) window.removeEventListener("keydown", prevKey);
		const onKey = (e: KeyboardEvent) => {
			if (e.ctrlKey && e.shiftKey && (e.key === "E" || e.key === "e")) {
				e.preventDefault();
				if (dbg) dbg.hidden = !dbg.hidden;
			} else if (e.ctrlKey && e.shiftKey && (e.key === "ArrowUp" || e.key === "ArrowDown")) {
				e.preventDefault();
				adjustVolume(e.key === "ArrowUp" ? 0.1 : -0.1);
			}
		};
		(window as any).__miKeydown = onKey;
		window.addEventListener("keydown", onKey);
		if (dbg) {
			dbg.querySelectorAll<HTMLButtonElement>("button[data-mid]").forEach((btn) => {
				btn.addEventListener("click", () => {
					const key = btn.dataset.mid as keyof typeof sim;
					sim[key] = !sim[key];
					btn.classList.toggle("on", sim[key]);
					sync();
				});
			});
		}

		document.addEventListener("astro:page-load", sync);
		setInterval(sync, 600);
		sync();
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initMediaIsland);
	} else {
		initMediaIsland();
	}
	document.addEventListener("astro:page-load", initMediaIsland);
	document.addEventListener("swup:contentReplaced", initMediaIsland);
</script>
