---
import { Icon } from "astro-icon/components";
import { url } from "@/utils/url-utils";

interface ArticleLink {
	name: string;
	url: string;
	icon: string;
	desc?: string;
}

interface Props {
	items: ArticleLink[];
	triggerName: string;
	triggerIcon: string;
	triggerHref: string;
}

const { items, triggerName, triggerIcon, triggerHref } = Astro.props;
const triggerFinalHref = url(triggerHref);
---

<div class="article-island" data-article-island>
	<!-- 触发器 - 始终在原位，展开后变成「凹陷槽位」 -->
	<button
		type="button"
		class="ai-trigger btn-plain scale-animation rounded-lg h-10 font-bold px-4 active:scale-95 flex items-center gap-1.5 relative"
		aria-label={triggerName}
		title={triggerName}
		aria-expanded="false"
		aria-haspopup="true"
		data-ai-trigger
	>
		<Icon is:inline name={triggerIcon} class="text-[1.1rem] navbar-icon" />
		<span class="ai-trigger-text">{triggerName}</span>
		<Icon is:inline name="material-symbols:keyboard-arrow-down-rounded" class="ai-trigger-arrow text-[1.2rem]" />
	</button>

	<!--
		文章岛（iOS 灵动岛式两段动效 · 长在岛里）
		面板顶边与导航岛顶边齐平，头部铺满岛内那一格、原地取代「文章」按钮
		（按钮同时淡出，避免叠字）；岛内那一段不铺玻璃，透出的是导航岛自己的
		玻璃；从岛的下沿往下才是面板自己的玻璃，材质与岛完全同一份配方
		（见下方 syncGlass），所以整体读起来是「岛在该列往下长出来的一块」，
		而不是另挂一张卡片，左右两侧也不会留下空的玻璃。
		生命周期：先在岛内那一格变成头部 → 再向两边拉伸 + 向下展开列表。
	-->
	<div class="ai-float-island" data-ai-panel role="region" aria-label={triggerName}>
		<div class="ai-fi-head">
			<span class="ai-fi-dot" aria-hidden="true"></span>
			<span class="ai-fi-title">{triggerName}</span>
			<span class="ai-fi-count">{items.length}</span>
			<button type="button" class="ai-fi-chev" data-ai-close aria-label={`收起${triggerName}`}>
				<Icon is:inline name="material-symbols:keyboard-arrow-down-rounded" class="text-[1.15rem]" />
			</button>
		</div>
		<div class="ai-fi-body">
			{items.map((item, i) => (
				<a
					href={url(item.url)}
					class="ai-fi-card"
					data-ai-item
					style={`--ai-i:${i}`}
				>
					<span class="ai-fi-icon">
						<Icon is:inline name={item.icon} class="text-[1.15rem]" />
					</span>
					<span class="ai-fi-text">
						<span class="ai-fi-name">{item.name}</span>
						{item.desc && <span class="ai-fi-desc">{item.desc}</span>}
					</span>
					<Icon is:inline name="material-symbols:chevron-right-rounded" class="ai-fi-arrow" />
				</a>
			))}
		</div>
	</div>

	<!-- 移动端提示 - 仅在手机端可见 -->
	<div class="ai-mobile-hint" data-ai-mobile-hint>
		<Icon is:inline name="material-symbols:desktop-windows-rounded" class="text-[1rem]" />
		<span>建议使用 1080P 桌面端预览</span>
	</div>

	<!-- 移动端抽屉式菜单覆盖层 -->
	<div class="ai-mobile-drawer" data-ai-mobile-drawer>
		<div class="ai-mobile-drawer-header">
			<span>{triggerName}</span>
			<button type="button" class="ai-mobile-close" data-ai-close aria-label="关闭">
				<Icon is:inline name="material-symbols:close-rounded" class="text-[1.2rem]" />
			</button>
		</div>
		<div class="ai-mobile-drawer-list">
			{items.map((item) => (
				<a
					href={url(item.url)}
					class="ai-mobile-item"
					data-ai-item
				>
					<div class="ai-card-icon">
						<Icon is:inline name={item.icon} class="text-[1.2rem]" />
					</div>
					<div class="ai-card-text">
						<div class="ai-card-title">{item.name}</div>
					</div>
					<Icon is:inline name="material-symbols:chevron-right-rounded" class="ai-mobile-arrow" />
				</a>
			))}
		</div>
	</div>
</div>

<style>
	/* ============================================================
	 * 触发器：展开后变成「凹陷槽位」，表示按钮已被摘走
	 * ============================================================ */
	/* ============================================================
	 * 触发器：「文章」那一列
	 *
	 * 展开时这一列会从「按钮宽」撑到「面板宽」（脚本写 inline width），
	 * 按钮始终居中，所以左右两组导航项被自然推向两边 —— 就是「让位」。
	 * ============================================================ */
	.article-island {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		position: relative;
		z-index: 1000;
		transition: width var(--ai-slot-dur, 440ms)
			var(--ai-ease, cubic-bezier(0.32, 0.72, 0, 1));
	}

	.article-island.open {
		z-index: 10000;
	}

	@media (prefers-reduced-motion: reduce) {
		.article-island {
			transition-duration: 1ms !important;
		}
	}

	@media (max-width: 1023px) {
		.article-island {
			width: auto;
		}
	}

	.ai-trigger {
		position: relative;
		display: inline-flex;
		flex-shrink: 0;
		white-space: nowrap;
		transition:
			opacity 0.4s ease,
			transform 0.45s cubic-bezier(0.32, 0.72, 0, 1),
			box-shadow 0.4s ease;
	}

	/* 展开中：按钮保持可见、可再点收起（面板从它下沿长出，不会盖到它）。
	   用 background-image 画激活底色，绕开 .btn-plain.scale-animation:hover 的
	   background-color: transparent !important */
	.article-island.open .ai-trigger {
		background-image: linear-gradient(rgba(127, 127, 127, 0.12), rgba(127, 127, 127, 0.12));
	}

	.ai-trigger-arrow {
		color: currentColor;
		margin-left: 0.15rem;
		transition: transform 0.32s cubic-bezier(0.32, 0.72, 0, 1);
	}

	.article-island.open .ai-trigger-arrow {
		transform: rotate(180deg);
	}

	.ai-trigger-text {
		display: inline;
		white-space: nowrap;
	}

	/* ============================================================
	 * 文章面板（从「文章」按钮分出来的独立小岛）
	 *
	 * 它不是另一块浮层，而是导航岛在「文章」那一列向下长出来的一块：
	 * 顶边与导航岛下沿齐平、玻璃材质与导航岛完全相同，所以两片是连成一体
	 * 的一个岛（上沿是原岛、下面这一块是长出来的），而不是「岛 + 外挂卡片」。
	 * 导航岛本身的高度、以及左右两侧，都不变（不会出现空的玻璃翅膀）。
	 *
	 * 两段动效（脚本驱动）：
	 *   ① 分割  按钮正下方长出一枚与按钮同宽同高的小岛（圆角胶囊）
	 *   ② 展开  顶边不动，向左右两边拉伸到大面板 + 向下生长出列表
	 * ============================================================ */
	:global(.ai-float-island) {
		position: absolute;
		/* 横向跟着「文章」那一列走：列有多宽，面板就多宽，
		   所以它始终以按钮为中线、向左右两边对称拉伸 */
		left: 0;
		width: 100%;
		top: 0;
		z-index: 5;
		display: flex;
		flex-direction: column;
		box-sizing: border-box;
		overflow: hidden;
		/* 初始不可见，避免 SSR 到脚本接管之间闪一下 */
		visibility: hidden;
		opacity: 0;
		pointer-events: none;
		color: rgb(23, 23, 23);
		/* 面板顶边与导航岛顶边齐平 —— 头部那一格就落在岛内、原地取代「文章」按钮，
		   所以「岛内那一行」不能再铺一层玻璃：两层 55% 玻璃叠在一起会发白，
		   一眼就能看出和岛不是一块。这里用一道硬边渐变，只在岛的下沿以下铺玻璃。
		   --ai-glass-top = 实测的岛高，由脚本写入。 */
		background: linear-gradient(
			to bottom,
			transparent 0,
			transparent var(--ai-glass-top, 0px),
			var(--ai-glass-bg, color-mix(in oklch, var(--card-bg) calc(var(--opacity-55) * 100%), transparent))
				var(--ai-glass-top, 0px)
		);
		/* 玻璃与岛是同一份配方：颜色/模糊/描边都由脚本从岛上抄来（见 syncGlass），
		   这里只留同位回退值，保证脚本没跑之前也不难看 */
		-webkit-backdrop-filter: blur(var(--navbar-glass-blur, 20px));
		backdrop-filter: blur(var(--navbar-glass-blur, 20px));
		border: 1px solid
			var(--ai-glass-border, color-mix(in oklch, var(--card-border, #e5e5e5) 30%, transparent));
		/* 顶边那条线在岛内，留着会在头部那一格上方多一道横线 */
		border-top-color: transparent;
		box-shadow: var(--shadow-navbar);
		transition:
			top var(--ai-dur, 460ms) var(--ai-ease, cubic-bezier(0.32, 0.72, 0, 1)),
			height var(--ai-dur, 460ms) var(--ai-ease, cubic-bezier(0.32, 0.72, 0, 1)),
			border-radius var(--ai-dur, 460ms) var(--ai-ease, cubic-bezier(0.32, 0.72, 0, 1)),
			opacity 220ms ease;
	}

	:global(.ai-float-island.is-shown) {
		visibility: visible;
		opacity: 1;
		pointer-events: auto;
	}

	/* 分割态（还没撑开）：玻璃全在岛的下沿以下，所以这一格是「透明」的，
	   面板此刻只是一块压在岛内的空盒子，不需要边框和投影 */
	:global(.ai-float-island.is-pill) {
		border-color: transparent;
		box-shadow: none;
	}

	/* ============================================================
	 * 三胶囊分裂（点击「文章」时才发生，见脚本 startSplit）
	 *
	 * 展开那一刻，整条导航岛裂成三枚独立胶囊：
	 *   左 = logo + 左侧链接；中 = 「文章」列（向下长出面板）；
	 *   右 = 其余链接 + 天气。
	 * 中间那枚不单独画 —— 面板把玻璃顶到岛顶（--ai-glass-top: 0），
	 * 头部那一格就是中间胶囊；左右两枚由 .ai-cap 实时定位。
	 * 玻璃配方全部走 CSS 变量（var(--card-bg) 等），开着切主题也自己跟上。
	 * ============================================================ */
	:global(.ai-cap) {
		position: absolute;
		display: none;
		border-radius: var(--ai-cap-radius, 9999px);
		background: color-mix(in oklch, var(--card-bg) var(--ai-cap-alpha, 55%), transparent);
		border: 1px solid color-mix(in oklch, var(--card-border, #e5e5e5) 30%, transparent);
		-webkit-backdrop-filter: blur(var(--navbar-glass-blur, 20px));
		backdrop-filter: blur(var(--navbar-glass-blur, 20px));
		box-shadow: var(--shadow-navbar);
		z-index: -1;
		pointer-events: none;
	}

	:global(.dark .ai-cap) {
		box-shadow: var(--shadow-navbar-dark);
	}

	/* 分裂期间摘掉岛自己的玻璃（瞬时生效，见脚本 setSplitClass）。
	:global(:root #navbar#navbar[data-transparent-mode][data-enable-blur][data-is-home].ai-island-split > div),
	:global(#navbar.ai-island-split > div) {
		background: transparent !important;
		border-color: transparent !important;
		box-shadow: none !important;
		backdrop-filter: none !important;
		-webkit-backdrop-filter: none !important;
	}

	/* 分裂期间把导航栏的玻璃高亮（navbar-pill）淡出：
	   高亮比按钮左右各外扩 8px，而左胶囊右缘正好贴着最后一个按钮，
	   高亮会悬进缝隙里「越出」胶囊；且点击「文章」后高亮会滑进面板头部
	   底下隔着毛玻璃透出一团。展开时注意力交给面板，收起后高亮原样回来 */
	:global(.navbar-pill.ai-pill-hidden) {
		opacity: 0 !important;
	}

	/* 面板一露头就把「文章」按钮隐去：面板头部会原地取代它，
	   否则岛内那一格里会出现两套「文章」叠字。
	   用 .ai-live 而不是 .open —— 收起动画期间面板还在，按钮不能提前回来。
	   opacity 单独提速到 0.16s，让它赶在头部淡入之前退干净，不出现重影 */
	.article-island.ai-live .ai-trigger {
		opacity: 0;
		pointer-events: none;
		transition-duration: 0.16s, 0.45s, 0.4s;
	}

	/* 测量 / 复位时用：掐掉整个子树的过渡与动画 */
	:global(.ai-float-island.no-anim),
	:global(.ai-float-island.no-anim *) {
		transition: none !important;
		animation: none !important;
	}

	/* --- 分割态：面板已经长到岛内「文章」按钮那一格上，只是还没撑开 ---
	   高度/内边距也是过渡的，展开时它会「长」成面板头部，而不是跳变 */
	:global(.ai-float-island.is-pill .ai-fi-head) {
		height: var(--ai-head-h, 44px);
		padding: 0 4px 0 10px;
		border-bottom-color: transparent;
	}

	/* --- 面板头部：正好铺满岛内那一格（--ai-head-h = 岛高），
	       内容自然与导航行其它按钮同一条基线 --- */
	:global(.ai-float-island .ai-fi-head) {
		position: relative;
		display: flex;
		flex: none;
		align-items: center;
		gap: 7px;
		height: var(--ai-head-h, 44px);
		padding: 0 8px 0 12px;
		box-sizing: border-box;
		border-bottom: 1px solid transparent;
		opacity: 0;
		transition:
			opacity 0.24s ease,
			height var(--ai-dur, 460ms) var(--ai-ease, cubic-bezier(0.32, 0.72, 0, 1)),
			padding var(--ai-dur, 460ms) var(--ai-ease, cubic-bezier(0.32, 0.72, 0, 1)),
			border-color 0.3s ease;
	}

	:global(.ai-float-island.is-pill .ai-fi-head),
	:global(.ai-float-island.is-expanded .ai-fi-head) {
		opacity: 1;
	}

	:global(.ai-float-island.is-expanded .ai-fi-head) {
		height: var(--ai-head-h, 44px);
		padding: 0 8px 0 12px;
		border-bottom-color: rgba(0, 0, 0, 0.06);
	}

	:global(.ai-float-island .ai-fi-dot) {
		flex: none;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: linear-gradient(135deg, rgb(59, 130, 246), rgb(99, 102, 241));
		box-shadow: 0 0 0 0.5px rgba(59, 130, 246, 0.35);
	}

	:global(.ai-float-island .ai-fi-title) {
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		white-space: nowrap;
	}

	:global(.ai-float-island .ai-fi-count) {
		display: inline-flex;
		flex: none;
		align-items: center;
		justify-content: center;
		min-width: 18px;
		height: 16px;
		padding: 0 5px;
		border-radius: 9999px;
		background: rgba(0, 0, 0, 0.07);
		color: rgba(23, 23, 23, 0.6);
		font-size: 0.625rem;
		font-weight: 600;
		line-height: 1;
	}

	:global(.ai-float-island .ai-fi-chev) {
		display: inline-flex;
		flex: none;
		align-items: center;
		justify-content: center;
		width: 26px;
		height: 26px;
		margin-left: auto;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: rgba(0, 0, 0, 0.05);
		color: inherit;
		cursor: pointer;
		opacity: 0.6;
		transition:
			transform 0.4s cubic-bezier(0.32, 0.72, 0, 1),
			opacity 0.2s ease,
			background 0.15s ease;
	}

	:global(.ai-float-island .ai-fi-chev:hover) {
		opacity: 1;
		background: rgba(0, 0, 0, 0.1);
	}

	:global(.ai-float-island.is-expanded .ai-fi-chev) {
		transform: rotate(180deg);
	}

	/* --- 内容体：跟随面板一起向下展开，卡片按序号错峰淡入 ---
	   弹出的小岛宽度有限，列表走双列栅格（窄到放不下两列时才退成单列） */
	:global(.ai-float-island .ai-fi-body) {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
		align-content: start;
		flex: 1 1 auto;
		gap: 3px;
		min-height: 0;
		padding: 6px 10px 10px;
		box-sizing: border-box;
		overflow-y: auto;
		overscroll-behavior: contain;
	}

	:global(.ai-float-island .ai-fi-body::-webkit-scrollbar) {
		width: 0;
		height: 0;
	}

	:global(.ai-float-island .ai-fi-card) {
		display: flex;
		flex: none;
		align-items: center;
		gap: 10px;
		padding: 7px 10px;
		border-radius: 12px;
		color: inherit;
		text-decoration: none;
		opacity: 0;
		transform: translateY(-6px);
		transition:
			opacity 0.24s ease calc(var(--ai-i, 0) * 34ms),
			transform 0.32s var(--ai-ease, cubic-bezier(0.32, 0.72, 0, 1))
				calc(var(--ai-i, 0) * 34ms),
			background 0.15s ease;
	}

	:global(.ai-float-island.is-expanded .ai-fi-card) {
		opacity: 1;
		transform: none;
	}

	:global(.ai-float-island .ai-fi-card:hover) {
		background: rgba(0, 0, 0, 0.055);
	}

	:global(.ai-float-island .ai-fi-card:active) {
		transform: scale(0.98);
	}

	:global(.ai-float-island .ai-fi-icon) {
		display: flex;
		flex: none;
		align-items: center;
		justify-content: center;
		width: 30px;
		height: 30px;
		border-radius: 9px;
		background: linear-gradient(135deg, rgba(59, 130, 246, 0.14), rgba(99, 102, 241, 0.14));
		color: rgb(59, 130, 246);
	}

	:global(.ai-float-island .ai-fi-text) {
		display: flex;
		flex: 1 1 auto;
		flex-direction: column;
		gap: 1px;
		min-width: 0;
	}

	:global(.ai-float-island .ai-fi-name) {
		font-size: 0.8125rem;
		font-weight: 600;
		line-height: 1.2;
	}

	:global(.ai-float-island .ai-fi-desc) {
		font-size: 0.6875rem;
		line-height: 1.25;
		color: rgba(60, 60, 67, 0.55);
	}

	:global(.ai-float-island .ai-fi-arrow) {
		flex: none;
		opacity: 0.32;
	}

	/* --- 暗色模式 ---
	   背景/描边不用再单独写：color-mix 里的 --card-bg 在暗色下是
	   oklch(0.23 0.015 hue)，会自己变深，和岛同步。这里只补文字色与阴影档位 */
	:global(.dark .ai-float-island) {
		color: rgb(245, 245, 247);
		box-shadow: var(--shadow-navbar-dark);
	}

	:global(.dark .ai-float-island .ai-fi-count) {
		background: rgba(255, 255, 255, 0.12);
		color: rgba(245, 245, 247, 0.7);
	}

	:global(.dark .ai-float-island .ai-fi-chev) {
		background: rgba(255, 255, 255, 0.1);
	}

	:global(.dark .ai-float-island .ai-fi-chev:hover) {
		background: rgba(255, 255, 255, 0.18);
	}

	:global(.dark .ai-float-island .ai-fi-card:hover) {
		background: rgba(255, 255, 255, 0.08);
	}

	:global(.dark .ai-float-island .ai-fi-icon) {
		background: linear-gradient(135deg, rgba(96, 165, 250, 0.2), rgba(129, 140, 248, 0.2));
		color: rgb(147, 197, 253);
	}

	:global(.dark .ai-float-island .ai-fi-desc) {
		color: rgba(235, 235, 245, 0.55);
	}

	:global(.dark .ai-float-island.is-expanded .ai-fi-head) {
		border-bottom-color: rgba(255, 255, 255, 0.1);
	}

	/* 尊重「减弱动效」偏好：直接跳过两段式，落位即展开 */
	@media (prefers-reduced-motion: reduce) {
