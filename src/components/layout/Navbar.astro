</style>

<script>
	// 同步所有导航按钮的 is-current / aria-current，匹配当前 URL
	function syncNavbarActiveState() {
		const path = window.location.pathname.replace(/\/+$/, '') || '/';
		const root = document.getElementById('navbar');
		if (!root) return;
		const elements: HTMLElement[] = Array.from(
			root.querySelectorAll<HTMLElement>('a[href], button[data-ai-trigger]')
		);
		for (const el of elements) {
			const href =
				el.tagName === 'A'
					? (el as HTMLAnchorElement).getAttribute('href')
					: el.getAttribute('data-ai-trigger-href') || el.getAttribute('href');
			if (!href) continue;
			try {
				const u = new URL(href, window.location.origin);
				const hp = u.pathname.replace(/\/+$/, '') || '/';
				if (hp === path || (hp === '/' && (path === '/' || path === '/index.html'))) {
					el.classList.add('is-current');
					if (el.tagName === 'A') el.setAttribute('aria-current', 'page');
				} else {
					el.classList.remove('is-current');
					if (el.tagName === 'A') el.removeAttribute('aria-current');
				}
			} catch { /* ignore */ }
		}
	}

	function initNavbarPill() {
		const pill = document.getElementById('navbar-pill');
		if (!pill) return;

		// 收集可作为高亮目标的元素
		function collectTargets(): HTMLElement[] {
			const root = pill?.parentElement;
			if (!root) return [];
			return Array.from(root.querySelectorAll<HTMLElement>('button, a[href]')).filter((n) => {
				if (n.closest('#navbar-actions')) return false;
				if (n.closest('button[data-ai-close]')) return false;
				return true;
			});
		}

		// 移动 pill 到指定元素
		function moveTo(el: HTMLElement | null) {
			if (!el) {
				pill?.classList.remove('is-active');
				return;
			}
			const parent = pill?.parentElement;
			if (!parent) return;
			const parentRect = parent.getBoundingClientRect();
			const r = el.getBoundingClientRect();
			// 玻璃椭圆比按钮左右各扩 8px、上 1px (iOS 灵动岛扩张感)
			const x = r.left - parentRect.left - 8;
			const yTop = r.top - parentRect.top - 1;
			pill.style.width = r.width + 16 + 'px';
			pill.style.transform = `translate(${x}px, ${yTop}px)`;
			pill.classList.add('is-active');
			document.querySelectorAll('[data-navbar-active]').forEach((n) => n.removeAttribute('data-navbar-active'));
			el.setAttribute('data-navbar-active', '');
		}

		// 找当前 URL 对应的目标元素
		function findActive(): HTMLElement | null {
			const path = window.location.pathname.replace(/\/+$/, '') || '/';
			const targets = collectTargets();
			// 1) aria-current
			for (const el of targets) {
				if (el.getAttribute('aria-current') === 'page') return el;
			}
			// 2) is-current 类
			for (const el of targets) {
				if (el.classList.contains('is-current')) return el;
			}
			// 3) href 精确匹配
			for (const el of targets) {
				const href = (el as HTMLAnchorElement).getAttribute('href');
				if (!href) continue;
				try {
					const u = new URL(href, window.location.origin);
					const hp = u.pathname.replace(/\/+$/, '') || '/';
					if (hp === path) return el;
				} catch { /* ignore */ }
			}
			// 4) 根路径兜底
			if (path === '/' || path === '/index.html') {
				for (const el of targets) {
					const href = (el as HTMLAnchorElement).getAttribute('href');
					if (!href) continue;
					try {
						const u = new URL(href, window.location.origin);
						if ((u.pathname.replace(/\/+$/, '') || '/') === '/') return el;
					} catch { /* ignore */ }
				}
			}
			return null;
		}

		// 临时锁定：点击后 swup 完成前，强制 pill 跟随点击元素，避免被旧 URL 拉回去
		let clickLock: HTMLElement | null = null;
		let clickLockTimer: ReturnType<typeof setTimeout> | null = null;

		function lockTo(el: HTMLElement) {
			clickLock = el;
			if (clickLockTimer) clearTimeout(clickLockTimer);
			// 给 swup 切页一个宽限窗口，期间不重新定位
			clickLockTimer = setTimeout(() => {
				clickLock = null;
			}, 1500);
		}

		// 事件委托：点击导航栏内任意按钮/链接，立即滑动到该元素
		const root = pill.parentElement;
		if (root && !(root as any).__navbarPillClickBound) {
			root.addEventListener('click', (e) => {
				const t = (e.target as HTMLElement)?.closest('button, a[href]') as HTMLElement | null;
				if (!t) return;
				if (t.closest('#navbar-actions')) return;
				if (t.closest('button[data-ai-close]')) return;
				if (t.closest('.dropdown-menu')) return;
				lockTo(t);
				requestAnimationFrame(() => moveTo(t));
			});
			(root as any).__navbarPillClickBound = true;
		}

		function refresh() {
			if (clickLock) {
				moveTo(clickLock);
				return;
			}
			syncNavbarActiveState();
			moveTo(findActive());
		}

		// 初始定位
		requestAnimationFrame(refresh);

		let resizeTimer: ReturnType<typeof setTimeout> | null = null;
		window.addEventListener('resize', () => {
			if (resizeTimer) clearTimeout(resizeTimer);
			resizeTimer = setTimeout(refresh, 80);
		});
		document.addEventListener('astro:page-load', () => {
			clickLock = null;
			setTimeout(refresh, 50);
		});
		// swup 切页：尊重点击锁定，等锁定释放再跟随 URL
		document.addEventListener('swup:contentReplaced', () => {
			setTimeout(refresh, 50);
		});
		if ((window as any).swup?.hooks) {
			(window as any).swup.hooks.on('page:view', () => {
				setTimeout(refresh, 30);
			});
		}

		(window as any).__navbarPillMove = moveTo;
		(window as any).__syncNavbarActiveState = syncNavbarActiveState;
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initNavbarPill);
	} else {
		initNavbarPill();
	}
	document.addEventListener('astro:page-load', initNavbarPill);
	document.addEventListener('swup:contentReplaced', () => setTimeout(initNavbarPill, 30));
</script>
</style>
