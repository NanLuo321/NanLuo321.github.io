	}

	.navbar-pill.is-active {
		opacity: 1;
	}

	/* 暗色模式：更通透的玻璃 */
	.dark .navbar-pill {
		background-color: rgba(14, 165, 233, 0.42);
		box-shadow:
			0 4px 14px -4px rgba(14, 165, 233, 0.55),
			inset 0 1px 0 rgba(255, 255, 255, 0.16),
			inset 0 -1px 0 rgba(56, 189, 248, 0.32);
		border: 1px solid rgba(56, 189, 248, 0.4);
