</style>

<script>
	// 同步所有导航按钮的 is-current / aria-current，匹配当前 URL
	function syncNavbarActiveState() {
		const path = window.location.pathname.replace(/\/+$/, '') || '/';
		const root = document.getElementById('navbar');
		if (!root) return;
		const elements: HTMLElement[] = Array.from(
			root.querySelectorAll<HTMLElement>('a[href], button[data-ai-trigger]')
		);
		for (const el of elements) {
			const href =
				el.tagName === 'A'
					? (el as HTMLAnchorElement).getAttribute('href')
					: el.getAttribute('data-ai-trigger-href') || el.getAttribute('href');
			if (!href) continue;
			try {
				const u = new URL(href, window.location.origin);
				const hp = u.pathname.replace(/\/+$/, '') || '/';
				if (hp === path || (hp === '/' && (path === '/' || path === '/index.html'))) {
					el.classList.add('is-current');
					if (el.tagName === 'A') el.setAttribute('aria-current', 'page');
				} else {
					el.classList.remove('is-current');
					if (el.tagName === 'A') el.removeAttribute('aria-current');
				}
			} catch { /* ignore */ }
		}
	}

	function initNavbarPill() {
		const pill = document.getElementById('navbar-pill');
		if (!pill) return;

		// 收集可作为高亮目标的元素
		function collectTargets(): HTMLElement[] {
			const root = pill?.parentElement;
			if (!root) return [];
			return Array.from(root.querySelectorAll<HTMLElement>('button, a[href]')).filter((n) => {
				if (n.closest('#navbar-actions')) return false;
				if (n.closest('button[data-ai-close]')) return false;
				// 文章岛面板（二级菜单）也在导航条子树里，但它的卡片不是高亮目标：
				// 面板展开时坐标在导航条下方，收起/切页后坐标退化，高亮会卡到屏幕中间
				if (n.closest('[data-ai-panel]')) return false;
				// 同理：文章岛的**移动端抽屉**（.ai-mobile-drawer）也在这棵子树里，
				// 桌面端它整棵是 0×0，但 href 一样对得上 —— 不排掉的话
				// findActive() 可能挑中这些看不见的项，高亮就飞到岛外面去了
				if (n.closest('[data-ai-mobile-drawer]')) return false;
				return true;
			});
		}

		// 移动 pill 到指定元素
		function moveTo(el: HTMLElement | null) {
			if (!el) {
				pill?.classList.remove('is-active');
				return;
			}
			const parent = pill?.parentElement;
			if (!parent) return;
			const parentRect = parent.getBoundingClientRect();
			const r = el.getBoundingClientRect();
			/* 还没量出宽度（字体没到位 / 刚插进来的新节点）：这会儿写
			   width=16px 会让高亮变成一道小竖条，玻璃引擎也会以
			   「尺寸 < 8px」为由拒绝它。宁可不动，等重试。 */
			if (r.width < 8) {
				locateRetry();
				return;
			}
			// 玻璃椭圆比按钮左右各扩 8px、上 1px (iOS 灵动岛扩张感)
			const x = r.left - parentRect.left - 8;
			const yTop = r.top - parentRect.top - 1;
			pill.style.width = r.width + 16 + 'px';
			pill.style.transform = `translate(${x}px, ${yTop}px)`;
			pill.classList.add('is-active');
			document.querySelectorAll('[data-navbar-active]').forEach((n) => n.removeAttribute('data-navbar-active'));
			el.setAttribute('data-navbar-active', '');
		}

		// 找当前 URL 对应的目标元素
		function findActive(): HTMLElement | null {
			const path = window.location.pathname.replace(/\/+$/, '') || '/';
			const targets = collectTargets();
			// 1) aria-current
			for (const el of targets) {
				if (el.getAttribute('aria-current') === 'page') return el;
			}
			// 2) is-current 类
			for (const el of targets) {
				if (el.classList.contains('is-current')) return el;
			}
			// 3) href 精确匹配
			for (const el of targets) {
				const href = (el as HTMLAnchorElement).getAttribute('href');
				if (!href) continue;
				try {
					const u = new URL(href, window.location.origin);
					const hp = u.pathname.replace(/\/+$/, '') || '/';
					if (hp === path) return el;
				} catch { /* ignore */ }
			}
			// 4) 根路径兜底
			if (path === '/' || path === '/index.html') {
				for (const el of targets) {
					const href = (el as HTMLAnchorElement).getAttribute('href');
					if (!href) continue;
					try {
						const u = new URL(href, window.location.origin);
						if ((u.pathname.replace(/\/+$/, '') || '/') === '/') return el;
					} catch { /* ignore */ }
				}
			}
			return null;
		}

		// 临时锁定：点击后 swup 完成前，强制 pill 跟随点击元素，避免被旧 URL 拉回去
		let clickLock: HTMLElement | null = null;
		let clickLockTimer: ReturnType<typeof setTimeout> | null = null;

		function lockTo(el: HTMLElement) {
			clickLock = el;
			if (clickLockTimer) clearTimeout(clickLockTimer);
			// 给 swup 切页一个宽限窗口，期间不重新定位
			clickLockTimer = setTimeout(() => {
				clickLock = null;
			}, 1500);
		}

		// 事件委托：点击导航栏内任意按钮/链接，立即滑动到该元素
		const root = pill.parentElement;
		if (root && !(root as any).__navbarPillClickBound) {
			root.addEventListener('click', (e) => {
				const t = (e.target as HTMLElement)?.closest('button, a[href]') as HTMLElement | null;
				if (!t) return;
				if (t.closest('#navbar-actions')) return;
				if (t.closest('button[data-ai-close]')) return;
				if (t.closest('.dropdown-menu')) return;
				// 文章岛面板内的链接（二级菜单卡片）不抢高亮：点了会导航，
				// 高亮交给 URL 匹配；把 pill 滑到面板里的卡片上会卡在导航条外
				if (t.closest('[data-ai-panel]')) return;
				lockTo(t);
				requestAnimationFrame(() => moveTo(t));
			});
			(root as any).__navbarPillClickBound = true;
		}

		/* ================= 液态玻璃：给高亮本体挂折射引擎 =================
		   需求是「拖的是那枚蓝色高亮」，所以玻璃就长在高亮自己身上，
		   不再另开一块独立的拖拽模块。
		   引擎没起来时（触屏 / 精简版 / 浏览器不支持 url() 滤镜）静默跳过，
		   高亮退回 CSS 那一层 blur(3px)，功能不受影响。 */
		/* band / strength 刻意比导航岛更猛：
		   岛是「一整块大玻璃」，高亮是「一颗小透镜」——小透镜要看清折射，
		   边缘就得掰得更狠，否则在一片素色岛面上什么形变都读不出来。
		   1.4 × 15 × 0.5 ≈ 10.5px 最大位移：拖过图标时能看见图标被「吸」进边缘。
		   rim 0.5 —— 高光棱压掉一半，少了那圈白雾才像玻璃而不是磨砂。 */
		const PILL_GLASS = {
			band: 15,
			strength: 1.4,
			blur: 1.2,
			sat: 1.28,
			rim: 0.5,
			tint: 0.5,
			nest: true,
		};
		/* ---------- 注册要带重试 ----------
		   高亮是「先位移、后显形」的：moveTo() 一边写 width/transform，
		   一边挂上 .is-active（opacity 0 → 1 有 0.3s 过渡）。同一帧里
		   同步调用注册，会撞上两件事：
		     · width 还是 0（引擎判 W < 8 直接跳过）
		     · getComputedStyle 读到的 opacity 还是 0（过渡的起始值）
		   引擎把「不可见」当成「不值得上玻璃」就跳过了，而它只会被
		   主动调用一次 —— 于是整条高亮永远只剩 CSS 那层底色。
		   用户看到的就是「点一次链接，高亮是一块浅色实心胶囊」（原话：
		   「点击一次链接后变白」）：不是玻璃变白，是玻璃压根没挂上。
		   所以失败就按 120ms 重试（上限约 1.7s，足够盖过过渡 + 引擎 idle 扫描），
		   成功即清零。 */
		let pillGlassTimer: ReturnType<typeof setTimeout> | null = null;
		let pillGlassTries = 0;
		function retryPillGlass() {
			if (pillGlassTimer) return;
			if (pillGlassTries >= 14) return;
			pillGlassTries++;
			pillGlassTimer = setTimeout(() => {
				pillGlassTimer = null;
				registerPillGlass();
			}, 120);
		}
		function registerPillGlass(): boolean {
			const api = (window as any).__liquidGlass;
			const el = document.getElementById('navbar-pill');
			/* 液态玻璃是 ProMax 独占：正常版 / 精简版的高亮只留 CSS 那层底色，
			   不上折射。类可能比脚本晚挂上，所以仍走重试（有界）。 */
			if (!document.body.classList.contains('site-promax')) {
				retryPillGlass();
				return false;
			}
			if (!api || !el || !el.classList.contains('is-active')) {
				retryPillGlass();
				return false;
			}
			if (el.hasAttribute('data-lg-on')) {
				pillGlassTries = 0;
				return true;
			}
			const ok = api.register(el, PILL_GLASS) !== false;
			if (ok) {
				pillGlassTries = 0;
			} else {
				retryPillGlass();
			}
			return ok;
		}
		window.addEventListener('liquidglass:ready', registerPillGlass);

		/* ================= 拖拽：把高亮带抓起来 =================
		   模型：pill 是「一块玻璃」，导航岛是「轨道」。
		     · 岛上按下（空白处 / 高亮自己 / 任意导航项）都先「待命」
		     · 位移超过 5px 才升级成拖拽 —— 所以点击行为一点没变
		     · 拖动时 pill 中心跟着指针、宽度取最近那一项的宽度（有「拉丝」感），
		       最近的那一项实时点亮当预览
		     · 松手吃掉那次 click（否则 <a> 会真跳页），然后弹性吸附到最近项
		     · 吸附后接管高亮（manualDrop），直到下次切页再交还给 URL */
		const DRAG_SLOP = 5;
		const dragArm = { armed: false, moved: false, x: 0, y: 0 };
		let suppressClick = false;
		let manualDrop = false;

		function nearestTarget(clientX: number): HTMLElement | null {
			let best: HTMLElement | null = null;
			let bestD = Infinity;
			for (const el of collectTargets()) {
				const r = el.getBoundingClientRect();
				if (r.width <= 0 || r.height <= 0) continue;
				const d = Math.abs(r.left + r.width / 2 - clientX);
				if (d < bestD) {
					bestD = d;
					best = el;
				}
			}
			return best;
		}

		function setPreview(el: HTMLElement | null) {
			document
				.querySelectorAll('[data-navbar-active]')
				.forEach((n) => n.removeAttribute('data-navbar-active'));
			if (el) el.setAttribute('data-navbar-active', '');
		}

		/** 拖拽跟随：pill 中心 = 指针 x，纵向 & 宽度吸附到最近那一项 */
		function dragFollow(clientX: number) {
			const el = document.getElementById('navbar-pill');
			const parent = el?.parentElement;
			if (!el || !parent) return;
			const near = nearestTarget(clientX);
			if (!near) return;
			const pr = parent.getBoundingClientRect();
			const r = near.getBoundingClientRect();
			const w = r.width + 16;
			const yTop = r.top - pr.top - 1;
			/* 允许轻微越出轨道两端（±10px），手感更「活」，松手反正会吸附回来 */
			let x = clientX - pr.left - w / 2;
			if (x < -10) x = -10;
			const maxX = pr.width - w + 10;
			if (x > maxX) x = maxX;
			el.style.width = `${w}px`;
			el.style.transform = `translate(${x}px, ${yTop}px)`;
			el.classList.add('is-active');
			setPreview(near);
		}

		function startDrag() {
			const el = document.getElementById('navbar-pill');
			const track = el?.parentElement;
			if (!el || !track) return;
			/* 拖起来就别再被「点击锁定」拉回去了 */
			clickLock = null;
			if (clickLockTimer) clearTimeout(clickLockTimer);
			el.classList.add('is-dragging');
			track.classList.add('navbar-track-dragging');
		}

		function endDrag(clientX: number) {
			const el = document.getElementById('navbar-pill');
			const track = el?.parentElement;
			const wasDragging = dragArm.moved;
			dragArm.armed = false;
			dragArm.moved = false;
			track?.classList.remove('navbar-track-dragging');
			el?.classList.remove('is-dragging');
			if (!wasDragging) return;
			/* 拖拽末尾那次 click 必须吃掉：导航项都是 <a>，不掐就直接跳页了。
			   click 在 pointerup 之后同步派发，这个 0ms 计时器足够晚。 */
			suppressClick = true;
			setTimeout(() => {
				suppressClick = false;
			}, 0);
			const near = nearestTarget(clientX);
			if (near) {
				manualDrop = true;
				moveTo(near); /* 过渡已恢复 → 这一下就是弹性吸附 */
			}
			/* 拖到某个入口上松手 = 选中它：是页面链接就真的跳过去。
			   只认 <a>（「天气 / 文章」这类在岛里是开面板的按钮，
			   拖上去就跳页反而莫名其妙），且必须是「另一页」才跳。 */
			if (near && near.tagName === "A") {
				let samePage = true;
				try {
					const u = new URL(near.getAttribute("href") || "", location.href);
					samePage =
						u.origin === location.origin &&
						(u.pathname.replace(/\/+$/, "") || "/") ===
							(location.pathname.replace(/\/+$/, "") || "/") &&
						!u.hash;
				} catch (e) {
					samePage = true;
				}
				/* 90ms：足够晚于上面那次「吃掉 click」的 0ms 计时器，
				   又早到看起来就是「松手即跳」 */
				if (!samePage) {
					setTimeout(() => near.click(), 90);
				}
			}
		}

		const dragTrack = pill.parentElement;
		if (dragTrack && !(dragTrack as any).__navbarPillDragBound) {
			dragTrack.addEventListener('pointerdown', (e) => {
				const pe = e as PointerEvent;
				if (pe.pointerType === 'mouse' && pe.button !== 0) return;
				dragArm.armed = true;
				dragArm.moved = false;
				dragArm.x = pe.clientX;
				dragArm.y = pe.clientY;
			});
			/* 捕获阶段掐掉拖拽后的那次 click */
			dragTrack.addEventListener(
				'click',
				(e) => {
					if (!suppressClick) return;
					e.preventDefault();
					e.stopPropagation();
					suppressClick = false;
				},
				true,
			);
			/* 原生 HTML5 拖拽的兜底闸门：CSS 的 -webkit-user-drag:none 已经挡掉
			   绝大部分（<a> 和 <img>），但外链箭头 / 未来新增的节点未必带着，
			   这里在捕获阶段直接 preventDefault —— 保证永远弹不出那个拖拽幽灵。
			   注意：这里只掐「原生拖拽」，我们自己的指针拖拽（pointerdown/move）
			   完全不受影响。 */
			dragTrack.addEventListener(
				'dragstart',
				(e) => {
					e.preventDefault();
					e.stopPropagation();
				},
				true,
			);
			(dragTrack as any).__navbarPillDragBound = true;
		}

		/* 这两个挂在 window 上，全站只挂一次（切页会重复调用本函数） */
		if (!(window as any).__navbarPillDragGlobal) {
			(window as any).__navbarPillDragGlobal = true;
			window.addEventListener(
				'pointermove',
				(e) => {
					if (!dragArm.armed) return;
					const pe = e as PointerEvent;
					if (!dragArm.moved) {
						if (
							Math.abs(pe.clientX - dragArm.x) < DRAG_SLOP &&
							Math.abs(pe.clientY - dragArm.y) < DRAG_SLOP
						)
							return;
						dragArm.moved = true;
						startDrag();
					}
					dragFollow(pe.clientX);
				},
				{ passive: true },
			);
			window.addEventListener('pointerup', (e) => {
				if (!dragArm.armed) return;
				endDrag((e as PointerEvent).clientX);
			});
			window.addEventListener('pointercancel', () => {
				if (!dragArm.armed) return;
				endDrag(Number.NaN);
			});
		}

		/* ---------- 初始定位要带重试 ----------
		   首屏的导航项宽度是「字体到位以后」才定的，切页时新节点更是
		   先以 0 宽插进来。找得到目标就定位；找不到（或被量成 0 宽）
		   时高亮会一直躺在 translate(-9999px) 的初始位上 ——
		   用户看到的就是「进了友链 / 关于我，高亮不见了或者糊成一片」。
		   所以找不到就按 120ms 有界重试，最多 ~1.5s。 */
		let locateTimer: ReturnType<typeof setTimeout> | null = null;
		let locateTries = 0;
		function locateRetry() {
			if (locateTimer || locateTries >= 12) return;
			locateTries++;
			locateTimer = setTimeout(() => {
				locateTimer = null;
				const target = findActive();
				if (target) {
					locateTries = 0;
					moveTo(target);
					registerPillGlass();
				} else {
					locateRetry();
				}
			}, 120);
		}

		function refresh() {
			if (clickLock) {
				moveTo(clickLock);
				return;
			}
			/* 用户手动把高亮摆到别处了 → 尊重它，别被 URL 立刻拉回去 */
			if (manualDrop) return;
			syncNavbarActiveState();
			const active = findActive();
			moveTo(active);
			registerPillGlass();
			if (!active) locateRetry();
		}

		// 初始定位
		requestAnimationFrame(refresh);
		/* 字体加载完导航项宽度会变，重定位一次；load 兜底一次全量布局落定 */
		if (document.fonts && document.fonts.ready) {
			document.fonts.ready.then(() => setTimeout(refresh, 40)).catch(() => {});
		}
		window.addEventListener('load', () => setTimeout(refresh, 60));

		let resizeTimer: ReturnType<typeof setTimeout> | null = null;
		window.addEventListener('resize', () => {
			if (resizeTimer) clearTimeout(resizeTimer);
			resizeTimer = setTimeout(refresh, 80);
		});
		document.addEventListener('astro:page-load', () => {
			clickLock = null;
			manualDrop = false;
			setTimeout(refresh, 50);
		});
		// swup 切页：尊重点击锁定，等锁定释放再跟随 URL
		document.addEventListener('swup:contentReplaced', () => {
			manualDrop = false;
			setTimeout(refresh, 50);
		});
		if ((window as any).swup?.hooks) {
			(window as any).swup.hooks.on('page:view', () => {
				manualDrop = false;
				setTimeout(refresh, 30);
			});
		}

		(window as any).__navbarPillMove = moveTo;
		(window as any).__syncNavbarActiveState = syncNavbarActiveState;
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initNavbarPill);
	} else {
		initNavbarPill();
	}
	document.addEventListener('astro:page-load', initNavbarPill);
	document.addEventListener('swup:contentReplaced', () => setTimeout(initNavbarPill, 30));
</script>
</style>
