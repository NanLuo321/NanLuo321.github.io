---
import { Picture } from "astro:assets";
import * as path from "node:path";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import DynamicIslandSearch from "@/components/controls/DynamicIslandSearch.svelte";
import LightDarkSwitch from "@/components/controls/LightDarkSwitch.svelte";
import {
	backgroundWallpaper,
	navBarConfig,
	profileConfig,
	siteConfig,
} from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { NavBarLink } from "@/types/config";
import { getFallbackFormat, getImageFormats } from "@/utils/image-utils";
import { isHomePage } from "@/utils/layout-utils";
import { url } from "@/utils/url-utils";
import DropdownMenu from "./DropdownMenu.astro";
import ArticleIsland from "./ArticleIsland.astro";

const className = Astro.props.class;

// 获取导航栏透明模式配置
const navbarTransparentMode =
	backgroundWallpaper.mode === "banner"
		? backgroundWallpaper.common?.navbar?.transparentMode || "semi"
		: "semi";

// 获取导航栏毛玻璃效果配置
const navbarEnableBlur =
	backgroundWallpaper.mode === "banner"
		? (backgroundWallpaper.common?.navbar?.enableBlur ?? true)
		: false;

// 获取导航栏模糊度
const navbarBlur =
	backgroundWallpaper.mode === "banner"
		? (backgroundWallpaper.common?.navbar?.blur ?? 20)
		: 0;

// 获取导航栏标题
// 注意：如果 navbar.title 被显式设为空字符串，则不显示标题（仅显示 logo）
const navbarTitle = siteConfig.navbar.title;
const showNavbarTitle =
	navbarTitle !== undefined && navbarTitle !== null && navbarTitle !== "";

// 获取导航栏宽度配置
const navbarWidthFull = siteConfig.navbar.widthFull ?? false;
const navbarMenuAlign = siteConfig.navbar.menuAlign ?? "center";
const isNavbarMenuCentered = navbarMenuAlign === "center";

// 检查是否为首页
const isHomePageCheck = isHomePage(Astro.url.pathname);

// 根据 siteConfig.pages 过滤导航栏链接
const pages = siteConfig.pages;

function isPageEnabled(link: NavBarLink): boolean {
	if (!link.pageKey) return true;
	return pages[link.pageKey as keyof typeof pages] !== false;
}

function filterLinks(link: NavBarLink): NavBarLink | null {
	if (!link.children) {
		return isPageEnabled(link) ? link : null;
	}

	const filteredChildren = link.children.filter(isPageEnabled);

	if (filteredChildren.length === 0) return null;
	return { ...link, children: filteredChildren };
}

let links: NavBarLink[] = navBarConfig.links
	.map(filterLinks)
	.filter((link): link is NavBarLink => link !== null);

// 处理导航栏 Logo 图片
const logoValue = siteConfig.navbar.logo?.value || "";
const isLocalSrcLogo =
	siteConfig.navbar.logo?.type === "image" &&
	logoValue &&
	!logoValue.startsWith("/") &&
	!logoValue.startsWith("http");
let logoImg: ImageMetadata | null = null;

if (isLocalSrcLogo) {
	const files = import.meta.glob<ImageMetadata>(
		"../../**/*.{png,jpg,jpeg,webp,avif,gif,svg}",
		{ import: "default" },
	);
	const normalizedPath = path
		.normalize(path.join("../../", logoValue))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (file) {
		logoImg = await file();
	}
}
---
<div id="navbar" class="w-max max-w-[calc(100vw-5rem)]" style={`--navbar-glass-blur: ${navbarBlur}px;`} data-transparent-mode={navbarTransparentMode} data-enable-blur={String(navbarEnableBlur)} data-is-home={isHomePageCheck} data-full-width={navbarWidthFull}>
    <div class:list={[
        className,
        "overflow-visible! h-14 px-4 rounded-2xl"
    ]}>
        <div class="mx-auto h-full flex items-center gap-3 relative navbar-track">
            <div id="navbar-pill" class="navbar-pill" aria-hidden="true"></div>
            <button
                id="navbar-logo-btn"
                onclick="openEasterEgg()"
                class="btn-plain scale-animation rounded-lg h-10 px-3 md:px-5 font-bold active:scale-95 shrink-0 cursor-pointer"
                aria-label="彩蛋"
                title="点我试试？"
            >
                <div class:list={[
                    "flex flex-row items-center text-md",
                    siteConfig.navbar.followTheme ? "text-(--primary)" : "dark:text-white text-black"
                ]} style="font-family: var(--font-navbar-title, inherit)">
                                    {siteConfig.navbar.logo?.type === "icon" ? (
                                        <Icon is:inline name={siteConfig.navbar.logo.value || "material-symbols:home-pin-outline"} class="text-[1.75rem] mr-2" />
                                    ) : siteConfig.navbar.logo?.type === "image" && logoImg ? (
                                        <Picture
                                            src={logoImg}
                                            alt={siteConfig.navbar.logo.alt || siteConfig.title}
                                            class="h-9 w-auto mr-2 object-contain"
                                            formats={getImageFormats()}
                                            fallbackFormat={getFallbackFormat()}
                                            widths={[36, 72]}
                                            loading="eager"
                                            fetchpriority="high"
                                        />
                                    ) : siteConfig.navbar.logo?.type === "image" ? (
                                        <img src={url(siteConfig.navbar.logo.value)} alt={siteConfig.navbar.logo.alt || siteConfig.title} class="h-9 w-auto mr-2 object-contain" fetchpriority="high" />
                                    ) : siteConfig.navbar.logo?.type === "url" ? (
                                        <img src={siteConfig.navbar.logo.value} alt={siteConfig.navbar.logo.alt || siteConfig.title} class="h-9 w-auto mr-2 object-contain" fetchpriority="high" />
                                    ) : null}
                    <span id="navbar-title" class="font-extrabold text-lg tracking-wide">{showNavbarTitle && navbarTitle}</span>
                    {/* ProMax 图标岛专用：文字标题换成圆形头像（只在 body.site-promax 下显示） */}
                    <span class="pm-logo-avatar" aria-hidden="true">
                        <img
                            src={url(profileConfig.avatar)}
                            alt=""
                            width="32"
                            height="32"
                            decoding="async"
                        />
                    </span>
                </div>
            </button>
            <div class:list={[
                /* ⚠ 用 md 而不是 lg：lg(1024) 会把平板（768~1023）排挤出图标导航，
                   岛上只剩 logo + 天气，用户看到的就是「平板模式图标消失」。
                   平板宽度塞得下这排图标（实测 768px 起），所以从 md 起就想显示。 */
                "hidden md:flex items-center space-x-1",
                isNavbarMenuCentered
                    ? "justify-center flex-1"
                    : "justify-start pl-2"
            ]}>
                {links.map((l) => {
                    // 文章按钮使用岛内展开的特殊组件
                    if (l.name === "文章") {
                        return (
                            <ArticleIsland
                                triggerName={l.name}
                                triggerIcon={l.icon || "material-symbols:article"}
                                triggerHref={l.url}
                                items={[
                                    { name: "文章", url: "/", icon: "material-symbols:article", desc: "返回主页" },
                                    { name: "归档", url: "/archive/", icon: "material-symbols:archive", desc: "按时间归档" },
                                    { name: "系列", url: "/series/", icon: "material-symbols:collections-bookmark", desc: "专题系列" },
                                    { name: "分类", url: "/categories/", icon: "material-symbols:folder-open-rounded", desc: "按分类浏览" },
                                    { name: "标签", url: "/tags/", icon: "material-symbols:tag-rounded", desc: "按标签浏览" },
                                ]}
                            />
                        );
                    }
                    return <DropdownMenu link={l} />;
                })}
            </div>
            <button
                aria-label="Rainform 天气"
                title="Rainform 数据成雨"
                class="btn-plain scale-animation rounded-lg h-10 px-3 active:scale-95 shrink-0 cursor-pointer flex items-center gap-1.5"
                id="rainform-weather-toggle"
            >
                <Icon is:inline name="material-symbols:rainy-rounded" class="text-[1.25rem]" />
                <span class="text-sm font-bold">天气</span>
            </button>
            <!--
                媒体灵动岛（原右上角黑色悬浮岛，现融合进本岛）
                常态收起、零宽不占位；音频播放 / 麦克风 / 摄像头占用时，
                这一块从导航岛内部向右侧挤出，点它可在岛下方展开详情。
                状态与交互脚本见 MediaIsland.astro（通过 #media-island 抓取节点）。
            -->
            <div id="media-island" class="mi-hidden">
                <!-- 挤出态内容 -->
                <div class="mi-slot">
                    <div class="mi-pill">
                        <span class="mi-eq" data-mi-eq aria-hidden="true"><i></i><i></i><i></i><i></i></span>
                        <span class="mi-label" data-mi-label></span>
                        <!-- 音量条（调节音量时临时显示） -->
                        <span class="mi-vol" data-mi-vol aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 8v8a4.5 4.5 0 0 0 2.5-4z"/></svg>
                            <span class="mi-vol-bar"><span class="mi-vol-fill" data-mi-vol-fill></span></span>
                        </span>
                        <!-- iOS 风格状态点：摄像头=绿点（左），麦克风=红点（右） -->
                        <span class="mi-dot mi-dot-cam" data-mi-dot-cam aria-hidden="true"></span>
                        <span class="mi-dot mi-dot-mic" data-mi-dot-mic aria-hidden="true"></span>
                    </div>
                </div>
                <!-- 展开态详情：浮在导航岛下方 -->
                <div class="mi-detail" data-mi-detail>
                    <div class="mi-row">
                        <span class="mi-k">正在播放</span>
                        <span class="mi-v" data-mi-song>—</span>
                    </div>
                    <div class="mi-row">
                        <span class="mi-k">麦克风</span>
                        <span class="mi-v" data-mi-mic-state>未使用</span>
                    </div>
                    <div class="mi-row">
                        <span class="mi-k">相机</span>
                        <span class="mi-v" data-mi-cam-state>未使用</span>
                    </div>
                    <div class="mi-tip">点击收起</div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- 独立悬浮按钮岛 -->
<div id="navbar-actions" class="pointer-events-auto" style={`--navbar-glass-blur: ${navbarBlur}px;`}>
    <div class="navbar-actions-inner flex items-center gap-1 h-14 px-2 rounded-2xl">
        <DynamicIslandSearch client:load />
        {backgroundWallpaper.playerEnable && backgroundWallpaper.mode !== "none" && (
            <button
                aria-label={i18n(I18nKey.videoPlay)}
                class="btn-plain scale-animation rounded-lg h-9 w-9 md:h-11 md:w-11 active:scale-90"
                id="bg-player-toggle"
                data-i18n-play={i18n(I18nKey.videoPlay)}
                data-i18n-pause={i18n(I18nKey.videoPause)}
            >
                <span class="bg-player-icon-play"><Icon is:inline name="material-symbols:play-arrow-rounded" class="text-[1.5rem]" /></span>
                <span class="bg-player-icon-pause hidden"><Icon is:inline name="material-symbols:pause-rounded" class="text-[1.5rem]" /></span>
            </button>
        )}
        <button
            aria-label="切换樱花和雨滴"
            title="切换樱花和雨滴"
            class="btn-plain scale-animation rounded-lg h-9 w-9 md:h-11 md:w-11 active:scale-90 flex items-center justify-center"
            id="effect-mode-toggle"
            data-mode="rain"
        >
            <span class="effect-icon-rain"><Icon is:inline name="material-symbols:water-drop-rounded" class="text-[1.25rem]" /></span>
            <span class="effect-icon-sakura hidden"><Icon is:inline name="material-symbols:local-florist-rounded" class="text-[1.25rem]" /></span>
            <span class="effect-icon-leaf hidden"><Icon is:inline name="material-symbols:eco-rounded" class="text-[1.25rem]" /></span>
            <span class="effect-icon-all hidden text-[1rem] font-black leading-none">A</span>
        </button>
        {/* 壁纸来源 + 角色凸出（iPhone 锁屏那种"时间嵌进角色里"）。
            这颗只管开面板，面板 DOM 与全部逻辑在 WallpaperDepth.astro。 */}
        <button
            aria-label="壁纸来源与角色凸出"
            title="壁纸来源 / 角色凸出（时间嵌进角色里）"
            class="btn-plain scale-animation rounded-lg h-9 w-9 md:h-11 md:w-11 active:scale-90 flex items-center justify-center"
            id="wp-source-toggle"
            aria-pressed="false"
        >
            <Icon is:inline name="material-symbols:wallpaper-rounded" class="text-[1.25rem]" />
        </button>
        {/* ProMax 专属：把右下角那颗「娱乐模式」搬进岛里（点击转发给 RainEffect 的隐藏开关） */}
        <button
            aria-label="娱乐模式：声音控制雨幕"
            title="娱乐模式：说话声音越大，雨越大"
            class="btn-plain scale-animation rounded-lg h-9 w-9 md:h-11 md:w-11 active:scale-90 items-center justify-center"
            id="pm-rain-toggle"
            aria-pressed="false"
        >
            <Icon is:inline name="material-symbols:mic-rounded" class="text-[1.25rem]" />
        </button>
        {/* @ts-ignore */}
        <LightDarkSwitch client:load></LightDarkSwitch>
    </div>
</div>
<!-- 手机端独立浮空导航岛 - 显示在导航栏下方，居中于视口
     ⚠ md:hidden：平板（768~1023）已经能显示桌面岛的图标导航了
       （见上面图标行的注释），再显示这排文字岛就是两套导航叠在一起 -->
<div id="mobile-nav-island" class="md:hidden fixed z-50 pointer-events-auto">
    <div class="mobile-nav-island-inner flex items-center gap-0.5 px-2 py-1.5 rounded-full">
        <span class="mobile-pill" aria-hidden="true"></span>
        {links.map((l) => {
            const linkUrl = l.children && l.children.length > 0
                ? (l.children[0].external ? l.children[0].url : url(l.children[0].url))
                : (l.external ? l.url : url(l.url));
            return (
                <a
                    href={linkUrl}
                    data-mobile-pill
                    class="mobile-pill-link shrink-0 px-2.5 py-1 text-xs font-medium text-black/60 dark:text-white/60 rounded-full active:scale-95 transition"
                    target={l.external ? "_blank" : null}
                >
                    {l.name}
                </a>
            );
        })}
    </div>
</div>

<script>
function initEffectModeToggle() {
    const button = document.getElementById('effect-mode-toggle') as HTMLButtonElement | null;
    if (!button) return;
    const buttonEl = button;

    const rainIcon = buttonEl.querySelector('.effect-icon-rain') as HTMLElement | null;
    const sakuraIcon = buttonEl.querySelector('.effect-icon-sakura') as HTMLElement | null;
    const leafIcon = buttonEl.querySelector('.effect-icon-leaf') as HTMLElement | null;
    const allIcon = buttonEl.querySelector('.effect-icon-all') as HTMLElement | null;

    function applyMode(mode: 'rain' | 'sakura' | 'leaf' | 'all') {
        buttonEl.dataset.mode = mode;
        buttonEl.title =
            mode === 'rain'
                ? '当前：雨滴，点击切换樱花'
                : mode === 'sakura'
                    ? '当前：樱花，点击切换树叶'
                    : mode === 'leaf'
                        ? '当前：树叶，点击切换全部特效'
                        : '当前：全部特效，点击切换雨滴';
        buttonEl.setAttribute('aria-label', buttonEl.title);
        rainIcon?.classList.toggle('hidden', mode !== 'rain');
        sakuraIcon?.classList.toggle('hidden', mode !== 'sakura');
        leafIcon?.classList.toggle('hidden', mode !== 'leaf');
        allIcon?.classList.toggle('hidden', mode !== 'all');
        localStorage.setItem('visualEffectMode', mode);
        window.dispatchEvent(new CustomEvent('effectModeChange', { detail: { mode } }));
    }

    const storedMode = localStorage.getItem('visualEffectMode');
    // 精简优化版：粒子特效保持关闭，不被默认值重置
    if (localStorage.getItem('siteVersion') === 'lite') {
        localStorage.setItem('visualEffectMode', 'none');
        window.dispatchEvent(new CustomEvent('effectModeChange', { detail: { mode: 'none' } }));
    } else {
        applyMode(storedMode === 'sakura' || storedMode === 'leaf' || storedMode === 'all' ? storedMode : 'rain');
    }

    if (buttonEl.dataset.bound === 'true') return;
    buttonEl.dataset.bound = 'true';
    buttonEl.addEventListener('click', () => {
        const currentMode = buttonEl.dataset.mode;
        applyMode(
            currentMode === 'rain'
                ? 'sakura'
                : currentMode === 'sakura'
                    ? 'leaf'
                    : currentMode === 'leaf'
                        ? 'all'
                        : 'rain',
        );
    });
}

initEffectModeToggle();
document.addEventListener('astro:page-load', initEffectModeToggle);

// 手机端浮空导航岛：移动到 body 层级并同步显隐
function initMobileNavIsland() {
    const mobileNavIsland = document.getElementById('mobile-nav-island');
    const navbarWrapper = document.getElementById('navbar-wrapper');
    if (!mobileNavIsland || !navbarWrapper) return;
    const mobileNavIslandEl = mobileNavIsland as HTMLElement;
    const navbarWrapperEl = navbarWrapper as HTMLElement;

    // 将浮空岛移动到 body 层级，避免父元素 transform 影响 fixed 定位
    if (mobileNavIslandEl.parentElement !== document.body) {
        document.body.appendChild(mobileNavIslandEl);
    }

    // 手机端将导航岛固定在网页下方居中
    function positionIsland() {
        const vw = document.documentElement.clientWidth;
        mobileNavIslandEl.style.left = '50%';
        mobileNavIslandEl.style.right = 'auto';
        mobileNavIslandEl.style.top = 'auto';
        mobileNavIslandEl.style.bottom = '4.7rem';
        mobileNavIslandEl.style.maxWidth = `${Math.max(120, vw - 24)}px`;
    }

    // 同步显隐状态
    function syncVisibility() {
        const hidden = navbarWrapperEl.classList.contains('navbar-manual-hidden') ||
                       navbarWrapperEl.classList.contains('navbar-hidden') ||
                       navbarWrapperEl.classList.contains('navbar-video-hidden');
        positionIsland();
        if (hidden) {
            mobileNavIslandEl.style.transform = 'translate(-50%, 140%) scale(0.9)';
            mobileNavIslandEl.style.opacity = '0';
            mobileNavIslandEl.style.pointerEvents = 'none';
        } else {
            mobileNavIslandEl.style.transform = 'translate(-50%, 0) scale(1)';
            mobileNavIslandEl.style.opacity = '';
            mobileNavIslandEl.style.pointerEvents = '';
        }
    }

    // 窗口大小变化时重新定位
    window.addEventListener('resize', positionIsland);

    // 使用 MutationObserver 监听导航栏 class 变化
    const observer = new MutationObserver(syncVisibility);
    observer.observe(navbarWrapperEl, { attributes: true, attributeFilter: ['class'] });

    // 监听背景视频播放状态，播放时自动隐藏两个导航岛
    window.addEventListener('bg-player-state-change', function(e: Event) {
        const ce = e as CustomEvent;
        const playing = ce.detail && ce.detail.playing;
        if (playing) {
            navbarWrapperEl.classList.add('navbar-video-hidden');
        } else {
            navbarWrapperEl.classList.remove('navbar-video-hidden');
        }
    });

    // 初始同步
    syncVisibility();
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMobileNavIsland);
} else {
    initMobileNavIsland();
}
document.addEventListener('astro:page-load', initMobileNavIsland);
document.addEventListener('swup:contentReplaced', initMobileNavIsland);

// 手机浮空岛：iOS 风格滑动玻璃高亮
function initMobilePill() {
    const inner = document.querySelector('#mobile-nav-island .mobile-nav-island-inner') as HTMLElement | null;
    const pill = document.querySelector('#mobile-nav-island .mobile-pill') as HTMLElement | null;
    if (!inner || !pill) return;
    const links = Array.from(inner.querySelectorAll<HTMLAnchorElement>('a[data-mobile-pill]'));
    if (links.length === 0) return;

    function moveTo(el: HTMLElement | null) {
        if (!el || !inner || !pill) {
            pill.classList.remove('is-active');
            return;
        }
        const innerRect = inner.getBoundingClientRect();
        const r = el.getBoundingClientRect();
        const x = r.left - innerRect.left;
        // pill 高度 24px == 链接高度 24px，直接用 link 的 top 作为 pill top，再向上 2px 微调
        const yTop = r.top - innerRect.top - 2;
        pill.style.width = r.width + 'px';
        pill.style.transform = `translate(${x}px, ${yTop}px)`;
        pill.classList.add('is-active');

        inner.querySelectorAll('[data-mobile-active]').forEach((n) => n.removeAttribute('data-mobile-active'));
        el.setAttribute('data-mobile-active', '');
    }

    function findActive(): HTMLElement | null {
        const path = window.location.pathname.replace(/\/+$/, '') || '/';
        for (const el of links) {
            const href = el.getAttribute('href');
            if (!href) continue;
            try {
                const u = new URL(href, window.location.origin);
                const hp = u.pathname.replace(/\/+$/, '') || '/';
                if (hp === path) return el;
            } catch { /* ignore */ }
        }
        return null;
    }

    // 点击锁定：点击后 swup 切页期间不重新定位
    let clickLock: HTMLElement | null = null;
    let clickLockTimer: ReturnType<typeof setTimeout> | null = null;
    function lockTo(el: HTMLElement) {
        clickLock = el;
        if (clickLockTimer) clearTimeout(clickLockTimer);
        clickLockTimer = setTimeout(() => { clickLock = null; }, 1500);
    }

    // 用事件委托替换逐个绑定
    if (!(inner as any).__mobilePillClickBound) {
        inner.addEventListener('click', (e) => {
            const t = (e.target as HTMLElement)?.closest('a[data-mobile-pill]') as HTMLElement | null;
            if (!t) return;
            lockTo(t);
            requestAnimationFrame(() => moveTo(t));
        });
        (inner as any).__mobilePillClickBound = true;
    }

    function refresh() {
        if (clickLock) {
            moveTo(clickLock);
            return;
        }
        moveTo(findActive());
    }

    // 初始定位（双 rAF，等布局/字体/可见性稳定）
    requestAnimationFrame(() => requestAnimationFrame(refresh));

    // 当 island 从隐藏变为可见（或尺寸变化）时，重新定位
    if (typeof ResizeObserver !== 'undefined' && inner) {
        const ro = new ResizeObserver(() => {
            if (inner && inner.offsetWidth > 0) refresh();
        });
        ro.observe(inner);
    }
    // 监听 island 自身的 display 变化
    if (inner) {
        const island = inner.closest('#mobile-nav-island') as HTMLElement | null;
        if (island && (window as any).MutationObserver) {
            const mo = new MutationObserver(() => {
                if (island.offsetWidth > 0 || getComputedStyle(island).display !== 'none') {
                    requestAnimationFrame(refresh);
                }
            });
            mo.observe(island, { attributes: true, attributeFilter: ['style', 'class'] });
        }
    }

    // 横向滚动 island 时，让 pill 也跟着水平移动
    inner.addEventListener('scroll', () => {
        const active = inner.querySelector('[data-mobile-active]') as HTMLElement | null;
        if (active) moveTo(active);
    });

    let resizeTimer: ReturnType<typeof setTimeout> | null = null;
    window.addEventListener('resize', () => {
        if (resizeTimer) clearTimeout(resizeTimer);
        resizeTimer = setTimeout(refresh, 80);
    });
    document.addEventListener('astro:page-load', () => {
        clickLock = null;
        setTimeout(refresh, 50);
    });
    document.addEventListener('swup:contentReplaced', () => {
        setTimeout(refresh, 50);
    });
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMobilePill);
} else {
    initMobilePill();
}
document.addEventListener('astro:page-load', initMobilePill);
document.addEventListener('swup:contentReplaced', () => setTimeout(initMobilePill, 30));

function loadButtonScript() {
    // 背景视频播放器控制按钮
    let bgPlayerBtn = document.getElementById("bg-player-toggle");
    if (bgPlayerBtn) {
        bgPlayerBtn.onclick = function () {
            window.dispatchEvent(new CustomEvent("bg-player-toggle"));
        };
        function toggleBgPlayerIcon(playing: boolean) {
            var playIcon = bgPlayerBtn!.querySelector(".bg-player-icon-play");
            var pauseIcon = bgPlayerBtn!.querySelector(".bg-player-icon-pause");
            if (playIcon && pauseIcon) {
                playIcon.classList.toggle("hidden", playing);
                pauseIcon.classList.toggle("hidden", !playing);
            }
            var i18nPlay = bgPlayerBtn!.getAttribute("data-i18n-play") ?? "";
            var i18nPause = bgPlayerBtn!.getAttribute("data-i18n-pause") ?? "";
            var label = playing ? i18nPause : i18nPlay;
            bgPlayerBtn!.setAttribute("title", label);
            bgPlayerBtn!.setAttribute("aria-label", label);
        }
        window.addEventListener("bg-player-state-change", function (e) {
            var ce = e as CustomEvent;
            var playing = ce.detail && ce.detail.playing;
            toggleBgPlayerIcon(playing);
        });
        // 切换壁纸模式时隐藏/显示播放按钮
        window.addEventListener("wallpaperModeChange", function (e) {
            var ce = e as CustomEvent;
            var mode = ce.detail && ce.detail.mode;
            bgPlayerBtn!.style.display = mode === "none" ? "none" : "";
        });
        // Swup 导航时同步播放按钮状态（BackgroundPlayer 可能被重建，也可能持久存在）
        function syncBgPlayerBtn() {
            var playing = document.documentElement.hasAttribute("data-bg-video-playing");
            toggleBgPlayerIcon(playing);
        }
        if (window.swup && window.swup.hooks) {
            window.swup.hooks.on("content:replace", syncBgPlayerBtn);
        } else {
            document.addEventListener("swup:enable", function () {
                window.swup.hooks.on("content:replace", syncBgPlayerBtn);
            });
        }
    }
}

loadButtonScript();
document.addEventListener("astro:page-load", loadButtonScript);
document.addEventListener("swup:contentReplaced", loadButtonScript);

// 为semifull模式添加滚动检测逻辑
function initSemifullScrollDetection() {
    const navbar = document.getElementById('navbar');
    if (!navbar) return;

    const transparentMode = navbar.getAttribute('data-transparent-mode');
    if (transparentMode !== 'semifull') return;

    // 无论首页/非首页，semifull 都由滚动位置决定是否进入 scrolled 状态
    // 先移除之前的滚动监听器，避免重复绑定
    if (window.semifullScrollHandler) {
        window.removeEventListener('scroll', window.semifullScrollHandler as () => void);
        window.semifullScrollHandler = undefined;
    }

    // 初始状态不强制加 scrolled，保持透明；滚动后再切换
    navbar.classList.remove('scrolled');

    let ticking = false;

    function updateNavbarState() {
        if (document.documentElement.classList.contains('is-page-transitioning')) {
            navbar!.classList.remove('scrolled');
            ticking = false;
            return;
        }

        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        const threshold = 50; // 滚动阈值，可以根据需要调整
        // 使用批量DOM操作优化性能
        if (scrollTop > threshold) {
            navbar!.classList.add('scrolled');
        } else {
            navbar!.classList.remove('scrolled');
        }

        ticking = false;
    }

    function requestTick() {
        if (!ticking) {
            requestAnimationFrame(updateNavbarState);
            ticking = true;
        }
    }

    // 移除之前的滚动事件监听器（如果存在）
    if (window.semifullScrollHandler) {
        window.removeEventListener('scroll', window.semifullScrollHandler as () => void);
    }

    // 保存新的事件处理器引用
    window.semifullScrollHandler = requestTick as unknown as (() => void);

    // 监听滚动事件
    window.addEventListener('scroll', requestTick, { passive: true });

    // 初始化状态
    updateNavbarState();
}

// 将函数暴露到全局对象，供页面切换时调用
window.initSemifullScrollDetection = initSemifullScrollDetection;

// 页面加载完成后初始化滚动检测
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSemifullScrollDetection);
} else {
    initSemifullScrollDetection();
}
</script>

