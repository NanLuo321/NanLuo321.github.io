---
// 光标 / 指针统一入口
//
// 1) 桌面端（hover + fine pointer）：整套指针换成用户提供的 .cur 套装
//    public/cursors/*.cur —— 32×32 32 位，热点按文件内定义
//      arrow      默认箭头        (2,2)
//      hand       链接/按钮手型    (6,1)
//      sizeall    拖拽/移动        (14,13)
//      sizewe     水平缩放        (10,6)
//      sizens     垂直缩放        (6,10)
//      sizenwse   对角缩放(\)     (8,8)
//      sizenesw   对角缩放(/)     (8,8)
//      progress   忙碌（.ani 首帧抽出来的静态帧，浏览器不认 .ani）
//    文本输入仍用系统 I 型光标，保证可用性。
//
//    ⚠ 光靠 CSS 选择器**盖不全**：站点自己的样式（.vr-toggle { cursor: pointer }、
//      Tailwind 的 .cursor-pointer 之类）特异性往往比标签选择器高，结果就是
//      「只有默认箭头变了，其它状态还是系统指针」。所以这里双管齐下：
//        a) CSS 全部带 !important —— 解决大部分
//        b) 运行时扫描：读每个元素真实的 computed cursor，凡是想显示
//           pointer / move / *-resize 的，直接内联写成 .cur —— 兜住剩下的
//           （内联 + !important 是作者级里唯一能稳压站点 !important 的东西）
//
// 2) 触摸端（coarse pointer）：Win7 风格「触摸指针」——触摸点上的
//    半透明圆环 + 中心点 + 四向短刻度，抬手淡出。
//    原来的「圆点 + 圆环」自定义光标已按需求移除。
---

<!-- Win7 风格触摸指针的宿主层（触摸端才会实例化） -->
<div id="touch-pointer-layer" aria-hidden="true"></div>

<style is:global>
	/* ===================== 1. 桌面端：用户 .cur 套装 ===================== */
	@media (hover: hover) and (pointer: fine) {
		html,
		body {
			cursor: url("/cursors/arrow.cur") 2 2, auto !important;
		}

		/* 可点击的东西 → 手型 */
		a,
		button,
		[role="button"],
		[role="tab"],
		[role="menuitem"],
		[role="option"],
		[role="link"],
		[role="switch"],
		[role="checkbox"],
		summary,
		label,
		select,
		.cursor-pointer,
		.btn-plain,
		.dropdown-trigger,
		.pm-hi,
		.vg-btn,
		#voice-rain-toggle,
		.vr-emoji,
		.vr-text,
		#pm-rain-toggle,
		input[type="submit"],
		input[type="button"],
		input[type="reset"],
		input[type="checkbox"],
		input[type="radio"],
		input[type="file"],
		input[type="range"] {
			cursor: url("/cursors/hand.cur") 6 1, pointer !important;
		}

		/* 文本输入 → 系统 I 型光标（.cur 套装里没有 I 型，保留系统的最易用） */
		input:not([type]),
		input[type="text"],
		input[type="search"],
		input[type="email"],
		input[type="url"],
		input[type="tel"],
		input[type="password"],
		input[type="number"],
		input[type="date"],
		input[type="time"],
		textarea,
		[contenteditable],
		[contenteditable="true"],
		.ProseMirror,
		[role="textbox"] {
			cursor: text !important;
		}

		/* 禁用态 */
		[disabled],
		[aria-disabled="true"],
		.is-disabled {
			cursor: url("/cursors/arrow.cur") 2 2, not-allowed !important;
		}

		/* 忙碌态：切页 / 加载中（配合 .is-busy / html.pm-busy 类） */
		.is-busy,
		.is-loading,
		html.pm-busy,
		html.pm-busy body,
		html.pm-busy * {
			cursor: url("/cursors/progress.cur") 2 2, progress !important;
		}

		/* 可拖拽 → 移动十字
		   导航岛整条行现在是「拖拽手柄」（拖那枚蓝色液态玻璃高亮），
		   所以岛本体给 grab、拖起来时由 .navbar-track-dragging 换成抓握态。 */
		[draggable="true"],
		.cursor-move,
		.cursor-grab,
		.cursor-grabbing,
		.profile-float-header,
		#music-float-drag,
		.navbar-track,
		.navbar-pill,
		.navbar-pill.is-dragging {
			cursor: url("/cursors/sizeall.cur") 14 13, move !important;
		}

		/* 浮窗缩放手柄 → 对角缩放
		   注意：Layout.astro 里 .profile-float-resize 自带 cursor: nwse-resize !important，
		   所以这里用「ID + !important」压过去（ID 权重高于那条类选择器）。 */
		#profile-float-resize,
		#announce-float-resize,
		#music-float-resize,
		#weather-float-resize,
		.profile-float-resize,
		.cursor-nwse-resize {
			cursor: url("/cursors/sizenwse.cur") 8 8, nwse-resize !important;
		}

		/* 玻璃滚动条 / 横向拖拽 → 水平缩放 */
		.cursor-ew-resize,
		.cursor-col-resize,
		.ew-resize {
			cursor: url("/cursors/sizewe.cur") 10 6, ew-resize !important;
		}

		/* 垂直缩放 */
		.cursor-ns-resize,
		.cursor-row-resize,
		.ns-resize {
			cursor: url("/cursors/sizens.cur") 6 10, ns-resize !important;
		}

		/* 另一条对角线 */
		.cursor-nesw-resize,
		.nesw-resize {
			cursor: url("/cursors/sizenesw.cur") 8 8, nesw-resize !important;
		}
	}

	/* ===================== 2. 触摸端：Win7 触摸指针 ===================== */
	#touch-pointer-layer {
		position: fixed;
		inset: 0;
		z-index: 100003;
		pointer-events: none;
	}

	.tp {
		position: fixed;
		top: 0;
		left: 0;
		width: 46px;
		height: 46px;
		margin: -23px 0 0 -23px;
		pointer-events: none;
		opacity: 0;
		/* 位置走 CSS 变量，缩放交给状态类，避免内联 transform 覆盖过渡 */
		transform: translate(var(--tp-x, 0px), var(--tp-y, 0px)) scale(0.72);
		transition:
			opacity 0.18s ease,
			transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
		will-change: transform, opacity;
	}

	.tp.on {
		opacity: 1;
		transform: translate(var(--tp-x, 0px), var(--tp-y, 0px)) scale(1);
	}

	.tp.tp-up {
		opacity: 0;
		transform: translate(var(--tp-x, 0px), var(--tp-y, 0px)) scale(1.35);
		transition:
			opacity 0.3s ease,
			transform 0.3s ease-out;
	}

	.tp svg {
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	/* 触摸端隐藏本组件的指针样式（触摸设备本来也不显示） */
	@media (hover: none), (pointer: coarse) {
		#touch-pointer-layer {
			display: block;
		}
	}

	@media (hover: hover) and (pointer: fine) {
		#touch-pointer-layer {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		#touch-pointer-layer {
			display: none !important;
		}
	}
</style>

<script is:inline>
	(function () {
		"use strict";
		var mq = window.matchMedia;
		var fine = false;
		try {
			fine = mq("(hover: hover) and (pointer: fine)").matches;
		} catch (e) {}

		/* ============ 1. 桌面端：把 .cur 套装铺满所有指针状态 ============ */
		/* computed cursor → 该换成哪个 .cur。文本态故意不动（系统 I 型更好用）。 */
		function skinFor(cs) {
			switch (cs) {
				case "auto":
				case "default":
				case "context-menu":
				case "alias":
				case "copy":
				case "cell":
				case "crosshair":
				case "zoom-in":
				case "zoom-out":
				case "help":
					return 'url("/cursors/arrow.cur") 2 2, auto';
				case "pointer":
					return 'url("/cursors/hand.cur") 6 1, pointer';
				case "move":
				case "all-scroll":
				case "grab":
				case "grabbing":
					return 'url("/cursors/sizeall.cur") 14 13, move';
				case "ew-resize":
				case "col-resize":
					return 'url("/cursors/sizewe.cur") 10 6, ew-resize';
				case "ns-resize":
				case "row-resize":
					return 'url("/cursors/sizens.cur") 6 10, ns-resize';
				case "nwse-resize":
					return 'url("/cursors/sizenwse.cur") 8 8, nwse-resize';
				case "nesw-resize":
					return 'url("/cursors/sizenesw.cur") 8 8, nesw-resize';
				case "progress":
				case "wait":
					return 'url("/cursors/progress.cur") 2 2, progress';
				case "not-allowed":
				case "no-drop":
					return 'url("/cursors/arrow.cur") 2 2, not-allowed';
				default:
					return null;
			}
		}

		function sweep(force) {
			var all = document.querySelectorAll("*");
			var budget = 24000;
			var changed = 0;
			for (var i = 0; i < all.length && budget-- > 0; i++) {
				var el = all[i];
				/* 扫过的盖章跳过 —— 否则每次 sweep 都要对整页几千个节点
				   重算样式，既慢又容易在预算耗尽时漏掉排在文档末尾的元素
				   （比如最后渲染的 #voice-rain-toggle）。class 变化时由
				   MutationObserver 把章清掉，让它重新走一遍。 */
				if (el.__csk && !force) continue;
				el.__csk = 1;
				var cs;
				try {
					cs = getComputedStyle(el).cursor;
				} catch (e) {
					continue;
				}
				if (!cs) continue;
				/* 已经是我们的 .cur（上面 CSS 或上一轮扫描写的）→ 不用再管 */
				if (cs.indexOf("/cursors/") >= 0) continue;
				/* 文本 / 隐藏态不动 */
				if (cs === "text" || cs === "vertical-text" || cs === "none") continue;
				var skin = skinFor(cs);
				if (!skin) continue;
				el.style.setProperty("cursor", skin, "important");
				changed++;
			}
			return changed;
		}

		var timer = 0;
		function queue() {
			if (timer) clearTimeout(timer);
			timer = setTimeout(function () {
				timer = 0;
				sweep(false);
			}, 320);
		}

		if (fine) {
			/* 先跑一轮：把 CSS 盖不住的那些补上 */
			sweep(false);
			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", function () {
					sweep(false);
				});
			}
			window.addEventListener("load", function () {
				sweep(true); /* 全量再走一遍，把懒加载出来的节点收进来 */
			});
			/* swup / Astro 切页后 DOM 是新节点，标记得重来 */
			document.addEventListener("astro:page-load", function () {
				sweep(true);
			});
			document.addEventListener("swup:contentReplaced", function () {
				sweep(true);
			});

			/* class 一变（.is-busy / 面板打开…）指针就可能该换，跟着增量补 */
			try {
				var mo = new MutationObserver(function (muts) {
					for (var i = 0; i < muts.length; i++) {
						var m = muts[i];
						/* class/style 变了 → 撤掉那一个元素的章，让 sweep 重看它 */
						if (m.type === "attributes" && m.target) m.target.__csk = 0;
					}
					queue();
				});
				var start = function () {
					if (!document.body) return;
					mo.observe(document.body, {
						childList: true,
						subtree: true,
						attributes: true,
						attributeFilter: ["class", "style", "disabled", "aria-disabled"],
					});
				};
				if (document.body) start();
				else document.addEventListener("DOMContentLoaded", start, { once: true });
			} catch (e) {}
		}

		/* ============ 2. 触摸端：Win7 触摸指针 ============ */
		// 只在触摸端（coarse pointer）启用
		var isCoarse =
			mq("(pointer: coarse)").matches ||
			(mq("(hover: none)").matches && "ontouchstart" in window);
		if (!isCoarse) return;
		if (mq("(prefers-reduced-motion: reduce)").matches) return;

		var layer = document.getElementById("touch-pointer-layer");
		if (!layer) return;

		// Win7 触摸指针：半透明圆环 + 中心实心点 + 四向短刻度
		var SVG =
			'<svg viewBox="0 0 46 46" xmlns="http://www.w3.org/2000/svg">' +
			"<g stroke=\"rgba(255,255,255,0.92)\" stroke-width=\"1.6\" stroke-linecap=\"round\">" +
			'<line x1="23" y1="5.5" x2="23" y2="11.5"/>' +
			'<line x1="23" y1="34.5" x2="23" y2="40.5"/>' +
			'<line x1="5.5" y1="23" x2="11.5" y2="23"/>' +
			'<line x1="34.5" y1="23" x2="40.5" y2="23"/>' +
			"</g>" +
			'<circle cx="23" cy="23" r="11.5" fill="rgba(20,20,26,0.28)" stroke="rgba(255,255,255,0.95)" stroke-width="1.8"/>' +
			'<circle cx="23" cy="23" r="3.2" fill="#ffffff"/>' +
			"</svg>";

		var active = Object.create(null);

		function place(el, x, y) {
			el.style.setProperty("--tp-x", x + "px");
			el.style.setProperty("--tp-y", y + "px");
		}

		function spawn(id, x, y) {
			var el = document.createElement("div");
			el.className = "tp";
			el.innerHTML = SVG;
			place(el, x, y);
			layer.appendChild(el);
			active[id] = el;
			// 下一帧进入「按下」态，触发过渡
			requestAnimationFrame(function () {
				el.classList.add("on");
			});
			return el;
		}

		function move(id, x, y) {
			var el = active[id];
			if (!el) return;
			place(el, x, y);
		}

		function release(id) {
			var el = active[id];
			if (!el) return;
			delete active[id];
			// 抬手：向外扩散一点再淡出（Windows 触摸指针的收束感）
			el.classList.remove("on");
			el.classList.add("tp-up");
			setTimeout(function () {
				if (el.parentNode) el.parentNode.removeChild(el);
			}, 340);
		}

		function onStart(e) {
			var t = e.changedTouches;
			for (var i = 0; i < t.length; i++) {
				spawn(t[i].identifier, t[i].clientX, t[i].clientY);
			}
		}

		function onMove(e) {
			var t = e.changedTouches;
			for (var i = 0; i < t.length; i++) {
				move(t[i].identifier, t[i].clientX, t[i].clientY);
			}
		}

		function onEnd(e) {
			var t = e.changedTouches;
			for (var i = 0; i < t.length; i++) {
				release(t[i].identifier);
			}
		}

		document.addEventListener("touchstart", onStart, { passive: true });
		document.addEventListener("touchmove", onMove, { passive: true });
		document.addEventListener("touchend", onEnd, { passive: true });
		document.addEventListener("touchcancel", onEnd, { passive: true });
	})();
</script>
