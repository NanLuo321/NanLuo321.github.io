---
// RainWeather — 第四个左下角独立浮窗（天气小窗）
// 接入 uapis.cn 天气 API，自动获取当前位置天气
// 条件动画：下雨→雨滴掉落 / 下雪→雪花飘落 / 晴天→右上角太阳 / 阴天→右上角云
// 所有 UI 通过 container query 随浮窗大小实时缩放
import { Icon } from "astro-icon/components";
---

<!-- 天气悬浮窗触发按钮 -->
<button
	id="weather-float-trigger"
	class="fixed bottom-5 left-[12rem] z-[9000] w-12 h-12 rounded-full flex items-center justify-center pointer-events-auto float-trigger-btn"
	aria-label="天气"
	title="天气"
>
	<Icon is:inline name="material-symbols:rainy-rounded" class="text-[1.4rem]" />
</button>

<!-- 天气悬浮窗 -->
<div id="weather-float" class="profile-float weather-float" style="display:none;">
	<div class="profile-float-header" id="weather-float-drag">
		<span class="profile-float-title">天气</span>
		<div class="profile-float-controls">
			<button class="profile-float-btn" id="weather-float-minimize" aria-label="最小化" title="最小化">
				<Icon is:inline name="material-symbols:remove-rounded" class="text-[1.1rem]" />
			</button>
			<button class="profile-float-btn" id="weather-float-fullscreen" aria-label="全屏" title="全屏">
				<Icon is:inline name="material-symbols:fullscreen-rounded" class="text-[1.1rem]" id="weather-float-fs-icon" />
			</button>
			<button class="profile-float-btn" id="weather-float-close" aria-label="关闭" title="关闭">
				<Icon is:inline name="material-symbols:close-rounded" class="text-[1.1rem]" />
			</button>
		</div>
	</div>
	<div class="profile-float-body" id="weather-float-body">
		<div class="weather-widget">
			<!-- 天气动画画布 -->
			<canvas id="weather-canvas"></canvas>

			<!-- 晴天太阳图标（右上角） -->
			<div class="weather-sun" id="weather-sun">
				<Icon is:inline name="material-symbols:sunny-rounded" />
			</div>

			<!-- 阴天云图标（右上角） -->
			<div class="weather-cloud" id="weather-cloud">
				<Icon is:inline name="material-symbols:cloud-rounded" />
			</div>

			<!-- 加载状态 -->
			<div class="weather-loading" id="weather-loading">
				<Icon is:inline name="material-symbols:progress-activity" class="weather-loading-icon" />
				<span>获取天气中...</span>
			</div>

			<!-- 天气信息覆盖层 -->
			<div class="weather-info" id="weather-info" style="display:none;">
				<!-- 位置 + 粉色定位图标 -->
				<div class="weather-location">
					<span class="weather-location-name" id="weather-city">加载中</span>
					<Icon is:inline name="material-symbols:location-on-rounded" class="weather-pin" />
				</div>

				<!-- 温度 -->
				<div class="weather-temp" id="weather-temp">--°</div>

				<!-- 天气状况 -->
				<div class="weather-condition" id="weather-condition">--</div>

				<!-- 温度/湿度/风向标签 -->
				<div class="weather-labels">
					<div class="weather-label-item">
						<span class="weather-label-title">温度</span>
						<span class="weather-label-value" id="weather-temp-value">--°</span>
					</div>
					<div class="weather-label-item">
						<span class="weather-label-title">湿度</span>
						<span class="weather-label-value" id="weather-humidity-value">--%</span>
					</div>
					<div class="weather-label-item">
						<span class="weather-label-title">风向</span>
						<span class="weather-label-value" id="weather-wind-value">--</span>
					</div>
				</div>

				<!-- 发布时间 -->
				<div class="weather-report-time" id="weather-report-time"></div>
			</div>
		</div>
	</div>
	<div class="profile-float-resize" id="weather-float-resize"></div>
</div>

<style is:global>
/* ========== 天气浮窗尺寸 ========== */
.weather-float {
	width: 300px;
	min-width: 200px;
	min-height: 280px;
}

/* ========== 天气小窗容器（container query 锚点） ========== */
.weather-widget {
	position: relative;
	width: 100%;
	height: 100%;
	min-height: 240px;
	overflow: hidden;
	border-radius: 12px;
	container-type: inline-size;
}

#weather-canvas {
	position: absolute;
	width: 100%;
	height: 100%;
	top: 0;
	left: 0;
	pointer-events: none;
}

/* ========== 晴天太阳（右上角） ========== */
.weather-sun {
	position: absolute;
	top: clamp(6px, 4cqw, 30px);
	right: clamp(8px, 5cqw, 40px);
	z-index: 2;
	color: #ffb74d;
	font-size: clamp(20px, 13cqw, 80px);
	filter: drop-shadow(0 0 12px rgba(255, 183, 77, 0.6));
	animation: weather-sun-pulse 3s ease-in-out infinite;
	pointer-events: none;
	display: none;
}
.weather-sun.is-visible {
	display: block;
}
.weather-sun svg {
	width: 1em;
	height: 1em;
}

/* ========== 阴天云图标（右上角） ========== */
.weather-cloud {
	position: absolute;
	top: clamp(6px, 4cqw, 30px);
	right: clamp(8px, 5cqw, 40px);
	z-index: 2;
	color: #b0bec5;
	font-size: clamp(20px, 13cqw, 80px);
	filter: drop-shadow(0 0 10px rgba(176, 190, 197, 0.4));
	animation: weather-cloud-float 4s ease-in-out infinite;
	pointer-events: none;
	display: none;
}
.weather-cloud.is-visible {
	display: block;
}
.weather-cloud svg {
	width: 1em;
	height: 1em;
}
@keyframes weather-sun-pulse {
	0%, 100% { transform: scale(1); opacity: 0.9; }
	50% { transform: scale(1.1); opacity: 1; }
}
@keyframes weather-cloud-float {
	0%, 100% { transform: translateX(0) scale(1); opacity: 0.7; }
	50% { transform: translateX(2px) scale(1.05); opacity: 0.9; }
}

/* ========== 加载状态 ========== */
.weather-loading {
	position: absolute;
	inset: 0;
	z-index: 4;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: clamp(4px, 2.5cqw, 16px);
	color: var(--text-primary, #fff);
	font-size: clamp(9px, 4cqw, 20px);
	opacity: 0.7;
}
.weather-loading-icon {
	font-size: clamp(16px, 9cqw, 50px);
	animation: weather-spin 1.2s linear infinite;
}
.weather-loading-icon svg {
	width: 1em;
	height: 1em;
}
@keyframes weather-spin {
	from { transform: rotate(0deg); }
	to { transform: rotate(360deg); }
}

/* ========== 天气信息覆盖层 ========== */
.weather-info {
	position: relative;
	z-index: 3;
	height: 100%;
	padding: clamp(10px, 6cqw, 50px);
	display: flex;
	flex-direction: column;
	justify-content: flex-end;
	gap: clamp(3px, 2cqw, 12px);
	color: var(--text-primary, #fff);
}

/* ========== 位置 + 粉色定位图标 ========== */
.weather-location {
	display: flex;
	align-items: center;
	gap: clamp(2px, 1cqw, 8px);
	font-size: clamp(10px, 4.5cqw, 24px);
	opacity: 0.85;
}
.weather-location-name {
	font-weight: 600;
}
.weather-pin {
	color: #ff4081 !important;
	font-size: clamp(10px, 5.5cqw, 30px);
	filter: drop-shadow(0 0 4px rgba(255, 64, 129, 0.4));
}
.weather-pin svg {
	width: 1em;
	height: 1em;
}

/* ========== 温度大字 ========== */
.weather-temp {
	font-size: clamp(28px, 18cqw, 100px);
	font-weight: 700;
	line-height: 1.1;
	letter-spacing: clamp(-6px, -1cqw, -1px);
	text-shadow: 0 2px 16px rgba(0, 0, 0, 0.25);
}

/* ========== 天气状况 ========== */
.weather-condition {
	font-size: clamp(11px, 5cqw, 26px);
	opacity: 0.7;
	font-weight: 500;
}

/* ========== 温度/湿度/风向标签 ========== */
.weather-labels {
	display: flex;
	gap: clamp(8px, 6cqw, 50px);
	margin-top: clamp(4px, 2.5cqw, 20px);
	padding-top: clamp(5px, 3cqw, 25px);
	border-top: 1px solid rgba(255, 255, 255, 0.12);
}
.weather-label-item {
	display: flex;
	flex-direction: column;
	gap: clamp(1px, 0.5cqw, 6px);
}
.weather-label-title {
	font-size: clamp(8px, 3.5cqw, 18px);
	opacity: 0.55;
	text-transform: uppercase;
	letter-spacing: 0.05em;
}
.weather-label-value {
	font-size: clamp(10px, 4.5cqw, 24px);
	font-weight: 600;
}

/* ========== 发布时间 ========== */
.weather-report-time {
	font-size: clamp(7px, 3cqw, 16px);
	opacity: 0.4;
	margin-top: clamp(2px, 1cqw, 10px);
}

/* ========== 移动端响应式 ========== */
@media (max-width: 1023px) {
	#weather-float-trigger {
		bottom: 1rem !important;
		left: calc(50% + 5.5rem) !important;
	}
}

@media (prefers-reduced-motion: reduce) {
	#weather-canvas {
		display: none;
	}
	.weather-sun,
	.weather-cloud {
		animation: none;
	}
	.weather-loading-icon {
		animation: none;
	}
}
</style>

<!-- 浮窗交互逻辑（拖拽/最小化/全屏/关闭/缩放 + API 天气获取） -->
<script is:inline>
(function () {
	if (window.__weatherFloatInit) return;
	window.__weatherFloatInit = true;
	var weatherFetched = false;

	function fetchWeatherData() {
		if (weatherFetched) return;
		weatherFetched = true;

		var loading = document.getElementById("weather-loading");
		var info = document.getElementById("weather-info");

		fetch("https://uapis.cn/api/v1/misc/weather")
			.then(function (res) { return res.json(); })
			.then(function (data) {
				if (loading) loading.style.display = "none";
				if (info) info.style.display = "flex";

				// 城市名（中文）
				var cityEl = document.getElementById("weather-city");
				if (cityEl && data.city) cityEl.textContent = data.city;

				// 温度
				var tempStr = (data.temperature !== undefined ? data.temperature : "--") + "°";
				var tempEl = document.getElementById("weather-temp");
				var tempValEl = document.getElementById("weather-temp-value");
				if (tempEl) tempEl.textContent = tempStr;
				if (tempValEl) tempValEl.textContent = tempStr;

				// 天气状况
				var condEl = document.getElementById("weather-condition");
				if (condEl && data.weather) condEl.textContent = data.weather;

				// 湿度
				var humEl = document.getElementById("weather-humidity-value");
				if (humEl && data.humidity !== undefined) humEl.textContent = data.humidity + "%";

				// 风向 + 风力
				var windEl = document.getElementById("weather-wind-value");
				if (windEl) {
					var windText = "";
					if (data.wind_direction) windText += data.wind_direction;
					if (data.wind_power) windText += " " + data.wind_power;
					if (!windText) windText = "--";
					windEl.textContent = windText;
				}

				// 发布时间
				var timeEl = document.getElementById("weather-report-time");
				if (timeEl && data.report_time) timeEl.textContent = data.report_time;

				// 根据天气文本自动设置动画
				var weatherText = data.weather || "";
				var weatherType = "none";
				if (weatherText.indexOf("晴") !== -1) {
					weatherType = "sunny";
				} else if (weatherText.indexOf("雨") !== -1) {
					weatherType = "rain";
				} else if (weatherText.indexOf("雪") !== -1) {
					weatherType = "snow";
				} else if (weatherText.indexOf("阴") !== -1 ||
				           weatherText.indexOf("云") !== -1 ||
				           weatherText.indexOf("雾") !== -1 ||
				           weatherText.indexOf("霾") !== -1) {
					weatherType = "cloudy";
				}

				window.dispatchEvent(new CustomEvent("weather-change", { detail: { weather: weatherType } }));
			})
			.catch(function (err) {
				// 请求失败时显示 fallback 数据
				if (loading) loading.style.display = "none";
				if (info) info.style.display = "flex";
				var cityEl = document.getElementById("weather-city");
				if (cityEl) cityEl.textContent = "获取失败";
				var condEl = document.getElementById("weather-condition");
				if (condEl) condEl.textContent = "请稍后重试";
				console.warn("[RainWeather] 天气 API 请求失败:", err);
			});
	}

	function initWeatherFloat() {
		var float = document.getElementById("weather-float");
		var trigger = document.getElementById("weather-float-trigger");
		var dragHandle = document.getElementById("weather-float-drag");
		var resizeHandle = document.getElementById("weather-float-resize");
		var closeBtn = document.getElementById("weather-float-close");
		var minimizeBtn = document.getElementById("weather-float-minimize");
		var fullscreenBtn = document.getElementById("weather-float-fullscreen");
		var fsIcon = document.getElementById("weather-float-fs-icon");

		if (!float || !trigger) return;
		if (float.dataset.weatherInit) return;
		float.dataset.weatherInit = "true";

		// 从 localStorage 恢复位置和大小
		var savedPos = localStorage.getItem("weather-float-pos");
		if (savedPos) {
			try {
				var pos = JSON.parse(savedPos);
				if (pos.left !== undefined) float.style.left = pos.left + "px";
				if (pos.top !== undefined) {
					float.style.top = pos.top + "px";
					float.style.bottom = "auto";
				}
				if (pos.width) float.style.width = pos.width + "px";
				if (pos.height) float.style.height = pos.height + "px";
			} catch (e) {}
		}

		function showFloat() {
			float.style.display = "flex";
			trigger.style.display = "none";
			window.dispatchEvent(new CustomEvent("weather-float-open"));
			// 打开时获取天气数据
			setTimeout(fetchWeatherData, 200);
		}
		function hideFloat() {
			float.style.display = "none";
			trigger.style.display = "flex";
			window.dispatchEvent(new CustomEvent("weather-float-close"));
		}

		trigger.onclick = function (e) {
			e.stopPropagation();
			showFloat();
		};
		if (closeBtn) {
			closeBtn.onclick = function (e) {
				e.stopPropagation();
				hideFloat();
			};
		}
		if (minimizeBtn) {
			minimizeBtn.onclick = function (e) {
				e.stopPropagation();
				hideFloat();
			};
		}

		// 全屏切换
		var isFullscreen = false;
		var prevRect = null;
		if (fullscreenBtn) {
			fullscreenBtn.onclick = function (e) {
				e.stopPropagation();
				if (!isFullscreen) {
					prevRect = {
						left: float.offsetLeft,
						top: float.offsetTop,
						width: float.offsetWidth,
						height: float.offsetHeight,
					};
					float.classList.add("profile-fullscreen");
					isFullscreen = true;
					if (fsIcon) fsIcon.setAttribute("data-icon", "material-symbols:fullscreen-exit-rounded");
				} else {
					float.classList.remove("profile-fullscreen");
					isFullscreen = false;
					if (prevRect) {
						float.style.left = prevRect.left + "px";
						float.style.top = prevRect.top + "px";
						float.style.width = prevRect.width + "px";
						float.style.height = prevRect.height + "px";
					}
					if (fsIcon) fsIcon.setAttribute("data-icon", "material-symbols:fullscreen-rounded");
				}
				window.dispatchEvent(new CustomEvent("weather-float-resize"));
			};
		}

		// 拖拽
		if (dragHandle) {
			var isDragging = false, startX = 0, startY = 0, startLeft = 0, startTop = 0;
			var onMouseDown = function (e) {
				if (isFullscreen) return;
				var target = e.target;
				if (target.closest && target.closest(".profile-float-btn")) return;
				isDragging = true;
				var point = "touches" in e ? e.touches[0] : e;
				startX = point.clientX;
				startY = point.clientY;
				startLeft = float.offsetLeft;
				startTop = float.offsetTop;
				float.style.bottom = "auto";
				dragHandle.style.cursor = "grabbing";
				e.preventDefault();
			};
			var onMouseMove = function (e) {
				if (!isDragging) return;
				var point = "touches" in e ? e.touches[0] : e;
				var newLeft = startLeft + (point.clientX - startX);
				var newTop = startTop + (point.clientY - startY);
				newLeft = Math.max(-float.offsetWidth + 60, Math.min(window.innerWidth - 60, newLeft));
				newTop = Math.max(0, Math.min(window.innerHeight - 60, newTop));
				float.style.left = newLeft + "px";
				float.style.top = newTop + "px";
				localStorage.setItem("weather-float-pos", JSON.stringify({
					left: newLeft, top: newTop,
					width: float.offsetWidth, height: float.offsetHeight,
				}));
			};
			var onMouseUp = function () {
				isDragging = false;
				dragHandle.style.cursor = "grab";
			};
			dragHandle.addEventListener("mousedown", onMouseDown);
			dragHandle.addEventListener("touchstart", onMouseDown, { passive: false });
			document.addEventListener("mousemove", onMouseMove);
			document.addEventListener("touchmove", onMouseMove, { passive: false });
			document.addEventListener("mouseup", onMouseUp);
			document.addEventListener("touchend", onMouseUp);
		}

		// 缩放
		if (resizeHandle) {
			var isResizing = false, rStartX = 0, rStartY = 0, rStartW = 0, rStartH = 0;
			var onResizeDown = function (e) {
				if (isFullscreen) return;
				e.stopPropagation();
				e.preventDefault();
				isResizing = true;
				var point = "touches" in e ? e.touches[0] : e;
				rStartX = point.clientX;
				rStartY = point.clientY;
				rStartW = float.offsetWidth;
				rStartH = float.offsetHeight;
			};
			var onResizeMove = function (e) {
				if (!isResizing) return;
				var point = "touches" in e ? e.touches[0] : e;
				var newWidth = Math.max(200, Math.min(window.innerWidth - float.offsetLeft - 10, rStartW + (point.clientX - rStartX)));
				var newHeight = Math.max(240, Math.min(window.innerHeight - float.offsetTop - 10, rStartH + (point.clientY - rStartY)));
				float.style.width = newWidth + "px";
				float.style.height = newHeight + "px";
				localStorage.setItem("weather-float-pos", JSON.stringify({
					left: float.offsetLeft, top: float.offsetTop,
					width: newWidth, height: newHeight,
				}));
				window.dispatchEvent(new CustomEvent("weather-float-resize"));
			};
			var onResizeUp = function () { isResizing = false; };
			resizeHandle.addEventListener("mousedown", onResizeDown);
			resizeHandle.addEventListener("touchstart", onResizeDown, { passive: false });
			document.addEventListener("mousemove", onResizeMove);
			document.addEventListener("touchmove", onResizeMove, { passive: false });
			document.addEventListener("mouseup", onResizeUp);
			document.addEventListener("touchend", onResizeUp);
		}

		// 液态玻璃鼠标跟随折射光
		float.addEventListener("mousemove", function (e) {
			var rect = float.getBoundingClientRect();
			float.style.setProperty("--mouse-x", e.clientX - rect.left + "px");
			float.style.setProperty("--mouse-y", e.clientY - rect.top + "px");
		});
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initWeatherFloat);
	} else {
		initWeatherFloat();
	}
	document.addEventListener("astro:page-load", initWeatherFloat);
})();
</script>

<!-- 天气动画（Canvas 2D 粒子：雨/雪） -->
<script>
let weatherCanvas: HTMLCanvasElement | null = null;
let weatherCtx: CanvasRenderingContext2D | null = null;
let weatherAnimId = 0;
let weatherAnimating = false;
let currentWeather: "rain" | "snow" | "sunny" | "cloudy" | "none" = "none";
let particles: Array<{ x: number; y: number; vx: number; vy: number; size: number; opacity: number }> = [];

function initWeatherCanvas() {
	weatherCanvas = document.getElementById("weather-canvas") as HTMLCanvasElement | null;
	if (!weatherCanvas) return;

	weatherCtx = weatherCanvas.getContext("2d");
	if (!weatherCtx) return;

	resizeWeatherCanvas();
	weatherAnimating = true;
	animateWeather();
}

function resizeWeatherCanvas() {
	if (!weatherCanvas || !weatherCtx) return;
	const w = weatherCanvas.clientWidth;
	const h = weatherCanvas.clientHeight;
	if (w === 0 || h === 0) return;
	weatherCanvas.width = w * (window.devicePixelRatio || 1);
	weatherCanvas.height = h * (window.devicePixelRatio || 1);
	weatherCtx.scale(window.devicePixelRatio || 1, window.devicePixelRatio || 1);
}

function setWeather(weather: string) {
	currentWeather = weather as "rain" | "snow" | "sunny" | "cloudy" | "none";
	const sun = document.getElementById("weather-sun");
	const cloud = document.getElementById("weather-cloud");

	// 先隐藏所有天气图标
	if (sun) sun.classList.remove("is-visible");
	if (cloud) cloud.classList.remove("is-visible");

	// 设置天气图标（不依赖 canvas，避免 canvas 未初始化时图标不显示）
	if (currentWeather === "sunny") {
		if (sun) sun.classList.add("is-visible");
	} else if (currentWeather === "cloudy") {
		if (cloud) cloud.classList.add("is-visible");
	}

	// 重新生成粒子（依赖 canvas）
	particles = [];
	if (!weatherCanvas) return;

	const w = weatherCanvas.clientWidth;
	const h = weatherCanvas.clientHeight;

	if (currentWeather === "rain") {
		const count = 80;
		for (let i = 0; i < count; i++) {
			particles.push({
				x: Math.random() * w,
				y: Math.random() * h,
				vx: -0.5,
				vy: 3 + Math.random() * 4,
				size: 1 + Math.random() * 1.5,
				opacity: 0.3 + Math.random() * 0.4,
			});
		}
	} else if (currentWeather === "snow") {
		const count = 50;
		for (let i = 0; i < count; i++) {
			particles.push({
				x: Math.random() * w,
				y: Math.random() * h,
				vx: (Math.random() - 0.5) * 1,
				vy: 0.8 + Math.random() * 1.5,
				size: 2 + Math.random() * 3,
				opacity: 0.5 + Math.random() * 0.5,
			});
		}
	}
}

function animateWeather() {
	if (!weatherCanvas || !weatherCtx || !weatherAnimating) return;
	weatherAnimId = requestAnimationFrame(animateWeather);

	const w = weatherCanvas.clientWidth;
	const h = weatherCanvas.clientHeight;

	weatherCtx.clearRect(0, 0, w, h);

	if (currentWeather === "rain") {
		weatherCtx.strokeStyle = "rgba(150, 200, 255, 0.6)";
		weatherCtx.lineWidth = 1;
		for (const p of particles) {
			weatherCtx.globalAlpha = p.opacity;
			weatherCtx.beginPath();
			weatherCtx.moveTo(p.x, p.y);
			weatherCtx.lineTo(p.x + p.vx * 2, p.y + p.vy * 2);
			weatherCtx.stroke();
			p.x += p.vx;
			p.y += p.vy;
			if (p.y > h) { p.y = -10; p.x = Math.random() * w; }
			if (p.x < 0) p.x = w;
		}
		weatherCtx.globalAlpha = 1;
	} else if (currentWeather === "snow") {
		weatherCtx.fillStyle = "rgba(255, 255, 255, 0.85)";
		for (const p of particles) {
			weatherCtx.globalAlpha = p.opacity;
			weatherCtx.beginPath();
			weatherCtx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
			weatherCtx.fill();
			p.x += p.vx + Math.sin(p.y * 0.01) * 0.3;
			p.y += p.vy;
			if (p.y > h) { p.y = -10; p.x = Math.random() * w; }
			if (p.x < 0) p.x = w;
			if (p.x > w) p.x = 0;
		}
		weatherCtx.globalAlpha = 1;
	}
}

function stopWeatherAnim() {
	weatherAnimating = false;
	if (weatherAnimId) {
		cancelAnimationFrame(weatherAnimId);
		weatherAnimId = 0;
	}
}

function destroyWeatherCanvas() {
	stopWeatherAnim();
	weatherCanvas = null;
	weatherCtx = null;
	particles = [];
}

// 监听浮窗事件
window.addEventListener("weather-float-open", () => {
	setTimeout(initWeatherCanvas, 100);
});

window.addEventListener("weather-float-close", () => {
	stopWeatherAnim();
});

window.addEventListener("weather-float-resize", () => {
	if (weatherCanvas) {
		resizeWeatherCanvas();
	}
});

window.addEventListener("weather-change", ((e: CustomEvent) => {
	setWeather(e.detail.weather);
}) as EventListener);

// Swup 页面切换时清理
window.addEventListener("astro:before-swap", () => {
	destroyWeatherCanvas();
});
</script>
