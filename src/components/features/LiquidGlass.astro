---
// Liquid Glass —— 真实折射玻璃引擎
//
// 思路来自 shuding/liquid-glass 那套 SVG feDisplacementMap 折射，做了工程化改造：
//
//   · 位移贴图现场算：沿元素边缘取一条 band 宽的折射带，贴图 R/G 通道编码
//     「向内采样多少像素」。元素多大、圆角多少，贴图就多大多圆。
//   · 每个元素一张 <filter>，直接挂到 backdrop-filter: url(#id) 上，
//     背景是真被掰弯的（实测 Chromium 支持 url() 形式的 backdrop-filter）。
//   · 门槛（不满足就一行都不跑，站点原有毛玻璃照旧，绝不会「变透明」）：
//       不支持 url() 滤镜 / prefers-reduced-motion / 触屏 / 低核机器 / 精简版
//   · 成本控制：贴图按「尺寸+圆角」缓存复用；进视口才生成；同屏上限；
//     元素尺寸变了用 ResizeObserver 防抖重建。
//   · 视差叠玻璃会互相打架，所以祖先已经是玻璃的后代直接跳过。
---

<!-- 所有折射滤镜都挂在这个隐藏 svg 里 -->
<svg
	id="lg-defs"
	aria-hidden="true"
	width="0"
	height="0"
	style="position:fixed;top:0;left:0;pointer-events:none;"
></svg>

<style is:global>
	/* 引擎给元素打的标记。真正的 backdrop-filter 由脚本写成**内联 !important**
	   （见 applyGlass）。

	   为什么必须内联 !important：
	   站点里大量毛玻璃是这么写的 ——
	     body.wallpaper-transparent #navbar[data-transparent-mode] > div { backdrop-filter: … !important }
	     body:has(#wallpaper-wrapper) #navbar[data-transparent-mode="semi"][data-is-home="true"] > div { … !important }
	   这些规则带 1~2 个 id、还带 !important，靠属性选择器无论堆多少层都压不过。
	   作者级里唯一能稳压它们的就是内联 !important。

	   另：不走「内联 --lg-bd + CSS var()」那条路，是因为 var() 解析失败时会
	   让整条声明在计算值阶段变成 none，反而不如直接写值稳。 */
	[data-lg-on] {
		/* 只做标记用，不参与样式 */
		--lg-mark: 1;
	}
</style>

<script is:inline>
	(function () {
		"use strict";
		if (window.__liquidGlass) return;

		var NS = "http://www.w3.org/2000/svg";
		var d = document;

		/* ================= 门槛：不满足就整体不启用 ================= */
		var mq = window.matchMedia;
		var reducedMotion = false;
		try {
			reducedMotion = mq("(prefers-reduced-motion: reduce)").matches;
		} catch (e) {}
		/* 注意：**不因为 prefers-reduced-motion 就关掉玻璃**。
		   折射是静态视觉效果，本身不产生任何动画，关掉只会让开了「减少动态效果」
		   的用户（Windows 上很常见）整站看到一片素面朝天。
		   真正会动的部分（拖拽惯性、触摸指针淡出）各自单独判 reducedMotion。 */

		/* 折射贴图是在主线程上算的，触屏设备（多半是手机）不值得 */
		if (!mq("(hover: hover) and (pointer: fine)").matches) return;
		var lowCores = (navigator.hardwareConcurrency || 4) <= 2;
		if ((navigator.hardwareConcurrency || 4) < 2) return;

		var supportsUrl = false;
		try {
			supportsUrl =
				!!(window.CSS && CSS.supports && CSS.supports("backdrop-filter", "url(#lg-probe)")) ||
				!!(
					window.CSS &&
					CSS.supports &&
					CSS.supports("-webkit-backdrop-filter", "url(#lg-probe)")
				);
		} catch (e) {}
		if (!supportsUrl) return;

		var defs = d.getElementById("lg-defs");
		if (!defs) return;

		/* ================= 参数 ================= */
		var MAX_MAP_PX = 62000; /* 单张贴图像素上限（越小越省，越大越顺滑） */
		/* 同屏最多几块玻璃。ProMax 要把内容区的文章卡片 + 侧栏卡片整片铺成玻璃
		   （首页 19~21 块是常态），所以上限抬到 40；低核机器仍是 10，别硬撑。 */
		var MAX_GLASS = lowCores ? 10 : 40;
		var MIN_AREA = 2600; /* 小于这个面积不折腾（点名目标用 force 绕过） */
		var REBUILD_DELAY = 300; /* 尺寸变化后多久重建 */
		var SIZE_EPS = 6; /* 尺寸差多少才算变了 */

		/* 精修目标：站点里「本来就该是玻璃」的那几块。
		   band     折射带宽度（px）—— 玻璃「肉边」的厚度
		   strength 边缘向内掰的力度（1 ≈ 掰进 band*0.5 px）
		   blur     SVG 里的高斯模糊 stdDeviation —— 也就是磨砂程度，
		            放在位移**之前**，边缘的折射才不会被糊平。
		   sat      饱和度
		   tint     透底系数：把元素自己的半透明底色的 alpha 再乘这个数。
		            关键 —— backdrop-filter 画在元素背景**之下**，底色越实，
		            折射越被盖住。岛原来的底是 55% 白，折射基本看不见；
		            乘 0.5 之后就透出来了（这是「液态玻璃像失效」的真正原因）。

		   数值口径（整体刻意偏「清」，宁可少磨砂也不要糊）：
		     blur   1.2~2.6px —— 只去掉背景的锐利，不是把背景抹平
		     bend   顶到 band*0.5*strength，导航岛 ≈ 11px，一眼能看出边缘发「肉」
		   早期版本给到 blur 13 / strength 2.6，结果整块岛像蒙了一层白纱，
		   折射全被糊掉、底色又厚，看着就是「失效」。 */
		var PRESETS = [
			{
				sel: "#navbar > div",
				band: 20,
				strength: 1.15,
				blur: 1.6,
				sat: 1.18,
				tint: 0.5,
				force: true,
			},
			{
				sel: ".navbar-actions-inner",
				band: 20,
				strength: 1.15,
				blur: 1.6,
				sat: 1.18,
				tint: 0.5,
				force: true,
			},
		/* 导航岛上那枚滑动高亮（#navbar-pill）：它才是「可拖拽的液态玻璃」本体。
		   它住在已经上玻璃的导航岛内部，所以必须开 nest（见 applyGlass）。
		   参数跟 Navbar.astro 里的 PILL_GLASS 保持一致 —— 预设先扫到就按这套来，
		   脚本后来 register 也拿到同一套，谁先谁后结果都一样。
		   比导航岛猛得多（岛是 band20/strength1.15）：小透镜周长/面积比大，
		   边缘得掰得更狠才看得出形变；rim 0.5 把高光棱压掉一半，去掉那圈白雾。 */
		{
			sel: "#navbar-pill",
			band: 15,
			strength: 1.4,
			blur: 1.2,
			sat: 1.28,
			rim: 0.5,
			/* ⚠ tint 必须给：高亮带自己的青色底画在折射**之上**，
			   不压淡的话它就是一颗实心青胶囊（用户：「切换一个链接仍然变白」）。
			   0.5 → promax 里再 ×0.72 = 0.36，0.5 的底色落到 ~0.18，
           和导航岛 (0.55→0.198) 一个透法。 */
			tint: 0.5,
			nest: true,
			force: true,
		},
			{
				/* ⚠ 必须 nest：面板住在**已经上了玻璃的导航岛内部**
				   （.ai-float-island 是 #navbar > div 的后代）。不加 nest 的话
				   applyGlass 的「玻璃上不再叠玻璃」规则会直接拒了它 ——
				   面板于是永远只剩 CSS 那层 55% 白底 + blur(5px)，
				   展开就是一大块发白的实心板（用户原话：
				   「你自己看看展开是什么什么东西」）。 */
				sel: ".ai-float-island",
				band: 24,
				strength: 1.2,
				blur: 2.2,
				sat: 1.2,
				tint: 0.62,
				nest: true,
				force: true,
			},
		{
			/* 屏幕上方那枚搜索胶囊（TopSearch.svelte，ProMax 桌面端）：
			   它不在任何玻璃元素内部 —— 它就是那块玻璃本身，不用 nest。
			   悬停 / 打开时这层会被 TopSearch 摘掉（引擎的 SDF 玻璃接管，
			   同口径参数写在 TopSearch 的 CAP_LG_CFG，两边改要一起改）；
			   blur/tint 抬了一档 —— 胶囊要的是参考实现那种烟灰感，
			   不是岛面的通透。 */
			sel: ".ts-capsule",
			band: 20,
			strength: 1.15,
			blur: 10,
			sat: 1.1,
			tint: 0.62,
			force: true,
		},
		{
			/* 顶部搜索的结果面板：它是胶囊的**兄弟**（不是子节点），
			   所以也不在玻璃里、不占 nest 名额 */
			sel: ".ts-results-panel",
			band: 24,
			strength: 1.2,
			blur: 2.2,
			sat: 1.2,
			tint: 0.62,
			force: true,
		},
		{
			/* 顶部那条「往下拖唤出搜索」的提示：小小一枚，跟着上玻璃。
			   ⚠ tint 给满 1：提示是**深底白字**，被透底一压就成半透灰纱，
			   字读不出来了。这里只要折射和棱线，底色保持它自己的。 */
			sel: ".ts-hint",
			band: 14,
			strength: 0.9,
			blur: 2.2,
			sat: 1.18,
			tint: 1,
			force: true,
		},
		{
			/* 同理：搜索结果面板在 #navbar-actions 的玻璃壳内部 */
			sel: ".dis-results-panel",
				band: 24,
				strength: 1.2,
				blur: 2.2,
				sat: 1.2,
				tint: 0.62,
				nest: true,
				force: true,
			},
			{
				sel: "#media-island .mi-detail",
				band: 18,
				strength: 1.0,
				blur: 2.2,
				sat: 1.2,
				tint: 0.62,
				nest: true,
				force: true,
			},
			{
				sel: "#mobile-nav-island .mobile-nav-island-inner",
				band: 18,
				strength: 1.0,
				blur: 2.4,
				sat: 1.2,
				tint: 0.6,
				force: true,
			},
			{
				sel: "#voice-rain-toggle",
				band: 14,
				strength: 0.9,
				blur: 2.2,
				sat: 1.2,
				tint: 0.7,
				force: true,
			},
			{
				sel: ".profile-float",
				band: 24,
				strength: 1.2,
				blur: 2.6,
				sat: 1.2,
				tint: 0.62,
				force: true,
			},
			{ sel: "#kbd-hint", band: 14, strength: 0.9, blur: 2.2, sat: 1.18, force: true },
			/* 内容区卡片（**仅 ProMax 生效**，引擎整体被版本门挡在 promax 里）。
			   文章卡片 / 侧栏卡片跟导航岛用同一套「液态玻璃」口径：
			   卡片面积大、底色本来就厚（0.4~0.55），所以 tint 只压到 0.62~0.68 ——
			   再透正文就压不住壁纸了；但比自动升级那档（0.82）淡得多，
			   折射和边缘高光棱才透得出来，一眼能从「磨砂白卡」变成「玻璃卡」。
			   band 给到 22：卡片体量大，边缘那圈「肉」得够厚才看得见。 */
			{
				sel: ".glass-float-card",
				band: 22,
				strength: 1.05,
				blur: 1.8,
				sat: 1.16,
				tint: 0.62,
				force: true,
			},
			{
				/* 排除浮动小圆钮（#back-to-top 那几颗也是 card-base）——
				   44×44 的圆钮整颗都是「边缘」，套卡片的 band/strength 会糊成一团白 */
				sel: ".card-base:not(.floating-btn)",
				band: 20,
				strength: 1.0,
				blur: 1.8,
				sat: 1.16,
				tint: 0.68,
				force: true,
			},
			/* 展开后的搜索输入框：它在导航岛（已上玻璃）内部，必须 nest。
			   原来那层 rgba(0,0,0,0.04) 底 + 岛内的玻璃，读出来是一块「发白的
			   实心药丸」——用户原话「点一下搜索也变白」。上了玻璃之后它才是
			   岛面上开的一扇小玻璃窗。 */
			{
				sel: ".dis-input-container",
				band: 14,
				strength: 1.0,
				blur: 1.6,
				sat: 1.2,
				tint: 0.5,
				rim: 0.7,
				nest: true,
				force: true,
			},
		];

		/* 「全站所有表面」：内容区里**已经在用 backdrop-filter** 的表面
		   自动跟着升级 —— 不用逐个去猜卡片的类名。
		   同一套「清」的口径：卡片底色本来就淡（0.4~0.5），
		   所以只轻微透底，别把卡片读成透明。 */
		var AUTO_CFG = { band: 20, strength: 1.0, blur: 2, sat: 1.12, tint: 0.76 };
		var AUTO_ROOTS = ["#main-grid", ".footer", "#category-bar-wrapper"];

		/* ================= 几何 ================= */
		function clamp01(v) {
			return v < 0 ? 0 : v > 1 ? 1 : v;
		}

		/* 圆角矩形有符号距离场：内部为负，边界为 0 */
		function sdRoundRect(px, py, hw, hh, r) {
			var qx = Math.abs(px) - (hw - r);
			var qy = Math.abs(py) - (hh - r);
			var inner = qx > qy ? qx : qy;
			if (inner > 0) inner = 0;
			var ax = qx > 0 ? qx : 0;
			var ay = qy > 0 ? qy : 0;
			return inner + Math.sqrt(ax * ax + ay * ay) - r;
		}

		/**
		 * 生成两张贴图（同一尺寸，一起缓存）：
		 *   map  位移贴图 —— R = 横向位移、G = 纵向位移（0.5 为中点），给 feDisplacementMap
		 *   spec 高光贴图 —— 沿内边缘一圈的白色高光（上亮下暗），叠在最后当「玻璃的棱」
		 *
		 * 为什么要 spec：折射只在背景有结构的地方才看得出来。沉底导航岛身后
		 * 往往是一片平滑渐变，光靠位移根本看不出玻璃 —— 加上这圈高光，
		 * 无论背景多素，一眼就是块玻璃。
		 *
		 * rimScale 是高光总强度的倍率（默认 1）：
		 *   大块玻璃（导航岛）用 1 —— 需要那圈棱线把轮廓定出来；
		 *   小透镜（可拖拽高亮）用 0.5 —— 它周长/面积比大得多，同样强度会糊成
		 *   一团白雾，读起来是磨砂不是玻璃。
		 */
		function buildMap(W, H, radius, band, strength, rimScale) {
			var dpi = Math.min(1, Math.sqrt(MAX_MAP_PX / Math.max(1, W * H)));
			if (dpi < 0.34) dpi = 0.34;
			var w = Math.max(3, Math.round(W * dpi));
			var h = Math.max(3, Math.round(H * dpi));

			var cv = d.createElement("canvas");
			cv.width = w;
			cv.height = h;
			var ctx = cv.getContext("2d");
			if (!ctx) return null;
			var img = ctx.createImageData(w, h);
			var data = img.data;

			var hw = W / 2;
			var hh = H / 2;
			var rr = Math.max(0, Math.min(radius, Math.min(hw, hh)));
			var sx = W / w;
			var sy = H / h;
			var offs = new Float32Array(w * h * 2);
			var spec = new Uint8ClampedArray(w * h * 4);
			var maxOff = 0;
			var idx = 0;
			var sidx = 0;
			/* 高光带的宽度：跟着磨砂带一起走，但收窄一点，免得糊成一片白。
			   收窄还有一层意义 —— 高光越宽越像「蒙了层纱」，
			   和「降低模糊」的诉求正好相反。 */
			var rimBand = Math.max(2, band * 0.34);
			var rimK = rimScale === undefined || rimScale === null ? 1 : rimScale;

			for (var y = 0; y < h; y++) {
				var cy = (y + 0.5) * sy - hh;
				for (var x = 0; x < w; x++) {
					var cx = (x + 0.5) * sx - hw;
					var sd = sdRoundRect(cx, cy, hw, hh, rr);
					var depth = -sd; /* >0 表示在形状内部 */
					var t = 1 - clamp01(depth / band); /* 边界 1 → 带内递减到 0 */
					var ox = 0;
					var oy = 0;
					var alpha = 0;

					if (depth > 0) {
						/* --- 高光：最外那道棱线 + 往内衰减的一圈光晕 --- */
						var edgeLine = 1 - clamp01(depth / 1.6);
						var rim = Math.pow(1 - clamp01(depth / rimBand), 1.7);
						var up = 0.5; /* 上边缘 1、下边缘 0（光从上面来） */
						if (t > 0.001) {
							var bend = strength * band * 0.5 * Math.pow(t, 1.7);
							/* 外法线用数值梯度求，指向形状外侧 */
							var e = 1;
							var gx =
								sdRoundRect(cx + e, cy, hw, hh, rr) - sdRoundRect(cx - e, cy, hw, hh, rr);
							var gy =
								sdRoundRect(cx, cy + e, hw, hh, rr) - sdRoundRect(cx, cy - e, hw, hh, rr);
							var gl = Math.sqrt(gx * gx + gy * gy) || 1;
							/* 向内采样：背景在边缘被「吸」进去，读起来就是一块玻璃 */
							ox = -(gx / gl) * bend;
							oy = -(gy / gl) * bend;
							var mAbs = Math.abs(ox) > Math.abs(oy) ? Math.abs(ox) : Math.abs(oy);
							if (mAbs > maxOff) maxOff = mAbs;
							up = clamp01(0.5 - (gy / gl) * 0.5);
						}
						alpha =
							(0.16 * rim * (0.3 + 0.7 * up) + 0.32 * edgeLine * (0.45 + 0.55 * up)) *
							rimK;
						if (alpha > 1) alpha = 1;
					}

					offs[idx++] = ox;
					offs[idx++] = oy;
					spec[sidx++] = 255;
					spec[sidx++] = 255;
					spec[sidx++] = 255;
					spec[sidx++] = (alpha * 255) | 0;
				}
			}

			if (maxOff < 0.05) return null; /* 一点位移都没有 → 不值得挂滤镜 */

			var j = 0;
			for (var k = 0; k < data.length; k += 4) {
				data[k] = ((offs[j++] / maxOff) * 127.5 + 127.5) | 0;
				data[k + 1] = ((offs[j++] / maxOff) * 127.5 + 127.5) | 0;
				data[k + 2] = 128;
				data[k + 3] = 255;
			}
			ctx.putImageData(img, 0, 0);
			var mapUrl = cv.toDataURL();

			/* 同一块 canvas 复用一次，再把高光图导出来 */
			var specImg = ctx.createImageData(w, h);
			specImg.data.set(spec);
			ctx.putImageData(specImg, 0, 0);
			var specUrl = cv.toDataURL();

			return { url: mapUrl, scale: maxOff * 2, spec: specUrl };
		}

		/* ================= 滤镜 =================
		   链序刻意是「先磨砂、后掰弯、最后压高光」：
		     feImage(map) → feGaussianBlur(SourceGraphic) → feDisplacementMap
		                  → saturate → feComposite(spec, over)
		   如果先掰弯再磨砂，边缘那圈折射会被高斯糊平，
		   看起来就只是一块普通的毛玻璃 —— 这正是「看不出液态玻璃」的原因。 */
		function makeFilter(id, map, frostPx, sat) {
			var f = d.createElementNS(NS, "filter");
			f.setAttribute("id", id);
			/* 区域刻意用 objectBoundingBox(0,0,1,1) —— 就是「元素的边框盒本身」。
			   别写死成 userSpaceOnUse + W/H：元素的尺寸一变（展开搜索、面板开合、
