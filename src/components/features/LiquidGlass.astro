					   用户感觉的「卡一下」。这里等到动画真的结束再一把重建，
					   动画期间沿用旧滤镜。 */
					var anims = null;
					if (el.getAnimations) {
						try {
							anims = el.getAnimations({ subtree: true });
						} catch (e) {
							anims = el.getAnimations();
						}
					}
					if (anims && anims.length) {
						var finite = [];
						for (var i = 0; i < anims.length; i++) {
							var t = null;
							try {
								t = anims[i].effect && anims[i].effect.getComputedTiming();
							} catch (e) {}
							/* 无限循环的动画永远不会 finished，别等它 */
							if (!t || t.iterations === Infinity || t.endTime === Infinity) continue;
							finite.push(anims[i].finished);
						}
						if (finite.length) {
							entry.busy = true;
							Promise.allSettled(finite).then(function () {
								entry.busy = false;
								rebuildNow();
							});
							return;
						}
					}
					rebuildNow();
				}, REBUILD_DELAY);
			});
			entry.ro.observe(el);
			watchers.set(el, entry);
		}

		function inView(el, pad) {
			var r = el.getBoundingClientRect();
			var vh = window.innerHeight || 800;
			return r.bottom > -(pad || 240) && r.top < vh + (pad || 240);
		}

		function ensureIO() {
			if (io || !window.IntersectionObserver) return;
			io = new IntersectionObserver(
				function (entries) {
					entries.forEach(function (en) {
						if (!en.isIntersecting) return;
						var el = en.target;
						var rec = watchers.get(el);
						io.unobserve(el);
						if (rec && !el.__lgOn) applyGlass(el, rec.cfg);
					});
				},
				{ rootMargin: "260px 0px" },
			);
		}

		function collect() {
			var items = [];
			PRESETS.forEach(function (p) {
				var list;
				try {
					list = d.querySelectorAll(p.sel);
				} catch (e) {
					return;
				}
				for (var i = 0; i < list.length; i++) items.push({ el: list[i], cfg: p, prio: 0 });
			});
			AUTO_ROOTS.forEach(function (rootSel) {
				var root = d.querySelector(rootSel);
				if (!root) return;
				var all = root.querySelectorAll("*");
				var budget = 1600; /* 单次扫描上限，避免超大页面卡一下 */
				for (var i = 0; i < all.length && budget-- > 0; i++) {
					var el = all[i];
					if (el.__lgOn || el.__lgScanned) continue;
					if (el.getAttribute("data-lg-skip") !== null) continue;
					if (el.closest("[data-lg-on]")) continue;
					var r = el.getBoundingClientRect();
					/* 布局还没就绪（尺寸为 0）时**不要盖章** —— 否则这一轮
					   「没量出来」会被记成「这元素不需要玻璃」，之后就再也不会
					   重扫了。首页卡片偶发不上玻璃就是这个竞态。 */
					if (r.width < 2 || r.height < 2) continue;
					/* 量到了、且明确不达标 → 盖章，避免每次 run 都全量算样式 */
					el.__lgScanned = 1;
					if (r.width * r.height < 12000) continue;
					var bd = "";
					try {
						bd = getComputedStyle(el).backdropFilter || "";
					} catch (e2) {}
					if (!bd || bd === "none" || bd.indexOf("url(") >= 0) continue;
					items.push({ el: el, cfg: AUTO_CFG, prio: 1 });
				}
			});
			return items;
		}

		/* 首屏布局是「渐次落定」的：字体加载、壁纸初始化、侧栏折叠、
		   卡片进场动画……引擎第一次跑的时候，有些卡片还是 0×0 或者还没
		   拿到背景色，会被当成「不达标」直接跳过 —— 它们不是不需要玻璃，
		   只是还没准备好。于是「点名的目标」里若还剩「看得见、尺寸够、
		   却没能上玻璃」的，就有界地再跑几轮（约 2s 内收敛）。 */
		var runRetry = 0;
		function settleRun() {
			if (runRetry >= 8) return;
			runRetry++;
			setTimeout(function () {
				schedule(20);
			}, 260);
		}

		/* 值得重跑的点名目标：可见、有尺寸、不在别的玻璃里、也没被显式跳过
		 *
		 * ⚠ cfg 必须传进来：「住在别的玻璃里」这条判据对 nest 目标是不成立的 ——
		 *   文章面板 .ai-float-island 整个就长在导航岛（已上玻璃）内部，
		 *   它要的正是「在岛的玻璃上再叠一块自己的玻璃」。
		 *   早先这里无脑 `el.closest("[data-lg-on]")`，于是面板被自己的祖先判出局：
		 *   首屏它 visibility:hidden 上不了玻璃 → run() 给它挂了显隐观察者 →
		 *   用户点「文章」、面板露头、观察者醒来 → 又在这里被判 false →
		 *   观察者既不上玻璃也不自摘，面板从此永远停在 CSS 那层白底上
		 *   （用户原话：「做成液态玻璃」「你看图片这是什么」——就是那块白板）。 */
		function isReadyTarget(el, cfg) {
			if (el.getAttribute("data-lg-skip") !== null) return false;
			if (!(cfg && cfg.nest) && el.closest("[data-lg-on]")) return false;
			var cs = getComputedStyle(el);
			if (cs.display === "none" || cs.visibility === "hidden") return false;
			var r = el.getBoundingClientRect();
			return r.width >= 8 && r.height >= 8;
		}

		/* ================= 透底基准的补算 =================
		   上玻璃那一刻读不到底色（读到 transparent）的元素会留一枚
		   __lgNeedTint 标记，这里按 220ms 的节奏有界补算，直到读到真底色。
		   为什么不在 applyGlass 里直接 setTimeout 重试：同一轮里可能有
		   好几块玻璃（导航岛 + 高亮 + 搜索面板 + 文章面板）都缺基准，
		   打成一个 sweep 只跑一遍遍历，省得每块各起一个定时器。 */
		var tintPump = 0;
		var TINT_RECHECK = 3; /* 基准要复读几次才算「落定」 */
		function tintSweep() {
			if (tintPump >= 10) return;
			tintPump++;
			setTimeout(function () {
				var again = false;
				applied.slice().forEach(function (el) {
					if (!el.__lgOn) return;
					var cfg = el.__lgOn.cfg;
					var tint = cfg.tint;
					if (!tint || tint >= 1) {
						el.__lgNeedTint = 0;
						el.__lgRecheck = 0;
						return;
					}
					if (d.body && d.body.classList.contains("site-promax")) tint *= 0.72;
					/* 两种待办：① 压根还没拿到基准 ② 拿到了，但要复读确认没读错 */
					var missing = !el.__lgTinted || el.__lgNeedTint;
					var recheck = !missing && el.__lgRecheck > 0;
					if (!missing && !recheck) return;
					var cs = getComputedStyle(el);
					var raw =
						alphaOf(cs.backgroundColor) > 0.02 ? baseBgOf(el) : cs.backgroundColor;
					if (!raw || raw === "transparent" || alphaOf(raw) <= 0.02) {
						if (missing) again = true;
						else el.__lgRecheck = 0;
						return;
					}
					if (recheck) {
						/* 基准是「页面初始化过程中的中间态」时（比如岛还没进
						   wallpaper 透明模式，量到的是 0.88 那种实底），
						   透底结果会停在偏实的 0.32 而不是 0.198。
						   复读几次，一变就按新基准重算。 */
						el.__lgRecheck--;
						if (Math.abs(alphaOf(raw) - alphaOf(el.__lgBaseBg)) <= 0.04) {
							if (el.__lgRecheck > 0) again = true;
							return;
						}
					}
					el.__lgBaseBg = raw;
					var tintedLate =
						"color-mix(in oklch, " + raw + " " + Math.round(tint * 100) + "%, transparent)";
					el.style.setProperty("background-color", tintedLate, "important");
					el.style.setProperty("--lg-tint-bg", tintedLate);
					el.__lgTinted = true;
					el.__lgNeedTint = 0;
					el.__lgRecheck = 0;
				});
				if (again) tintSweep();
				else tintPump = 0;
			}, 220);
		}

		/* ================= 还没显形的点名目标：一露头就补玻璃 =================
		   典型是文章面板（.ai-float-island）：它在 SSR 里就是
		   visibility:hidden，引擎首屏扫到它时只能跳过；而它只会在用户
		   点「文章」时才显形 —— 没有人会在这时候再喊一次引擎，所以
		   面板一直是纯 CSS 的那层白底（用户原话：「你自己看看展开是什么
		   什么东西」）。
		   这里给这类目标挂一个只盯显隐的 MutationObserver，一显形立刻
		   补上玻璃并自摘观察者；找不到就保留到页面卸载（最多几十个节点）。 */
		var revealWatch = new Map();
		function watchReveal(el, cfg) {
			if (revealWatch.has(el) || !window.MutationObserver || !el.isConnected) return;
			var mo = new MutationObserver(function () {
				if (!isReadyTarget(el, cfg)) return;
				mo.disconnect();
				revealWatch.delete(el);
				applyGlass(el, cfg);
			});
			mo.observe(el, { attributes: true, attributeFilter: ["class", "style"] });
			revealWatch.set(el, mo);
		}

		function run() {
			scheduled = false;
			if (!d.body) return;
			/* 液态玻璃是 **ProMax 独占**：
			   · 精简版本来就没什么动效，不该有折射；
			   · 正常版是「图形原样」档，导航岛只需要那枚 CSS 高亮带，
			     不需要引擎接管 backdrop-filter（用户明确要求：
			     「正常版的岛不需要液态玻璃，只有 promax 的才有」）。
			   不在 promax 时就保持「引擎没来过」的状态。 */
			if (!d.body.classList.contains("site-promax")) {
				revertAll();
				/* 版本门里的类可能比本脚本晚一丁点挂上（首屏竞态），
				   有界重试几次；之后靠 siteversionchange 事件唤醒。 */
				if (bootRetry < 4) {
					bootRetry++;
					setTimeout(function () {
						schedule(20);
					}, 300);
				}
				return;
			}
			bootRetry = 0;
			var items = collect();
			var near = [];
			var far = [];
			items.forEach(function (it) {
				(inView(it.el) ? near : far).push(it);
			});
			var pending = 0;
			near.forEach(function (it) {
				var ok = applyGlass(it.el, it.cfg);
				if (it.prio !== 0) return;
				if (ok) return;
				/* 点名目标这一轮没上成，分两种：
				   · 已经可见、只是还没长开 → 交给 settleRun 有界重跑
				   · 还没显形（display:none / visibility:hidden / opacity:0）→
				     挂一个显隐观察者，它露头的那一刻直接补上（文章面板就是这种） */
				if (isReadyTarget(it.el, it.cfg)) pending++;
				else watchReveal(it.el, it.cfg);
			});
			watchNavbar();
			if (window.IntersectionObserver && far.length) {
				ensureIO();
				far.forEach(function (it) {
					/* 只为「还没上玻璃」的元素注册监听 */
					if (!it.el.__lgOn && !watchers.has(it.el)) {
						watchers.set(it.el, { cfg: it.cfg, ro: null, timer: 0 });
						io.observe(it.el);
					}
				});
			}
			if (pending > 0) settleRun();
			else runRetry = 0;
		}

		function schedule(delay) {
			if (scheduled) return;
			scheduled = true;
			/* 早先用的是 requestIdleCallback（超时 900ms）—— 首屏一堆远程壁纸
			   在加载时它可能被推迟得很久，表现就是「进友链 / 关于我，导航岛
			   还是一块白底、高亮也没就位」。改成固定 60ms 的定时器：
			   代价是可能落在一次布局中途，但那时不达标的元素会被
			   settleRun / watchReveal / tintSweep 补上，正确性不再依赖时机。 */
			setTimeout(function () {
				run();
			}, delay || 60);
		}

		/* ================= 文章岛分裂态特例 =================
		   点「文章」时站点会把导航岛的玻璃整块摘掉（改由左右两枚胶囊接管），
		   用的是 backdrop-filter: none !important。我们的内联 !important 权重更高，
		   不特殊处理的话岛中间会残留一条折射带。所以分裂期间主动撤掉、收回来再补上。 */
		var FRAME_CFG = PRESETS[0];
		var frameCfgBackup = null;
		var navMO = null;

		function guardNavbarSplit() {
			var nav = d.getElementById("navbar");
			if (!nav) return;
			var frame = nav.querySelector(":scope > div");
			if (!frame) return;
			if (nav.classList.contains("ai-island-split")) {
				if (frame.__lgOn) frameCfgBackup = frame.__lgOn.cfg;
				frame.setAttribute("data-lg-skip", "");
				if (frame.__lgOn) revertGlass(frame);
			} else if (frame.getAttribute("data-lg-skip") !== null) {
				frame.removeAttribute("data-lg-skip");
				var cfg = frameCfgBackup || FRAME_CFG;
				frameCfgBackup = null;
				applyGlass(frame, cfg);
			}
		}

		function watchNavbar() {
			if (navMO) return;
			var nav = d.getElementById("navbar");
			if (!nav || !window.MutationObserver) return;
			navMO = new MutationObserver(guardNavbarSplit);
			navMO.observe(nav, { attributes: true, attributeFilter: ["class"] });
		}

		/* ================= 生命周期 ================= */
		/* 亮/暗主题切换必须整块重来：
		   tint 读的是「当下算出来的底色」，还会内联写死。主题一换，
		   亮色那层白纱就被锁在暗色主题里了（导航岛会白得离谱）。
		   只盯 <html> 的 class / data-theme，并且只在**真的换主题**时重建，
		   免得被 is-page-transitioning 之类的无关 class 变化带得频繁重算。 */
		function isDarkNow() {
			var html = d.documentElement;
			return html.classList.contains("dark") || html.getAttribute("data-theme") === "dark"
				? 1
				: 0;
		}
		var lastDark = isDarkNow();
		if (window.MutationObserver) {
			new MutationObserver(function () {
				var now = isDarkNow();
				if (now === lastDark) return;
				lastDark = now;
				revertAll();
				schedule(40);
			}).observe(d.documentElement, {
				attributes: true,
				attributeFilter: ["class", "data-theme", "style"],
			});
		}
		try {
			var colorMQ = window.matchMedia("(prefers-color-scheme: dark)");
			var onScheme = function () {
				revertAll();
				schedule(40);
			};
			if (colorMQ.addEventListener) colorMQ.addEventListener("change", onScheme);
			else if (colorMQ.addListener) colorMQ.addListener(onScheme);
		} catch (e) {}

		var lastW = window.innerWidth;
		var rtimer = 0;
		window.addEventListener(
			"resize",
			function () {
				/* 只有宽度变化才需要重建（高度变化一般是地址栏收放） */
				if (Math.abs(window.innerWidth - lastW) < 12) return;
				lastW = window.innerWidth;
				if (rtimer) clearTimeout(rtimer);
				rtimer = setTimeout(function () {
					revertAll();
					schedule();
				}, 320);
			},
			{ passive: true },
		);

		/* swup / astro 切页：新节点要补上 */
		["swup:contentReplaced", "astro:page-load", "swup:pageView"].forEach(function (ev) {
			d.addEventListener(ev, function () {
				schedule(200);
			});
		});
		d.addEventListener("siteversionchange", function () {
			revertAll();
			schedule(60);
		});
		window.addEventListener("load", function () {
			schedule(300);
		});

		window.__liquidGlass = {
			run: run,
			reset: function () {
				revertAll();
				schedule(30);
			},
			stats: function () {
				return {
					applied: applied.length,
					maps: Object.keys(cache).length,
					el: applied.slice(),
				};
			},
			/* 外部组件手动注册一块玻璃 —— 手动指定的一律开 force。
			   同样受版本门限制：非 ProMax 直接拒绝（导航高亮那边会据此停止重试）。 */
			register: function (el, cfg) {
				if (!d.body || !d.body.classList.contains("site-promax")) return false;
				var c = cfg || AUTO_CFG;
				if (!c.force) {
					c = {
						band: c.band,
						strength: c.strength,
						blur: c.blur,
						sat: c.sat,
						tint: c.tint,
						rim: c.rim,
						nest: c.nest,
						sel: c.sel,
						force: true,
					};
				}
				return applyGlass(el, c);
			},
			unregister: function (el) {
				revertGlass(el);
			},
			rebuild: function (el) {
				var info = el.__lgOn;
				var cfg = info ? info.cfg : AUTO_CFG;
				if (info) revertGlass(el);
				return applyGlass(el, cfg);
			},
		};
		try {
			d.dispatchEvent(new CustomEvent("liquidglass:ready"));
		} catch (e) {}

		schedule(80);
		if (d.readyState === "loading") {
			d.addEventListener("DOMContentLoaded", function () {
				schedule(140);
			});
		}
	})();
</script>
