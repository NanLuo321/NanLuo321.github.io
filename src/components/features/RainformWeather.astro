	function fetchWeatherData() {
		if (weatherDataFetched) return;
		weatherDataFetched = true;

		var loading = document.getElementById("rw-loading");
		var content = document.getElementById("rw-content");

		// 1. 先用 uapis.cn 获取当前天气（含城市名）
		fetch("https://uapis.cn/api/v1/misc/weather")
			.then(function(r) { return r.json(); })
			.then(function(data) {
				// 显示当前天气
				if (loading) loading.style.display = "none";
				if (content) content.style.display = "flex";

				var cityEl = document.getElementById("rw-city");
				if (cityEl && data.city) cityEl.textContent = data.city;

				var tempStr = (data.temperature !== undefined ? data.temperature : "--") + "°";
				var tempEl = document.getElementById("rw-temp");
				if (tempEl) tempEl.textContent = tempStr;

				var condEl = document.getElementById("rw-condition");
				if (condEl && data.weather) condEl.textContent = data.weather;

				var humEl = document.getElementById("rw-humidity");
				if (humEl && data.humidity !== undefined) humEl.textContent = "湿度 " + data.humidity + "%";

				var windEl = document.getElementById("rw-wind");
				if (windEl) {
					var windText = "风 ";
					if (data.wind_direction) windText += data.wind_direction;
					if (data.wind_power) windText += " " + data.wind_power;
					windEl.textContent = windText;
				}

				// 2. 获取经纬度，用 Open-Meteo 获取逐小时降水预报
				getCoordinates(data.city, function(lat, lon) {
					fetchHourlyForecast(lat, lon);
				}, function() {
					// 定位失败，使用默认上海坐标
					fetchHourlyForecast(31.23, 121.47);
				});

				return data;
			})
			.catch(function(err) {
				console.warn("[RainformWeather] uapis.cn 请求失败:", err);
				// 降级：直接用 Open-Meteo + 默认坐标
				if (loading) loading.style.display = "none";
				if (content) content.style.display = "flex";
				fetchHourlyForecast(31.23, 121.47);
			});
	}

	function getCoordinates(cityName, onSuccess, onFail) {
		// 先尝试浏览器定位
		if (navigator.geolocation) {
			navigator.geolocation.getCurrentPosition(
				function(pos) {
					onSuccess(pos.coords.latitude, pos.coords.longitude);
				},
				function() {
					// 浏览器定位失败，尝试 Open-Meteo 地名编码
					if (cityName) {
						fetch("https://geocoding-api.open-meteo.com/v1/search?name=" + encodeURIComponent(cityName) + "&count=1&language=zh")
							.then(function(r) { return r.json(); })
							.then(function(data) {
								if (data.results && data.results.length > 0) {
									onSuccess(data.results[0].latitude, data.results[0].longitude);
								} else {
									onFail();
								}
							})
							.catch(function() { onFail(); });
					} else {
						onFail();
					}
				},
				{ timeout: 5000 }
			);
		} else if (cityName) {
			fetch("https://geocoding-api.open-meteo.com/v1/search?name=" + encodeURIComponent(cityName) + "&count=1&language=zh")
				.then(function(r) { return r.json(); })
				.then(function(data) {
					if (data.results && data.results.length > 0) {
						onSuccess(data.results[0].latitude, data.results[0].longitude);
					} else {
						onFail();
					}
				})
				.catch(function() { onFail(); });
		} else {
			onFail();
		}
	}

	function fetchHourlyForecast(lat, lon) {
		var url = "https://api.open-meteo.com/v1/forecast?latitude=" + lat + "&longitude=" + lon +
			"&hourly=precipitation,temperature_2m,weathercode&current_weather=true&timezone=Asia/Shanghai&forecast_days=2";

		fetch(url)
			.then(function(r) { return r.json(); })
			.then(function(data) {
				if (!data.hourly || !data.hourly.time) return;

				var now = new Date();
				var times = data.hourly.time;
				var precips = data.hourly.precipitation || [];
				var temps = data.hourly.temperature_2m || [];
				var codes = data.hourly.weathercode || [];

				// 提取全天降水数据（00:00-24:00，25个点）注入 Rainform
				// 注意：Open-Meteo API 使用 timezone=Asia/Shanghai，不能用 toISOString()（UTC 时间）
				// 必须用本地时间（浏览器时区）构造日期字符串，确保与 API 返回的时间匹配
				var todayStr = now.getFullYear() + "-" +
					String(now.getMonth() + 1).padStart(2, "0") + "-" +
					String(now.getDate()).padStart(2, "0");
				var allDayPrecip = [];
				for (var d = 0; d < times.length; d++) {
					if (times[d].startsWith(todayStr)) {
						allDayPrecip.push(precips[d] || 0);
					}
				}
				console.log("[RainformWeather] 日期过滤: todayStr=" + todayStr + ", 匹配小时数=" + allDayPrecip.length);
				// 补齐第 25 个点（次日 00:00 = 24:00）
				var nextDay = new Date(now);
				nextDay.setDate(nextDay.getDate() + 1);
				var nextStr = nextDay.getFullYear() + "-" +
					String(nextDay.getMonth() + 1).padStart(2, "0") + "-" +
					String(nextDay.getDate()).padStart(2, "0");
				for (var d2 = 0; d2 < times.length; d2++) {
					if (times[d2].startsWith(nextStr) && times[d2].endsWith("00:00")) {
						allDayPrecip.push(precips[d2] || 0);
						break;
					}
				}
				console.log("[RainformWeather] 补齐后 allDayPrecip 长度=" + allDayPrecip.length + ", 前5=" + allDayPrecip.slice(0, 5));
				if (allDayPrecip.length >= 24) {
					injectRainformData(allDayPrecip.slice(0, 25));
				} else {
					console.warn("[RainformWeather] allDayPrecip 长度不足 24，跳过注入");
				}

				// 找到当前小时开始的索引
				var startIdx = 0;
				for (var i = 0; i < times.length; i++) {
					var t = new Date(times[i]);
					if (t >= now) { startIdx = i; break; }
				}

				// 取未来 12 小时
				var timeline = document.getElementById("rw-timeline");
				if (!timeline) return;
				timeline.innerHTML = "";

				var rainHours = [];

				for (var j = 0; j < 12 && (startIdx + j) < times.length; j++) {
					var idx = startIdx + j;
					var time = new Date(times[idx]);
					var hh = time.getHours().toString().padStart(2, "0");
					var mm = time.getMinutes().toString().padStart(2, "0");
					var precip = precips[idx] || 0;
					var code = codes[idx] || 0;
					var wmoInfo = getWmoInfo(code);
					var isRain = precip > 0 || isRainCode(code);

					if (isRain) {
						rainHours.push({ time: hh + ":" + mm, precip: precip, code: code, text: wmoInfo.text });
					}

					var hourDiv = document.createElement("div");
					hourDiv.className = "rw-hour" + (isRain ? " is-rain" : "") + (j === 0 ? " is-now" : "");

					var timeSpan = document.createElement("span");
					timeSpan.className = "rw-hour-time";
					timeSpan.textContent = (j === 0 ? "现在" : hh + ":00");
					hourDiv.appendChild(timeSpan);

					var iconSpan = document.createElement("span");
					iconSpan.className = "rw-hour-icon " + wmoInfo.icon;
					iconSpan.innerHTML = createIconSvg(wmoInfo.name);
					hourDiv.appendChild(iconSpan);

					var precipSpan = document.createElement("span");
					precipSpan.className = "rw-hour-precip" + (precip > 0 ? " has-rain" : "");
					precipSpan.textContent = precip > 0 ? precip.toFixed(1) + "mm" : "—";
					hourDiv.appendChild(precipSpan);

					timeline.appendChild(hourDiv);
				}

				// 降水摘要
				var summary = document.getElementById("rw-rain-summary");
				if (summary) {
					if (rainHours.length > 0) {
						var totalRain = 0;
						for (var k = 0; k < rainHours.length; k++) {
							totalRain += rainHours[k].precip;
						}
						var firstRain = rainHours[0].time;
						var lastRain = rainHours[rainHours.length - 1].time;
						summary.innerHTML = "<strong>" + firstRain + " - " + lastRain + "</strong> 有雨 · 预计降水 <strong>" + totalRain.toFixed(1) + "mm</strong>";
						summary.classList.add("is-visible");
					} else {
						summary.innerHTML = "未来 12 小时无降水";
						summary.classList.add("is-visible");
					}
				}
			})
			.catch(function(err) {
				console.warn("[RainformWeather] Open-Meteo 请求失败:", err);
				var summary = document.getElementById("rw-rain-summary");
				if (summary) {
					summary.textContent = "降水预报获取失败";
					summary.classList.add("is-visible");
				}
			});
	}

	// 将全天降水数据注入 Rainform 雨幕强度 UI
	function injectRainformData(allDayPrecip) {
		var iframe = document.getElementById("rainform-weather-iframe");
		if (!iframe || !iframe.contentWindow) {
			console.warn("[RainformWeather] iframe 不存在，无法注入数据");
			return;
		}

		console.log("[RainformWeather] injectRainformData 被调用，数据长度:", allDayPrecip.length, "前5:", allDayPrecip.slice(0, 5));

		// 判断是否有雨
		var hasRain = false;
		for (var i = 0; i < allDayPrecip.length; i++) {
			if (allDayPrecip[i] > 0) { hasRain = true; break; }
		}

		// 显示/隐藏太阳图标
		var sunOverlay = document.getElementById("rw-sun-overlay");
		if (sunOverlay) sunOverlay.style.display = hasRain ? "none" : "block";

		// 通过 postMessage 发送降水数据到 iframe 内部脚本
		// 带重试机制：iframe 可能尚未加载完成，首次发送可能丢失
		var sendCount = 0;
		function sendToIframe() {
			if (!iframe || !iframe.contentWindow) return;
			try {
				iframe.contentWindow.postMessage({
					type: "setRainfall",
					values: allDayPrecip
				}, "*");
				console.log("[RainformWeather] postMessage 已发送, 第", sendCount + 1, "次");
			} catch(e) {
				console.warn("[RainformWeather] postMessage 发送失败:", e);
			}
			sendCount++;
			if (sendCount < 3) setTimeout(sendToIframe, 2000);
		}
		sendToIframe();
	}

	function initRainformWeather() {
		var overlay = document.getElementById("rainform-weather-overlay");
		var iframe = document.getElementById("rainform-weather-iframe");
		var closeBtn = document.getElementById("rainform-weather-close");
		var navBtn = document.getElementById("rainform-weather-toggle");

		if (!overlay || !iframe) return;
		if (overlay.dataset.rwInit) return;
		overlay.dataset.rwInit = "true";

		function showOpenSourceToast() {
			var existing = document.getElementById("rw-opensource-toast");
			if (existing) existing.remove();
			var toast = document.createElement("div");
			toast.id = "rw-opensource-toast";
			toast.innerHTML = '🌧️ 本天气场景基于开源项目 Rainform 构建';
			toast.style.cssText = "position:fixed;top:50%;left:50%;transform:translate(-50%,-50%) scale(0.9);z-index:100001;background:rgba(20,20,30,0.75);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);color:#fff;padding:14px 28px;border-radius:14px;font-size:14px;font-weight:600;white-space:nowrap;pointer-events:none;opacity:0;transition:opacity 0.4s ease,transform 0.4s ease;border:1px solid rgba(255,255,255,0.12);box-shadow:0 8px 32px rgba(0,0,0,0.3);";
			document.body.appendChild(toast);
			requestAnimationFrame(function() {
				toast.style.opacity = "1";
				toast.style.transform = "translate(-50%,-50%) scale(1)";
			});
			setTimeout(function() {
				toast.style.opacity = "0";
				toast.style.transform = "translate(-50%,-50%) scale(0.9)";
				setTimeout(function() { toast.remove(); }, 400);
			}, 2000);
		}

		function openWeather() {
			console.log("[RainformWeather] openWeather() 被调用, iframe.src =", iframe.src);
			// 更可靠的 src 检查：用 getAttribute 和 indexOf 双重检查
			var srcAttr = iframe.getAttribute("src") || "";
			if (srcAttr === "about:blank" || srcAttr === "" || iframe.src === "about:blank" || iframe.src === "" || iframe.src === window.location.href || srcAttr.indexOf("weather-widget") === -1) {
				iframe.src = "/weather-widget/index.html";
				console.log("[RainformWeather] iframe.src 已设置为 /weather-widget/index.html");
			} else {
				console.log("[RainformWeather] iframe.src 已存在，不重复设置:", iframe.src);
			}
			overlay.classList.add("is-open");
			overlay.setAttribute("aria-hidden", "false");
			if (closeBtn) closeBtn.classList.add("is-visible");
			document.body.style.overflow = "hidden";
			// 显示开源提示浮窗（2秒）
			showOpenSourceToast();
			// 延迟获取天气数据
			setTimeout(fetchWeatherData, 500);
			// 恢复面板位置
			setTimeout(restorePanelPosition, 100);
			// iframe 加载后触发 resize 让 Three.js 重新计算画布尺寸
			iframe.addEventListener("load", function () {
				try {
					var win = iframe.contentWindow;
					if (!win) return;
					[100, 300, 600, 1000, 2000].forEach(function (delay) {
						setTimeout(function () {
							win.dispatchEvent(new win.Event("resize"));
						}, delay);
					});
				} catch (e) {}
			});
		}

		function closeWeather() {
			overlay.classList.remove("is-open");
			overlay.setAttribute("aria-hidden", "true");
			if (closeBtn) closeBtn.classList.remove("is-visible");
			document.body.style.overflow = "";
			// 重置最小化状态
			var p = document.getElementById("rw-panel");
			var m = document.getElementById("rw-minimized");
			if (p) p.style.display = "";
			if (m) m.style.display = "none";
			setTimeout(function() {
				if (!overlay.classList.contains("is-open")) {
					iframe.src = "about:blank";
				}
			}, 500);
		}

		if (closeBtn) closeBtn.addEventListener("click", closeWeather);
		if (navBtn) navBtn.addEventListener("click", openWeather);

		// === 拖拽功能 ===
		var panel = document.getElementById("rw-panel");
		var panelHeader = document.getElementById("rw-panel-header");
		var minimizeBtn = document.getElementById("rainform-weather-minimize");
		var minimizedEl = document.getElementById("rw-minimized");
		var restoreBtn = document.getElementById("rainform-weather-restore");

		var isDragging = false;
		var dragOffsetX = 0;
		var dragOffsetY = 0;
		var panelPosKey = "rw-panel-position";

		function restorePanelPosition() {
			if (!panel) return;
			var saved = null;
			try { saved = JSON.parse(localStorage.getItem(panelPosKey)); } catch(e) {}
			if (saved && typeof saved.left === "number" && typeof saved.top === "number") {
				// 确保位置在当前视口范围内
				var maxX = window.innerWidth - 80;
				var maxY = window.innerHeight - 80;
				var left = Math.min(saved.left, maxX);
				var top = Math.min(saved.top, maxY);
				panel.style.left = left + "px";
				panel.style.top = top + "px";
				panel.style.bottom = "auto";
				panel.style.transform = "none";
				panel.classList.add("is-dragged");
			}
		}

		function savePanelPosition(left, top) {
			try { localStorage.setItem(panelPosKey, JSON.stringify({ left: left, top: top })); } catch(e) {}
		}

		function startDrag(clientX, clientY) {
			if (!panel || panel.style.display === "none") return;
			var rect = panel.getBoundingClientRect();
			panel.style.left = rect.left + "px";
			panel.style.top = rect.top + "px";
			panel.style.bottom = "auto";
			panel.style.transform = "none";
			panel.classList.add("is-dragged", "is-dragging");
			dragOffsetX = clientX - rect.left;
			dragOffsetY = clientY - rect.top;
			isDragging = true;
			document.body.style.userSelect = "none";
			document.body.style.webkitUserSelect = "none";
		}

		function onDrag(clientX, clientY) {
			if (!isDragging || !panel) return;
			var newLeft = clientX - dragOffsetX;
			var newTop = clientY - dragOffsetY;
			var maxX = window.innerWidth - panel.offsetWidth - 8;
			var maxY = window.innerHeight - panel.offsetHeight - 8;
			newLeft = Math.max(8, Math.min(newLeft, maxX));
			newTop = Math.max(8, Math.min(newTop, maxY));
			panel.style.left = newLeft + "px";
			panel.style.top = newTop + "px";
		}

		function endDrag() {
			if (!isDragging) return;
			isDragging = false;
			if (panel) {
				panel.classList.remove("is-dragging");
				var rect = panel.getBoundingClientRect();
				savePanelPosition(rect.left, rect.top);
			}
			document.body.style.userSelect = "";
			document.body.style.webkitUserSelect = "";
		}

		if (panelHeader) {
			panelHeader.addEventListener("mousedown", function(e) {
				if (e.target.closest("button")) return;
				startDrag(e.clientX, e.clientY);
				e.preventDefault();
			});
			document.addEventListener("mousemove", function(e) {
				if (isDragging) onDrag(e.clientX, e.clientY);
			});
			document.addEventListener("mouseup", endDrag);

			panelHeader.addEventListener("touchstart", function(e) {
				if (e.target.closest("button")) return;
				var t = e.touches[0];
				startDrag(t.clientX, t.clientY);
			}, { passive: true });
			document.addEventListener("touchmove", function(e) {
				if (isDragging) {
					var t = e.touches[0];
					onDrag(t.clientX, t.clientY);
					e.preventDefault();
				}
			}, { passive: false });
			document.addEventListener("touchend", endDrag);
		}

		// === 最小化 / 恢复 ===
		function minimizePanel() {
			if (!panel || !minimizedEl) return;
			panel.style.display = "none";
			minimizedEl.style.display = "block";
		}
		function restorePanel() {
			if (!panel || !minimizedEl) return;
			panel.style.display = "";
			minimizedEl.style.display = "none";
		}
		if (minimizeBtn) minimizeBtn.addEventListener("click", minimizePanel);
		if (restoreBtn) restoreBtn.addEventListener("click", restorePanel);

		// === 时间线鼠标滚轮横向滚动 ===
		var timeline = document.getElementById("rw-timeline");
		if (timeline) {
			timeline.addEventListener("wheel", function(e) {
				if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
					e.preventDefault();
					timeline.scrollLeft += e.deltaY;
				}
			}, { passive: false });
		}

		document.addEventListener("keydown", function(e) {
			if (e.key === "Escape" && overlay.classList.contains("is-open")) {
				closeWeather();
			}
		});
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initRainformWeather);
	} else {
		initRainformWeather();
	}
	document.addEventListener("astro:page-load", initRainformWeather);
})();
</script>
