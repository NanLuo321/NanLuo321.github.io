			   说明那几行虽然是 opacity:0，但**占位** —— 先填说明再量的话，
			   量到的是「说明已经把上面那排按钮顶上去之后」的位置，动画起点就错了
			   （表现成：点完按钮，列表先向上跳一下、再往左滑）。 */
			var vEl = gate.querySelector(".vg-versions");
			var firstRect = vEl ? vEl.getBoundingClientRect() : null;
			/* 「从中间滑到左边」只在**第一次**点版本时播：之后列表已经在左边了，
			   再点别的版本只是换选中态 + 换说明，不该再滑一次（那会像在抖）。 */
			var wasPicking = gate.classList.contains("is-picking");

			gate.classList.add("is-picking"); /* 版本列表左移、说明移到正中并放大 */
			var btns = gate.querySelectorAll(".vg-btn[data-ver]");
			for (var b = 0; b < btns.length; b++) {
				btns[b].classList.toggle("is-sel", btns[b].getAttribute("data-ver") === v);
			}
			if (DESC_BOX) {
				DESC_BOX.textContent = ""; /* 重新建节点 → 动画自然从头播 */
				var lines = linesOf(v);
				for (var i = 0; i < lines.length; i++) {
					var p = document.createElement("p");
					p.className = "vg-desc__line";
					p.style.animationDelay = (i * LINE_STEP).toFixed(2) + "s";
					p.textContent = lines[i];
					DESC_BOX.appendChild(p);
				}
			}
			if (ENTER_BTN) ENTER_BTN.classList.add("is-on");

			if (!wasPicking) flipFrom(vEl, firstRect); /* 布局已经改完 → 用 transform 把它「滑」过去 */
		}

		/* ── 「从中间滑到左边」的动画（FLIP）────────────────────────────
		   栅格换列（`grid-column: 1/-1` → `1`）是**没法 transition 的** ——
		   位置瞬间就跳过去了。所以走 FLIP 四步：
		     ① First  —— 改布局**之前**量旧矩形（在 showDesc 里量好传进来）
		     ② Last   —— 改完布局量新矩形
		     ③ Invert —— 用 transform 把它「按回」旧位置（此刻画面 = 点击前那一帧）
		     ④ Play   —— 下一帧撤掉 transform，靠 transition 平滑滑到新位置
		   ⚠ 必须用 transform 而不是过渡 width：transform 只影响绘制、不参与布局，
		     滑动全程不会把中间那列（说明）挤偏；过渡 width 会真改布局，
		     栅格每帧重算 → 中间那列跟着抖。
		   代价：新旧宽度不同（420 → min(340px,22vw)），scale 会让文字在飞的途中
		     轻微拉伸 —— 这是 FLIP 的固有代价，换来的是「第一帧与点击前一模一样」。
		   结束后内联的 transform / transition / transform-origin 全部清干净，
		   免得后面任何一次布局变化都拖着这段已经播完的过渡。 */
		var FLIP_MS = 620;
		function flipFrom(el, first) {
			if (!el || !first || !first.width) return;
			var reduce = false;
			try {
				reduce = !!(
					window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches
				);
			} catch (e) {}
			if (reduce) return; /* 关了动效就让它直接到新位置（布局已经改完了） */
			var last = el.getBoundingClientRect();
			if (!last.width || !last.height) return;
			el.style.transformOrigin = "top left";
			el.style.transform =
				"translate(" +
				(first.left - last.left).toFixed(2) +
				"px, " +
				(first.top - last.top).toFixed(2) +
				"px) scale(" +
				(first.width / last.width).toFixed(4) +
				", " +
				(first.height / last.height).toFixed(4) +
				")";
			void el.offsetWidth; /* 逼一帧：否则「设起点 + 改终点」会被合成一次，动画不播 */
			el.style.transition = "transform " + FLIP_MS + "ms cubic-bezier(0.2, 0.8, 0.2, 1)";
			el.style.transform = "none";
			setTimeout(function () {
				el.style.transition = "";
				el.style.transform = "";
				el.style.transformOrigin = "";
			}, FLIP_MS + 40);
		}

		/* 真正应用版本（就是原来「点按钮即进站」那段，原样搬进来） */
		function applyVersion(v) {
			try {
				localStorage.setItem(KEY, v);
				localStorage.setItem("visualEffectMode", v === "lite" ? "none" : "rain");
			} catch (err) {}
			document.body.classList.remove("site-lite", "site-normal", "site-promax");
			document.body.classList.add("site-" + v);
			if (v === "lite") {
				// 立即关掉底部波浪
				try {
					localStorage.setItem("wavesEnabled", "false");
				} catch (err2) {}
				document.documentElement.setAttribute("data-waves-enabled", "false");
				var w = document.getElementById("header-waves");
				if (w) w.style.display = "none";
			} else {
				// 正常版 / ProMax：恢复精简时关掉的东西
				document.documentElement.removeAttribute("data-waves-enabled");
				var w2 = document.getElementById("header-waves");
				if (w2) w2.style.display = "";
			}
			// 导航岛沉底的 ProMax 版：收起按钮的箭头语义要反向，重建一次图标状态
			try {
				var resync = window.resetFullscreenNavbarState;
				if (typeof resync === "function") resync();
			} catch (err3) {}
			// 版本换了 → 归一化浮层方向（搜索面板 / 媒体详情 / 文章面板都按 body 类判断）
			try {
				document.dispatchEvent(new CustomEvent("siteversionchange", { detail: { ver: v } }));
			} catch (err4) {}
			gate.hidden = true;
			gate.classList.remove("is-cover", "is-shown", "is-ready");
			document.documentElement.style.overflow = "";
			/* 选完版本收门：背景音乐一并停掉 */
			if (audioEl) audioEl.pause();
			/* 解锁滚动后视口宽度会变化（滚动条回来了）→ 提醒玻璃引擎重新量一次 */
			try {
				window.dispatchEvent(new Event("resize"));
			} catch (err5) {}
			window.dispatchEvent(
				new CustomEvent("effectModeChange", { detail: { mode: v === "lite" ? "none" : "rain" } }),
			);
		}

		/* 右下角「进入 →」：用当前选中的版本进站 */
		if (ENTER_BTN) {
			ENTER_BTN.addEventListener("click", function (e) {
				e.stopPropagation();
				if (selected) applyVersion(selected);
			});
		}

		var soonTipTimer = 0;
		gate.addEventListener("click", function (e) {
			var btn = e.target && e.target.closest ? e.target.closest("[data-ver]") : null;
			if (!btn) return;
			var v = btn.getAttribute("data-ver");
			/* 占位档位（ProMaxPlusUltra / ULTRA）：只在面板底部回一句提示，
			   不写 localStorage、不切 body 类名，免得选出一个还不存在的版本。
			   也不改选中态 —— 它们没有说明、也进不去。 */
			if (v === "ultra" || v === "promaxplusultra") {
				var tipEl = gate.querySelector("[data-vg-tip]");
				if (tipEl) {
					tipEl.textContent =
						v === "ultra"
							? "ULTRA 版还在路上，明年再说～"
							: "ProMaxPlusUltra 还在图纸上，先剧透一下～";
					if (soonTipTimer) clearTimeout(soonTipTimer);
					soonTipTimer = setTimeout(function () {
						tipEl.textContent = "";
					}, 2600);
				}
				return;
			}
			/* 正式档位：先出说明（逐句），真正进站等右下角「进入 →」 */
			showDesc(v);
		});
	})();
</script>
