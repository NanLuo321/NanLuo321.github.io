	@media (prefers-reduced-motion: reduce) {
		#version-gate.is-shown .vg-bg::before,
		#version-gate.is-shown .vg-bg::after,
		#version-gate.is-shown .vg-glass {
			animation: none;
		}
		#version-gate.is-shown .vg-glass,
		#version-gate.is-shown .vg-bg::before,
		#version-gate.is-shown .vg-bg::after {
			opacity: 1;
		}
		/* 无动画时三行文字都要直接可见（否则 TO / 南洛'S BLOG 永远 opacity:0） */
