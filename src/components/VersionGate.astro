<!--
  版本门 + 开屏
  ─────────────────────────────────────────────────────────────
  分两段上场：
    ① 幕布期（整站还在加载）—— 黑底 + WELCOME 先到位，静态、零动画。
      加载期间不出空档；重活（大半径 blur 光斑 / 流光 / backdrop-filter 按钮）
      一律不上，免得跟首屏抢主线程（用户反馈：一起上会卡）。
    ② 开场（window load + 字体就绪 + 站内 Loading 退场之后）——
      .is-shown 接上：光斑淡入开始游动、WELCOME 起流光、TO 与 南洛'S BLOG
      依次模糊入场；4.5s 后 .is-ready 收起开屏、放出版本按钮。
      期间点一下可立刻跳过。
  行为沿用原来的版本门脚本：
    · localStorage.siteVersion 记档；首次进站 / 刷新弹，站内跳转不弹
    · lite 关粒子特效与底部波浪；normal / promax 还原
    · ultra、promaxplusultra 是占位档：只回一句提示，不写盘
-->
<div
	id="version-gate"
	hidden
	style="position:fixed;inset:0;z-index:100000;overflow:hidden;background:#000;color:#fff"
>
	<!-- 黑白动态背景 -->
	<div class="vg-bg" aria-hidden="true"></div>

	<!-- 开屏 -->
	<section class="vg-intro" data-vg-skip>
		<div class="vg-glass vg-line1">WELCOME</div>
		<div class="vg-glass vg-line2">TO</div>
		<div class="vg-glass vg-line3">南洛'S BLOG</div>
		<div class="vg-skip">点一下跳过</div>
	</section>

	<!-- 背景音乐：lite / normal / promax 各一段，**点哪个版本才播哪一段**
	     （不是悬停就播 —— 悬停太早出声，容易吓人，也容易和浏览器的自动播放策略打架） -->
	<audio id="vg-audio" loop preload="auto" hidden></audio>

	<!-- 右上角静音按钮 -->
	<button type="button" class="vg-mute" data-vg-mute aria-label="静音背景音乐">
		<svg class="vg-mute__on" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M11 5 6 9H2v6h4l5 4V5z" fill="currentColor" stroke="none"></path>
			<path d="M15.5 8.5a5 5 0 0 1 0 7"></path>
			<path d="M18.5 5.5a9 9 0 0 1 0 13"></path>
		</svg>
		<svg class="vg-mute__off" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M11 5 6 9H2v6h4l5 4V5z" fill="currentColor" stroke="none"></path>
			<line x1="16" y1="9" x2="22" y2="15"></line>
			<line x1="22" y1="9" x2="16" y2="15"></line>
		</svg>
	</button>

	<!-- 版本选择 -->
	<section class="vg-panel">
		<div class="vg-stack">
			<div class="vg-versions">
				<button type="button" class="vg-btn" data-ver="lite">
					<span class="vg-name">精简版</span>
					<span class="vg-tag">Lite</span>
				</button>
				<button type="button" class="vg-btn" data-ver="normal">
					<span class="vg-name">普通版</span>
					<span class="vg-tag vg-tag--rec">推荐 · Normal</span>
				</button>
				<button type="button" class="vg-btn" data-ver="promax">
					<span class="vg-name">PROMAX</span>
					<span class="vg-tag vg-tag--rec">新</span>
				</button>
				<button type="button" class="vg-btn vg-btn--soon" data-ver="promaxplusultra" data-soon="1">
					<span class="vg-name">PROMAX ULTRA</span>
					<span class="vg-tag vg-tag--soon">预告</span>
				</button>
				<button type="button" class="vg-btn vg-btn--soon" data-ver="ultra" data-soon="1">
					<span class="vg-name">ULTRA</span>
					<span class="vg-tag vg-tag--soon">明年</span>
				</button>
			</div>

			<!-- 版本说明：点某个版本之后才出现，**一个逗号 / 句号一行**、逐句淡入。
			     未选中时它在按钮下面占位（预留 min-height，所以按钮不会上下跳）；
			     选中之后（.is-picking）它搬去屏幕正中、放大、居中 —— 见 CSS。 -->
			<div class="vg-desc" data-vg-desc aria-live="polite"></div>

			<div class="vg-tip" data-vg-tip></div>
		</div>
	</section>

	<!-- 右下角「进入 →」：选了版本才淡入。
	     ⚠ 点版本按钮**不再**直接进站 —— 先看说明，点这里才真正应用版本。 -->
	<button type="button" class="vg-enter" data-vg-enter>
		进入<span class="vg-enter__arrow" aria-hidden="true">→</span>
	</button>
</div>

<style>
	#version-gate {
		position: fixed;
		inset: 0;
		z-index: 100000;
		overflow: hidden;
		background: #000;
		color: #fff;
		font-family:
			-apple-system, BlinkMacSystemFont, "SF Pro Display", "Helvetica Neue", Arial, sans-serif;
	}
	#version-gate[hidden] {
		display: none;
	}

	/* =========================
	   黑白动态背景
	========================= */
	.vg-bg {
		position: absolute;
		inset: 0;
		overflow: hidden;
		background:
			radial-gradient(circle at 20% 30%, rgba(255, 255, 255, 0.12), transparent 28%),
			radial-gradient(circle at 80% 70%, rgba(255, 255, 255, 0.08), transparent 30%), #000;
	}
	.vg-bg::before,
	.vg-bg::after {
		content: "";
		position: absolute;
		border-radius: 50%;
		/* 幕布期不画这两团大半径 blur（一次性光栅也不做），
		   开场时再淡入 + 游动 */
		opacity: 0;
		transition: opacity 1.1s ease;
	}
	.vg-bg::before {
		width: 70vw;
		height: 70vw;
		left: -20vw;
		top: -30vw;
		background: radial-gradient(
			circle,
			rgba(255, 255, 255, 0.2),
			rgba(255, 255, 255, 0.03) 35%,
			transparent 70%
		);
		filter: blur(70px);
	}
	.vg-bg::after {
		width: 60vw;
		height: 60vw;
		right: -20vw;
		bottom: -25vw;
		background: radial-gradient(circle, rgba(255, 255, 255, 0.16), transparent 65%);
		filter: blur(80px);
	}
	#version-gate.is-shown .vg-bg::before {
		opacity: 1;
		animation: vgBgMove 12s ease-in-out infinite alternate;
	}
	#version-gate.is-shown .vg-bg::after {
		opacity: 1;
		animation: vgBgMove2 15s ease-in-out infinite alternate;
	}
	@keyframes vgBgMove {
		from {
			transform: translate3d(0, 0, 0) scale(1);
		}
		to {
			transform: translate3d(15vw, 12vh, 0) scale(1.2);
		}
	}
	@keyframes vgBgMove2 {
		from {
			transform: translate3d(0, 0, 0);
		}
		to {
			transform: translate3d(-12vw, -10vh, 0) scale(1.15);
		}
	}

	/* =========================
	   开屏（三行液态玻璃文字）
	========================= */
	.vg-intro {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		cursor: pointer;
		transition: opacity 0.9s ease, transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	#version-gate.is-ready .vg-intro {
		opacity: 0;
		transform: scale(1.04);
		pointer-events: none;
	}
	.vg-glass {
		position: relative;
		opacity: 0;
		font-weight: 700;
		letter-spacing: 0.16em;
		color: rgba(255, 255, 255, 0.88);
		text-shadow:
			0 1px 0 rgba(255, 255, 255, 0.9),
			0 -1px 0 rgba(255, 255, 255, 0.15),
			0 3px 20px rgba(255, 255, 255, 0.18),
			0 8px 35px rgba(0, 0, 0, 0.9);
		background: linear-gradient(
			180deg,
			#ffffff 0%,
			#eeeeee 18%,
			#777777 45%,
			#ffffff 58%,
			#333333 75%,
			#ffffff 100%
		);
		background-size: 100% 220%;
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		filter: drop-shadow(0 0 1px rgba(255, 255, 255, 0.9)) drop-shadow(0 10px 30px rgba(0, 0, 0, 0.8));
	}
	#version-gate.is-shown .vg-glass {
		animation:
			vgTextIn 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) forwards,
			vgShine 4s ease-in-out infinite;
	}
	#version-gate.is-shown .vg-line2 {
		animation-delay: 0.8s, 0.8s;
	}
	#version-gate.is-shown .vg-line3 {
		animation-delay: 1.2s, 1.2s;
	}
	/* 幕布期：WELCOME 先出现（静态玻璃字，不跑动画） */
	#version-gate.is-cover .vg-line1 {
		opacity: 1;
	}
	/* 开场时 WELCOME 已经在位了，不再重播入场（否则会「闪一下」重来），
	   只接上流光继续走 */
	#version-gate.is-shown .vg-line1 {
		opacity: 1;
		animation: vgShine 4s ease-in-out infinite 0.3s;
	}
	.vg-line1 {
		font-size: clamp(42px, 7vw, 100px);
	}
	.vg-line2 {
		margin-top: 6px;
		font-size: clamp(28px, 4vw, 60px);
	}
	.vg-line3 {
		margin-top: 10px;
		font-size: clamp(24px, 3.5vw, 52px);
	}
	@keyframes vgTextIn {
		0% {
			opacity: 0;
			transform: translateY(35px) scale(0.94);
			filter: blur(15px);
		}
		100% {
			opacity: 1;
			transform: translateY(0) scale(1);
			filter: blur(0);
		}
	}
	@keyframes vgShine {
		0% {
			background-position: 0% 0%;
		}
		50% {
			background-position: 0% 100%;
		}
		100% {
			background-position: 0% 0%;
		}
	}
	.vg-skip {
		margin-top: 34px;
		font-size: 0.7rem;
		letter-spacing: 0.28em;
		color: rgba(255, 255, 255, 0.34);
		opacity: 0;
	}
	/* 「点一下跳过」只在开场之后才提示（幕布期点了也没意义） */
	#version-gate.is-shown .vg-skip {
		animation: vgSkipIn 1s ease 2.2s forwards;
	}
	@keyframes vgSkipIn {
		to {
			opacity: 1;
		}
	}

	/* =========================
	   背景音乐静音按钮
	========================= */
	.vg-mute {
		position: absolute;
		top: 18px;
		right: 18px;
		z-index: 20;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 42px;
		height: 42px;
		border-radius: 50%;
		border: 1px solid rgba(255, 255, 255, 0.18);
		background: rgba(255, 255, 255, 0.08);
		-webkit-backdrop-filter: blur(14px);
		backdrop-filter: blur(14px);
		color: rgba(255, 255, 255, 0.75);
		cursor: pointer;
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2), 0 8px 24px rgba(0, 0, 0, 0.35);
		transition:
			transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), background 0.35s, border 0.35s,
			color 0.35s;
	}
	.vg-mute:hover {
		transform: scale(1.08);
		background: rgba(255, 255, 255, 0.16);
		border-color: rgba(255, 255, 255, 0.45);
		color: #fff;
	}
	.vg-mute:active {
		transform: scale(0.94);
	}
	.vg-mute:focus-visible {
		outline: 2px solid rgba(255, 255, 255, 0.6);
		outline-offset: 3px;
	}
	.vg-mute .vg-mute__off {
		display: none;
	}
	.vg-mute.is-muted {
		color: rgba(255, 255, 255, 0.4);
	}
	.vg-mute.is-muted .vg-mute__on {
		display: none;
	}
	.vg-mute.is-muted .vg-mute__off {
		display: block;
	}

	/* =========================
	   版本选择
	========================= */
	.vg-panel {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		box-sizing: border-box;
		padding: 24px 16px;
		/* 内容靠 .vg-stack 的 margin:auto 竖直居中 —— 这里**不能**用
		   justify-content:center：内容一旦超过视口，flex 会把顶部裁掉，且滚动也拉不回来
		   （加了版本说明之后，矮屏 / 横屏手机上内容确实会超一屏）。 */
		overflow-y: auto;
		opacity: 0;
		transform: scale(0.96);
		pointer-events: none;
		transition: opacity 1.2s ease, transform 1.2s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	#version-gate.is-ready .vg-panel {
		opacity: 1;
		transform: scale(1);
		pointer-events: auto;
	}
	/* 三列栅格：`1fr auto 1fr` 让**中间那列永远在屏幕正中**（两侧等分剩余空间）。
	   未选中：按钮（第 1 行、横跨整行）/ 说明（第 2 行）/ 提示（第 3 行）逐行竖排，整体竖直居中。
	   选中后（.is-picking）：按钮搬去第 1 列（用户圈的红框），
	                        说明搬去第 2 列（屏幕正中，用户圈的红圈）并放大。
	   用栅格而不是绝对定位，是为了保住 margin:auto 的「竖向居中 + 超一屏可滚动」。
	   ⚠ 换列是**瞬间跳**的（grid-column 不可过渡）—— 「从中间滑到左边」那段动画
	     由脚本的 flipFrom() 用 transform 补（FLIP），不在这里做。 */
	.vg-stack {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		justify-items: center;
		width: 100%;
		margin: auto 0; /* 不足一屏 → 竖直居中；超过一屏 → 正常滚动 */
	}
	.vg-versions {
		grid-column: 1 / -1;
		grid-row: 1;
		justify-self: center;
		display: flex;
		flex-direction: column;
		gap: 12px;
		width: min(420px, 88vw);
	}
	#version-gate.is-picking .vg-versions {
		/* 搬到左边（第 1 列）。
		   ⚠ 宽度必须跟着视口缩（22vw），**不能写死像素、也不能 min(100%,…) 铺满整列** ——
		     侧列是 1fr，写死会把栅格撑出横向溢出（中间那列被顶偏）；
		     铺满整列则反过来，版本列表右缘会顶到说明的左缘（实测 876 宽时只剩 0px 间距）。
		     22vw 让两侧恒定留出约 13~35px 的呼吸位。 */
		grid-column: 1;
		justify-self: center;
		gap: 10px;
		width: min(340px, 22vw);
	}
	#version-gate.is-picking .vg-btn {
		height: 56px;
		padding: 0 16px;
		font-size: 13.5px;
	}

	/* 玻璃按钮 */
	.vg-btn {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
		width: 100%;
		height: 62px;
		padding: 0 22px;
		border-radius: 18px;
		border: 1px solid rgba(255, 255, 255, 0.18);
		background: linear-gradient(135deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.025));
		-webkit-backdrop-filter: blur(25px) saturate(180%);
		backdrop-filter: blur(25px) saturate(180%);
		color: rgba(255, 255, 255, 0.82);
		font-size: 15px;
		font-family: inherit;
		letter-spacing: 0.12em;
		cursor: pointer;
		overflow: hidden;
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.25), inset 0 -1px 0 rgba(0, 0, 0, 0.8),
			0 12px 40px rgba(0, 0, 0, 0.35);
		transition:
			transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), background 0.35s, border 0.35s,
			box-shadow 0.35s, color 0.35s;
	}
	/* 斜切高光 */
	.vg-btn::before {
		content: "";
		position: absolute;
		top: -100%;
		left: -60%;
		width: 45%;
		height: 300%;
		background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.35), transparent);
		transform: rotate(20deg);
		filter: blur(8px);
		transition: left 0.8s;
	}
	/* 顶部反光棱 */
	.vg-btn::after {
		content: "";
		position: absolute;
		top: 0;
		left: 10%;
		right: 10%;
		height: 1px;
		background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.8), transparent);
		opacity: 0.6;
	}
	.vg-btn:hover {
		transform: translateY(-4px) scale(1.015);
		background: linear-gradient(135deg, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0.05));
		border-color: rgba(255, 255, 255, 0.45);
		color: #fff;
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.5), 0 15px 50px rgba(255, 255, 255, 0.08);
	}
	.vg-btn:hover::before {
		left: 125%;
	}
	.vg-btn:active {
		transform: scale(0.97);
	}
	.vg-btn:focus-visible {
		outline: 2px solid rgba(255, 255, 255, 0.6);
		outline-offset: 3px;
	}
	.vg-name {
		font-weight: 700;
	}
	.vg-tag {
		font-size: 0.66rem;
		letter-spacing: 0.08em;
		padding: 3px 9px;
		border-radius: 9999px;
		background: rgba(255, 255, 255, 0.1);
		color: rgba(255, 255, 255, 0.6);
		white-space: nowrap;
	}
	.vg-tag--rec {
		background: rgba(52, 211, 153, 0.18);
		color: rgb(52, 211, 153);
		font-weight: 700;
	}
	.vg-tag--soon {
		background: rgba(255, 214, 102, 0.16);
		color: rgb(255, 214, 102);
		font-weight: 700;
	}
	/* 占位档位：虚线框 + 压暗，一眼看出「还没到」 */
	.vg-btn--soon {
		border-style: dashed;
		border-color: rgba(255, 255, 255, 0.16);
		background: rgba(255, 255, 255, 0.02);
	}
	.vg-btn--soon .vg-name {
		opacity: 0.75;
	}
	.vg-tip {
		grid-column: 1 / -1;
		grid-row: 3;
		min-height: 20px;
		margin-top: 16px;
		text-align: center;
		font-size: 0.72rem;
		letter-spacing: 0.06em;
		color: rgb(52, 211, 153);
		font-weight: 600;
	}
	/* 选中后说明占了第 1 行，提示往上收一行，免得空出一整行 */
	#version-gate.is-picking .vg-tip {
		grid-row: 2;
	}

	/* 选中的版本按钮（点一下只「选中」，真正进站要点右下角的「进入 →」） */
	.vg-btn.is-sel {
		border-color: rgba(255, 255, 255, 0.5);
		background: linear-gradient(135deg, rgba(255, 255, 255, 0.24), rgba(255, 255, 255, 0.06));
		color: #fff;
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.5), 0 15px 45px rgba(255, 255, 255, 0.07);
	}
	/* 占位档位（ULTRA / ProMaxPlusUltra）不给选中态 —— 它们本来就进不去 */
	.vg-btn--soon.is-sel {
		border-color: rgba(255, 255, 255, 0.16);
		background: rgba(255, 255, 255, 0.02);
		color: rgba(255, 255, 255, 0.82);
		box-shadow: none;
	}

	/* =========================
	   版本说明（点版本后逐句淡入）
	========================= */
	.vg-desc {
		grid-column: 1 / -1;
		grid-row: 2;
		justify-self: center;
		box-sizing: border-box;
		width: min(420px, 88vw);
		/* 未选中时这块是空的（说明只在选中后才出），留一段 min-height 是给
		   「打开面板 → 第一帧」一个稳定的占位，免得面板竖直居中量到最后一行时抖一下。
		   真正的说明高度见下面 .is-picking 那条（按最多 5 行留）。 */
		min-height: 94px;
		margin-top: 20px;
		text-align: left;
		font-size: 0.82rem;
		line-height: 1.7;
		letter-spacing: 0.04em;
		color: rgba(255, 255, 255, 0.62);
	}
	/* 选中之后：搬去第 2 列（屏幕正中）并放大居中 —— 就是用户圈的那个「红圈」。
