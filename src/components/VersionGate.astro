</style>

<script is:inline>
	(function () {
		var KEY = "siteVersion";
		var gate = document.getElementById("version-gate");
		if (!gate) return;

		var ver = null;
		try {
			ver = localStorage.getItem(KEY);
		} catch (e) {}

		/* 已保存的版本先应用（页面在门后面按已选版本渲染），门每次刷新都弹出供重新切换 */
		if (ver === "lite") {
			// 精简版：强制关闭粒子特效（rain/sakura/leaf 都读这个键）+ 底部波浪
			try {
				localStorage.setItem("visualEffectMode", "none");
				localStorage.setItem("wavesEnabled", "false");
			} catch (e) {}
			document.body.classList.add("site-lite");
			document.documentElement.setAttribute("data-waves-enabled", "false");
			var waves = document.getElementById("header-waves");
			if (waves) waves.style.display = "none";
		} else if (ver === "normal" || ver === "promax") {
			// ProMax = 正常版的满配特效 + 导航岛沉底（样式见 styles/promax.css）
			document.body.classList.remove("site-lite");
			document.body.classList.add("site-" + ver);
		}

		/* 门的弹出时机：
		   - 首次进站（没选过版本）→ 弹
		   - 刷新网页 / 前后导航（reload / back_forward）→ 弹，供重新切换
		   - 站内点链接跳转（navigate，整页加载）→ 不弹，别打断浏览
		   另用 window 标记兜底 swup 等不重载 window 的切页场景 */
		var navType = "navigate";
		try {
			var entries = performance.getEntriesByType("navigation");
			navType = (entries && entries[0] && entries[0].type) || "navigate";
		} catch (e) {}
		var isReloadish = navType === "reload" || navType === "back_forward";
		if (window.__versionGateShownThisLoad) return;
		window.__versionGateShownThisLoad = true;
		if (ver !== null && !isReloadish) return;

		/* ── 版本音频 ──────────────────────────────────────────────────
		   三个可选版本各配一段：lite.mp3 / normal.mp3 / promax.mp3。
		   开门不自动播；鼠标悬停（或键盘聚焦）到哪个版本按钮，
		   就播对应曲名的音频；右上角静音按钮随时关（记档，下次进站保持）。 */
		var TRACKS = { lite: "/audio/lite.mp3", normal: "/audio/normal.mp3", promax: "/audio/promax.mp3" };
		var MUTE_KEY = "vgMusicMuted";
		var audioEl = document.getElementById("vg-audio");
		var muteBtn = gate.querySelector("[data-vg-mute]");
		var muted = false;
		try {
			muted = localStorage.getItem(MUTE_KEY) === "1";
		} catch (e) {}

		function playTrack(v) {
			if (!TRACKS[v] || !audioEl) return;
			if (audioEl.getAttribute("src") !== TRACKS[v]) {
				audioEl.src = TRACKS[v];
				audioEl.volume = 0.55;
			}
			if (muted) return;
			tryPlay();
		}
		function tryPlay() {
			if (!audioEl || !audioEl.getAttribute("src")) return;
			var p = audioEl.play();
			if (p && p.catch) {
				p.catch(function () {
					/* 浏览器拦自动播放：等第一次交互再起 */
					var kick = function () {
						if (!gate.hidden && !muted) tryPlay();
					};
					document.addEventListener("pointerdown", kick, { once: true });
					document.addEventListener("keydown", kick, { once: true });
				});
			}
		}
		function applyMute() {
			if (muteBtn) {
				muteBtn.classList.toggle("is-muted", muted);
				muteBtn.setAttribute("aria-label", muted ? "取消静音" : "静音背景音乐");
			}
			if (muted && audioEl) audioEl.pause();
		}
		if (muteBtn) {
			muteBtn.addEventListener("click", function (e) {
				e.stopPropagation();
				muted = !muted;
				try {
					localStorage.setItem(MUTE_KEY, muted ? "1" : "0");
				} catch (err) {}
				applyMute();
			});
		}
		/* 悬停 / 键盘聚焦版本按钮 → 播对应版本的音频（占位档不播） */
		function trackFromEvent(e) {
			var btn = e.target && e.target.closest ? e.target.closest(".vg-btn[data-ver]") : null;
			if (!btn || btn.getAttribute("data-soon")) return;
			playTrack(btn.getAttribute("data-ver"));
		}
		gate.addEventListener("pointerover", trackFromEvent);
		gate.addEventListener("focusin", trackFromEvent);
		applyMute();

		/* ── 等整站加载完再开门 ────────────────────────────────────────
		   开屏这块东西不轻：70vw/60vw 的大半径 blur 光斑在动、玻璃文字在跑
		   流光、按钮全是 backdrop-filter。要是它跟首屏抢主线程和合成层
		   （图片还在拉、字体还在换、引擎还在初始化），表现就是「卡」。
		   所以先把门关着，等到：
		     1) window load —— 图片 / 字体文件 / CSS / 脚本全部到手
		     2) document.fonts.ready —— 字体度量就绪，玻璃文字排版不跳
		     3) 站内 Loading 动画退场 —— 免得两层遮罩叠在一起
		   之后再让出两帧 + 一次空闲回调（等引擎把首帧画完），才真正开场。
		   兜底 6s：万一某个资源卡死，也不能把用户永远挡在门外。 */
		function whenPageReady(done) {
			var timers = [];
			var fired = false;
			function finish() {
				if (fired) return;
				fired = true;
				for (var i = 0; i < timers.length; i++) clearTimeout(timers[i]);
				done();
			}
			timers.push(setTimeout(finish, 6000)); /* 兜底 */

			var pending = 3;
			function oneDone() {
				if (--pending > 0) return;
				/* 让出两帧 + 一次空闲回调：等首帧渲染与引擎初始化跑完再开场 */
				requestAnimationFrame(function () {
					requestAnimationFrame(function () {
						if (typeof requestIdleCallback === "function") {
							timers.push(setTimeout(finish, 400)); /* idle 没回调时的兜底 */
							requestIdleCallback(finish, { timeout: 300 });
						} else {
							timers.push(setTimeout(finish, 80));
						}
					});
				});
			}

			/* 1) 全站资源加载完成 */
			if (document.readyState === "complete") oneDone();
			else window.addEventListener("load", oneDone, { once: true });

			/* 2) 字体就绪 */
			try {
				if (document.fonts && document.fonts.ready && document.fonts.ready.then) {
					document.fonts.ready.then(oneDone, oneDone);
				} else oneDone();
			} catch (e) {
				oneDone();
			}

			/* 3) 站内 Loading 动画已退场（它 600ms 后加 is-hidden） */
			var loader = document.getElementById("page-loader");
			if (!loader || loader.classList.contains("is-hidden")) {
				oneDone();
			} else {
				var tries = 0;
				var poll = setInterval(function () {
					if (!loader.isConnected || loader.classList.contains("is-hidden") || ++tries > 60) {
						clearInterval(poll);
						oneDone();
					}
				}, 100);
				timers.push(poll);
			}
		}

		function openGate() {
			/* 撤幕布、锁滚动都在这一帧：早锁会白白冻住页面，还可能干扰引擎测量 */
			gate.hidden = false;
			gate.classList.remove("is-cover");
			document.documentElement.style.overflow = "hidden";
			/* 下一帧再加 .is-shown，保证入场动画从头播
			   （万一用户在开门这一帧就把版本选完，别把状态留在门上） */
			requestAnimationFrame(function () {
				if (!gate.hidden) gate.classList.add("is-shown");
			});

			/* 开屏时序：.is-shown 启动三行文字的入场 + 流光；
			   4.5s 后 .is-ready 收起开屏、放出版本按钮；
			   期间点一下可立刻跳过（不打断正在播的背景动画）。 */
			var readyTimer = setTimeout(function () {
				gate.classList.add("is-ready");
			}, 4500);
			gate.addEventListener("click", function (e) {
				// 只有还没 ready、且点在开屏区域时才算「跳过」
				if (gate.classList.contains("is-ready")) return;
				if (e.target && e.target.closest && e.target.closest("[data-ver]")) return;
				if (e.target && e.target.closest && e.target.closest("[data-vg-mute]")) return;
				gate.classList.add("is-ready");
				if (readyTimer) clearTimeout(readyTimer);
			});
			// 键盘可达：回车 / 空格也能跳过开屏
			gate.addEventListener("keydown", function (e) {
				if (gate.classList.contains("is-ready")) return;
				if (e.key === "Enter" || e.key === " " || e.key === "Escape") {
					gate.classList.add("is-ready");
					if (readyTimer) clearTimeout(readyTimer);
				}
			});
		}

		/* ── 幕布期 ────────────────────────────────────────────────────
		   先用一块纯黑幕布 + 静态的 WELCOME 字顶上去（零动画：不画大半径
		   blur 光斑、不跑流光、按钮也不上），这样加载期间不露页面空档，
		   也不会跟首屏抢性能。真正的开场等整站就绪（见 whenPageReady）。 */
		gate.hidden = false;
		gate.classList.add("is-cover");
		document.documentElement.style.overflow = "hidden";

		whenPageReady(openGate);

		var soonTipTimer = 0;
		gate.addEventListener("click", function (e) {
			var btn = e.target && e.target.closest ? e.target.closest("[data-ver]") : null;
			if (!btn) return;
			var v = btn.getAttribute("data-ver");
			/* 占位档位（ProMaxPlusUltra / ULTRA）：只在面板底部回一句提示，
			   不写 localStorage、不切 body 类名，免得选出一个还不存在的版本。 */
			if (v === "ultra" || v === "promaxplusultra") {
				var tipEl = gate.querySelector("[data-vg-tip]");
				if (tipEl) {
					tipEl.textContent =
						v === "ultra"
							? "ULTRA 版还在路上，明年再说～"
							: "ProMaxPlusUltra 还在图纸上，先剧透一下～";
					if (soonTipTimer) clearTimeout(soonTipTimer);
					soonTipTimer = setTimeout(function () {
						tipEl.textContent = "";
					}, 2600);
				}
				return;
			}
			try {
				localStorage.setItem(KEY, v);
				localStorage.setItem("visualEffectMode", v === "lite" ? "none" : "rain");
			} catch (err) {}
			document.body.classList.remove("site-lite", "site-normal", "site-promax");
			document.body.classList.add("site-" + v);
			if (v === "lite") {
				// 立即关掉底部波浪
				try {
					localStorage.setItem("wavesEnabled", "false");
				} catch (err2) {}
				document.documentElement.setAttribute("data-waves-enabled", "false");
				var w = document.getElementById("header-waves");
				if (w) w.style.display = "none";
			} else {
				// 正常版 / ProMax：恢复精简时关掉的东西
				document.documentElement.removeAttribute("data-waves-enabled");
				var w2 = document.getElementById("header-waves");
				if (w2) w2.style.display = "";
			}
			// 导航岛沉底的 ProMax 版：收起按钮的箭头语义要反向，重建一次图标状态
			try {
				var resync = window.resetFullscreenNavbarState;
				if (typeof resync === "function") resync();
			} catch (err3) {}
			// 版本换了 → 归一化浮层方向（搜索面板 / 媒体详情 / 文章面板都按 body 类判断）
			try {
				document.dispatchEvent(new CustomEvent("siteversionchange", { detail: { ver: v } }));
			} catch (err4) {}
			gate.hidden = true;
			gate.classList.remove("is-cover", "is-shown", "is-ready");
			document.documentElement.style.overflow = "";
			/* 选完版本收门：背景音乐一并停掉 */
			if (audioEl) audioEl.pause();
			/* 解锁滚动后视口宽度会变化（滚动条回来了）→ 提醒玻璃引擎重新量一次 */
			try {
				window.dispatchEvent(new Event("resize"));
			} catch (err5) {}
			window.dispatchEvent(
				new CustomEvent("effectModeChange", { detail: { mode: v === "lite" ? "none" : "rain" } }),
			);
		});
	})();
</script>
