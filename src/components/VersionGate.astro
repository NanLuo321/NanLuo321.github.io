	/* 斜切高光 */
	.vg-btn::before {
		content: "";
		position: absolute;
		top: -100%;
		left: -60%;
		width: 45%;
		height: 300%;
		background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.35), transparent);
		transform: rotate(20deg);
		filter: blur(8px);
		transition: left 0.8s;
