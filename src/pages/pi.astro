---
// 完全独立的彩蛋页面，不使用任何布局
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>????</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html, body {
      width: 100%;
      height: 100%;
      background: #000;
      overflow: hidden;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
    }

    .mystery-page {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: #000;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1;
      margin: 0;
      padding: 0;
      overflow: hidden;
    }

    .mystery-page::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background:
        radial-gradient(ellipse at center, rgba(127, 0, 255, 0.08) 0%, transparent 70%),
        radial-gradient(ellipse at 20% 80%, rgba(0, 200, 255, 0.06) 0%, transparent 50%);
      pointer-events: none;
      z-index: 1;
    }

    /* 悬浮窗口式监控 */
    .monitor-window {
      position: fixed;
      width: 360px;
      height: 280px;
      background: #1a1a1a;
      border: 1px solid #333;
      border-radius: 8px;
      z-index: 200;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(255, 255, 255, 0.03);
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    .monitor-titlebar {
      height: 32px;
      background: linear-gradient(180deg, #2a2a2a 0%, #1f1f1f 100%);
      border-bottom: 1px solid #333;
      display: flex;
      align-items: center;
      padding: 0 12px;
      gap: 8px;
      flex-shrink: 0;
      cursor: move;
      user-select: none;
    }

    .monitor-titlebar:active {
      cursor: grabbing;
    }

    .monitor-dots {
      display: flex;
      gap: 6px;
    }

    .monitor-dot-btn {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: #555;
      cursor: pointer;
      transition: all 0.2s;
    }

    .monitor-dot-btn.close { background: #ff5f57; }
    .monitor-dot-btn.close:hover { filter: brightness(1.3); }
    .monitor-dot-btn.min { background: #febc2e; }
    .monitor-dot-btn.min:hover { filter: brightness(1.3); }
    .monitor-dot-btn.max { background: #28c840; }
    .monitor-dot-btn.max:hover { filter: brightness(1.3); }

    .monitor-title-text {
      flex: 1;
      text-align: center;
      font-size: 12px;
      color: #888;
      font-family: "Courier New", monospace;
      letter-spacing: 1px;
    }

    .monitor-record-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #ff0040;
      box-shadow: 0 0 6px #ff0040;
      animation: dot-blink 1.5s infinite;
      cursor: pointer;
      transition: all 0.2s;
      position: relative;
      z-index: 20;
    }

    .monitor-record-dot:hover {
      box-shadow: 0 0 12px #ff0040, 0 0 20px #ff0040;
      transform: scale(1.3);
    }

    @keyframes dot-blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.3; }
    }

    .monitor-body {
      flex: 1;
      position: relative;
      background: #0a0a0a;
      overflow: hidden;
    }

    .monitor-body::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: repeating-linear-gradient(
        0deg,
        rgba(0, 0, 0, 0.2),
        rgba(0, 0, 0, 0.2) 1px,
        transparent 1px,
        transparent 2px
      );
      pointer-events: none;
      z-index: 10;
    }

    /* 左上角窗口 */
    .monitor-1 {
      top: 40px;
      left: 40px;
    }

    .no-signal-content {
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: #555;
      font-family: "Courier New", monospace;
    }

    .no-signal-icon {
      font-size: 3rem;
      margin-bottom: 0.8rem;
      opacity: 0.5;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .no-signal-icon:hover {
      opacity: 1;
      transform: scale(1.1);
      filter: drop-shadow(0 0 8px rgba(0, 245, 255, 0.5));
    }

    .no-signal-text {
      font-size: 1rem;
      letter-spacing: 0.3em;
      color: #444;
    }

    /* 摄像头实时画面 */
    .cam-feed {
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      position: relative;
      z-index: 5;
    }

    .cam-feed video {
      flex: 1;
      width: 100%;
      height: 100%;
      object-fit: cover;
      background: #000;
      min-height: 0;
    }

    .cam-note {
      padding: 6px 8px;
      font-size: 10px;
      color: #888;
      font-family: "Courier New", monospace;
      text-align: center;
      background: rgba(0, 0, 0, 0.75);
      border-top: 1px solid #333;
      flex-shrink: 0;
      letter-spacing: 0.3px;
      line-height: 1.5;
    }

    .no-signal-line {
      width: 50%;
      height: 1px;
      background: #333;
      margin: 0.8rem 0;
    }

    /* 右上角窗口 */
    .monitor-2 {
      top: 40px;
      right: 40px;
    }

    .snow-canvas {
      width: 100%;
      height: 100%;
      display: block;
    }

    /* WHO ARE YOU 漂浮文字 */
    .floating-text-layer {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 999;
      pointer-events: none;
      overflow: hidden;
      display: none;
      background: rgba(0, 0, 0, 0.1);
    }

    .floating-text-layer.show {
      display: block;
    }

    .float-text {
      position: absolute;
      font-family: "Courier New", monospace;
      font-weight: 900;
      color: #ff0040;
      text-shadow: 0 0 10px rgba(255, 0, 64, 0.8), 0 0 20px rgba(255, 0, 64, 0.4);
      white-space: nowrap;
      user-select: none;
      opacity: 0;
      transform: scale(3);
      transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94), opacity 0.2s ease;
    }

    .float-text.show {
      opacity: 1;
      transform: scale(1);
    }

    .mystery-container {
      text-align: center;
      max-width: 500px;
      padding: 2rem;
      position: relative;
      z-index: 10;
    }

    .mystery-glitch {
      font-size: 2.8rem;
      font-weight: 900;
      letter-spacing: 0.3em;
      color: #fff;
      position: relative;
      animation: glitch-skew 4s infinite linear alternate-reverse;
      margin: 0 0 1rem;
    }

    .mystery-glitch::before,
    .mystery-glitch::after {
      content: attr(data-text);
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
    }

    .mystery-glitch::before {
      color: #ff006e;
      animation: glitch-anim 3s infinite linear alternate-reverse;
      clip-path: polygon(0 0, 100% 0, 100% 35%, 0 35%);
      transform: translate(-2px, -2px);
    }

    .mystery-glitch::after {
      color: #00f5ff;
      animation: glitch-anim2 2.5s infinite linear alternate-reverse;
      clip-path: polygon(0 65%, 100% 65%, 100% 100%, 0 100%);
      transform: translate(2px, 2px);
    }

    @keyframes glitch-anim {
      0% { clip-path: polygon(0 2%, 100% 2%, 100% 5%, 0 5%); }
      10% { clip-path: polygon(0 15%, 100% 15%, 100% 15%, 0 15%); }
      20% { clip-path: polygon(0 10%, 100% 10%, 100% 20%, 0 20%); }
      30% { clip-path: polygon(0 1%, 100% 1%, 100% 2%, 0 2%); }
      40% { clip-path: polygon(0 33%, 100% 33%, 100% 33%, 0 33%); }
      50% { clip-path: polygon(0 44%, 100% 44%, 100% 44%, 0 44%); }
      60% { clip-path: polygon(0 50%, 100% 50%, 100% 20%, 0 20%); }
      70% { clip-path: polygon(0 70%, 100% 70%, 100% 70%, 0 70%); }
      80% { clip-path: polygon(0 80%, 100% 80%, 100% 80%, 0 80%); }
      90% { clip-path: polygon(0 50%, 100% 50%, 100% 55%, 0 55%); }
      100% { clip-path: polygon(0 70%, 100% 70%, 100% 80%, 0 80%); }
    }

    @keyframes glitch-anim2 {
      0% { clip-path: polygon(0 25%, 100% 25%, 100% 30%, 0 30%); }
      15% { clip-path: polygon(0 3%, 100% 3%, 100% 3%, 0 3%); }
      25% { clip-path: polygon(0 20%, 100% 20%, 100% 20%, 0 20%); }
      35% { clip-path: polygon(0 40%, 100% 40%, 100% 40%, 0 40%); }
      45% { clip-path: polygon(0 52%, 100% 52%, 100% 54%, 0 54%); }
      55% { clip-path: polygon(0 60%, 100% 60%, 100% 60%, 0 60%); }
      65% { clip-path: polygon(0 75%, 100% 75%, 100% 75%, 0 75%); }
      75% { clip-path: polygon(0 85%, 100% 85%, 100% 85%, 0 85%); }
      85% { clip-path: polygon(0 65%, 100% 65%, 100% 67%, 0 67%); }
      100% { clip-path: polygon(0 35%, 100% 35%, 100% 40%, 0 40%); }
    }

    @keyframes glitch-skew {
      0% { transform: skew(0deg); }
      10% { transform: skew(0.5deg); }
      20% { transform: skew(-0.5deg); }
      30% { transform: skew(0.3deg); }
      40% { transform: skew(-0.3deg); }
      50% { transform: skew(0deg); }
      100% { transform: skew(0deg); }
    }

    .mystery-sub {
      color: #666;
      font-size: 0.9rem;
      letter-spacing: 0.2em;
      margin-bottom: 2rem;
      animation: fade-in-out 3s ease-in-out infinite;
    }

    @keyframes fade-in-out {
      0%, 100% { opacity: 0.4; }
      50% { opacity: 1; }
    }

    .mystery-divider {
      width: 60%;
      height: 1px;
      margin: 1.5rem auto;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
    }

    .mystery-text {
      color: #aaa;
      font-size: 0.95rem;
      line-height: 2.2;
      margin: 2rem 0;
    }

    .mystery-text p {
      margin: 0.5rem 0;
      opacity: 0;
      animation: text-appear 0.8s ease forwards;
    }

    .mystery-text p:nth-child(1) { animation-delay: 0.3s; }
    .mystery-text p:nth-child(2) { animation-delay: 0.8s; }
    .mystery-text p:nth-child(3) { animation-delay: 1.3s; }
    .mystery-text p:nth-child(4) { animation-delay: 1.8s; }

    @keyframes text-appear {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .mystery-flicker {
      color: #ff006e;
      animation: flicker 2s infinite;
    }

    @keyframes flicker {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
      75% { opacity: 0.8; }
    }

    .mystery-questions {
      display: flex;
      justify-content: center;
      gap: 1rem;
      margin: 2rem 0;
      font-size: 1.5rem;
      color: #333;
    }

    .mystery-questions span {
      color: #ff0040;
      text-shadow: 0 0 12px rgba(255, 0, 64, 0.7);
    }

    /* 回去吧按钮 */
    .mystery-back {
      position: fixed;
      display: inline-block;
      padding: 0.8rem 2rem;
      color: #666;
      text-decoration: none;
      border: 1px solid #333;
      border-radius: 4px;
      font-size: 0.9rem;
      letter-spacing: 0.1em;
      transition: all 0.3s ease;
      opacity: 0;
      animation: btn-appear 0.8s ease forwards;
      animation-delay: 2.5s;
      cursor: pointer;
      user-select: none;
      z-index: 50;
      left: 50%;
      bottom: 15%;
      transform: translateX(-50%);
      white-space: nowrap;
    }

    @keyframes btn-appear {
      from { opacity: 0; transform: translateX(-50%) translateY(10px); }
      to { opacity: 1; transform: translateX(-50%) translateY(0); }
    }

    .mystery-back:hover {
      color: #fff;
      border-color: #ff006e;
      box-shadow: 0 0 20px rgba(255, 0, 110, 0.3);
    }

    /* ===== 进入警告框 ===== */
    .enter-warning {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.93);
      z-index: 999999;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: "Courier New", monospace;
    }

    .warning-box {
      text-align: center;
      padding: 2.5rem 3rem;
      border: 1px solid rgba(255,0,64,0.5);
      border-radius: 8px;
      background: linear-gradient(180deg, #1a0000 0%, #000 100%);
      box-shadow: 0 0 50px rgba(255,0,64,0.25), inset 0 0 30px rgba(0,0,0,0.6);
      max-width: 440px;
      animation: warning-in 0.6s ease;
    }

    @keyframes warning-in {
      from { opacity: 0; transform: scale(0.92); }
      to { opacity: 1; transform: scale(1); }
    }

    .warning-icon {
      font-size: 3rem;
      color: #ff0040;
      margin-bottom: 1rem;
      text-shadow: 0 0 18px rgba(255,0,64,0.8);
      animation: warning-pulse 2s ease-in-out infinite;
    }

    @keyframes warning-pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }

    .warning-title {
      color: #ff0040;
      font-size: 1.4rem;
      font-weight: bold;
      letter-spacing: 0.15em;
      margin-bottom: 1rem;
    }

    .warning-text {
      color: #888;
      font-size: 0.9rem;
      line-height: 1.9;
      margin-bottom: 2rem;
    }

    .warning-buttons {
      display: flex;
      gap: 1rem;
      justify-content: center;
    }

    .warning-btn {
      padding: 0.7rem 2.4rem;
      border: 1px solid #444;
      background: transparent;
      color: #ccc;
      font-size: 0.95rem;
      cursor: pointer;
      text-decoration: none;
      border-radius: 4px;
      font-family: "Courier New", monospace;
      letter-spacing: 0.15em;
      transition: all 0.25s ease;
    }

    .warning-yes {
      border-color: #ff0040;
      color: #ff0040;
    }

    .warning-yes:hover {
      background: #ff0040;
      color: #000;
      box-shadow: 0 0 22px rgba(255,0,64,0.55);
    }

    .warning-home:hover {
      border-color: #aaa;
      color: #fff;
    }

    /* ===== 恐怖氛围增强 ===== */

    /* 跟随鼠标的注视眼睛 */
    .watch-eyes {
      position: fixed;
      top: 0; left: 0;
      width: 100%; height: 100%;
      pointer-events: none;
      z-index: 5;
    }

    .eye {
      position: absolute;
      width: 88px;
      height: 42px;
      background: radial-gradient(ellipse at center, #200000 0%, #000 85%);
      border-radius: 50%;
      border: 1px solid rgba(255,0,0,0.12);
      overflow: hidden;
      box-shadow: 0 0 35px rgba(255,0,0,0.28), inset 0 0 22px #000;
      opacity: 0;
      transition: opacity 2s ease;
    }

    .eye.show { opacity: 0.92; }

    .pupil {
      position: absolute;
      top: 50%; left: 50%;
      width: 14px; height: 14px;
      background: radial-gradient(circle at 35% 35%, #ff5a5a 0%, #cc0000 45%, #400000 100%);
      border-radius: 50%;
      transform: translate(-50%, -50%);
      box-shadow: 0 0 14px #ff0000;
      will-change: transform;
    }

    /* 屏幕边缘心跳脉动 */
    .heartbeat-vignette {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 4;
      box-shadow: inset 0 0 120px 40px rgba(120,0,0,0);
      transition: box-shadow 0.18s ease;
    }

    .heartbeat-vignette.beat {
      box-shadow: inset 0 0 200px 70px rgba(150,0,0,0.6);
    }

    /* 血色闪光 */
    .blood-flash {
      position: fixed;
      inset: 0;
      background: rgba(120,0,0,0);
      pointer-events: none;
      z-index: 600;
      transition: background 0.07s ease;
    }

    .blood-flash.flash {
      background: rgba(255,0,0,0.78);
    }

    /* 鬼影闪现 */
    .ghost-figure {
      position: fixed;
      pointer-events: none;
      z-index: 150;
      opacity: 0;
      width: 170px;
      height: 340px;
      filter: blur(3px) brightness(0.25) contrast(1.4);
      transition: opacity 0.1s ease;
      will-change: opacity, transform;
    }

    .ghost-figure.show { opacity: 0.85; }

    @media (max-width: 768px) {
      .monitor-window {
        width: 260px;
        height: 200px;
      }
      .monitor-1 { top: 20px; left: 20px; }
      .monitor-2 { top: 20px; right: 20px; }

      .mystery-glitch {
        font-size: 1.8rem;
        letter-spacing: 0.2em;
      }

      .mystery-container {
        padding: 1rem;
      }

      .mystery-text {
        font-size: 0.85rem;
      }
    }
  </style>
</head>
<body>
  <!-- 进入警告 -->
  <div class="enter-warning" id="enterWarning">
    <div class="warning-box">
      <div class="warning-icon">⚠</div>
      <div class="warning-title">本页面带有恐怖元素</div>
      <div class="warning-text">包含闪烁画面、注视效果与低频声响，可能引起不适。<br>是否继续？</div>
      <div class="warning-buttons">
        <button class="warning-btn warning-yes" id="warningYes">是</button>
        <a href="/" class="warning-btn warning-home">主页</a>
      </div>
    </div>
  </div>

  <!-- 监控窗口1：无信号（左上角） -->
  <div class="monitor-window monitor-1" id="monitor1">
    <div class="monitor-titlebar" data-drag-handle="monitor1">
      <div class="monitor-dots">
        <div class="monitor-dot-btn close" onclick="showWhoText(event, true)"></div>
        <div class="monitor-dot-btn min"></div>
        <div class="monitor-dot-btn max"></div>
      </div>
      <div class="monitor-title-text">CAM-01 — SURVEILLANCE</div>
      <div class="monitor-record-dot" id="monitorDot1" title="点我？" onclick="showWhoText(event, false)"></div>
    </div>
    <div class="monitor-body">
      <div class="no-signal-content" id="noSignalContent1">
        <svg class="no-signal-icon" id="tvIcon1" title="点我开启摄像头" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" style="width:3rem;height:3rem;">
          <rect x="28" y="40" width="8" height="14" fill="currentColor"/>
          <rect x="20" y="52" width="24" height="4" rx="2" fill="currentColor"/>
          <rect x="10" y="18" width="38" height="20" rx="3" fill="currentColor"/>
          <rect x="46" y="24" width="8" height="8" rx="2" fill="currentColor"/>
          <circle cx="38" cy="28" r="7" fill="#000"/>
          <circle cx="38" cy="28" r="4.5" fill="currentColor"/>
          <circle cx="36" cy="26" r="1.5" fill="#000" opacity="0.5"/>
          <circle cx="16" cy="24" r="1.5" fill="#ff0040"/>
        </svg>
        <div class="no-signal-line"></div>
        <div class="no-signal-text">NO SIGNAL</div>
      </div>
      <div class="cam-feed" id="camFeed1" style="display: none;">
        <video id="camVideo1" autoplay playsinline muted></video>
        <div class="cam-note">此视频不会上传到任何网站包括设备 刷新网页后什么都没发生。</div>
      </div>
    </div>
  </div>

  <!-- 监控窗口2：雪花（右上角） -->
  <div class="monitor-window monitor-2" id="monitor2">
    <div class="monitor-titlebar" data-drag-handle="monitor2">
      <div class="monitor-dots">
        <div class="monitor-dot-btn close" onclick="showWhoText(event, true)"></div>
        <div class="monitor-dot-btn min"></div>
        <div class="monitor-dot-btn max"></div>
      </div>
      <div class="monitor-title-text">CAM-02 — SURVEILLANCE</div>
      <div class="monitor-record-dot" id="monitorDot2" title="点我？" onclick="showWhoText(event, false)"></div>
    </div>
    <div class="monitor-body">
      <canvas class="snow-canvas" id="snowCanvas"></canvas>
    </div>
  </div>

  <!-- WHO ARE YOU 漂浮文字层 -->
  <div class="floating-text-layer" id="floatingTextLayer"></div>

  <!-- 恐怖氛围层 -->
  <div class="heartbeat-vignette" id="heartbeatVignette"></div>
  <div class="blood-flash" id="bloodFlash"></div>
  <div class="watch-eyes" id="watchEyes"></div>
  <svg class="ghost-figure" id="ghostFigure" viewBox="0 0 100 200" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <ellipse cx="50" cy="26" rx="17" ry="21" fill="#0a0a0a"/>
    <path d="M33,46 Q29,82 31,124 Q33,165 41,200 L59,200 Q67,165 69,124 Q71,82 67,46 Z" fill="#0a0a0a"/>
  </svg>

  <div class="mystery-page">
    <div class="mystery-container">
      <h1 class="mystery-glitch" data-text="你不该来这里的">你不该来这里的</h1>
      <p class="mystery-sub">...它已经看见你了...</p>

      <div class="mystery-divider"></div>

      <div class="mystery-text">
        <p>这里埋着不该被看见的东西。</p>
        <p>你每多看一秒，它就离你更近一点。</p>
        <p>别回头。</p>
        <p class="mystery-flicker">它就在屏幕后面...看着你。</p>
      </div>

      <div class="mystery-questions">
        <span>?</span>
        <span>?</span>
        <span>?</span>
        <span>?</span>
      </div>
    </div>
  </div>

  <!-- 回去吧按钮（全屏移动） -->
  <a href="/" class="mystery-back" id="mysteryBackBtn">← 回去吧</a>

  <script>
    // 雪花效果
    (function() {
      const canvas = document.getElementById('snowCanvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');

      function resizeCanvas() {
        canvas.width = canvas.offsetWidth;
        canvas.height = canvas.offsetHeight;
      }
      resizeCanvas();
      window.addEventListener('resize', resizeCanvas);

      function drawNoise() {
        const w = canvas.width;
        const h = canvas.height;
        const imageData = ctx.createImageData(w, h);
        const data = imageData.data;

        for (let i = 0; i < data.length; i += 4) {
          const noise = Math.random() * 255;
          data[i] = noise;
          data[i + 1] = noise;
          data[i + 2] = noise;
          data[i + 3] = 255;
        }

        ctx.putImageData(imageData, 0, 0);
        requestAnimationFrame(drawNoise);
      }
      drawNoise();
    })();

    // 电视图标点击 - 调取设备摄像头（本地，不上传）
    (function() {
      var tvIcon = document.getElementById('tvIcon1');
      if (!tvIcon) return;

      var camStream = null;
      var camActive = false;

      function startCamera() {
        if (camActive) return;

        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
          alert('当前浏览器不支持摄像头调用');
          return;
        }

        navigator.mediaDevices.getUserMedia({ video: true, audio: false })
          .then(function(stream) {
            camStream = stream;
            camActive = true;
            var noSignal = document.getElementById('noSignalContent1');
            var camFeed = document.getElementById('camFeed1');
            var video = document.getElementById('camVideo1');
            if (noSignal) noSignal.style.display = 'none';
            if (camFeed) camFeed.style.display = 'flex';
            if (video) video.srcObject = stream;
          })
          .catch(function(err) {
            alert('无法访问摄像头：' + (err.message || '权限被拒绝'));
          });
      }

      tvIcon.addEventListener('click', startCamera);
    })();

    // 监控窗口拖拽
    (function() {
      const handles = document.querySelectorAll('[data-drag-handle]');
      let dragTarget = null;
      let offsetX = 0;
      let offsetY = 0;

      handles.forEach(function(handle) {
        handle.addEventListener('mousedown', function(e) {
          // 如果点到了录制灯，不触发拖拽
          if (e.target.classList.contains('monitor-record-dot')) return;
          if (e.target.closest('.monitor-dots')) return;

          const winId = handle.getAttribute('data-drag-handle');
          dragTarget = document.getElementById(winId);
          if (!dragTarget) return;

          const rect = dragTarget.getBoundingClientRect();
          offsetX = e.clientX - rect.left;
          offsetY = e.clientY - rect.top;

          // 把当前窗口置顶
          dragTarget.style.zIndex = 300;
          const other = dragTarget.id === 'monitor1' ? document.getElementById('monitor2') : document.getElementById('monitor1');
          if (other) other.style.zIndex = 200;

          e.preventDefault();
        });
      });

      document.addEventListener('mousemove', function(e) {
        if (!dragTarget) return;

        let newX = e.clientX - offsetX;
        let newY = e.clientY - offsetY;

        // 边界限制
        const winW = dragTarget.offsetWidth;
        const winH = dragTarget.offsetHeight;
        newX = Math.max(0, Math.min(window.innerWidth - winW, newX));
        newY = Math.max(0, Math.min(window.innerHeight - winH, newY));

        dragTarget.style.left = newX + 'px';
        dragTarget.style.top = newY + 'px';
        dragTarget.style.right = 'auto';
        dragTarget.style.bottom = 'auto';
      });

      document.addEventListener('mouseup', function() {
        dragTarget = null;
      });

      // 触摸支持
      handles.forEach(function(handle) {
        handle.addEventListener('touchstart', function(e) {
          if (e.target.classList.contains('monitor-record-dot')) return;
          if (e.target.closest('.monitor-dots')) return;

          const winId = handle.getAttribute('data-drag-handle');
          dragTarget = document.getElementById(winId);
          if (!dragTarget) return;

          const touch = e.touches[0];
          const rect = dragTarget.getBoundingClientRect();
          offsetX = touch.clientX - rect.left;
          offsetY = touch.clientY - rect.top;

          dragTarget.style.zIndex = 300;
          const other = dragTarget.id === 'monitor1' ? document.getElementById('monitor2') : document.getElementById('monitor1');
          if (other) other.style.zIndex = 200;
        });
      });

      document.addEventListener('touchmove', function(e) {
        if (!dragTarget) return;
        const touch = e.touches[0];
        let newX = touch.clientX - offsetX;
        let newY = touch.clientY - offsetY;

        const winW = dragTarget.offsetWidth;
        const winH = dragTarget.offsetHeight;
        newX = Math.max(0, Math.min(window.innerWidth - winW, newX));
        newY = Math.max(0, Math.min(window.innerHeight - winH, newY));

        dragTarget.style.left = newX + 'px';
        dragTarget.style.top = newY + 'px';
        dragTarget.style.right = 'auto';
        dragTarget.style.bottom = 'auto';
      });

      document.addEventListener('touchend', function() {
        dragTarget = null;
      });
    })();

    // 回去吧按钮躲避逻辑
    (function() {
      const backBtn = document.getElementById('mysteryBackBtn');
      if (!backBtn) return;

      let dodgeCount = 0;
      const maxDodges = 9;
      let currentX = 0;
      let currentY = 0;
      let initialized = false;

      function getInitialPos() {
        const rect = backBtn.getBoundingClientRect();
        currentX = rect.left;
        currentY = rect.top;
      }

      function dodge() {
        if (dodgeCount >= maxDodges) return;

        if (!initialized) {
          getInitialPos();
          initialized = true;
        }

        dodgeCount++;

        const btnRect = backBtn.getBoundingClientRect();
        const btnWidth = btnRect.width;
        const btnHeight = btnRect.height;
        const maxX = window.innerWidth - btnWidth - 20;
        const maxY = window.innerHeight - btnHeight - 20;
        const minX = 20;
        const minY = 20;

        let newX = Math.random() * (maxX - minX) + minX;
        let newY = Math.random() * (maxY - minY) + minY;

        const minDist = 150;
        const dist = Math.sqrt((newX - currentX) ** 2 + (newY - currentY) ** 2);
        if (dist < minDist) {
          newX = currentX + (Math.random() > 0.5 ? 1 : -1) * (minDist + Math.random() * 100);
          newY = currentY + (Math.random() > 0.5 ? 1 : -1) * (minDist + Math.random() * 100);
          newX = Math.max(minX, Math.min(maxX, newX));
          newY = Math.max(minY, Math.min(maxY, newY));
        }

        currentX = newX;
        currentY = newY;

        backBtn.style.transition = 'left 0.2s ease-out, top 0.2s ease-out, color 0.3s, border-color 0.3s, box-shadow 0.3s';
        backBtn.style.left = currentX + 'px';
        backBtn.style.top = currentY + 'px';
        backBtn.style.transform = 'none';
        backBtn.style.bottom = 'auto';

        if (dodgeCount === maxDodges) {
          setTimeout(function() {
            backBtn.textContent = '你不应该在这里';
            backBtn.style.color = '#ff006e';
            backBtn.style.borderColor = '#ff006e';
            backBtn.style.transition = 'all 0.3s ease';
          }, 200);
        }
      }

      backBtn.addEventListener('mouseover', dodge);

      backBtn.addEventListener('click', function(e) {
        if (dodgeCount < maxDodges) {
          e.preventDefault();
          dodge();
        }
      });
    })();

    // 点击录制灯 - 满屏弹出 WHO ARE YOU
    // 点击关闭按钮 - 显示"你为什么关闭？"
    var whoTexts = ['WHO ARE YOU?', '你是谁？', 'IDENTIFY YOURSELF', 'UNKNOWN ENTITY', '???', 'WHO IS THERE?', 'SHOW YOURSELF', 'WHO?'];
    var whoColors = ['#ff0040', '#ff006e', '#ff3366', '#cc0033', '#ff4444', '#ff1a4d'];
    var whoActive = false;
    var whoAutoHideTimer = null;

    window.showWhoText = function(e, isClose) {
      e.preventDefault();
      e.stopPropagation();

      if (whoActive) return;
      whoActive = true;

      var layer = document.getElementById('floatingTextLayer');
      if (!layer) return;

      layer.innerHTML = '';
      layer.style.display = 'block';
      layer.style.opacity = '1';
      layer.style.background = 'rgba(0,0,0,0.6)';
      layer.style.zIndex = '99999';

      var contentText = isClose ? '你为什么关闭？' : null;
      var contentColor = isClose ? '#ff0040' : null;

      // 一个一个弹出，无缩放动画
      for (var i = 0; i < 260; i++) {
        (function(idx) {
          setTimeout(function() {
            if (!whoActive) return;

            var text = document.createElement('div');
            text.style.position = 'absolute';
            text.style.fontFamily = '"Courier New", monospace';
            text.style.fontWeight = 'bold';
            text.style.color = contentColor || whoColors[Math.floor(Math.random() * whoColors.length)];
            text.style.textShadow = '0 0 6px rgba(255,0,64,0.8)';
            text.style.whiteSpace = 'nowrap';
            text.style.pointerEvents = 'none';
            text.style.fontStyle = 'italic';
            text.textContent = contentText || whoTexts[Math.floor(Math.random() * whoTexts.length)];

            var fontSize = 7 + Math.random() * 11;
            text.style.fontSize = fontSize + 'px';
            text.style.top = (Math.random() * 96 + 2) + '%';
            text.style.left = (Math.random() * 96 + 2) + '%';

            var rotate = (Math.random() * 60 - 30);
            text.style.transformOrigin = 'center';
            text.style.transform = 'scale(1) rotate(' + rotate + 'deg)';
            text.style.opacity = '1';

            layer.appendChild(text);
          }, idx * 14);
        })(i);
      }

      // 5秒后直接消失，无关闭动画
      if (whoAutoHideTimer) clearTimeout(whoAutoHideTimer);
      whoAutoHideTimer = setTimeout(function() {
        whoActive = false;
        layer.style.display = 'none';
        layer.style.opacity = '';
        layer.style.transition = '';
        layer.style.background = '';
        layer.innerHTML = '';
      }, 5000);
    };

    // ===== 恐怖氛围（确认进入后启动） =====
    window.startHorror = function() {
      // 跟随鼠标的注视眼睛
      var eyesLayer = document.getElementById('watchEyes');
      if (eyesLayer) {
        var eyePositions = [
          { x: 6, y: 14 },
          { x: 84, y: 9 },
          { x: 18, y: 80 },
          { x: 74, y: 84 },
          { x: 48, y: 90 }
        ];
        var eyes = [];
        eyePositions.forEach(function(pos, i) {
          var eye = document.createElement('div');
          eye.className = 'eye';
          eye.style.left = pos.x + '%';
          eye.style.top = pos.y + '%';
          var pupil = document.createElement('div');
          pupil.className = 'pupil';
          eye.appendChild(pupil);
          eyesLayer.appendChild(eye);
          eyes.push({ el: eye, pupil: pupil });
          setTimeout(function() { eye.classList.add('show'); }, 2200 + i * 900);
        });

        document.addEventListener('mousemove', function(e) {
          var mx = e.clientX, my = e.clientY;
          eyes.forEach(function(item) {
            var rect = item.el.getBoundingClientRect();
            var cx = rect.left + rect.width / 2;
            var cy = rect.top + rect.height / 2;
            var dx = mx - cx, dy = my - cy;
            var dist = Math.sqrt(dx * dx + dy * dy);
            var nx = dist > 0 ? dx / dist : 0;
            var ny = dist > 0 ? dy / dist : 0;
            var move = Math.min(13, dist / 28);
            item.pupil.style.transform = 'translate(-50%, -50%) translate(' + (nx * move) + 'px,' + (ny * move) + 'px)';
          });
        });
      }

      // 心跳脉动
      var vig = document.getElementById('heartbeatVignette');
      if (vig) {
        function beat() {
          vig.classList.add('beat');
          setTimeout(function() { vig.classList.remove('beat'); }, 170);
          setTimeout(function() {
            vig.classList.add('beat');
            setTimeout(function() { vig.classList.remove('beat'); }, 170);
          }, 300);
        }
        setTimeout(beat, 1600);
        setInterval(beat, 2300);
      }

      // 随机血色闪光
      var flash = document.getElementById('bloodFlash');
      if (flash) {
        function randomFlash() {
          flash.classList.add('flash');
          setTimeout(function() { flash.classList.remove('flash'); }, 65);
          setTimeout(randomFlash, 4500 + Math.random() * 9000);
        }
        setTimeout(randomFlash, 7000);
      }

      // 鬼影闪现
      var ghost = document.getElementById('ghostFigure');
      if (ghost) {
        function appear() {
          var x = 8 + Math.random() * 72;
          var y = 8 + Math.random() * 45;
          var scale = 0.55 + Math.random() * 0.85;
          ghost.style.left = x + '%';
          ghost.style.top = y + '%';
          ghost.style.transform = 'scale(' + scale + ')';
          ghost.classList.add('show');
          setTimeout(function() { ghost.classList.remove('show'); }, 130 + Math.random() * 180);
          setTimeout(appear, 5500 + Math.random() * 11000);
        }
        setTimeout(appear, 9000);
      }

      // 低频嗡鸣 + 心跳低音（用户已确认进入，直接启动）
      try {
        var AC = window.AudioContext || window.webkitAudioContext;
        if (AC) {
          var ctx = new AC();
          var osc1 = ctx.createOscillator();
          var osc2 = ctx.createOscillator();
          var gain = ctx.createGain();
          osc1.type = 'sine';
          osc1.frequency.value = 41;
          osc2.type = 'sawtooth';
          osc2.frequency.value = 42.7;
          gain.gain.value = 0.035;
          osc1.connect(gain);
          osc2.connect(gain);
          gain.connect(ctx.destination);
          osc1.start();
          osc2.start();

          setInterval(function() {
            var o = ctx.createOscillator();
            var g = ctx.createGain();
            o.type = 'sine';
            o.frequency.value = 58;
            var t = ctx.currentTime;
            g.gain.setValueAtTime(0, t);
            g.gain.linearRampToValueAtTime(0.09, t + 0.03);
            g.gain.linearRampToValueAtTime(0, t + 0.35);
            o.connect(g);
            g.connect(ctx.destination);
            o.start();
            o.stop(t + 0.4);
          }, 2300);
        }
      } catch (e) {}
    };

    // 进入警告框：点击"是"后才启动恐怖效果与声音
    var warning = document.getElementById('enterWarning');
    var yesBtn = document.getElementById('warningYes');
    if (warning && yesBtn) {
      yesBtn.addEventListener('click', function() {
        warning.style.transition = 'opacity 0.4s ease';
        warning.style.opacity = '0';
        setTimeout(function() {
          warning.style.display = 'none';
        }, 400);
        if (window.startHorror) window.startHorror();
      });
    }
  </script>
</body>
</html>
