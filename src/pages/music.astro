---
import { Icon } from "astro-icon/components";
import MusicPlayer from "@/components/features/MusicPlayer.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
---

<MainGridLayout title={i18n(I18nKey.music)} description={i18n(I18nKey.music)}>
    <div class="music-page-container w-full max-w-3xl mx-auto">
        <!-- 页面标题 -->
        <div class="music-page-header flex items-center gap-3 mb-6 px-1">
            <div class="w-12 h-12 rounded-full bg-(--primary)/10 flex items-center justify-center shrink-0">
                <Icon is:inline name="material-symbols:music-note-rounded" class="text-2xl text-(--primary)" />
            </div>
            <div>
                <h1 class="text-2xl font-bold text-neutral-800 dark:text-neutral-100 leading-tight">
                    {i18n(I18nKey.music)}
                </h1>
                <p class="text-sm text-neutral-500 dark:text-neutral-400">
                    {i18n(I18nKey.musicPlaylist)}
                </p>
            </div>
        </div>

        <!-- 音乐播放器卡片 -->
        <div class="music-page-card card-base rounded-(--radius-large) p-6 md:p-8 relative overflow-hidden">
            <!-- 装饰性背景渐变 -->
            <div class="music-page-glow absolute -top-20 -right-20 w-64 h-64 rounded-full bg-(--primary)/8 blur-3xl pointer-events-none"></div>
            <div class="music-page-glow absolute -bottom-20 -left-20 w-64 h-64 rounded-full bg-(--primary)/5 blur-3xl pointer-events-none"></div>

            <!-- 播放器主体 -->
            <div class="music-player-wrapper relative z-10">
                <MusicPlayer class="music-page-player" />
            </div>
        </div>
    </div>
</MainGridLayout>

<style>
    .music-page-card {
        transition: box-shadow 0.36s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .music-page-card:hover {
        box-shadow: 0 8px 40px rgba(0, 0, 0, 0.08);
    }

    :root.dark .music-page-card:hover {
        box-shadow: 0 8px 40px rgba(0, 0, 0, 0.3);
    }

    /* 放大播放器内部元素 */
    .music-page-player :global(.music-cover) {
        width: 6rem !important;
        height: 6rem !important;
    }

    .music-page-player :global(.music-title) {
        font-size: 1.25rem !important;
    }

    .music-page-player :global(.music-artist) {
        font-size: 0.875rem !important;
    }

    .music-page-player :global(.btn-play) {
        width: 3.5rem !important;
        height: 3.5rem !important;
    }

    .music-page-player :global(.btn-play .icon-play),
    .music-page-player :global(.btn-play .icon-pause) {
        font-size: 2rem !important;
    }

    .music-page-player :global(.lrc-container) {
        height: 16rem !important;
    }

    .music-page-player :global(.playlist-container) {
        max-height: 20rem !important;
    }

    /* 进度条加粗 */
    .music-page-player :global(.progress-container) {
        height: 0.375rem !important;
    }

    /* 音量条加宽 */
    .music-page-player :global(.vol-container) {
        width: 8rem !important;
    }

    /* 响应式 */
    @media (max-width: 640px) {
        .music-page-player :global(.music-cover) {
            width: 4rem !important;
            height: 4rem !important;
        }

        .music-page-player :global(.btn-play) {
            width: 3rem !important;
            height: 3rem !important;
        }
    }
</style>
