---
import { Icon } from "astro-icon/components";
import MusicPlayer from "@/components/features/MusicPlayer.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
---

<MainGridLayout title={i18n(I18nKey.music)} description={i18n(I18nKey.music)}>
	<div class="music-page-container w-full max-w-3xl mx-auto">
		<div class="music-page-header flex items-center gap-3 mb-6 px-1">
			<div class="w-12 h-12 rounded-full bg-white/10 backdrop-blur-md border border-white/10 flex items-center justify-center shrink-0">
				<Icon is:inline name="material-symbols:music-note-rounded" class="text-2xl text-white/85" />
			</div>
			<div>
				<h1 class="text-2xl font-bold text-white/90 leading-tight">
					{i18n(I18nKey.music)}
				</h1>
				<p class="text-sm text-white/50">
					雨幕会在背景里轻轻落下
				</p>
			</div>
		</div>

		<div class="music-page-card relative overflow-hidden rounded-(--radius-large) p-6 md:p-8">
			<div class="music-page-glow music-page-glow-a"></div>
			<div class="music-page-glow music-page-glow-b"></div>

			<div class="relative z-10">
				<MusicPlayer class="music-page-player" />
			</div>
		</div>
	</div>
</MainGridLayout>

<style>
	.music-page-container {
		color: rgba(255, 255, 255, 0.9);
	}

	.music-page-card {
		border: 1px solid rgba(255, 255, 255, 0.12);
		background:
			linear-gradient(145deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.04)),
			rgba(8, 10, 20, 0.52);
		backdrop-filter: blur(18px);
		box-shadow: 0 24px 70px rgba(0, 0, 0, 0.36);
	}

	.music-page-glow {
		position: absolute;
		width: 16rem;
		height: 16rem;
		border-radius: 9999px;
		filter: blur(52px);
		pointer-events: none;
	}

	.music-page-glow-a {
		top: -6rem;
		right: -5rem;
		background: rgba(120, 170, 255, 0.18);
	}

	.music-page-glow-b {
		left: -5rem;
		bottom: -7rem;
		background: rgba(80, 220, 255, 0.12);
	}

	.music-page-player {
		color: rgba(255, 255, 255, 0.9);
	}

	.music-page-player :global(.music-cover) {
		width: 6rem !important;
		height: 6rem !important;
	}

	.music-page-player :global(.music-title) {
		color: #fff !important;
		font-size: 1.25rem !important;
	}

	.music-page-player :global(.music-artist),
	.music-page-player :global(.current-time),
	.music-page-player :global(.total-time) {
		color: rgba(255, 255, 255, 0.55) !important;
	}

	.music-page-player :global(.btn-play) {
		width: 3.5rem !important;
		height: 3.5rem !important;
		background: rgba(255, 255, 255, 0.16) !important;
		color: #fff !important;
		backdrop-filter: blur(12px);
	}

	.music-page-player :global(.progress-container),
	.music-page-player :global(.vol-container) {
		background: rgba(255, 255, 255, 0.16) !important;
	}

	.music-page-player :global(.btn-prev),
	.music-page-player :global(.btn-next),
	.music-page-player :global(.btn-repeat),
	.music-page-player :global(.btn-drawer-toggle),
	.music-page-player :global(.btn-lrc-toggle),
	.music-page-player :global(.btn-mute) {
		color: rgba(255, 255, 255, 0.7) !important;
	}

	.music-page-player :global(.lrc-container) {
		height: 16rem !important;
		color: rgba(255, 255, 255, 0.72);
	}

	.music-page-player :global(.playlist-container) {
		max-height: 20rem !important;
		color: rgba(255, 255, 255, 0.72);
	}

	.music-page-player :global(.playlist-item:hover) {
		background: rgba(255, 255, 255, 0.1) !important;
	}

	.music-page-player :global(.music-loading) {
		background: rgba(0, 0, 0, 0.52) !important;
	}

	@media (max-width: 640px) {
		.music-page-player :global(.music-cover) {
			width: 4rem !important;
			height: 4rem !important;
		}

		.music-page-player :global(.btn-play) {
			width: 3rem !important;
			height: 3rem !important;
		}
	}
</style>
