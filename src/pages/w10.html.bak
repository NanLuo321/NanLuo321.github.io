








<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Windows 10</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; user-select: none; }
  html, body {
    width: 100%; height: 100%; overflow: hidden;
    font-family: "Segoe UI", "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
    font-size: 14px;
    color: #fff;
    background: #0078d7;
  }

  /* ===== 桌面壁纸（Win10 蓝色光效） ===== */
  .desktop {
    position: fixed; inset: 0;
    background:
      radial-gradient(ellipse at 30% 40%, rgba(100, 180, 255, 0.35) 0%, transparent 55%),
      radial-gradient(ellipse at 70% 65%, rgba(0, 120, 215, 0.5) 0%, transparent 60%),
      linear-gradient(135deg, #0078d7 0%, #005a9e 40%, #003e77 75%, #002447 100%);
    background-size: cover;
  }
  .desktop::before {
    content: "";
    position: absolute; inset: 0;
    background:
      radial-gradient(circle at 25% 35%, rgba(150, 220, 255, 0.2) 0%, transparent 40%),
      radial-gradient(circle at 75% 70%, rgba(30, 90, 160, 0.3) 0%, transparent 45%);
    pointer-events: none;
  }

  /* ===== 桌面图标 ===== */
  .desktop-icons {
    position: absolute;
    top: 12px; left: 12px;
    display: grid;
    grid-template-columns: 80px;
    gap: 4px;
  }
  .d-icon {
    width: 80px;
    padding: 8px 4px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    border: 1px solid transparent;
    border-radius: 2px;
    cursor: pointer;
    text-align: center;
    color: #fff;
    text-shadow: 1px 1px 2px rgba(0,0,0,0.8);
    font-size: 12px;
    line-height: 1.3;
    word-break: break-all;
  }
  .d-icon:hover {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.3);
  }
  .d-icon.selected {
    background: rgba(0, 120, 215, 0.4);
    border-color: rgba(255,255,255,0.5);
  }
  .d-icon svg {
    width: 44px; height: 44px;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
  }

  /* ===== 任务栏 ===== */
  .taskbar {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    height: 40px;
    background: rgba(20, 20, 20, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-top: 1px solid rgba(255,255,255,0.08);
    display: flex;
    align-items: center;
    z-index: 1000;
  }

  .start-btn {
    width: 48px; height: 40px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    transition: background 0.15s;
  }
  .start-btn:hover, .start-btn.active { background: rgba(255,255,255,0.08); }
  .start-btn svg { width: 20px; height: 20px; }

  .search-box {
    width: 280px; height: 30px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 2px;
    display: flex; align-items: center;
    padding: 0 10px;
    margin-left: 4px;
    color: rgba(255,255,255,0.7);
    font-size: 12px;
  }
  .search-box svg { width: 14px; height: 14px; margin-right: 8px; opacity: 0.7; }

  .task-view {
    width: 40px; height: 40px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; margin-left: 4px;
  }
  .task-view:hover { background: rgba(255,255,255,0.08); }
  .task-view svg { width: 18px; height: 18px; opacity: 0.85; }

  .pinned-apps {
    display: flex; align-items: center;
    margin-left: 8px;
    height: 100%;
  }
  .pinned-app {
    width: 40px; height: 40px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    position: relative;
  }
  .pinned-app:hover { background: rgba(255,255,255,0.08); }
  .pinned-app.active::after {
    content: "";
    position: absolute;
    bottom: 2px; left: 50%;
    transform: translateX(-50%);
    width: 16px; height: 3px;
    background: #0078d7;
    border-radius: 2px;
  }
  .pinned-app svg { width: 20px; height: 20px; }

  .taskbar-spacer { flex: 1; }

  .tray {
    display: flex; align-items: center;
    height: 100%;
    padding-right: 4px;
  }
  .tray-icon {
    width: 28px; height: 40px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
  }
  .tray-icon:hover { background: rgba(255,255,255,0.08); }
  .tray-icon svg { width: 14px; height: 14px; opacity: 0.85; }

  .clock {
    padding: 0 12px;
    height: 100%;
    display: flex; flex-direction: column;
    align-items: flex-end; justify-content: center;
    cursor: pointer;
    font-size: 12px;
    line-height: 1.35;
    color: #fff;
  }
  .clock:hover { background: rgba(255,255,255,0.08); }

  .show-desktop {
    width: 4px; height: 100%;
    border-left: 1px solid rgba(255,255,255,0.15);
    cursor: pointer;
  }
  .show-desktop:hover { background: rgba(255,255,255,0.1); }

  /* ===== 开始菜单 ===== */
  .start-menu {
    position: fixed;
    bottom: 40px; left: 0;
    width: 600px; height: 560px;
    background: rgba(25, 25, 25, 0.95);
    backdrop-filter: blur(30px);
    -webkit-backdrop-filter: blur(30px);
    border: 1px solid rgba(255,255,255,0.08);
    border-bottom: none;
    display: none;
    flex-direction: column;
    z-index: 999;
    animation: startIn 0.2s ease-out;
  }
  .start-menu.show { display: flex; }
  @keyframes startIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .start-top {
    flex: 1;
    display: flex;
    padding: 12px 0 0 0;
  }
  .start-apps {
    width: 240px;
    padding: 0 8px;
    overflow-y: auto;
  }
  .start-app-list-title {
    font-size: 13px;
    color: #fff;
    padding: 8px 12px 4px;
    font-weight: 600;
  }
  .start-app-item {
    display: flex; align-items: center;
    padding: 6px 10px;
    border-radius: 2px;
    cursor: pointer;
    font-size: 13px;
    color: #fff;
    gap: 10px;
  }
  .start-app-item:hover { background: rgba(255,255,255,0.08); }
  .start-app-item svg { width: 20px; height: 20px; flex-shrink: 0; }

  .start-tiles {
    flex: 1;
    padding: 0 16px 12px 8px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 80px;
    gap: 4px;
    align-content: start;
  }
  .tile {
    background: #0078d7;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    cursor: pointer;
    border: 1px solid transparent;
    color: #fff;
    font-size: 11px;
    gap: 6px;
    transition: transform 0.1s;
  }
  .tile:hover { border-color: rgba(255,255,255,0.3); }
  .tile:active { transform: scale(0.97); }
  .tile svg { width: 28px; height: 28px; }
  .tile.green { background: #107c10; }
  .tile.purple { background: #5c2d91; }
  .tile.orange { background: #d83b01; }
  .tile.pink { background: #e3008c; }
  .tile.cyan { background: #00b294; }
  .tile.gray { background: #5c5c5c; }

  .start-bottom {
    height: 48px;
    border-top: 1px solid rgba(255,255,255,0.06);
    display: flex;
    align-items: center;
    padding: 0 12px;
    gap: 8px;
  }
  .start-user {
    display: flex; align-items: center;
    gap: 10px;
    flex: 1;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 2px;
  }
  .start-user:hover { background: rgba(255,255,255,0.08); }
  .start-avatar {
    width: 28px; height: 28px;
    border-radius: 50%;
    background: #0078d7;
    display: flex; align-items: center; justify-content: center;
    font-size: 13px; font-weight: 600;
  }
  .start-user-name { font-size: 13px; }
  .start-power {
    width: 36px; height: 36px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    border-radius: 2px;
  }
  .start-power:hover { background: rgba(255,255,255,0.08); }
  .start-power svg { width: 16px; height: 16px; }

  /* ===== 窗口 ===== */
  .window {
    position: absolute;
    min-width: 400px;
    min-height: 280px;
    background: #f3f3f3;
    border: 1px solid #d0d0d0;
    box-shadow: 0 8px 32px rgba(0,0,0,0.4);
    display: flex;
    flex-direction: column;
    color: #1f1f1f;
    z-index: 100;
    border-radius: 0;
  }
  .window.maximized {
    top: 0 !important; left: 0 !important;
    width: 100% !important;
    height: calc(100% - 40px) !important;
    border: none;
  }
  .window.minimized { display: none; }

  .win-titlebar {
    height: 32px;
    flex-shrink: 0;
    background: #ffffff;
    border-bottom: 1px solid #e1e1e1;
    display: flex;
    align-items: stretch;
    cursor: default;
  }
  .window:not(.maximized) .win-titlebar { cursor: move; }

  .win-title-icon {
    display: flex; align-items: center;
    padding-left: 12px;
    color: #0078d7;
  }
  .win-title-icon svg { width: 16px; height: 16px; }
  .win-title-text {
    flex: 1;
    display: flex; align-items: center;
    padding-left: 8px;
    font-size: 12px;
    color: #1f1f1f;
  }
  .win-controls { display: flex; height: 100%; }
  .win-btn {
    width: 46px; height: 100%;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    color: #1f1f1f;
    transition: background 0.12s;
    border: none; background: transparent;
  }
  .win-btn:hover { background: #e5e5e5; }
  .win-btn.close:hover { background: #e81123; color: #fff; }
  .win-btn svg { width: 10px; height: 10px; }

  .win-toolbar {
    height: 38px;
    flex-shrink: 0;
    background: #f9f9f9;
    border-bottom: 1px solid #e1e1e1;
    display: flex; align-items: center;
    padding: 0 10px;
    gap: 6px;
    font-size: 12px;
    color: #5a5a5a;
  }
  .win-nav-btn {
    width: 26px; height: 26px;
    display: flex; align-items: center; justify-content: center;
    border-radius: 2px;
    cursor: pointer;
  }
  .win-nav-btn:hover { background: #e5e5e5; }
  .win-nav-btn svg { width: 14px; height: 14px; }
  .win-address {
    flex: 1;
    height: 26px;
    background: #fff;
    border: 1px solid #ccc;
    display: flex; align-items: center;
    padding: 0 8px;
    font-family: Consolas, monospace;
    font-size: 12px;
    color: #333;
  }
  input.win-address {
    outline: none;
    border-radius: 2px;
    padding: 0 10px;
    user-select: text;
  }
  input.win-address:focus {
    border-color: #0078d4;
  }

  .win-body {
    flex: 1;
    display: flex;
    overflow: hidden;
  }
  .win-sidebar {
    width: 180px;
    background: #f9f9f9;
    border-right: 1px solid #e1e1e1;
    padding: 8px 0;
    overflow-y: auto;
    flex-shrink: 0;
  }
  .win-sidebar-item {
    display: flex; align-items: center;
    padding: 6px 12px;
    font-size: 12px;
    color: #333;
    cursor: pointer;
    gap: 8px;
  }
  .win-sidebar-item:hover { background: #e5e5e5; }
  .win-sidebar-item.active { background: #e5f3ff; color: #0078d7; }
  .win-sidebar-item svg { width: 16px; height: 16px; }

  .win-content {
    flex: 1;
    overflow-y: auto;
    padding: 12px;
    background: #fff;
  }
  .file-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
    gap: 8px;
  }
  .file-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 8px 4px;
    border: 1px solid transparent;
    border-radius: 2px;
    cursor: pointer;
    text-align: center;
    font-size: 11px;
    color: #333;
    gap: 4px;
    line-height: 1.3;
  }
  .file-item:hover {
    background: #e5f3ff;
    border-color: #99ccff;
  }
  .file-item svg { width: 40px; height: 40px; }

  .win-statusbar {
    height: 28px;
    flex-shrink: 0;
    background: #f9f9f9;
    border-top: 1px solid #e1e1e1;
    display: flex;
    align-items: center;
    padding: 0 12px;
    font-size: 11px;
    color: #5a5a5a;
  }

  /* ===== 右键菜单 ===== */
  .context-menu {
    position: fixed;
    background: #f9f9f9;
    border: 1px solid #d0d0d0;
    box-shadow: 0 4px 16px rgba(0,0,0,0.3);
    min-width: 180px;
    padding: 4px 0;
    z-index: 2000;
    display: none;
    color: #1f1f1f;
  }
  .context-menu.show { display: block; }
  .ctx-item {
    padding: 6px 20px;
    font-size: 12px;
    cursor: pointer;
    display: flex; align-items: center;
    gap: 10px;
  }
  .ctx-item:hover { background: #e5f3ff; }
  .ctx-sep {
    height: 1px;
    background: #e0e0e0;
    margin: 4px 0;
  }

  /* ===== 窗口 resize 手柄 ===== */
  .window-resize-handle {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 16px;
    height: 16px;
    cursor: nwse-resize;
    z-index: 10;
  }
  .window-resize-handle::before {
    content: "";
    position: absolute;
    right: 2px;
    bottom: 2px;
    width: 10px;
    height: 10px;
    background:
      linear-gradient(135deg, transparent 40%, #b0b0b0 40%, #b0b0b0 50%, transparent 50%, transparent 60%, #b0b0b0 60%, #b0b0b0 70%, transparent 70%, transparent 80%, #b0b0b0 80%, #b0b0b0 90%, transparent 90%);
  }
  .window.maximized .window-resize-handle { display: none; }

  /* ===== 记事本菜单栏 ===== */
  .notepad-menubar {
    height: 24px;
    background: #f0f0f0;
    border-bottom: 1px solid #d0d0d0;
    display: flex;
    align-items: stretch;
    flex-shrink: 0;
    font-size: 12px;
    color: #333;
    position: relative;
  }
  .notepad-menu-item {
    padding: 0 10px;
    display: flex;
    align-items: center;
    cursor: default;
  }
  .notepad-menu-item:hover { background: #e5f3ff; }
  .notepad-dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    background: #f9f9f9;
    border: 1px solid #d0d0d0;
    box-shadow: 2px 2px 6px rgba(0,0,0,0.2);
    min-width: 180px;
    z-index: 50;
  }
  .notepad-dropdown.show { display: block; }
  .notepad-dd-item {
    padding: 5px 24px 5px 20px;
    font-size: 12px;
    color: #333;
    cursor: default;
    display: flex;
    justify-content: space-between;
    gap: 20px;
  }
  .notepad-dd-item:hover { background: #e5f3ff; }
  .notepad-dd-item.disabled { color: #aaa; }
  .notepad-dd-item.disabled:hover { background: transparent; }
  .notepad-dd-sep { height: 1px; background: #e0e0e0; margin: 3px 0; }
  .notepad-dd-shortcut { color: #888; font-size: 11px; }
  .notepad-textarea {
    flex: 1;
    padding: 4px 6px;
    font-family: Consolas, monospace;
    font-size: 13px;
    line-height: 1.6;
    color: #000;
    outline: none;
    white-space: pre-wrap;
    overflow-y: auto;
    background: #fff;
    user-select: text;
    resize: none;
    border: none;
  }

  /* ===== 托盘弹出面板 ===== */
  .tray-panel {
    position: fixed;
    bottom: 40px;
    background: rgba(25, 25, 25, 0.92);
    backdrop-filter: blur(30px);
    -webkit-backdrop-filter: blur(30px);
    border: 1px solid rgba(255,255,255,0.08);
    border-bottom: none;
    color: #fff;
    z-index: 999;
    display: none;
    animation: trayIn 0.18s ease-out;
  }
  .tray-panel.show { display: block; }
  @keyframes trayIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* 网络面板 */
  .network-panel {
    right: 92px;
    width: 320px;
    padding: 16px;
  }
  .network-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 2px;
    cursor: pointer;
  }
  .network-item:hover { background: rgba(255,255,255,0.1); }
  .network-item svg { width: 24px; height: 24px; flex-shrink: 0; }
  .network-info { flex: 1; }
  .network-name { font-size: 13px; font-weight: 600; }
  .network-status { font-size: 11px; color: #aaa; margin-top: 2px; }
  .network-connected { color: #7ecf7e; }

  /* 音量面板 */
  .volume-panel {
    right: 60px;
    width: 280px;
    padding: 16px;
  }
  .volume-slider-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .volume-icon-btn {
    width: 32px; height: 32px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    border-radius: 2px;
    flex-shrink: 0;
  }
  .volume-icon-btn:hover { background: rgba(255,255,255,0.1); }
  .volume-icon-btn svg { width: 20px; height: 20px; }
  .volume-slider-track {
    flex: 1;
    height: 4px;
    background: rgba(255,255,255,0.2);
    border-radius: 2px;
    position: relative;
    cursor: pointer;
  }
  .volume-slider-fill {
    position: absolute;
    left: 0; top: 0;
    height: 100%;
    background: #0078d7;
    border-radius: 2px;
  }
  .volume-slider-thumb {
    position: absolute;
    top: 50%;
    width: 16px; height: 16px;
    background: #fff;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 0 1px 4px rgba(0,0,0,0.4);
  }
  .volume-label {
    font-size: 12px;
    color: #ccc;
    min-width: 32px;
    text-align: right;
  }

  /* 日历面板 */
  .calendar-panel {
    right: 0;
    width: 340px;
    padding: 12px 16px 16px;
  }
  .cal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 4px 10px;
  }
  .cal-title {
    font-size: 14px;
    font-weight: 600;
  }
  .cal-nav {
    display: flex;
    gap: 4px;
  }
  .cal-nav-btn {
    width: 24px; height: 24px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    border-radius: 2px;
    font-size: 12px;
  }
  .cal-nav-btn:hover { background: rgba(255,255,255,0.1); }
  .cal-grid-header {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    text-align: center;
    font-size: 11px;
    color: #888;
    padding-bottom: 4px;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .cal-grid-header div { padding: 4px 0; }
  .cal-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    text-align: center;
    font-size: 12px;
    padding-top: 4px;
  }
  .cal-day {
    padding: 8px 0;
    cursor: default;
    border-radius: 50%;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 2px auto;
  }
  .cal-day.today {
    background: #0078d7;
    color: #fff;
    font-weight: 600;
  }
  .cal-day.other { color: #555; }
  .cal-time-big {
    font-size: 28px;
    font-weight: 300;
    padding: 4px 4px 8px;
  }
  .cal-date-big {
    font-size: 13px;
    color: #ccc;
    padding: 0 4px 10px;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    margin-bottom: 8px;
  }

  /* ===== 打开方式对话框 ===== */
  .open-with-dialog {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 420px;
    background: #f3f3f3;
    border: 1px solid #d0d0d0;
    box-shadow: 0 8px 32px rgba(0,0,0,0.4);
    z-index: 3000;
    color: #1f1f1f;
    font-size: 12px;
  }
  .owd-titlebar {
    height: 30px;
    background: #fff;
    border-bottom: 1px solid #e1e1e1;
    display: flex;
    align-items: center;
    padding: 0 10px;
    font-size: 12px;
  }
  .owd-title-text { flex: 1; }
  .owd-close {
    width: 30px; height: 30px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    margin-right: -10px;
  }
  .owd-close:hover { background: #e81123; color: #fff; }
  .owd-body { padding: 16px; }
  .owd-desc {
    font-size: 12px;
    color: #555;
    margin-bottom: 12px;
    line-height: 1.5;
  }
  .owd-option {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border: 1px solid #d0d0d0;
    border-radius: 2px;
    cursor: pointer;
    margin-bottom: 6px;
    background: #fff;
  }
  .owd-option:hover { border-color: #0078d4; background: #e5f3ff; }
  .owd-option svg { width: 32px; height: 32px; flex-shrink: 0; }
  .owd-option-name { font-weight: 600; font-size: 12px; }
  .owd-option-sub { font-size: 11px; color: #888; margin-top: 2px; }
  .owd-always {
    margin-top: 12px;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: #333;
    cursor: pointer;
  }
  .owd-always input { cursor: pointer; }
  .owd-buttons {
    display: flex;
    justify-content: flex-end;
    gap: 6px;
    margin-top: 16px;
  }
  .owd-btn {
    padding: 5px 18px;
    font-size: 12px;
    border: 1px solid #adadad;
    background: #e1e1e1;
    cursor: pointer;
    border-radius: 2px;
  }
  .owd-btn:hover { background: #e5f3ff; border-color: #0078d4; }
  .owd-btn.primary {
    background: #0078d4;
    border-color: #0078d4;
    color: #fff;
  }
  .owd-btn.primary:hover { background: #006cbd; }
  .owd-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.3);
    z-index: 2999;
  }

  /* ===== 照片查看器 ===== */
  .photo-viewer {
    width: 100%;
    height: 100%;
    background: #1a1a1a;
    display: flex;
    flex-direction: column;
  }
  .photo-viewer-body {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  .photo-placeholder {
    width: 280px;
    height: 200px;
    background: linear-gradient(135deg, #2c3e50 0%, #4a6580 50%, #2c3e50 100%);
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    color: #8899aa;
    font-size: 12px;
  }
  .photo-placeholder svg { width: 48px; height: 48px; opacity: 0.5; }
  .photo-filename {
    font-size: 13px;
    color: #ccc;
    max-width: 80%;
    text-align: center;
    word-break: break-all;
  }

  /* 响应式 */
  @media (max-width: 640px) {
    .search-box { display: none; }
    .start-menu { width: 100%; height: calc(100% - 40px); }
    .pinned-apps .pinned-app:nth-child(n+5) { display: none; }
    .window { min-width: 280px; min-height: 200px; }
    .win-sidebar { width: 120px; }
  }
</style>
</head>
<body>

<!-- 桌面 -->
<div class="desktop" id="desktop">

  <!-- 桌面图标 -->
  <div class="desktop-icons" id="desktopIcons">
    <div class="d-icon" data-app="thispc" ondblclick="openWindow('thispc')">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="3" y="4" width="18" height="14" rx="1.5" fill="#0078d4" stroke="#fff" stroke-width="1"/>
        <rect x="5" y="18" width="14" height="2" rx="0.5" fill="#0078d4" stroke="#fff" stroke-width="1"/>
        <path d="M7 8h10M7 11h10M7 14h6" stroke="#fff" stroke-width="1.2" stroke-linecap="round"/>
      </svg>
      <span>此电脑</span>
    </div>
    <div class="d-icon" data-app="recycle" ondblclick="openWindow('recycle')">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M5 7h14l-1.5 13a1.5 1.5 0 0 1-1.5 1.5H8A1.5 1.5 0 0 1 6.5 20L5 7z" fill="#6c6c6c" stroke="#fff" stroke-width="0.8"/>
        <path d="M9 7V4.5A1.5 1.5 0 0 1 10.5 3h3A1.5 1.5 0 0 1 15 4.5V7" fill="#8c8c8c" stroke="#fff" stroke-width="0.8"/>
        <path d="M4 7h16" stroke="#fff" stroke-width="1" stroke-linecap="round"/>
      </svg>
      <span>回收站</span>
    </div>
    <div class="d-icon" data-app="edge" ondblclick="openWindow('edge')">
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <defs><linearGradient id="eg" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#0078d4"/><stop offset="100%" stop-color="#00bcf2"/>
        </linearGradient></defs>
        <circle cx="12" cy="12" r="10" fill="url(#eg)"/>
        <path d="M6 16c3 3 9 3.5 13 1-2-4-7-7-13-1 0 0 0 0 0 0z" fill="#fff" opacity="0.9"/>
        <path d="M8 10c3-2 7-2 9 1-2-3-6-3-9-1z" fill="#fff" opacity="0.6"/>
      </svg>
      <span>Microsoft Edge</span>
    </div>
    <div class="d-icon" data-app="vlc" ondblclick="openWindow('vlc')">
      <svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
        <!-- VLC 橙色交通锥 -->
        <defs>
          <linearGradient id="vlcGrad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#ff8c00"/>
            <stop offset="50%" stop-color="#ff6600"/>
            <stop offset="100%" stop-color="#e65c00"/>
          </linearGradient>
        </defs>
        <!-- 锥底底座 -->
        <ellipse cx="24" cy="42" rx="16" ry="3.5" fill="#333"/>
        <ellipse cx="24" cy="40" rx="16" ry="3.5" fill="#555"/>
        <!-- 锥体 - 橙色主体 -->
        <path d="M20 40 L14 22 L24 6 L34 22 L28 40 Z" fill="url(#vlcGrad)"/>
        <!-- 白色条纹 -->
        <path d="M17.5 26 L24 16 L30.5 26 L28.5 30 L24 23 L19.5 30 Z" fill="#fff" opacity="0.9"/>
        <!-- 顶部黑色小帽 -->
        <ellipse cx="24" cy="6.5" rx="2.5" ry="1" fill="#222"/>
        <!-- 高光 -->
        <path d="M21 12 L17 24 L19 24 L23 12 Z" fill="#fff" opacity="0.25"/>
      </svg>
      <span>VLC media player</span>
    </div>

  </div>
  <!-- 动态桌面文件（保存到网页桌面的文件） -->
  <div class="desktop-icons" id="desktopFiles"></div>

  <!-- 窗口容器 -->
  <div id="windowContainer"></div>

</div>

<!-- 任务栏 -->
<div class="taskbar">
  <div class="start-btn" id="startBtn" onclick="toggleStart()">
    <svg viewBox="0 0 24 24" fill="#fff" xmlns="http://www.w3.org/2000/svg">
      <path d="M3 5h8v7H3V5zm0 9h8v7H3v-7zm10-9h8v7h-8V5zm0 9h8v7h-8v-7z"/>
    </svg>
  </div>
  <div class="search-box" id="searchBox" onclick="openSearchPanel()">
    <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" xmlns="http://www.w3.org/2000/svg">
      <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
    </svg>
    在这里输入你要搜索的内容
  </div>
  <div class="task-view" title="任务视图" id="taskViewBtn" onclick="openTaskView()">
    <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" xmlns="http://www.w3.org/2000/svg">
      <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
      <rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>
    </svg>
  </div>
  <div class="pinned-apps" id="pinnedApps">
    <div class="pinned-app active" data-app="thispc" ondblclick="openWindow('thispc')" title="文件资源管理器">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h4l2 2h9A1.5 1.5 0 0 1 21 8.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5v-11z" fill="#ffc83d" stroke="#fff" stroke-width="0.5"/>
      </svg>
    </div>
    <div class="pinned-app" data-app="edge" ondblclick="openWindow('edge')" title="Microsoft Edge">
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <defs><linearGradient id="eg2" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#0078d4"/><stop offset="100%" stop-color="#00bcf2"/>
        </linearGradient></defs>
        <circle cx="12" cy="12" r="10" fill="url(#eg2)"/>
        <path d="M6 16c3 3 9 3.5 13 1-2-4-7-7-13-1z" fill="#fff" opacity="0.9"/>
      </svg>
    </div>
    <div class="pinned-app" data-app="vlc" ondblclick="openWindow('vlc')" title="VLC media player">
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <ellipse cx="12" cy="21" rx="8" ry="1.8" fill="#333"/>
        <path d="M10 20 L7 11 L12 3 L17 11 L14 20 Z" fill="#ff6600"/>
        <path d="M8.6 13 L12 8 L15.4 13 L14.4 15 L12 11.5 L9.6 15 Z" fill="#fff" opacity="0.9"/>
        <ellipse cx="12" cy="3.2" rx="1.2" ry="0.5" fill="#222"/>
      </svg>
    </div>
  </div>
  <div class="taskbar-spacer"></div>
  <div class="tray">
    <div class="tray-icon" id="trayNetwork" title="网络" onclick="toggleTrayPanel('network')">
      <svg id="trayNetworkIcon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- 电脑主体 -->
        <rect x="3" y="4" width="18" height="12" rx="1" fill="none" stroke="#fff" stroke-width="1.6"/>
        <rect x="5" y="6" width="14" height="8" fill="none" stroke="#fff" stroke-width="0.8" opacity="0.5"/>
        <!-- 底座 -->
        <rect x="9" y="17" width="6" height="1.5" fill="#fff"/>
        <rect x="7" y="19" width="10" height="1" rx="0.5" fill="#fff"/>
        <!-- 网线 -->
        <path d="M12 16 L12 14" stroke="#fff" stroke-width="1.2"/>
        <path d="M9 13.5 L15 13.5" stroke="#fff" stroke-width="1.2"/>
        <path d="M10 13.5 L10 11.5 L14 11.5 L14 13.5" fill="none" stroke="#fff" stroke-width="1.2"/>
        <path d="M10.5 11.5 L10.5 9.5 L13.5 9.5 L13.5 11.5" fill="none" stroke="#fff" stroke-width="1"/>
      </svg>
    </div>
    <div class="tray-icon" id="trayVolume" title="音量" onclick="toggleTrayPanel('volume')">
      <svg id="trayVolumeIcon" viewBox="0 0 24 24" fill="#fff" xmlns="http://www.w3.org/2000/svg">
        <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/>
      </svg>
    </div>
    <div class="clock" id="clock" onclick="toggleTrayPanel('calendar')">
      <span id="clockTime">--:--</span>
      <span id="clockDate">----/--/--</span>
    </div>
  </div>
  <div class="show-desktop" id="showDesktop" title="显示桌面"></div>
</div>

<!-- 开始菜单 -->
<div class="start-menu" id="startMenu">
  <div class="start-top">
    <div class="start-apps">
      <div class="start-app-list-title">最近添加</div>
      <div class="start-app-item" onclick="openWindow('edge'); toggleStart();">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <defs><linearGradient id="eg3" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#0078d4"/><stop offset="100%" stop-color="#00bcf2"/>
          </linearGradient></defs>
          <circle cx="12" cy="12" r="10" fill="url(#eg3)"/>
        </svg>
        Microsoft Edge
      </div>
      <div class="start-app-list-title">A</div>
      <div class="start-app-item" onclick="openWindow('calculator'); toggleStart();">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="5" y="2" width="14" height="20" rx="2" fill="#5c5c5c"/>
          <rect x="7" y="5" width="10" height="4" rx="0.5" fill="#a8d08d"/>
          <circle cx="8.5" cy="13" r="1.3" fill="#d0d0d0"/><circle cx="12" cy="13" r="1.3" fill="#d0d0d0"/><circle cx="15.5" cy="13" r="1.3" fill="#d0d0d0"/>
          <circle cx="8.5" cy="16.5" r="1.3" fill="#d0d0d0"/><circle cx="12" cy="16.5" r="1.3" fill="#d0d0d0"/><circle cx="15.5" cy="16.5" r="1.3" fill="#ff9800"/>
          <circle cx="12" cy="19.5" r="1.3" fill="#d0d0d0"/>
        </svg>
        计算器
      </div>
      <div class="start-app-item" onclick="openWindow('notepad'); toggleStart();">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M6 3h9l4 4v14a0.5 0.5 0 0 1-0.5 0.5h-13A0.5 0.5 0 0 1 5 21V3.5A0.5 0.5 0 0 1 5.5 3z" fill="#fff" stroke="#0078d4" stroke-width="1.2"/>
          <path d="M15 3v4h4" stroke="#0078d4" stroke-width="1.2" fill="none"/>
        </svg>
        记事本
      </div>
      <div class="start-app-list-title">S</div>
      <div class="start-app-item" onclick="openWindow('settings'); toggleStart();">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="12" cy="12" r="9" fill="#5c5c5c" stroke="#fff" stroke-width="0.5"/>
          <circle cx="12" cy="12" r="4" fill="#fff"/>
          <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.5 5.5l1.4 1.4M17.1 17.1l1.4 1.4M5.5 18.5l1.4-1.4M17.1 6.9l1.4-1.4" stroke="#fff" stroke-width="1.5"/>
        </svg>
        设置
      </div>
      <div class="start-app-list-title">V</div>
      <div class="start-app-item" onclick="openWindow('vlc'); toggleStart();">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <ellipse cx="12" cy="21" rx="8" ry="1.8" fill="#333"/>
          <path d="M10 20 L7 11 L12 3 L17 11 L14 20 Z" fill="#ff6600"/>
          <path d="M8.6 13 L12 8 L15.4 13 L14.4 15 L12 11.5 L9.6 15 Z" fill="#fff" opacity="0.9"/>
        </svg>
        VLC media player
      </div>
    </div>
    <div class="start-tiles">
      <div class="tile" onclick="openWindow('edge'); toggleStart();">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="fill:#fff;width:32px;height:32px">
          <circle cx="12" cy="12" r="10" fill="#fff"/>
        </svg>
        Edge
      </div>
      <div class="tile green" onclick="openWindow('mail'); toggleStart();">
        <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2">
          <rect x="3" y="5" width="18" height="14" rx="1"/><path d="m3 7 9 6 9-6"/>
        </svg>
        邮件
      </div>
      <div class="tile purple" onclick="openWindow('calendar'); toggleStart();">
        <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2">
          <rect x="3" y="5" width="18" height="16" rx="1"/><path d="M3 10h18M8 3v4M16 3v4"/>
        </svg>
        日历
      </div>
      <div class="tile orange" onclick="openWindow('photos'); toggleStart();">
        <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2">
          <rect x="3" y="5" width="18" height="14" rx="1"/><circle cx="10" cy="11" r="2.5"/><path d="m21 17-5-5-9 9"/>
        </svg>
        照片
      </div>
      <div class="tile pink" onclick="openWindow('store'); toggleStart();">
        <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2">
          <path d="M3 7h18l-1.5 13a1 1 0 0 1-1 1h-13a1 1 0 0 1-1-1L3 7z"/><path d="M8 7V4a4 4 0 0 1 8 0v3"/>
        </svg>
        应用商店
      </div>
      <div class="tile cyan" onclick="openWindow('rtmp'); toggleStart();">
        <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2">
          <rect x="2" y="6" width="20" height="12" rx="2"/><path d="m10 9 5 3-5 3V9z" fill="#fff"/>
        </svg>
        CAM？
      </div>
      <div class="tile orange" onclick="openWindow('vlc'); toggleStart();">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <ellipse cx="12" cy="21" rx="8" ry="1.8" fill="#fff" opacity="0.3"/>
          <path d="M10 20 L7 11 L12 3 L17 11 L14 20 Z" fill="#fff"/>
          <path d="M8.6 13 L12 8 L15.4 13 L14.4 15 L12 11.5 L9.6 15 Z" fill="#ff6600"/>
        </svg>
        VLC
      </div>
    </div>
  </div>
  <div class="start-bottom">
    <div class="start-user">
      <div class="start-avatar">南</div>
      <div class="start-user-name">南洛</div>
    </div>
    <div class="start-power" title="关机" onclick="shutdown()">
      <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" xmlns="http://www.w3.org/2000/svg">
        <path d="M12 3v9"/><path d="M5.5 8.5a8 8 0 1 0 13 0"/>
      </svg>
    </div>
  </div>
</div>

<!-- 右键菜单 -->
<div class="context-menu" id="contextMenu">
  <div class="ctx-item" onclick="openWindow('thispc'); hideContext();">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="4" y="5" width="16" height="13" rx="1" fill="#0078d4"/>
    </svg>
    查看
  </div>
  <div class="ctx-sep"></div>
  <div class="ctx-item" id="ctxDeleteFile" onclick="deleteSelectedDesktopFile(); hideContext();" style="color:#e81123;">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
    <span>删除</span>
  </div>
  <div class="ctx-item" onclick="openWindow('thispc'); hideContext();">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="4" y="4" width="16" height="16" rx="1" fill="#0078d4"/>
    </svg>
    刷新
  </div>
  <div class="ctx-item" onclick="openWindow('settings'); hideContext();">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="12" cy="12" r="8" fill="#5c5c5c"/>
    </svg>
    显示设置
  </div>
  <div class="ctx-item" onclick="openWindow('settings'); hideContext();">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="12" cy="12" r="8" fill="#5c5c5c"/>
    </svg>
    个性化
  </div>
  <div class="ctx-sep"></div>
  <div class="ctx-item" onclick="openWindow('notepad'); hideContext();">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M6 3h9l4 4v14a0.5 0.5 0 0 1-0.5 0.5h-13A0.5 0.5 0 0 1 5 21V3.5A0.5 0.5 0 0 1 5.5 3z" fill="#fff" stroke="#0078d4" stroke-width="1.2"/>
    </svg>
    新建
  </div>
  <div class="ctx-sep"></div>
  <div class="ctx-item" onclick="openWindow('settings'); hideContext();">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="12" cy="12" r="8" fill="#5c5c5c"/>
    </svg>
    屏幕分辨率
  </div>
</div>

<!-- 网络面板 -->
<div class="tray-panel network-panel" id="networkPanel">
  <div style="font-size:13px;font-weight:600;margin-bottom:10px;">网络</div>
  <div class="network-item">
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="3" y="4" width="18" height="12" rx="1" fill="none" stroke="#fff" stroke-width="1.6"/>
      <rect x="9" y="17" width="6" height="1.5" fill="#fff"/>
      <rect x="7" y="19" width="10" height="1" rx="0.5" fill="#fff"/>
      <path d="M12 16 L12 14" stroke="#fff" stroke-width="1.2"/>
      <path d="M9 13.5 L15 13.5" stroke="#fff" stroke-width="1.2"/>
      <path d="M10 13.5 L10 11.5 L14 11.5 L14 13.5" fill="none" stroke="#fff" stroke-width="1.2"/>
    </svg>
    <div class="network-info">
      <div class="network-name">以太网</div>
      <div class="network-status"><span class="network-connected">已连接</span> · Internet 访问</div>
    </div>
  </div>
  <div style="margin-top:12px;font-size:11px;color:#888;">已连接到 网络</div>
</div>

<!-- 音量面板 -->
<div class="tray-panel volume-panel" id="volumePanel">
  <div class="volume-slider-row">
    <div class="volume-icon-btn" id="volPanelMuteBtn" onclick="toggleSystemVolumeMute()" title="静音">
      <svg id="volPanelIcon" viewBox="0 0 24 24" fill="#fff" xmlns="http://www.w3.org/2000/svg">
        <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/>
      </svg>
    </div>
    <div class="volume-slider-track" id="volPanelTrack">
      <div class="volume-slider-fill" id="volPanelFill" style="width:70%;"></div>
      <div class="volume-slider-thumb" id="volPanelThumb" style="left:70%;"></div>
    </div>
    <div class="volume-label" id="volPanelLabel">70</div>
  </div>
</div>

<!-- 日历面板 -->
<div class="tray-panel calendar-panel" id="calendarPanel">
  <div class="cal-time-big" id="calBigTime">--:--</div>
  <div class="cal-date-big" id="calBigDate">----年--月--日 星期-</div>
  <div class="cal-header">
    <div class="cal-title" id="calTitle">---- 年 -- 月</div>
    <div class="cal-nav">
      <div class="cal-nav-btn" onclick="changeCalMonth(-1)" title="上个月">&#8249;</div>
      <div class="cal-nav-btn" onclick="changeCalMonth(1)" title="下个月">&#8250;</div>
    </div>
  </div>
  <div class="cal-grid-header">
    <div>日</div><div>一</div><div>二</div><div>三</div><div>四</div><div>五</div><div>六</div>
  </div>
  <div class="cal-grid" id="calGrid"></div>
</div>

<!-- 隐藏的文件选择器 -->
<input type="file" id="notepadFileInput" accept=".txt,text/plain" style="display:none;">

<!-- 记事本保存对话框 -->
<div id="saveDialog" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.3);z-index:3000;align-items:center;justify-content:center;">
  <div id="saveDialogInner" style="width:420px;background:#fff;border:1px solid #999;box-shadow:0 8px 32px rgba(0,0,0,0.3);position:relative;font-family:'Segoe UI','Microsoft YaHei UI',sans-serif;">
    <!-- 标题栏（可拖动） -->
    <div id="saveDlgTitleBar" style="background:#0078d7;color:#fff;padding:8px 12px;font-size:13px;display:flex;align-items:center;cursor:move;">
      <span style="flex:1;">保存文件</span>
      <span id="saveDlgClose" style="width:24px;height:20px;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:14px;">✕</span>
    </div>
    <!-- 内容区 -->
    <div style="padding:16px;color:#333;font-size:12px;">
      <div style="margin-bottom:8px;">文件名：</div>
      <input type="text" id="saveDlgFilename" placeholder="新建文本文档.txt" style="width:100%;padding:6px 8px;border:1px solid #ccc;border-radius:2px;font-size:12px;box-sizing:border-box;outline:none;" />
      <div style="margin-top:14px;margin-bottom:8px;font-weight:600;">保存方式：</div>
      <div style="display:flex;flex-direction:column;gap:6px;">
        <label id="saveOptDesktop" style="display:flex;align-items:center;gap:8px;padding:8px 10px;border:1px solid #e0e0e0;border-radius:2px;cursor:pointer;background:#f9f9f9;">
          <input type="radio" name="saveOpt" value="desktop" checked style="cursor:pointer;">
          <div>
            <div style="font-weight:600;color:#333;">保存到网页桌面</div>
            <div style="font-size:11px;color:#888;margin-top:2px;">在桌面生成 txt 文件图标，双击可用记事本打开</div>
          </div>
        </label>
        <label id="saveOptDownload" style="display:flex;align-items:center;gap:8px;padding:8px 10px;border:1px solid #e0e0e0;border-radius:2px;cursor:pointer;background:#f9f9f9;">
          <input type="radio" name="saveOpt" value="download" style="cursor:pointer;">
          <div>
            <div style="font-weight:600;color:#333;">下载到本地</div>
            <div style="font-size:11px;color:#888;margin-top:2px;">将 .txt 文件下载到你的电脑</div>
          </div>
        </label>
      </div>
    </div>
    <!-- 按钮区 -->
    <div style="padding:0 16px 14px;display:flex;justify-content:flex-end;gap:8px;">
      <button id="saveDlgOk" style="padding:6px 20px;background:#0078d7;color:#fff;border:1px solid #0067b8;border-radius:2px;font-size:12px;cursor:pointer;">保存</button>
      <button id="saveDlgCancel" style="padding:6px 20px;background:#f0f0f0;color:#333;border:1px solid #ccc;border-radius:2px;font-size:12px;cursor:pointer;">取消</button>
    </div>
  </div>
</div>

<script>
  // ===== 时钟 =====
  function updateClock() {
    var now = new Date();
    var h = String(now.getHours()).padStart(2, '0');
    var m = String(now.getMinutes()).padStart(2, '0');
    var y = now.getFullYear();
    var mo = String(now.getMonth() + 1).padStart(2, '0');
    var d = String(now.getDate()).padStart(2, '0');
    document.getElementById('clockTime').textContent = h + ':' + m;
    document.getElementById('clockDate').textContent = y + '/' + mo + '/' + d;
  }
  updateClock();
  setInterval(updateClock, 1000 * 30);

  // 初始化托盘音量图标
  setTimeout(function() { updateVolumePanel(); }, 0);

  // 音量滑块拖动（全局绑定）
  var isVolPanelDragging = false;
  function initVolumeSlider() {
    var track = document.getElementById('volPanelTrack');
    if (!track) return;

    function handleVolClick(e) {
      var rect = track.getBoundingClientRect();
      var pct = (e.clientX - rect.left) / rect.width;
      pct = Math.max(0, Math.min(1, pct));
      systemVolume = Math.round(pct * 100);
      if (systemVolume > 0) systemMuted = false;
      updateVolumePanel();
    }

    track.addEventListener('mousedown', function(e) {
      isVolPanelDragging = true;
      handleVolClick(e);
    });
    document.addEventListener('mousemove', function(e) {
      if (isVolPanelDragging) handleVolClick(e);
    });
    document.addEventListener('mouseup', function() { isVolPanelDragging = false; });
  }
  initVolumeSlider();

  // 记事本文件选择（全局，避免重复绑定）
  var notepadFileInputEl = document.getElementById('notepadFileInput');
  if (notepadFileInputEl) {
    notepadFileInputEl.addEventListener('change', function(e) {
      var file = e.target.files[0];
      if (!file) return;
      var reader = new FileReader();
      reader.onload = function(ev) {
        var ta = document.getElementById('notepad-textarea');
        if (ta) {
          ta.value = ev.target.result;
          notepadState.filename = file.name;
          notepadState.dirty = false;
          notepadState.content = ta.value;
          updateNotepadTitle();
          // 更新状态栏
          var statusEl = document.getElementById('notepad-status');
          if (statusEl) statusEl.textContent = '第 1 行，第 1 列';
        }
      };
      reader.readAsText(file);
    });
  }

  // ===== 开始菜单 =====
  var startMenu = document.getElementById('startMenu');
  var startBtn = document.getElementById('startBtn');
  function toggleStart() {
    startMenu.classList.toggle('show');
    startBtn.classList.toggle('active');
  }
  document.addEventListener('click', function(e) {
    if (!startMenu.contains(e.target) && !startBtn.contains(e.target)) {
      startMenu.classList.remove('show');
      startBtn.classList.remove('active');
    }
  });

  // ===== 窗口管理 =====
  var windows = {};
  var zIndexCounter = 100;
  var windowCounter = 0;

  function getAppConfig(app) {
    var configs = {
      thispc: { title: '此电脑', icon: 'pc', w: 820, h: 520, hasSidebar: true, hasToolbar: true, type: 'explorer' },
      documents: { title: '文档', icon: 'folder', w: 760, h: 500, hasSidebar: true, hasToolbar: true, type: 'explorer' },
      recycle: { title: '回收站', icon: 'recycle', w: 680, h: 460, hasSidebar: true, hasToolbar: true, type: 'explorer' },
      edge: { title: 'Microsoft Edge', icon: 'edge', w: 900, h: 600, hasSidebar: false, hasToolbar: true, type: 'browser' },
      calculator: { title: '计算器', icon: 'calc', w: 320, h: 480, hasSidebar: false, hasToolbar: false, type: 'calc' },
      notepad: { title: '无标题 - 记事本', icon: 'notepad', w: 600, h: 440, hasSidebar: false, hasToolbar: false, type: 'notepad' },
      settings: { title: '设置', icon: 'settings', w: 800, h: 560, hasSidebar: true, hasToolbar: false, type: 'settings' },
      mail: { title: '邮件', icon: 'mail', w: 800, h: 540, hasSidebar: true, hasToolbar: false, type: 'mail' },
      calendar: { title: '日历', icon: 'calendar', w: 800, h: 540, hasSidebar: true, hasToolbar: false, type: 'calendar' },
      photos: { title: '照片', icon: 'photos', w: 800, h: 540, hasSidebar: false, hasToolbar: false, type: 'photos' },
      store: { title: 'Microsoft Store', icon: 'store', w: 860, h: 580, hasSidebar: false, hasToolbar: true, type: 'store' },
      rtmp: { title: 'CAM？', icon: 'video', w: 860, h: 560, hasSidebar: false, hasToolbar: false, type: 'rtmp' },
      vlc: { title: 'VLC media player', icon: 'vlc', w: 720, h: 520, hasSidebar: false, hasToolbar: false, type: 'vlc' }
    };
    return configs[app] || { title: app, icon: 'app', w: 600, h: 400, hasSidebar: false, hasToolbar: false, type: 'default' };
  }

  function getIconSvg(icon) {
    var icons = {
      pc: '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="4" width="18" height="14" rx="1.5" fill="#0078d4"/><rect x="5" y="18" width="14" height="2" rx="0.5" fill="#0078d4"/></svg>',
      folder: '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h4l2 2h9A1.5 1.5 0 0 1 21 8.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5v-11z" fill="#ffc83d"/></svg>',
      recycle: '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5 7h14l-1.5 13a1.5 1.5 0 0 1-1.5 1.5H8A1.5 1.5 0 0 1 6.5 20L5 7z" fill="#6c6c6c"/><path d="M9 7V4.5A1.5 1.5 0 0 1 10.5 3h3A1.5 1.5 0 0 1 15 4.5V7" fill="#8c8c8c"/></svg>',
      edge: '<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><defs><linearGradient id="egi" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#0078d4"/><stop offset="100%" stop-color="#00bcf2"/></linearGradient></defs><circle cx="12" cy="12" r="10" fill="url(#egi)"/></svg>',
      calc: '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="5" y="2" width="14" height="20" rx="2" fill="#5c5c5c"/><rect x="7" y="5" width="10" height="4" rx="0.5" fill="#a8d08d"/></svg>',
      notepad: '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 3h9l4 4v14a0.5 0.5 0 0 1-0.5 0.5h-13A0.5 0.5 0 0 1 5 21V3.5A0.5 0.5 0 0 1 5.5 3z" fill="#fff" stroke="#0078d4" stroke-width="1.2"/></svg>',
      settings: '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="9" fill="#5c5c5c"/><circle cx="12" cy="12" r="4" fill="#fff"/></svg>',
      mail: '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="5" width="18" height="14" rx="1" fill="#107c10"/><path d="m3 7 9 6 9-6" stroke="#fff" stroke-width="1.5" fill="none"/></svg>',
      calendar: '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="5" width="18" height="16" rx="1" fill="#5c2d91"/><path d="M3 10h18M8 3v4M16 3v4" stroke="#fff" stroke-width="1.5"/></svg>',
      photos: '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="5" width="18" height="14" rx="1" fill="#d83b01"/><circle cx="10" cy="11" r="2.5" fill="#fff"/></svg>',
      store: '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 7h18l-1.5 13a1 1 0 0 1-1 1h-13a1 1 0 0 1-1-1L3 7z" fill="#e3008c"/><path d="M8 7V4a4 4 0 0 1 8 0v3" stroke="#fff" stroke-width="1.5" fill="none"/></svg>',
      video: '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="2" y="6" width="20" height="12" rx="2" fill="#00b294"/><path d="m10 9 5 3-5 3V9z" fill="#fff"/></svg>',
      vlc: '<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><ellipse cx="12" cy="21" rx="8" ry="1.8" fill="#333"/><path d="M10 20 L7 11 L12 3 L17 11 L14 20 Z" fill="#ff6600"/><path d="M8.6 13 L12 8 L15.4 13 L14.4 15 L12 11.5 L9.6 15 Z" fill="#fff" opacity="0.9"/></svg>',
      app: '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="4" y="4" width="16" height="16" rx="2" fill="#0078d4"/></svg>'
    };
    return icons[icon] || icons.app;
  }

  function openWindow(app) {
    if (windows[app] && !windows[app].minimized) {
      focusWindow(app);
      return;
    }
    if (windows[app] && windows[app].minimized) {
      windows[app].minimized = false;
      windows[app].el.classList.remove('minimized');
      focusWindow(app);
      return;
    }

    var cfg = getAppConfig(app);
    var container = document.getElementById('windowContainer');
    var win = document.createElement('div');
    win.className = 'window';
    win.id = 'win-' + app;

    // 初始位置
    var offsetX = 40 + (windowCounter * 24);
    var offsetY = 40 + (windowCounter * 24);
    win.style.left = Math.min(offsetX, window.innerWidth - cfg.w - 40) + 'px';
    win.style.top = Math.min(offsetY, window.innerHeight - cfg.h - 80) + 'px';
    win.style.width = cfg.w + 'px';
    win.style.height = cfg.h + 'px';
    windowCounter++;

    win.innerHTML =
      '<div class="win-titlebar">' +
        '<div class="win-title-icon">' + getIconSvg(cfg.icon) + '</div>' +
        '<div class="win-title-text">' + cfg.title + '</div>' +
        '<div class="win-controls">' +
          '<button class="win-btn" data-action="min" title="最小化"><svg viewBox="0 0 10 10" xmlns="http://www.w3.org/2000/svg"><rect x="1" y="4.5" width="8" height="1" fill="currentColor"/></svg></button>' +
          '<button class="win-btn" data-action="max" title="最大化"><svg viewBox="0 0 10 10" xmlns="http://www.w3.org/2000/svg"><rect x="1.5" y="1.5" width="7" height="7" fill="none" stroke="currentColor" stroke-width="1"/></svg></button>' +
          '<button class="win-btn close" data-action="close" title="关闭"><svg viewBox="0 0 10 10" xmlns="http://www.w3.org/2000/svg"><path d="M1 1 L9 9 M9 1 L1 9" stroke="currentColor" stroke-width="1" fill="none"/></svg></button>' +
        '</div>' +
      '</div>' +
      (cfg.hasToolbar ?
        (cfg.type === 'browser' ?
          '<div class="win-toolbar" id="toolbar-' + app + '">' +
            '<div class="win-nav-btn" id="back-' + app + '" title="后退"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 6-6 6 6 6"/></svg></div>' +
            '<div class="win-nav-btn" id="fwd-' + app + '" title="前进"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6"/></svg></div>' +
            '<div class="win-nav-btn" id="refresh-' + app + '" title="刷新"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 4v5h-5"/></svg></div>' +
            '<input class="win-address" id="addr-' + app + '" type="text" value="https://www.bing.com" spellcheck="false">' +
            '<div class="win-nav-btn" id="sc-toggle-' + app + '" title="显示/隐藏快捷方式" style="font-size:13px;font-weight:bold;color:#ffd700;">🔽 快捷</div>' +
          '</div>' :
          '<div class="win-toolbar">' +
            '<div class="win-nav-btn" title="后退"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 6-6 6 6 6"/></svg></div>' +
            '<div class="win-nav-btn" title="前进"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6"/></svg></div>' +
            '<div class="win-nav-btn" title="向上"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 15 6-6 6 6"/></svg></div>' +
            '<div class="win-address">此电脑</div>' +
          '</div>') : '') +
      '<div class="win-body">' +
        (cfg.hasSidebar ?
          '<div class="win-sidebar">' +
            '<div class="win-sidebar-item active"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="4" y="5" width="16" height="13" rx="1" fill="currentColor"/></svg>快速访问</div>' +
            '<div class="win-sidebar-item"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h4l2 2h9A1.5 1.5 0 0 1 21 8.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5v-11z" fill="currentColor"/></svg>桌面</div>' +
            '<div class="win-sidebar-item"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 3h9l4 4v14a0.5 0.5 0 0 1-0.5 0.5h-13A0.5 0.5 0 0 1 5 21V3.5A0.5 0.5 0 0 1 5.5 3z" fill="currentColor"/></svg>下载</div>' +
            '<div class="win-sidebar-item"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 3h9l4 4v14a0.5 0.5 0 0 1-0.5 0.5h-13A0.5 0.5 0 0 1 5 21V3.5A0.5 0.5 0 0 1 5.5 3z" fill="currentColor"/></svg>文档</div>' +
            '<div class="win-sidebar-item"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="4" width="18" height="14" rx="1.5" fill="currentColor"/></svg>此电脑</div>' +
            '<div class="win-sidebar-item"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5 7h14l-1.5 13a1.5 1.5 0 0 1-1.5 1.5H8A1.5 1.5 0 0 1 6.5 20L5 7z" fill="currentColor"/></svg>回收站</div>' +
            '<div class="win-sidebar-item"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z" fill="currentColor"/></svg>网络</div>' +
          '</div>' : '') +
        '<div class="win-content" id="content-' + app + '"></div>' +
      '</div>' +
      (cfg.type === 'explorer' ? '<div class="win-statusbar"><span id="status-' + app + '">0 个项目</span></div>' : '') +
      '<div class="window-resize-handle" id="resize-' + app + '"></div>';

    container.appendChild(win);
    windows[app] = { el: win, minimized: false, maximized: false };
    focusWindow(app);

    // 内容填充
    renderAppContent(app, cfg.type);

    // 拖拽
    var titlebar = win.querySelector('.win-titlebar');
    var isDragging = false;
    var dragOffset = { x: 0, y: 0 };
    titlebar.addEventListener('mousedown', function(e) {
      if (e.target.closest('.win-btn')) return;
      if (windows[app].maximized) return;
      isDragging = true;
      var rect = win.getBoundingClientRect();
      dragOffset.x = e.clientX - rect.left;
      dragOffset.y = e.clientY - rect.top;
      focusWindow(app);
      e.preventDefault();
    });
    document.addEventListener('mousemove', function(e) {
      if (!isDragging) return;
      var x = e.clientX - dragOffset.x;
      var y = e.clientY - dragOffset.y;
      win.style.left = Math.max(0, Math.min(x, window.innerWidth - 100)) + 'px';
      win.style.top = Math.max(0, Math.min(y, window.innerHeight - 80)) + 'px';
    });
    document.addEventListener('mouseup', function() { isDragging = false; });

    // 窗口 resize
    var resizeHandle = document.getElementById('resize-' + app);
    var isResizing = false;
    var resizeStart = { x: 0, y: 0, w: 0, h: 0 };
    resizeHandle.addEventListener('mousedown', function(e) {
      if (windows[app].maximized) return;
      isResizing = true;
      resizeStart.x = e.clientX;
      resizeStart.y = e.clientY;
      var rect = win.getBoundingClientRect();
      resizeStart.w = rect.width;
      resizeStart.h = rect.height;
      focusWindow(app);
      e.preventDefault();
      e.stopPropagation();
    });
    document.addEventListener('mousemove', function(e) {
      if (!isResizing) return;
      var newW = Math.max(400, resizeStart.w + (e.clientX - resizeStart.x));
      var newH = Math.max(280, resizeStart.h + (e.clientY - resizeStart.y));
      win.style.width = newW + 'px';
      win.style.height = newH + 'px';
    });
    document.addEventListener('mouseup', function() { isResizing = false; });

    // 标题栏按钮
    win.querySelectorAll('.win-btn').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        var action = btn.getAttribute('data-action');
        if (action === 'min') minimizeWindow(app);
        if (action === 'max') toggleMaximize(app);
        if (action === 'close') closeWindow(app);
      });
    });

    // 点击聚焦
    win.addEventListener('mousedown', function() { focusWindow(app); });

    // 更新任务栏高亮
    updatePinnedActive();
  }

  function focusWindow(app) {
    if (!windows[app]) return;
    zIndexCounter++;
    windows[app].el.style.zIndex = zIndexCounter;
  }

  function minimizeWindow(app) {
    if (!windows[app]) return;
    windows[app].minimized = true;
    windows[app].el.classList.add('minimized');
    updatePinnedActive();
  }

  function toggleMaximize(app) {
    if (!windows[app]) return;
    var w = windows[app];
    if (w.maximized) {
      w.el.classList.remove('maximized');
      w.maximized = false;
    } else {
      w.el.classList.add('maximized');
      w.maximized = true;
    }
  }

  function closeWindow(app) {
    if (!windows[app]) return;
    windows[app].el.remove();
    delete windows[app];
    updatePinnedActive();
  }

  function updatePinnedActive() {
    document.querySelectorAll('.pinned-app').forEach(function(el) {
      var app = el.getAttribute('data-app');
      if (windows[app] && !windows[app].minimized) {
        el.classList.add('active');
      } else {
        el.classList.remove('active');
      }
    });
  }

  // ===== 文件系统数据 =====
