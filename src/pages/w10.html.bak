  // 记录当前每个 explorer 窗口的路径
  var explorerPaths = {};

  // 记录每个浏览器窗口的快捷方式显示状态
  var browserShortcutsVisible = {};

  // 桌面文件数组（保存到网页桌面的文件）
  var desktopFiles = [];
  var desktopIconPositions = {}; // { id: {row, col} }

  // 加载桌面文件位置
  function loadDesktopPositions() {
    try {
      var saved = localStorage.getItem('w10_desktop_positions');
      if (saved) desktopIconPositions = JSON.parse(saved);
    } catch(e) {}
  }
  loadDesktopPositions();

  // 保存桌面文件位置
  function saveDesktopPositions() {
    try {
      localStorage.setItem('w10_desktop_positions', JSON.stringify(desktopIconPositions));
    } catch(e) {}
  }

  // 加载桌面文件内容
  function loadDesktopFiles() {
    try {
      var saved = localStorage.getItem('w10_desktop_files');
      if (saved) {
        desktopFiles = JSON.parse(saved);
        renderDesktopFiles();
      }
    } catch(e) {}
  }

  // 保存桌面文件内容
  function saveDesktopFiles() {
    try {
      localStorage.setItem('w10_desktop_files', JSON.stringify(desktopFiles));
    } catch(e) {}
  }

  // 初始化桌面图标拖动
  function initDesktopDrag() {
    var icons = document.querySelectorAll('#desktopFiles .d-icon');
    icons.forEach(function(icon) {
      makeDesktopIconDraggable(icon);
    });
  }

  function makeDesktopIconDraggable(icon) {
    var isDragging = false;
    var startX, startY, origX, origY;
    var gridSize = 90; // 网格大小

    icon.addEventListener('mousedown', function(e) {
      isDragging = false;
      startX = e.clientX;
      startY = e.clientY;
      // Get current position
      var rect = icon.getBoundingClientRect();
      var desktopRect = document.getElementById('desktop').getBoundingClientRect();
      origX = rect.left - desktopRect.left;
      origY = rect.top - desktopRect.top;
      icon.style.position = 'absolute';
      icon.style.left = origX + 'px';
      icon.style.top = origY + 'px';
      icon.style.margin = '0';
    });

    document.addEventListener('mousemove', function(e) {
      if (!isDragging) {
        // First mouse move - mark as dragging and prevent click
        if (Math.abs(e.clientX - startX) > 3 || Math.abs(e.clientY - startY) > 3) {
          isDragging = true;
          icon.classList.add('dragging');
          e.preventDefault();
        }
        return;
      }
      var dx = e.clientX - startX;
      var dy = e.clientY - startY;
      icon.style.left = (origX + dx) + 'px';
      icon.style.top = (origY + dy) + 'px';
    });

    document.addEventListener('mouseup', function(e) {
      if (!isDragging) return;
      isDragging = false;
      icon.classList.remove('dragging');
      // Snap to grid
      var currentLeft = parseFloat(icon.style.left) || 0;
      var currentTop = parseFloat(icon.style.top) || 0;
      var snappedLeft = Math.round(currentLeft / gridSize) * gridSize + 12;
      var snappedTop = Math.round(currentTop / gridSize) * gridSize + 12;
      icon.style.left = snappedLeft + 'px';
      icon.style.top = snappedTop + 'px';
      // Save position
      var id = icon.getAttribute('data-app') || icon.getAttribute('data-file-id');
      if (id) {
        desktopIconPositions[id] = { row: Math.round(currentTop / gridSize), col: Math.round(currentLeft / gridSize) };
        saveDesktopPositions();
      }
    });
  }

  // 删除桌面文件
    // 右键删除桌面文件
  function deleteSelectedDesktopFile() {
    var selected = document.querySelector('#desktopFiles .d-icon.selected');
    if (!selected) return;
    var name = selected.getAttribute('data-file-id');
    if (name && confirm('确定要删除 "' + name + '" 吗？')) {
      deleteDesktopFile(name);
    }
  }

  // 桌面文件右键菜单
  function showDesktopFileContextMenu(e, name) {
    e.preventDefault();
    e.stopPropagation();
    var ctxMenu = document.getElementById('contextMenu');
    if (!ctxMenu) return;
    // 高亮当前文件
    var icons = document.querySelectorAll('#desktopFiles .d-icon');
    icons.forEach(function(ic) { ic.classList.remove('selected'); });
    var target = e.currentTarget;
    target.classList.add('selected');
    // 存储当前文件名用于删除
    ctxMenu.setAttribute('data-target-file', name);
    // 显示删除项
    var delItem = document.getElementById('ctxDeleteFile');
    if (delItem) delItem.style.display = 'flex';
    // 显示菜单
    ctxMenu.style.left = e.clientX + 'px';
    ctxMenu.style.top = e.clientY + 'px';
    ctxMenu.classList.add('show');
  }

  function deleteDesktopFile(name) {
    for (var i = 0; i < desktopFiles.length; i++) {
      if (desktopFiles[i].name === name) {
        desktopFiles.splice(i, 1);
        break;
      }
    }
    renderDesktopFiles();
    saveDesktopFiles();
  }

  // 渲染桌面文件图标
  function renderDesktopFiles() {
    var container = document.getElementById('desktopFiles');
    if (!container) return;
    container.innerHTML = '';
    var gridSize = 90;
    for (var i = 0; i < desktopFiles.length; i++) {
      (function(idx) {
        var f = desktopFiles[idx];
        var div = document.createElement('div');
        div.className = 'd-icon';
        div.title = f.name;
        div.setAttribute('data-file-id', f.name);
        div.innerHTML =

          '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:44px;height:44px;">' +
            '<path d="M6 3h9l4 4v14a0.5 0.5 0 0 1-0.5 0.5h-13A0.5 0.5 0 0 1 5 21V3.5A0.5 0.5 0 0 1 5.5 3z" fill="#fff" stroke="#0078d4" stroke-width="1.2"/>' +
            '<path d="M8 11h8M8 14h8M8 17h5" stroke="#0078d4" stroke-width="1.2" stroke-linecap="round"/>' +
          '</svg>' +
          '<span>' + f.name + '</span>';
        // 恢复保存的位置
        var pos = desktopIconPositions[f.name];
        if (pos) {
          div.style.position = 'absolute';
          div.style.left = (pos.col * gridSize + 12) + 'px';
          div.style.top = (pos.row * gridSize + 12) + 'px';
          div.style.margin = '0';
        }
        // 双击打开
        div.addEventListener('dblclick', function() {
          openNotepadWithFile(f.name, f.content);
        });
        // 右键菜单
        div.addEventListener('contextmenu', function(e) {
          showDesktopFileContextMenu(e, f.name);
        });

        // 单击选中
        div.addEventListener('click', function(e) {
          e.stopPropagation();
          var icons = document.querySelectorAll('.d-icon');
          icons.forEach(function(ic) { ic.classList.remove('selected'); });
          div.classList.add('selected');
        });
        container.appendChild(div);
        // 启用拖动
        makeDesktopIconDraggable(div);
      })(i);
    }
  }

  // 获取文件后缀
  function getFileExt(name) {
    var idx = name.lastIndexOf('.');
    if (idx < 0) return '';
    return name.substring(idx + 1).toLowerCase();
  }

  // 判断是否为图片类型
  function isImageFile(name) {
    var ext = getFileExt(name);
    return ['png', 'jpg', 'jpeg', 'gif', 'webp', 'bmp'].indexOf(ext) >= 0;
  }

  // 判断是否为视频类型
  function isVideoFile(name) {
    var ext = getFileExt(name);
    return ['mp4', 'avi', 'mkv', 'mov'].indexOf(ext) >= 0;
  }

  // 判断是否为文本类型
  function isTextFile(name) {
    var ext = getFileExt(name);
    return ext === 'txt';
  }

  // 打开文件（根据后缀关联应用）
  function openFileByType(fileItem) {
    var name = fileItem.name;
    if (isTextFile(name)) {
      // txt → 记事本
      openNotepadWithFile(name, fileItem.content || '');
    } else if (isImageFile(name)) {
      // 图片 → 照片应用
      openPhotosWithFile(name);
    } else if (isVideoFile(name)) {
      // 视频 → 打开方式对话框
      showOpenWithDialog(name, fileItem);
    } else {
      // 其他类型 → 提示
      alert('无法打开此文件：' + name + '\n没有关联的应用程序。');
    }
  }

  // 用记事本打开文件
  function openNotepadWithFile(filename, content) {
    // 如果记事本已打开，直接更新内容
    if (windows['notepad'] && !windows['notepad'].minimized) {
      focusWindow('notepad');
    } else if (windows['notepad'] && windows['notepad'].minimized) {
      windows['notepad'].minimized = false;
      windows['notepad'].el.classList.remove('minimized');
      focusWindow('notepad');
    } else {
      openWindow('notepad');
    }
    // 延迟设置内容（等待窗口创建）
    setTimeout(function() {
      var ta = document.getElementById('notepad-textarea');
      if (ta) {
        ta.value = content;
        notepadState.filename = filename;
        notepadState.dirty = false;
        notepadState.content = content;
        updateNotepadTitle();
      }
    }, 50);
  }

  // 用照片应用打开图片
  function openPhotosWithFile(filename) {
    if (windows['photos'] && !windows['photos'].minimized) {
      focusWindow('photos');
    } else if (windows['photos'] && windows['photos'].minimized) {
      windows['photos'].minimized = false;
      windows['photos'].el.classList.remove('minimized');
      focusWindow('photos');
    } else {
      openWindow('photos');
    }
    setTimeout(function() {
      var pv = document.getElementById('photo-viewer');
      if (pv) {
        pv.setAttribute('data-file', filename);
        var fn = pv.querySelector('.photo-filename');
        if (fn) fn.textContent = filename;
      }
      // 更新窗口标题
      var winEl = windows['photos'] ? windows['photos'].el : null;
      if (winEl) {
        var titleEl = winEl.querySelector('.win-title-text');
        if (titleEl) titleEl.textContent = filename + ' - 照片';
      }
    }, 50);
  }

  // VLC 打开视频文件
  function openVLCWithVideo(filename) {
    if (windows['vlc'] && !windows['vlc'].minimized) {
      focusWindow('vlc');
    } else if (windows['vlc'] && windows['vlc'].minimized) {
      windows['vlc'].minimized = false;
      windows['vlc'].el.classList.remove('minimized');
      focusWindow('vlc');
    } else {
      openWindow('vlc');
    }
    setTimeout(function() {
      var statusBar = document.getElementById('vlc-status-vlc');
      if (statusBar) statusBar.textContent = '正在播放: ' + filename + ' （视频占位）';
      var logo = document.getElementById('vlc-logo-vlc');
      var video = document.getElementById('vlc-video-vlc');
      if (logo) {
        logo.innerHTML = '<div style="text-align:center;">' +
          '<div style="width:200px;height:140px;background:linear-gradient(135deg,#1a1a2e,#16213e);border-radius:4px;display:flex;align-items:center;justify-content:center;margin-bottom:10px;">' +
          '<svg width="40" height="40" viewBox="0 0 24 24" fill="#fff" opacity="0.3"><path d="m10 9 5 3-5 3V9z"/></svg>' +
          '</div>' +
          '<div style="font-size:13px;color:#888;">' + filename + '</div>' +
          '<div style="font-size:11px;color:#666;margin-top:4px;">视频占位 - 无法解码</div>' +
          '</div>';
      }
    }, 50);
  }

  // 电影和电视 打开视频
  function openMoviesTvWithVideo(filename) {
    // 复用 photos 窗口样式播放视频
    if (windows['photos'] && !windows['photos'].minimized) {
      focusWindow('photos');
    } else if (windows['photos'] && windows['photos'].minimized) {
      windows['photos'].minimized = false;
      windows['photos'].el.classList.remove('minimized');
      focusWindow('photos');
    } else {
      openWindow('photos');
    }
    setTimeout(function() {
      var pv = document.getElementById('photo-viewer');
      if (pv) {
        pv.setAttribute('data-file', filename);
        var body = pv.querySelector('.photo-viewer-body');
        if (body) {
          body.innerHTML = '<div style="text-align:center;">' +
            '<div class="photo-placeholder">' +
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="5 3 19 12 5 21 5 3" fill="currentColor" opacity="0.3"/></svg>' +
            '<span>视频占位 - 无法播放</span>' +
            '</div>' +
            '<div class="photo-filename" style="margin-top:12px;">' + filename + '</div>' +
            '</div>';
        }
      }
      var winEl = windows['photos'] ? windows['photos'].el : null;
      if (winEl) {
        var titleEl = winEl.querySelector('.win-title-text');
        if (titleEl) titleEl.textContent = filename + ' - 电影和电视';
      }
    }, 50);
  }

  // ===== 打开方式对话框 =====
  function showOpenWithDialog(filename, fileItem) {
    var overlay = document.createElement('div');
    overlay.className = 'owd-overlay';
    var dialog = document.createElement('div');
    dialog.className = 'open-with-dialog';

    var moviesTvIcon = '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="2" y="5" width="20" height="14" rx="2" fill="#0078d4"/><path d="m10 9 5 3-5 3V9z" fill="#fff"/></svg>';
    var vlcIcon = '<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><ellipse cx="12" cy="21" rx="8" ry="1.8" fill="#333"/><path d="M10 20 L7 11 L12 3 L17 11 L14 20 Z" fill="#ff6600"/><path d="M8.6 13 L12 8 L15.4 13 L14.4 15 L12 11.5 L9.6 15 Z" fill="#fff" opacity="0.9"/></svg>';

    dialog.innerHTML =
      '<div class="owd-titlebar">' +
        '<div class="owd-title-text">你要如何打开这个文件？</div>' +
        '<div class="owd-close" id="owd-close">✕</div>' +
      '</div>' +
      '<div class="owd-body">' +
        '<div class="owd-desc">.<span id="owd-ext">' + getFileExt(filename) + '</span> 文件 - 选择一个应用以打开 "' + filename + '"</div>' +
        '<div class="owd-option" data-app="moviestv">' +
          moviesTvIcon +
          '<div><div class="owd-option-name">电影和电视</div><div class="owd-option-sub">Windows 默认视频播放器</div></div>' +
        '</div>' +
        '<div class="owd-option" data-app="vlc">' +
          vlcIcon +
          '<div><div class="owd-option-name">VLC media player</div><div class="owd-option-sub">开源多媒体播放器</div></div>' +
        '</div>' +
        '<label class="owd-always">' +
          '<input type="checkbox" id="owd-always">' +
          '<span>始终使用此应用打开 .' + getFileExt(filename) + ' 文件</span>' +
        '</label>' +
        '<div class="owd-buttons">' +
          '<button class="owd-btn" id="owd-cancel">取消</button>' +
          '<button class="owd-btn primary" id="owd-ok" disabled style="opacity:0.5;">确定</button>' +
        '</div>' +
      '</div>';

    document.body.appendChild(overlay);
    document.body.appendChild(dialog);

    var selectedApp = null;
    var options = dialog.querySelectorAll('.owd-option');
    var okBtn = dialog.querySelector('#owd-ok');

    function selectOption(app) {
      selectedApp = app;
      options.forEach(function(o) {
        if (o.getAttribute('data-app') === app) {
          o.style.borderColor = '#0078d4';
          o.style.background = '#e5f3ff';
        } else {
          o.style.borderColor = '#d0d0d0';
          o.style.background = '#fff';
        }
      });
      okBtn.disabled = false;
      okBtn.style.opacity = '1';
    }

    options.forEach(function(opt) {
      opt.addEventListener('click', function() {
        selectOption(opt.getAttribute('data-app'));
      });
    });

    function closeDialog() {
      overlay.remove();
      dialog.remove();
    }

    dialog.querySelector('#owd-close').addEventListener('click', closeDialog);
    dialog.querySelector('#owd-cancel').addEventListener('click', closeDialog);
    overlay.addEventListener('click', closeDialog);

    okBtn.addEventListener('click', function() {
      if (!selectedApp) return;
      if (selectedApp === 'moviestv') {
        openMoviesTvWithVideo(filename);
      } else if (selectedApp === 'vlc') {
        openVLCWithVideo(filename);
      }
      closeDialog();
    });

    // 双击选项直接打开
    options.forEach(function(opt) {
      opt.addEventListener('dblclick', function() {
        selectOption(opt.getAttribute('data-app'));
        okBtn.click();
      });
    });
  }

  // ===== 记事本状态 =====
  var notepadState = {
    filename: null,
    dirty: false,
    content: ''
  };

  var calcState = { display: '0', prev: null, op: null, reset: false, dot: false };

  function updateNotepadTitle() {
    var winEl = windows['notepad'] ? windows['notepad'].el : null;
    if (!winEl) return;
    var titleEl = winEl.querySelector('.win-title-text');
    if (!titleEl) return;
    var name = notepadState.filename || '无标题';
    var star = notepadState.dirty ? '*' : '';
    titleEl.textContent = star + name + ' - 记事本';
  }

  // ===== 应用内容 =====
  function renderAppContent(app, type) {
    var content = document.getElementById('content-' + app);
    if (!content) return;

    if (type === 'explorer') {
      // 初始路径
      var initPath = '此电脑';
      if (app === 'documents') initPath = '文档';
      if (app === 'recycle') initPath = '回收站';
      explorerPaths[app] = initPath;

      function renderExplorer() {
        var currentPath = explorerPaths[app];
        var folder = fileSystem[currentPath];
        var files = folder ? folder.items : [];

        // 更新地址栏
        var addrEl = win.querySelector('.win-address');
        if (addrEl && addrEl.tagName !== 'INPUT') {
          addrEl.textContent = currentPath;
        }

        var html = '<div class="file-grid">';
        files.forEach(function(f, idx) {
          var icon = '';
          if (f.type === 'folder') icon = '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h4l2 2h9A1.5 1.5 0 0 1 21 8.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5v-11z" fill="#ffc83d"/></svg>';
          else if (f.type === 'drive') icon = '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="6" width="18" height="12" rx="1" fill="#5c5c5c"/><circle cx="18" cy="12" r="1" fill="#fff"/></svg>';
          else if (f.type === 'text') icon = '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 3h9l4 4v14a0.5 0.5 0 0 1-0.5 0.5h-13A0.5 0.5 0 0 1 5 21V3.5A0.5 0.5 0 0 1 5.5 3z" fill="#fff" stroke="#0078d4" stroke-width="1.2"/></svg>';
          else if (f.type === 'word') icon = '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 3h9l4 4v14a0.5 0.5 0 0 1-0.5 0.5h-13A0.5 0.5 0 0 1 5 21V3.5A0.5 0.5 0 0 1 5.5 3z" fill="#2b579a"/><text x="12" y="17" text-anchor="middle" fill="#fff" font-size="9" font-weight="bold" font-family="Arial">W</text></svg>';
          else if (f.type === 'excel') icon = '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 3h9l4 4v14a0.5 0.5 0 0 1-0.5 0.5h-13A0.5 0.5 0 0 1 5 21V3.5A0.5 0.5 0 0 1 5.5 3z" fill="#217346"/><text x="12" y="17" text-anchor="middle" fill="#fff" font-size="9" font-weight="bold" font-family="Arial">X</text></svg>';
          else if (f.type === 'image') icon = '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="5" width="18" height="14" rx="1" fill="#d83b01"/><circle cx="10" cy="11" r="2.5" fill="#fff"/><path d="m21 17-5-5-9 9" stroke="#fff" stroke-width="1.2" fill="none"/></svg>';
          else if (f.type === 'video') icon = '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="2" y="6" width="20" height="12" rx="2" fill="#5c2d91"/><path d="m10 9 5 3-5 3V9z" fill="#fff"/></svg>';
          else if (f.type === 'audio') icon = '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 18V5l12-2v13" fill="#107c10"/><circle cx="6" cy="18" r="3" fill="#fff"/><circle cx="18" cy="16" r="3" fill="#fff"/></svg>';
          else icon = '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="5" width="18" height="14" rx="1" fill="#5c5c5c"/></svg>';
          html += '<div class="file-item" data-idx="' + idx + '">' + icon + '<span>' + f.name + '</span></div>';
        });
        html += '</div>';
        content.innerHTML = html;
        var status = document.getElementById('status-' + app);
        if (status) status.textContent = files.length + ' 个项目';

        // 绑定双击事件
        var fileItems = content.querySelectorAll('.file-item');
        fileItems.forEach(function(item) {
          item.addEventListener('dblclick', function() {
            var idx = parseInt(item.getAttribute('data-idx'));
            var f = files[idx];
            if (!f) return;
            if (f.type === 'folder' || f.type === 'drive') {
              // 进入文件夹/驱动器
              if (fileSystem[f.name]) {
                explorerPaths[app] = f.name;
                renderExplorer();
              }
            } else {
              // 打开文件
              openFileByType(f);
            }
          });
        });
      }

      var win = windows[app] ? windows[app].el : null;
      renderExplorer();

      // 绑定后退/向上按钮
      if (win) {
        var navBtns = win.querySelectorAll('.win-nav-btn');
        if (navBtns.length >= 3) {
          // 第三个是向上按钮
          navBtns[2].addEventListener('click', function() {
            // 简化版：始终回到"此电脑"
            if (explorerPaths[app] !== '此电脑') {
              explorerPaths[app] = '此电脑';
              renderExplorer();
            }
          });
        }
        if (navBtns.length >= 1) {
          navBtns[0].addEventListener('click', function() {
            if (explorerPaths[app] !== '此电脑') {
              explorerPaths[app] = '此电脑';
              renderExplorer();
            }
          });
        }
      }
    }
    else if (type === 'browser') {
      content.style.padding = '0';
      content.style.display = 'flex';
      content.style.flexDirection = 'column';
      content.style.background = '#fff';

      var shortcuts = [
        { name: '百度', url: 'https://www.baidu.com', color: '#2932e1' },
        { name: '微博', url: 'https://weibo.com', color: '#e6162d' },
        { name: 'B站', url: 'https://www.bilibili.com', color: '#fb7299' },
        { name: '知乎', url: 'https://www.zhihu.com', color: '#0066ff' },
        { name: '淘宝', url: 'https://www.taobao.com', color: '#ff5000' },
        { name: '京东', url: 'https://www.jd.com', color: '#e1251b' },
        { name: 'GitHub', url: 'https://github.com', color: '#24292e' },
        { name: 'CSDN', url: 'https://www.csdn.net', color: '#fc5531' }
      ];

      content.innerHTML =
        '<div id="browser-page-' + app + '" style="flex:1;position:relative;background:#fff;">' +
          '<iframe id="browser-iframe-' + app + '" src="https://www.bing.com" style="width:100%;height:100%;border:0;display:block;" sandbox="allow-same-origin allow-scripts allow-forms allow-popups allow-popups-to-escape-sandbox"></iframe>' +
        '</div>' +
        '<div id="browser-shortcuts-' + app + '" style="padding:12px 20px 14px;background:#f9f9f9;border-top:1px solid #e5e5e5;flex-shrink:0;">' +
          '<div style="font-size:12px;color:#666;margin-bottom:8px;">快速链接</div>' +
          '<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;">' +
            shortcuts.map(function(s, i) {
              return '<div class="sc-' + app + '" data-idx="' + i + '" style="padding:10px 6px;background:#fff;border:1px solid #e5e5e5;border-radius:4px;cursor:pointer;text-align:center;transition:all 0.15s;">' +
                '<div style="width:28px;height:28px;margin:0 auto 4px;border-radius:6px;background:' + s.color + ';display:flex;align-items:center;justify-content:center;color:#fff;font-size:11px;font-weight:600;">' + s.name.charAt(0) + '</div>' +
                '<div style="font-size:11px;color:#333;">' + s.name + '</div>' +
              '</div>';
            }).join('') +
          '</div>' +
        '</div>';

      // 浏览器状态
      var browserState = {
        history: ['https://www.bing.com'],
        historyIndex: 0
      };

      function navigateTo(url, addHistory) {
        if (addHistory !== false) {
          // 如果不是在历史末尾，清除后面的历史
          if (browserState.historyIndex < browserState.history.length - 1) {
            browserState.history = browserState.history.slice(0, browserState.historyIndex + 1);
          }
          browserState.history.push(url);
          browserState.historyIndex = browserState.history.length - 1;
        }
        // 更新地址栏
        var addrInput = document.getElementById('addr-' + app);
        if (addrInput) addrInput.value = url;

        // 更新 iframe
        var iframe = document.getElementById('browser-iframe-' + app);
        if (iframe) {
          iframe.src = url;
        }
        updateNavButtons();
      }

      function updateNavButtons() {
        var backBtn = document.getElementById('back-' + app);
        var fwdBtn = document.getElementById('fwd-' + app);
        if (backBtn) backBtn.style.opacity = browserState.historyIndex > 0 ? '1' : '0.4';
        if (fwdBtn) fwdBtn.style.opacity = browserState.historyIndex < browserState.history.length - 1 ? '1' : '0.4';
      }

      function goBack() {
        if (browserState.historyIndex > 0) {
          browserState.historyIndex--;
          navigateTo(browserState.history[browserState.historyIndex], false);
        }
      }

      function goForward() {
        if (browserState.historyIndex < browserState.history.length - 1) {
          browserState.historyIndex++;
          navigateTo(browserState.history[browserState.historyIndex], false);
        }
      }

      function handleAddressSubmit() {
        var addrInput = document.getElementById('addr-' + app);
        if (!addrInput) return;
        var val = addrInput.value.trim();
        if (!val) return;

        // 如果包含 "." 且没有空格，认为是网址，否则是搜索词
        var url;
        if (val.indexOf('.') >= 0 && val.indexOf(' ') < 0) {
          // 网址
          if (val.indexOf('http://') !== 0 && val.indexOf('https://') !== 0) {
            url = 'https://' + val;
          } else {
            url = val;
          }
        } else {
          // 搜索词 -> 必应搜索
          url = 'https://www.bing.com/search?q=' + encodeURIComponent(val);
        }
        navigateTo(url, true);
      }

      // 绑定地址栏事件
      var addrInput = document.getElementById('addr-' + app);
      if (addrInput) {
        addrInput.addEventListener('keydown', function(e) {
          if (e.key === 'Enter') {
            e.preventDefault();
            handleAddressSubmit();
          }
        });
      }

      // 绑定后退/前进/刷新按钮
      var backBtn = document.getElementById('back-' + app);
      if (backBtn) backBtn.addEventListener('click', goBack);
      var fwdBtn = document.getElementById('fwd-' + app);
      if (fwdBtn) fwdBtn.addEventListener('click', goForward);
      var refreshBtn = document.getElementById('refresh-' + app);
      if (refreshBtn) {
        refreshBtn.addEventListener('click', function() {
          var iframe = document.getElementById('browser-iframe-' + app);
          if (iframe) {
            iframe.src = browserState.history[browserState.historyIndex];
          }
        });
      }

      // 绑定快捷方式点击
      var scItems = content.querySelectorAll('.sc-' + app);
      scItems.forEach(function(item) {
        item.addEventListener('click', function() {
          var idx = parseInt(item.getAttribute('data-idx'));
          var url = shortcuts[idx].url;
          navigateTo(url, true);
        });
        item.addEventListener('mouseenter', function() {
          item.style.borderColor = '#0078d4';
          item.style.transform = 'translateY(-2px)';
          item.style.boxShadow = '0 4px 8px rgba(0,0,0,0.1)';
        });
        item.addEventListener('mouseleave', function() {
          item.style.borderColor = '#e5e5e5';
          item.style.transform = '';
          item.style.boxShadow = '';
        });
      });

      // 初始化导航按钮状态
      updateNavButtons();

      // 快捷方式显示/隐藏切换
      browserShortcutsVisible[app] = true;
      var scToggleBtn = document.getElementById('sc-toggle-' + app);
      if (scToggleBtn) {
        updateScToggleBtn(app);
        scToggleBtn.addEventListener('click', function() {
          var scEl = document.getElementById('browser-shortcuts-' + app);
          if (!scEl) return;
          browserShortcutsVisible[app] = !browserShortcutsVisible[app];
          if (browserShortcutsVisible[app]) {
            scEl.style.display = '';
            scToggleBtn.style.opacity = '1';
            scToggleBtn.textContent = '🔽 快捷';
          } else {
            scEl.style.display = 'none';
            scToggleBtn.style.opacity = '0.6';
            scToggleBtn.textContent = '▶ 快捷';
          }
        });
      }
      function updateScToggleBtn(app) {
        var btn = document.getElementById('sc-toggle-' + app);
        if (btn) {
          if (browserShortcutsVisible[app]) {
            btn.textContent = '🔽 快捷';
            btn.style.opacity = '1';
          } else {
            btn.textContent = '▶ 快捷';
            btn.style.opacity = '0.6';
          }
        }
      }
    }
    else if (type === 'calc') {
      content.style.background = '#f0f0f0';
      content.style.padding = '0';
      content.innerHTML =
        '<div id="calc-display" style="padding:16px;text-align:right;font-size:32px;font-weight:300;background:#f0f0f0;color:#000;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">0</div>' +
        '<div id="calc-buttons" style="display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#ccc;">' +
        ['%','CE','C','⌫','1/x','x²','√','÷','7','8','9','×','4','5','6','-','1','2','3','+','±','0','.','='].map(function(k,i){
          var isOp = ['÷','×','-','+','='].indexOf(k) >= 0;
          var bg = isOp ? '#0078d4' : '#fafafa';
          var color = isOp ? '#fff' : '#000';
          return '<div data-calc-key="'+k+'" style="padding:14px 0;background:'+bg+';color:'+color+';text-align:center;cursor:pointer;font-size:16px;user-select:none;">' + k + '</div>';
        }).join('') +
        '</div>';
      // 计算器逻辑
      content.querySelector('#calc-buttons').addEventListener('click', function(e) {
        var key = e.target.getAttribute('data-calc-key');
        if (!key) return;
        var s = calcState;
        var d = s.display;
        if (key >= '0' && key <= '9') {
          if (s.reset || d === '0') { d = key; s.reset = false; s.dot = false; }
          else { d += key; }
        }
        else if (key === '.') {
          if (s.reset) { d = '0.'; s.reset = false; s.dot = true; }
          else if (!s.dot) { d += '.'; s.dot = true; }
        }
        else if (key === '±') {
          d = d.charAt(0) === '-' ? d.slice(1) : '-' + d;
        }
        else if (key === 'C' || key === 'CE') {
          d = '0'; s.prev = null; s.op = null; s.reset = false; s.dot = false;
        }
        else if (key === '⌫') {
          d = d.length > 1 ? d.slice(0, -1) : '0';
        }
        else if (key === '1/x') {
          d = (1 / parseFloat(d)).toString();
        }
        else if (key === 'x²') {
          d = (parseFloat(d) * parseFloat(d)).toString();
        }
        else if (key === '√') {
          d = Math.sqrt(parseFloat(d)).toString();
        }
        else if (key === '%') {
          d = (parseFloat(d) / 100).toString();
        }
        else if (['÷','×','-','+'].indexOf(key) >= 0) {
          if (s.op && !s.reset) {
            d = calcCompute(s.prev, d, s.op);
          }
          s.prev = d;
          s.op = key;
          s.reset = true;
          s.dot = false;
        }
        else if (key === '=') {
          if (s.op) {
            d = calcCompute(s.prev, d, s.op);
            s.op = null;
            s.prev = null;
          }
          s.reset = true;
          s.dot = d.indexOf('.') >= 0;
        }
        // 格式化显示
        var num = parseFloat(d);
        if (!isNaN(num)) {
          var parts = d.split('.');
          if (parts.length > 1) {
            d = num.toString();
            // 保留小数点
            if (d.indexOf('.') < 0) d += '.';
            d += parts[1];
          } else {
            d = num.toString();
          }
        }
        s.display = d;
        content.querySelector('#calc-display').textContent = d;
      });
      function calcCompute(a, b, op) {
        var x = parseFloat(a), y = parseFloat(b);
        switch(op) {
          case '÷': return (x / y).toString();
          case '×': return (x * y).toString();
          case '-': return (x - y).toString();
          case '+': return (x + y).toString();
          default: return b;
        }
      }
    }
    else if (type === 'notepad') {
      content.style.padding = '0';
      content.style.display = 'flex';
      content.style.flexDirection = 'column';
      content.style.background = '#fff';

      // 重置状态
      notepadState.filename = null;
      notepadState.dirty = false;
      notepadState.content = '';

      content.innerHTML =
        // 菜单栏
        '<div class="notepad-menubar" id="notepad-menubar">' +
          '<div class="notepad-menu-item" data-menu="file">文件(<u>F</u>)</div>' +
          '<div class="notepad-menu-item" data-menu="edit">编辑(<u>E</u>)</div>' +
          '<div class="notepad-menu-item" data-menu="format">格式(<u>O</u>)</div>' +
          '<div class="notepad-menu-item" data-menu="view">查看(<u>V</u>)</div>' +
          '<div class="notepad-menu-item" data-menu="help">帮助(<u>H</u>)</div>' +
          // 文件下拉菜单
          '<div class="notepad-dropdown" id="notepad-dd-file">' +
            '<div class="notepad-dd-item" data-action="new">新建<span class="notepad-dd-shortcut">Ctrl+N</span></div>' +
            '<div class="notepad-dd-item" data-action="open">打开...<span class="notepad-dd-shortcut">Ctrl+O</span></div>' +
            '<div class="notepad-dd-item" data-action="save">保存<span class="notepad-dd-shortcut">Ctrl+S</span></div>' +
            '<div class="notepad-dd-item" data-action="saveas">另存为...<span class="notepad-dd-shortcut">Ctrl+Shift+S</span></div>' +
            '<div class="notepad-dd-sep"></div>' +
            '<div class="notepad-dd-item disabled">页面设置...</div>' +
            '<div class="notepad-dd-item disabled">打印...<span class="notepad-dd-shortcut">Ctrl+P</span></div>' +
            '<div class="notepad-dd-sep"></div>' +
            '<div class="notepad-dd-item" data-action="exit">退出</div>' +
          '</div>' +
        '</div>' +
        // 文本区
        '<textarea class="notepad-textarea" id="notepad-textarea" spellcheck="false">欢迎使用记事本。\n\n在这里输入你的文字...\n\n---\nWindows 10 模拟桌面\n南洛的博客</textarea>' +
        // 状态栏
        '<div style="height:24px;background:#f0f0f0;border-top:1px solid #d0d0d0;display:flex;align-items:center;padding:0 12px;font-size:11px;color:#5a5a5a;flex-shrink:0;">' +
          '<span id="notepad-status">第 1 行，第 1 列</span>' +
          '<span style="flex:1;"></span>' +
          '<span>100%</span>' +
          '<span style="margin-left:16px;">Windows (CRLF)</span>' +
          '<span style="margin-left:16px;">UTF-8</span>' +
        '</div>';

      // 初始化状态
      var ta = document.getElementById('notepad-textarea');
      notepadState.content = ta.value;
      updateNotepadTitle();

      // 菜单栏交互
      var menuBar = document.getElementById('notepad-menubar');
      var menuItems = menuBar.querySelectorAll('.notepad-menu-item');
      var activeDropdown = null;

      function closeAllDropdowns() {
        menuBar.querySelectorAll('.notepad-dropdown').forEach(function(dd) {
          dd.classList.remove('show');
        });
        activeDropdown = null;
      }

      menuItems.forEach(function(item) {
        item.addEventListener('click', function(e) {
          e.stopPropagation();
          var menu = item.getAttribute('data-menu');
          var dd = document.getElementById('notepad-dd-' + menu);
          if (!dd) return;
          if (activeDropdown === dd) {
            closeAllDropdowns();
          } else {
            closeAllDropdowns();
            dd.classList.add('show');
            // 定位到菜单项下方
            var rect = item.getBoundingClientRect();
            var menuRect = menuBar.getBoundingClientRect();
            dd.style.left = (rect.left - menuRect.left) + 'px';
            activeDropdown = dd;
          }
        });
        item.addEventListener('mouseenter', function() {
          if (activeDropdown) {
            var menu = item.getAttribute('data-menu');
            var dd = document.getElementById('notepad-dd-' + menu);
            if (dd && dd !== activeDropdown) {
              closeAllDropdowns();
              dd.classList.add('show');
              var rect = item.getBoundingClientRect();
              var menuRect = menuBar.getBoundingClientRect();
              dd.style.left = (rect.left - menuRect.left) + 'px';
              activeDropdown = dd;
            }
          }
        });
      });

      document.addEventListener('click', function() {
        closeAllDropdowns();
      });

      // 下拉菜单项点击
      var ddItems = document.querySelectorAll('#notepad-dd-file .notepad-dd-item:not(.disabled)');
      ddItems.forEach(function(item) {
        item.addEventListener('click', function(e) {
          e.stopPropagation();
          var action = item.getAttribute('data-action');
          closeAllDropdowns();
          if (action === 'new') notepadNew();
          else if (action === 'open') notepadOpen();
          else if (action === 'save') notepadSave();
          else if (action === 'saveas') notepadSaveAs();
          else if (action === 'exit') closeWindow('notepad');
        });
      });

      // 新建
      function notepadNew() {
        if (notepadState.dirty) {
          if (!confirm('是否保存更改到 ' + (notepadState.filename || '无标题') + '？')) {
            // 用户取消，不新建
            return;
          }
          // 保存当前
          notepadSave();
        }
        ta.value = '';
        notepadState.filename = null;
        notepadState.dirty = false;
        notepadState.content = '';
        updateNotepadTitle();
        updateNotepadStatus();
      }

      // 打开
      function notepadOpen() {
        if (notepadState.dirty) {
          if (!confirm('是否保存更改到 ' + (notepadState.filename || '无标题') + '？')) {
            return;
          }
        }
        var fileInput = document.getElementById('notepadFileInput');
        fileInput.value = '';
        fileInput.click();
      }

      // 文件选择（已在全局绑定）

      // 保存
      function notepadSave() {
        showSaveDialog(notepadState.filename || '新建文本文档.txt');
      }

      // 另存为
      function notepadSaveAs() {
        showSaveDialog(notepadState.filename || '新建文本文档.txt');
      }

      // 显示保存对话框
      function showSaveDialog(defaultName) {
        var dlg = document.getElementById('saveDialog');
        var inner = document.getElementById('saveDialogInner');
        var nameInput = document.getElementById('saveDlgFilename');
        if (!dlg || !nameInput) return;
        nameInput.value = defaultName;
        // 重置位置：放在记事本窗口附近，避免与文档窗口重叠
        if (inner) {
          inner.style.position = '';
          inner.style.left = '';
          inner.style.top = '';
          inner.style.margin = '';
          // 如果记事本窗口存在，放在记事本窗口旁边
          var notepadWin = document.getElementById('win-notepad');
          if (notepadWin) {
            var nr = notepadWin.getBoundingClientRect();
            inner.style.position = 'fixed';
            inner.style.left = (nr.right + 20) + 'px';
            inner.style.top = (nr.top + 60) + 'px';
            inner.style.margin = '0';
          }
        }
        dlg.style.display = 'flex';
        setTimeout(function() { nameInput.focus(); nameInput.select(); }, 50);
      }

      // 保存对话框 - 执行保存
      function executeSave() {
        var nameInput = document.getElementById('saveDlgFilename');
        var radios = document.querySelectorAll('input[name="saveOpt"]:checked');
        var name = nameInput ? nameInput.value.trim() : '';
        if (!name) {
          nameInput.focus();
          return;
        }
        if (name.lastIndexOf('.txt') !== name.length - 4) {
          name += '.txt';
        }
        var option = radios.length > 0 ? radios[0].value : 'desktop';
        var content = ta.value;

        if (option === 'desktop') {
          // 保存到网页桌面
          var found = false;
          for (var i = 0; i < desktopFiles.length; i++) {
            if (desktopFiles[i].name === name) {
              desktopFiles[i].content = content;
              found = true;
              break;
            }
          }
          if (!found) {
            desktopFiles.push({ name: name, content: content });
          }
          renderDesktopFiles();
          saveDesktopFiles();
          notepadState.filename = name;
          notepadState.dirty = false;
          notepadState.content = content;
          updateNotepadTitle();
        } else {
          // 下载到本地
          downloadTextFile(content, name);
          notepadState.filename = name;
          notepadState.dirty = false;
          notepadState.content = content;
          updateNotepadTitle();
        }

        hideSaveDialog();
      }

      // 隐藏保存对话框
      function hideSaveDialog() {
        var dlg = document.getElementById('saveDialog');
        if (dlg) dlg.style.display = 'none';
      }

      // 保存对话框拖动
      

      // 绑定保存对话框按钮（只绑定一次）
      if (!window._saveDlgBound) {
        window._saveDlgBound = true;
        var saveDlgOk = document.getElementById('saveDlgOk');
        var saveDlgCancel = document.getElementById('saveDlgCancel');
        var saveDlgClose = document.getElementById('saveDlgClose');
        var saveDlgFilename = document.getElementById('saveDlgFilename');
        if (saveDlgOk) saveDlgOk.addEventListener('click', executeSave);
        if (saveDlgCancel) saveDlgCancel.addEventListener('click', hideSaveDialog);
        if (saveDlgClose) saveDlgClose.addEventListener('click', hideSaveDialog);
        if (saveDlgFilename) {
          saveDlgFilename.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
              e.preventDefault();
              executeSave();
            } else if (e.key === 'Escape') {
              hideSaveDialog();
            }
          });
        }
        // 选项 hover 效果
        var saveOptDesktop = document.getElementById('saveOptDesktop');
        var saveOptDownload = document.getElementById('saveOptDownload');
        if (saveOptDesktop) {
          saveOptDesktop.addEventListener('mouseenter', function() {
            saveOptDesktop.style.borderColor = '#0078d4';
            saveOptDesktop.style.background = '#e5f3ff';
          });
          saveOptDesktop.addEventListener('mouseleave', function() {
            saveOptDesktop.style.borderColor = '#e0e0e0';
            saveOptDesktop.style.background = '#f9f9f9';
          });
        }
        if (saveOptDownload) {
          saveOptDownload.addEventListener('mouseenter', function() {
            saveOptDownload.style.borderColor = '#0078d4';
            saveOptDownload.style.background = '#e5f3ff';
          });
          saveOptDownload.addEventListener('mouseleave', function() {
            saveOptDownload.style.borderColor = '#e0e0e0';
            saveOptDownload.style.background = '#f9f9f9';
          });
        }
      }

      // 初始化保存对话框拖动
      initSaveDialogDrag();

      // 下载文本文件
      function downloadTextFile(text, filename) {
        var blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        setTimeout(function() { URL.revokeObjectURL(url); }, 100);
      }

      // 文本变化检测
      ta.addEventListener('input', function() {
        if (ta.value !== notepadState.content) {
          notepadState.dirty = true;
        } else {
          notepadState.dirty = false;
        }
        updateNotepadTitle();
        updateNotepadStatus();
      });

      ta.addEventListener('keyup', updateNotepadStatus);
      ta.addEventListener('click', updateNotepadStatus);

      function updateNotepadStatus() {
        var statusEl = document.getElementById('notepad-status');
        if (!statusEl) return;
        var pos = ta.selectionStart;
        var textBefore = ta.value.substring(0, pos);
        var line = textBefore.split('\n').length;
        var col = pos - textBefore.lastIndexOf('\n');
        statusEl.textContent = '第 ' + line + ' 行，第 ' + col + ' 列';
      }

      // 快捷键
      ta.addEventListener('keydown', function(e) {
        if (e.ctrlKey && e.key === 's') {
          e.preventDefault();
          notepadSave();
        } else if (e.ctrlKey && e.key === 'n') {
          e.preventDefault();
          notepadNew();
        } else if (e.ctrlKey && e.key === 'o') {
          e.preventDefault();
          notepadOpen();
        } else if (e.ctrlKey && e.shiftKey && e.key === 'S') {
          e.preventDefault();
          notepadSaveAs();
        }
      });
    }
    else if (type === 'settings') {
      content.style.background = '#f3f3f3';
      content.innerHTML =
        '<div style="display:flex;height:100%;">' +
          '<div id="settings-sidebar" style="width:200px;background:#f3f3f3;border-right:1px solid #e1e1e1;flex-shrink:0;overflow-y:auto;padding:8px 0;">' +
            '<div style="padding:16px 16px 8px;font-size:18px;font-weight:600;">设置</div>' +
            '<div id="settings-nav" style="display:flex;flex-direction:column;">' +
              '<div class="settings-nav-item active" data-page="personalize" style="padding:10px 16px;cursor:pointer;display:flex;align-items:center;gap:10px;font-size:13px;border-left:3px solid #0078d7;background:#e5f0fa;font-weight:600;"><span>🎨</span><span>个性化</span></div>' +
              '<div class="settings-nav-item" data-page="display" style="padding:10px 16px;cursor:pointer;display:flex;align-items:center;gap:10px;font-size:13px;border-left:3px solid transparent;"><span>🖥️</span><span>显示</span></div>' +
              '<div class="settings-nav-item" data-page="system" style="padding:10px 16px;cursor:pointer;display:flex;align-items:center;gap:10px;font-size:13px;border-left:3px solid transparent;"><span>⚙️</span><span>系统</span></div>' +
              '<div class="settings-nav-item" data-page="network" style="padding:10px 16px;cursor:pointer;display:flex;align-items:center;gap:10px;font-size:13px;border-left:3px solid transparent;"><span>🌐</span><span>网络和 Internet</span></div>' +
              '<div class="settings-nav-item" data-page="apps" style="padding:10px 16px;cursor:pointer;display:flex;align-items:center;gap:10px;font-size:13px;border-left:3px solid transparent;"><span>📦</span><span>应用</span></div>' +
              '<div class="settings-nav-item" data-page="about" style="padding:10px 16px;cursor:pointer;display:flex;align-items:center;gap:10px;font-size:13px;border-left:3px solid transparent;"><span>ℹ️</span><span>关于</span></div>' +
            '</div>' +
          '</div>' +
          '<div id="settings-content" style="flex:1;overflow-y:auto;padding:24px;background:#fff;">' +
            renderSettingsPage('personalize') +
          '</div>' +
        '</div>';

      setTimeout(function() {
        var navItems = document.querySelectorAll('#settings-nav .settings-nav-item');
        navItems.forEach(function(item) {
          item.addEventListener('click', function() {
            navItems.forEach(function(n) { n.style.background = 'transparent'; n.style.borderLeftColor = 'transparent'; n.style.fontWeight = 'normal'; n.classList.remove('active'); });
            item.style.background = '#e5f0fa';
            item.style.borderLeftColor = '#0078d7';
            item.style.fontWeight = '600';
            item.classList.add('active');
            var page = item.getAttribute('data-page');
            var contentArea = document.getElementById('settings-content');
            if (contentArea) contentArea.innerHTML = renderSettingsPage(page);
            if (page === 'display' || page === 'personalize') { bindResolutionSelect(); }
            if (page === 'personalize') { bindThemeToggle(); bindBgColorPicker(); }
          });
        });
      }, 50);
    }

    function renderSettingsPage(page) {
      if (page === 'personalize') {
        return '' +
          '<h2 style="font-size:22px;font-weight:600;margin-bottom:24px;">个性化</h2>' +
          '<div style="margin-bottom:28px;">' +
            '<div style="font-size:14px;font-weight:600;margin-bottom:12px;">主题</div>' +
            '<div style="display:flex;gap:12px;">' +
              '<div id="theme-light" class="theme-card" style="flex:1;padding:14px;border:2px solid ' + (window._settingsTheme !== 'dark' ? '#0078d7' : '#e1e1e1') + ';border-radius:4px;cursor:pointer;text-align:center;background:#fff;">' +
                '<div style="font-size:28px;margin-bottom:6px;">☀️</div>' +
                '<div style="font-size:12px;font-weight:600;">浅色</div>' +
              '</div>' +
              '<div id="theme-dark" class="theme-card" style="flex:1;padding:14px;border:2px solid ' + (window._settingsTheme === 'dark' ? '#0078d7' : '#e1e1e1') + ';border-radius:4px;cursor:pointer;text-align:center;background:#2a2a2a;color:#fff;">' +
                '<div style="font-size:28px;margin-bottom:6px;">🌙</div>' +
                '<div style="font-size:12px;font-weight:600;">深色</div>' +
              '</div>' +
            '</div>' +
          '</div>' +
          '<div style="margin-bottom:28px;">' +
            '<div style="font-size:14px;font-weight:600;margin-bottom:12px;">背景颜色</div>' +
            '<div style="display:flex;gap:8px;flex-wrap:wrap;" id="bg-color-picker">' +
              '["#0078d7","#107c10","#e81123","#ff8c00","#9b59b6","#1abc9c","#34495e","#f39c12","#2c3e50","#e74c3c","#3498db","#27ae60","#8e44ad","#d35400","#7f8c8d","#000000"].map(function(c) {' +
              '  var sel = (window._settingsBgColor || "#0078d7") === c;' +
              '  return "<div class="bg-color-opt" data-color=\"" + c + "\" style=\"width:36px;height:36px;border-radius:50%;background:" + c + ";cursor:pointer;border:2px solid " + (sel ? "#fff" : "transparent") + ";box-shadow:" + (sel ? "0 0 0 2px " + c : "none") + ";display:inline-block;margin:2px;\"></div>";' +
              '}).join("")' +
            '</div>' +
          '</div>' +
          '<div style="margin-bottom:28px;">' +
            '<div style="font-size:14px;font-weight:600;margin-bottom:12px;">屏幕分辨率</div>' +
