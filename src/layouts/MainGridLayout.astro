---
import Live2DWidget from "@components/features/Live2DWidget.astro";

import SpineModel from "@components/features/SpineModel.astro";
import Footer from "@components/layout/Footer.astro";
import Navbar from "@components/layout/Navbar.astro";
import StatusIsland from "@components/layout/StatusIsland.astro";
import GlassScrollbar from "@components/layout/GlassScrollbar.astro";
import MediaIsland from "@components/layout/MediaIsland.astro";
import SideBar from "@components/layout/SideBar.astro";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import FloatingControls from "@/components/controls/FloatingControls.astro";
import ScrollDownIndicator from "@/components/controls/ScrollDownIndicator.astro";
import TopSearch from "@/components/controls/TopSearch.svelte";
import BackgroundPlayer from "@/components/features/BackgroundPlayer.astro";
import TypewriterText from "@/components/features/TypewriterText.astro";
import CategoryBar from "@/components/layout/CategoryBar.astro";
import {
	backgroundWallpaper,
	displaySettingsConfig,
	live2dWidgetConfig,
	sidebarLayoutConfig,
	siteConfig,
} from "@/config";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
} from "@/constants/constants";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { getImageQuality } from "@/utils/image-utils";
import { getBackgroundImages, isHomePage } from "@/utils/layout-utils";
import {
	generateGridClasses,
	generateMainContentClasses,
	generateRightSidebarClasses,
	generateSidebarClasses,
	getResponsiveSidebarConfig,
	type ResponsiveSidebarConfig,
} from "@/utils/responsive-utils";
import Layout from "./Layout.astro";

import "@/styles/markdown.css";
import "@/styles/expressive-code.css";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	postCategory?: string;
	headings?: MarkdownHeading[];
	encrypted?: boolean;
	bannerPostMeta?: {
		title: string;
		description?: string;
		published: Date;
		updated?: Date;
		words?: number;
		minutes?: number;
	};
}

const backgroundImages = getBackgroundImages();

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	postSlug,
	postCategory,
	headings = [],
	encrypted = false,
	bannerPostMeta,
} = Astro.props;

// 检查背景壁纸模式和是否允许切换
const isBannerMode = backgroundWallpaper.mode === "banner";
const isFullscreenMode = backgroundWallpaper.mode === "fullscreen";
const isOverlayMode = backgroundWallpaper.mode === "overlay";
const isBackgroundEnabled = backgroundWallpaper.mode !== "none";
const isWallpaperSwitchable = displaySettingsConfig.wallpaperModeSwitchable;

// 检查是否启用水波纹动画效果
const wavesConfig = backgroundWallpaper.common?.waves?.enable;
const wavesSwitchable = displaySettingsConfig.wavesSwitchable;
// 处理分设备控制的水波纹动画
const wavesEnabledOnDesktop =
	typeof wavesConfig === "object" ? wavesConfig.desktop : wavesConfig;
const wavesEnabledOnMobile =
	typeof wavesConfig === "object" ? wavesConfig.mobile : wavesConfig;
// 是否需要渲染水波纹元素（任一设备启用 或 允许用户切换）
const shouldRenderWaves =
	wavesEnabledOnDesktop || wavesEnabledOnMobile || wavesSwitchable;

// 渐变过渡配置
const gradientConfig = backgroundWallpaper.common?.gradient?.enable;
const gradientSwitchable = displaySettingsConfig.gradientSwitchable;
const gradientEnabledOnDesktop =
	typeof gradientConfig === "object"
		? gradientConfig.desktop
		: (gradientConfig ?? true);
const gradientEnabledOnMobile =
	typeof gradientConfig === "object"
		? gradientConfig.mobile
		: (gradientConfig ?? true);
const gradientHeight = backgroundWallpaper.common?.gradient?.height ?? "30vh";
// 是否需要渲染渐变元素（任一设备启用 或 允许用户切换）
const shouldRenderGradient =
	gradientEnabledOnDesktop || gradientEnabledOnMobile || gradientSwitchable;

// 检查是否为首页
const isHomePageCheck = isHomePage(Astro.url.pathname);

const shouldRenderCategoryBar = !!siteConfig.categoryBar;

// 检查是否在文章详情页
const isPostPage = !!postSlug;

// 随机选择副标题（当打字机关闭且为数组时）
const getRandomSubtitle = () => {
	const subtitle = backgroundWallpaper.common?.homeText?.subtitle;
	if (Array.isArray(subtitle)) {
		const randomIndex = Math.floor(Math.random() * subtitle.length);
		return subtitle[randomIndex];
	}
	return subtitle;
};
const randomSubtitle = getRandomSubtitle();

// 主页横幅文本只在首页且全局开关为 true 时显示，不区分设备
const homeTextEnable = backgroundWallpaper.common?.homeText?.enable;
const showHomeText =
	(isBannerMode || isFullscreenMode) && !!homeTextEnable && isHomePageCheck;

const showBannerPostMeta =
	(isBannerMode || isFullscreenMode) &&
	isBackgroundEnabled &&
	!isHomePageCheck &&
	isPostPage &&
	!!bannerPostMeta;

const bannerPostInfoMode =
	backgroundWallpaper.common?.postInfo?.mode ?? "description";

const getBannerDescriptionWidth = (description?: string) => {
	if (!description) return undefined;

	const textUnits = Array.from(description).reduce((total, character) => {
		if (/\s/u.test(character)) return total + 0.35;
		const codePoint = character.codePointAt(0) ?? 0;
		return total + (codePoint <= 0xff ? 0.55 : 1);
	}, 0);
	const maxLineUnits = 52;
	const lineCount = Math.max(1, Math.ceil(textUnits / maxLineUnits));

	if (lineCount === 1) return undefined;

	const targetLineUnits = Math.min(maxLineUnits, textUnits / (lineCount - 0.5));
	return `${Math.max(28, targetLineUnits).toFixed(1)}em`;
};

const bannerDescriptionWidth = getBannerDescriptionWidth(
	bannerPostMeta?.description,
);

const showBannerDim = (isBannerMode || isFullscreenMode) && isBackgroundEnabled;
const dimOpacity = backgroundWallpaper.common?.dimOpacity ?? 0.15;

const showBannerPageTitle =
	(isBannerMode || isFullscreenMode) &&
	isBackgroundEnabled &&
	!isHomePageCheck &&
	!isPostPage &&
	!!title;
// 手机端非首页不显示banner的CSS类
const mobileNonHomeBannerClass = !isHomePageCheck ? "mobile-hide-banner" : "";

// 计算主内容区域位置，考虑手机端非首页时banner被隐藏
const mainPanelTop =
	isBannerMode && isBackgroundEnabled
		? `calc(${BANNER_HEIGHT}vh - ${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem)`
		: "5.5rem";

// 当banner模式被禁用时，主内容区域应该始终从顶栏下面开始
// 非首页在小于1024px时会通过 mobile-main-no-banner CSS类覆盖top值为5.5rem
const finalMainPanelTop =
	isBannerMode && isBackgroundEnabled ? mainPanelTop : "5.5rem";

// 获取响应式侧边栏配置
const sidebarConfig = getResponsiveSidebarConfig();

// 侧边栏是否在文章详情页显示（默认 true）
const hideSidebarOnPostPage =
	sidebarLayoutConfig.hideSidebarOnPostPage === true;

// 在文章页面且启用了showBothSidebarsOnPostPage时，确保对侧组件参与网格计算
const shouldShowBothSidebarsOnPostPage: boolean =
	sidebarLayoutConfig.enable &&
	!hideSidebarOnPostPage &&
	isPostPage &&
	sidebarLayoutConfig.position !== "both" &&
	!!sidebarLayoutConfig.showBothSidebarsOnPostPage;

// position为left时，对侧为右侧；position为right时，对侧为左侧
const shouldAddRightSidebar: boolean =
	shouldShowBothSidebarsOnPostPage && sidebarLayoutConfig.position === "left";
const shouldAddLeftSidebar: boolean =
	shouldShowBothSidebarsOnPostPage && sidebarLayoutConfig.position === "right";

const effectiveIsBothSidebars: boolean =
	sidebarConfig.isBothSidebars || shouldShowBothSidebarsOnPostPage;
const effectiveHasRightComponents: boolean =
	sidebarConfig.hasRightComponents ||
	(shouldAddRightSidebar &&
		sidebarLayoutConfig.rightComponents.some((comp) => comp.enable));
const effectiveHasLeftComponents: boolean =
	sidebarConfig.hasLeftComponents ||
	(shouldAddLeftSidebar &&
		sidebarLayoutConfig.leftComponents.some((comp) => comp.enable));

// 使用effective值重新生成网格类
// 当position为right且文章页临时显示左侧栏时，tabletSidebar应为right（保持显示主侧栏）
const effectiveTabletSidebar = shouldAddLeftSidebar
	? ("right" as const)
	: sidebarConfig.tabletSidebar;

const updatedGridConfig: ResponsiveSidebarConfig = {
	...sidebarConfig,
	isBothSidebars: effectiveIsBothSidebars,
	hasLeftComponents: effectiveHasLeftComponents,
	hasRightComponents: effectiveHasRightComponents,
	tabletSidebar: effectiveTabletSidebar,
};

const { gridCols } = generateGridClasses(updatedGridConfig);
const sidebarClass = generateSidebarClasses(updatedGridConfig);
const rightSidebarClass =
	effectiveIsBothSidebars || sidebarLayoutConfig.position === "right"
		? generateRightSidebarClasses(updatedGridConfig)
		: "";
const mainContentClass = generateMainContentClasses(updatedGridConfig);
const staticBarClass = mainContentClass.replace("transition-main", "").trim();

const footerClass = ["footer", "col-span-full", "onload-animation"];

const footerClassName = footerClass.join(" ");

// 检查是否应该启用半透明效果
const shouldEnableTransparency = isOverlayMode && isBackgroundEnabled;

// 获取图片质量配置
const configQuality = getImageQuality();
const mobileQuality = Math.round(configQuality * 0.9);
const bannerCarouselEnabledDefault =
	backgroundWallpaper.common?.carousel?.enable ?? false;
const bannerCarouselSwitchable = displaySettingsConfig.bannerCarouselSwitchable;
const bannerCarouselInterval = Math.max(
	backgroundWallpaper.common?.carousel?.interval ?? 5000,
	3000,
);
const bannerCarouselEffect =
	backgroundWallpaper.common?.carousel?.transitionEffect ?? "fade";
const hasMultipleImages =
	backgroundImages.desktop.length > 1 || backgroundImages.mobile.length > 1;
---

<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle} postSlug={postSlug}>


<!-- 为全屏壁纸模式添加body类 -->
{shouldEnableTransparency && (
	<script>
		document.body.classList.add('wallpaper-transparent');
	</script>
)}

<slot slot="head" name="head"></slot>

<!--
    屏幕上方那枚搜索（ProMax 桌面端专属）
    ⚠ 必须挂在 #top-row **外面**：#top-row 是 fixed + -translate-x-1/2，
      transform 会给后代当包含块，后代里的 position:fixed 就不再相对视口。
      挂在 body 直下（这里）才是真正的「屏幕上方」。
-->
<TopSearch client:load />

<!-- Floating Navbar - 居中悬浮 -->
<div id="top-row" class="z-50 fixed top-3 left-1/2 -translate-x-1/2 pointer-events-none flex items-center gap-3">
    <div id="navbar-wrapper" class="pointer-events-auto flex items-center gap-3">
        <Navbar></Navbar>
    </div>
    <!-- 隐藏/显示导航岛按钮 -->
    <button
        id="fullscreen-navbar-toggle"
        class="pointer-events-auto w-9 h-9 md:w-10 md:h-10 rounded-full flex items-center justify-center"
        aria-label="隐藏导航栏"
        title="隐藏导航栏"
        onclick="toggleFullscreenNavbar()"
    >
        <Icon is:inline id="navbar-toggle-icon-up" name="material-symbols:expand-less-rounded" class="text-[1.25rem]" />
        <Icon is:inline id="navbar-toggle-icon-down" name="material-symbols:expand-more-rounded" class="text-[1.25rem] hidden" />
    </button>
    <!--
        ProMax 版专属：iPhone 式 home indicator。
        岛沉底时它就是屏幕最下方那根短条，同时兼职「阅读进度条 + 回到顶部」：
          - .pm-hi-fill 的宽度 = --pm-hi-progress（脚本按滚动比例写入）
          - 点击 / 回车 = 平滑回顶
          - hover = 拉长加粗 + 浮出提示
          - 切页加载时脚本加 .pm-hi-loading 扫一道高光
        默认 display:none，只有 body.site-promax 且 ≥1024px 才出现（见 styles/promax.css）。
    -->
    <button
        id="pm-home-indicator"
        type="button"
        aria-label="回到顶部"
        title="回到顶部"
    >
        <span class="pm-hi-fill" aria-hidden="true"></span>
        <span class="pm-hi-tip" aria-hidden="true">
            <span class="pm-hi-pct" data-pm-hi-pct>0%</span>
            <span>· 回到顶部</span>
        </span>
    </button>
</div>

<script is:inline>
    /* ProMax home indicator：阅读进度 + 回到顶部 + 切页扫光
       元素在非 ProMax / 窄屏下是 display:none，脚本跑了也只是原地空转。 */
    (function () {
        var bar = document.getElementById("pm-home-indicator");
        if (!bar) return;

        var pctEl = bar.querySelector("[data-pm-hi-pct]");
        var lastPct = -1;
        var rafId = 0;

        function computeProgress() {
            var doc = document.documentElement;
            var max = doc.scrollHeight - window.innerHeight;
            if (max <= 4) return 0;
            var y = window.scrollY || doc.scrollTop || 0;
            return Math.min(1, Math.max(0, y / max));
        }

        function render() {
            rafId = 0;
            var pct = Math.round(computeProgress() * 100);
            if (pct === lastPct) return;
            lastPct = pct;
            bar.style.setProperty("--pm-hi-progress", pct + "%");
            if (pctEl) pctEl.textContent = pct + "%";
            document.body.classList.toggle("pm-at-top", pct <= 0);
        }

        function schedule() {
            if (!rafId) rafId = requestAnimationFrame(render);
        }

        window.addEventListener("scroll", schedule, { passive: true });
        window.addEventListener("resize", schedule, { passive: true });
        /* 图片 / 字体加载完，文档高度会变，补算一次 */
        window.addEventListener("load", schedule);

        /* 点一下 / 回车 / 在条上向上滑 → 平滑回到顶部 */
        function toTop() {
            var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
        }
        bar.addEventListener("click", toTop);

        /* 向上滑手势：条子贴在屏幕最下沿，拇指上推是最自然的「回顶」动作。
           位移超过 24px 才认，避免把「按下时手抖」当成滑动。 */
        var swipeY = 0;
        var swiping = false;
        bar.addEventListener(
            "pointerdown",
            function (e) {
                swiping = true;
                swipeY = e.clientY;
            },
            { passive: true },
        );
        window.addEventListener(
            "pointerup",
            function (e) {
                if (!swiping) return;
                swiping = false;
                if (swipeY - e.clientY > 24) toTop();
            },
            { passive: true },
        );
        bar.addEventListener("pointercancel", function () {
            swiping = false;
        });

        /* ================= 墨色：跟着壁纸亮暗走 =================
           条子要「有时候是黑的、有时候是白的」，判据不是站点主题而是
           **它身下那片壁纸的亮度** —— 浅色壁纸用黑条、深色壁纸用白条，
           否则深色壁纸上一条黑线完全看不见。
           做法：把壁纸图（或视频当前帧）画进极小的 canvas，取「画面
           下半部中间」那一块的加权亮度（Rec.709）。
           ⚠ 壁纸若是**外链 CDN**（本站默认的 t.alcy.cc 就是），画进
           canvas 后 getImageData 会因跨域污染直接抛 SecurityError，
           读不到任何像素 —— 这时退回主题（亮主题黑墨 / 暗主题白墨），
           并在 body 上留 data-pm-hi-tone="theme" 说明这一档是退路。
           自托管的壁纸能正常取样，那时才是真正的「按壁纸亮暗」。 */
        var inkGaveUp = false;
        function wallpaperMedia() {
            var wrap = document.getElementById("wallpaper-wrapper");
            if (!wrap) return null;
            var vids = wrap.querySelectorAll("video");
            for (var i = 0; i < vids.length; i++) {
                if (vids[i].readyState >= 2 && vids[i].getBoundingClientRect().width > 0) return vids[i];
            }
            var imgs = wrap.querySelectorAll("img");
            for (var j = 0; j < imgs.length; j++) {
                var el = imgs[j];
                if (!el.currentSrc || !el.complete || !el.naturalWidth) continue;
                if (getComputedStyle(el).display === "none") continue;
                if (el.getBoundingClientRect().width <= 0) continue;
                return el;
            }
            return null;
        }
        function sampleInk() {
            var media = wallpaperMedia();
            if (!media) return "";
            var nw = media.naturalWidth || media.videoWidth || 0;
            var nh = media.naturalHeight || media.videoHeight || 0;
            if (!nw || !nh) return "";
            var c = document.createElement("canvas");
            c.width = c.height = 12;
            var cx = c.getContext("2d", { willReadFrequently: true });
            if (!cx) return "";
            /* 只看画面「下半部中间」——条子就落在壁纸的下缘，那里才是
               它真正的底。窗口宽取 34%、高取 18%，够摊平局部噪点。 */
            var sw = nw * 0.34;
            var sh = nh * 0.18;
            var sx = nw * 0.5 - sw / 2;
            var sy = nh * 0.88 - sh / 2;
            if (sx < 0) sx = 0;
            if (sy < 0) sy = 0;
            if (sx + sw > nw) sw = nw - sx;
            if (sy + sh > nh) sh = nh - sy;
            try {
                cx.drawImage(media, sx, sy, sw, sh, 0, 0, 12, 12);
                var data = cx.getImageData(0, 0, 12, 12).data;
                var sum = 0;
                for (var i = 0; i < data.length; i += 4) {
                    sum += (0.2126 * data[i] + 0.7152 * data[i + 1] + 0.0722 * data[i + 2]) / 255;
                }
                var lum = sum / (data.length / 4);
                /* 0.56 ≈ 中灰偏亮一点：这一档之上用黑墨，之下用白墨 */
                return lum > 0.56 ? "dark" : "light";
            } catch (e) {
                /* 跨域污染（SecurityError）不是「还没准备好」，再试也不会变 ——
                   记下来，别让重试轮次空转。 */
                inkGaveUp = true;
                return "";
            }
        }
        function applyInk() {
            var tone = sampleInk();
            if (!tone) {
                /* 取不到壁纸（外链图 / 视频还没出帧）→ 先交给主题，稍后再试 */
                bar.style.removeProperty("--pm-hi-ink");
                document.body.setAttribute("data-pm-hi-tone", "theme");
                return false;
            }
            bar.style.setProperty("--pm-hi-ink", tone === "dark" ? "rgb(17, 17, 19)" : "rgb(245, 245, 247)");
            document.body.setAttribute("data-pm-hi-tone", tone);
            return true;
        }
        applyInk();
        /* 壁纸 / 字体 / 轮播都是渐次到位的：有界地补几轮，直到算出来为止 */
        var inkTries = 0;
        function retryInk() {
            if (inkGaveUp || inkTries >= 8) return;
            inkTries++;
            setTimeout(function () {
                if (applyInk()) return;
                retryInk();
            }, 400 + inkTries * 150);
        }
        retryInk();
        window.addEventListener("load", applyInk);
        /* 换壁纸 / 轮播切图：等过渡走完再重算 */
        var wrapEl = document.getElementById("wallpaper-wrapper");
        if (wrapEl && window.MutationObserver) {
            var inkTimer = 0;
            new MutationObserver(function () {
                if (inkTimer) clearTimeout(inkTimer);
                inkTimer = setTimeout(applyInk, 700);
            }).observe(wrapEl, { attributes: true, childList: true, subtree: true });
        }
        document.addEventListener("siteversionchange", applyInk);

        /* 切页 / 加载：扫一道高光。swup 与 astro 两套事件都挂，
           没有过渡动画时用定时器兜底收尾。 */
        var loading = 0;
        function startLoading() {
            loading++;
            bar.classList.add("pm-hi-loading");
        }
        function stopLoading() {
            loading = Math.max(0, loading - 1);
            if (loading) return;
            bar.classList.remove("pm-hi-loading");
            schedule();
        }
        document.addEventListener("astro:before-preparation", startLoading);
        document.addEventListener("astro:after-swap", stopLoading);
        document.addEventListener("swup:willReplaceContent", startLoading);
        document.addEventListener("swup:contentReplaced", function () {
            stopLoading();
            render();
        });
        document.addEventListener("click", function (e) {
            /* 默认行为已被接管（比如 ProMax 岛内浏览拦下了这次点击）→ 不是跳转，
               别弹「正在跳转」：否则它会亮着空等 2.5s 才自己收回去 */
            if (e.defaultPrevented) return;
            var a = e.target && e.target.closest ? e.target.closest("a[href]") : null;
            if (!a) return;
            var href = a.getAttribute("href") || "";
            if (!href || href.charAt(0) === "#" || a.target === "_blank") return;
            if (a.host && a.host !== location.host) return;
            startLoading();
            setTimeout(stopLoading, 2500);
        });

        document.addEventListener("siteversionchange", schedule);
        render();
    })();
</script>

<script is:inline>
    /* ================================================================
       ProMax 底部导航岛「鼠标移开自动隐藏」
       用户需求：鼠标移走时岛自动滑出屏幕，移回底部感应区再滑回来；
       箭头按钮点过的「钉住」状态除外（钉住时常驻不隐藏）。
       生效条件（缺一不可）：
         · body.site-promax（其它版本维持原行为）
         · ≥768px（岛沉底的宽度档，与 promax.css 的媒体查询一致）
         · (hover: hover) and (pointer: fine) —— 真鼠标才有「移开」，
           触屏设备没有 hover，一律保持常显
       实现直接复用现有的 navbar-manual-hidden 类（动画/位移/镜像
       全部现成），箭头图标语义照抄 toggleFullscreenNavbar：
       岛沉底时常态朝下、收起后朝上。
       ⚠ 节点查询全部惰性 —— 本脚本与 navbar 分属不同组件，
         is:inline 按文档顺序执行时不保证对方已在 DOM 里。
       ================================================================ */
    (function () {
        var wrapper = document.getElementById("navbar-wrapper");
        var toggle = document.getElementById("fullscreen-navbar-toggle");
        if (!wrapper || !toggle) return;
        if (wrapper.__pmAutoHideBound) return; /* swup 换页重跑防重复绑定 */
        wrapper.__pmAutoHideBound = true;

        var pinned = false; /* 箭头钉住：展开状态下不自动隐藏 */
        var away = false; /* 鼠标是否在感应区外（初值=在区内：岛首屏常显） */

        function active() {
            return (
                document.body.classList.contains("site-promax") &&
                window.innerWidth >= 768 &&
                window.matchMedia("(hover: hover) and (pointer: fine)").matches
            );
        }

        /* 这些状态下不许藏：搜索面板展开 / 岛内有键盘焦点 / 高亮带拖拽中 */
        function busy() {
            if (document.querySelector("#dynamic-island-search.open")) return true;
            var ae = document.activeElement;
            if (ae && ae !== document.body && wrapper.contains(ae)) return true;
            if (document.querySelector("#navbar-pill.is-dragging")) return true;
            return false;
        }

        /* 底部感应区：屏幕下缘 150px / 岛的包围盒外扩 28px / 箭头按钮外扩 14px */
        function inZone(x, y) {
            if (y >= window.innerHeight - 150) return true;
            var r = wrapper.getBoundingClientRect();
            if (r.width > 0 && y >= r.top - 28 && y <= r.bottom + 28) return true;
            var t = toggle.getBoundingClientRect();
            return (
                x >= t.left - 14 && x <= t.right + 14 && y >= t.top - 14 && y <= t.bottom + 14
            );
        }

        function setHidden(hide) {
            var isHidden = wrapper.classList.contains("navbar-manual-hidden");
            if (hide !== isHidden) {
                if (hide) wrapper.classList.add("navbar-manual-hidden");
                else wrapper.classList.remove("navbar-manual-hidden");
            }
            /* 图标/文案无论状态是否变化都校一遍：初始 markup 是「顶部导航栏」
               的图标语义（朝上），沉底岛要按当下状态归位 */
            syncIcons(hide);
            toggle.setAttribute("aria-label", hide ? "显示导航栏" : "隐藏导航栏");
            toggle.title = pinned ? "取消钉住导航岛" : hide ? "显示导航栏" : "钉住导航岛";
        }

        /* 箭头图标语义（照抄 toggleFullscreenNavbar）：岛沉底时常态朝下、收起朝上 */
        function syncIcons(hide) {
            var iconUp = document.getElementById("navbar-toggle-icon-up");
            var iconDown = document.getElementById("navbar-toggle-icon-down");
            if (!iconUp || !iconDown) return;
            iconUp.classList.toggle("hidden", !hide);
            iconUp.style.opacity = hide ? "1" : "0";
            iconDown.classList.toggle("hidden", hide);
            iconDown.style.opacity = hide ? "0" : "1";
        }

        /* 初始归位：markup 默认是「顶部导航栏」的图标语义（朝上），
           Layout.astro 的 resetFullscreenNavbarState 定义了但没人调用，
           沉底岛上箭头就一直反着 —— 这里按当下状态校一次。 */
        if (document.body.classList.contains("site-promax") && window.innerWidth >= 768) {
            syncIcons(wrapper.classList.contains("navbar-manual-hidden"));
        }

        function evaluate() {
            if (!active()) {
                setHidden(false);
                return;
            }
            if (pinned) {
                setHidden(false);
                return;
            }
            setHidden(away && !busy());
        }

        /* ⚠ 不能只在 away 翻转时评估：搜索面板关闭、拖拽结束这类
           「busy 解除」的时刻没有 pointermove 之外的信号，所以每次
           移动都重估。pointermove 很高频，用 rAF 合并成一帧一次。 */
        var pending = 0;
        var lastX = 0;
        var lastY = 0;
        function onMove(e) {
            lastX = e.clientX;
            lastY = e.clientY;
            if (pending) return;
            pending = requestAnimationFrame(function () {
                pending = 0;
                away = !inZone(lastX, lastY);
                evaluate();
            });
        }
        window.addEventListener("pointermove", onMove, { passive: true });
        /* 鼠标离开窗口也算「移开」 */
        document.addEventListener("mouseleave", function () {
            away = true;
            evaluate();
        });

        /* 箭头 = 钉住开关。⚠ ProMax 下必须摘掉 inline onclick：
           toggleFullscreenNavbar 定义在 Layout 的模块脚本里，模块是
           deferred 的 —— 页面刚加载完那一秒内点击会 ReferenceError
           （真实用户也能踩到：加载后立刻点箭头没反应）。
           ProMax 的钉住逻辑完全自持，不依赖那个函数；其它版本原样保留。 */
        function claimToggle() {
            if (active()) toggle.removeAttribute("onclick");
        }
        claimToggle();

        toggle.addEventListener("click", function () {
            if (!active()) return; /* 非 ProMax 走原 onclick 逻辑 */
            pinned = !pinned;
            evaluate();
        });

        document.addEventListener("siteversionchange", function () {
            /* 切走 ProMax 时必须把岛还回来，钉住状态一并清掉 */
            if (!document.body.classList.contains("site-promax")) pinned = false;
            claimToggle();
            evaluate();
        });
    })();
</script>

<script is:inline>
    /* 「正在跳转 / 正在播放」媒体指示块的位置（仅 ProMax 沉底布局）
       ─────────────────────────────────────────────────────────────
       它原生是左岛（#navbar）的最后一格，「正在跳转…」一挤出就把左岛
       撑宽，玻璃引擎的高亮带与岛面玻璃跟着重排（观感：左岛右端冒一块、
       玻璃发白）。ProMax 下把它搬进右侧动作岛（#navbar-actions），
       从右岛右端挤出，左岛彻底不再被它动。其它版本留在原地不动。 */
    (function () {
        /* 原生位置记档：非 ProMax（或缩回窄屏）时还回去 */
        var home = null;

        function rowOf() {
            var frame = document.querySelector("#navbar > div");
            return frame ? frame.firstElementChild : null;
        }

        function dedupe(keepInActions) {
            /* swup 重建导航岛时会带来一份新的 #media-island —— 只留
               「在正确位置」的那份（旧节点带着全部监听器，优先保留） */
            var all = document.querySelectorAll("#media-island");
            if (all.length <= 1) return;
            var keep = null;
            for (var i = 0; i < all.length; i++) {
                var inActions = !!all[i].closest("#navbar-actions");
                if (keepInActions === inActions && !keep) keep = all[i];
            }
            keep = keep || all[0];
            for (var j = 0; j < all.length; j++) {
                if (all[j] !== keep) all[j].remove();
            }
        }

        function place() {
            var mi = document.getElementById("media-island");
            if (!mi) return;
            var actions = document.querySelector("#navbar-actions .navbar-actions-inner");
            var promax =
                document.body.classList.contains("site-promax") &&
                window.innerWidth >= 768 &&
                !!actions;
            if (promax) {
                dedupe(true);
                mi = document.getElementById("media-island");
                if (!mi) return;
                if (mi.parentElement !== actions) {
                    if (!home || !home.parent) {
                        home = { parent: mi.parentElement, next: mi.nextSibling };
                    }
                    actions.appendChild(mi);
                    /* 岛宽变了 → 提醒玻璃引擎 / 字形蒙版重新量 */
                    window.dispatchEvent(new Event("resize"));
                }
            } else {
                dedupe(false);
                mi = document.getElementById("media-island");
                if (!mi || mi.closest("#navbar")) return;
                var row = rowOf();
                if (!row) return;
                if (home && home.parent && home.parent.isConnected) {
                    home.parent.insertBefore(
                        mi,
                        home.next && home.next.parentElement === home.parent ? home.next : null,
                    );
                } else {
                    row.appendChild(mi);
                }
                window.dispatchEvent(new Event("resize"));
            }
        }

        var t = 0;
        window.addEventListener("resize", function () {
            clearTimeout(t);
            t = setTimeout(place, 160);
        });
        document.addEventListener("siteversionchange", place);
        document.addEventListener("astro:page-load", place);
        document.addEventListener("swup:contentReplaced", place);
        place();
    })();
</script>

<!-- 灵动岛状态栏：右上角常驻，音乐播放/天气面板打开/导航隐藏时自动滑出 -->
