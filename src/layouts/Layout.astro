    .no-banner-layout #wallpaper-wrapper.wallpaper-fullscreen {
      height: 100vh;
      min-height: 100vh;
      max-height: 100vh;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      transform: none;
      overflow: hidden;
      z-index: -1;
    }

    .no-banner-layout #wallpaper-wrapper.wallpaper-fullscreen img {
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      object-position: center !important;
      filter: blur(var(--scroll-blur, 0px)) !important;
      opacity: 1 !important;
      transition: filter 0.15s ease-out;
