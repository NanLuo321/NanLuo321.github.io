      const storedTheme = localStorage.getItem("theme") || siteConfig.themeColor.defaultMode || "light";
      let isDark = false;
      
      // 处理 system 模式
      if (storedTheme === "system") {
        isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      } else {
