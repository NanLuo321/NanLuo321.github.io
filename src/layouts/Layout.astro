      /* iOS 风格出现动画 */
      animation: navbar-toggle-appear 0.5s cubic-bezier(0.32, 0.72, 0, 1) forwards;
    }

    @keyframes navbar-toggle-appear {
      0% { opacity: 0; transform: scale(0.5) translateY(-10px); }
      100% { opacity: 0.85; transform: scale(1) translateY(0); }
    }

    :root.dark #fullscreen-navbar-toggle {
      box-shadow: 0 2px 16px rgba(0, 0, 0, 0.35), 0 0 0 0.5px rgba(255, 255, 255, 0.08);
