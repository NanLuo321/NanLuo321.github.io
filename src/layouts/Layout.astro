  };

  // 优化的滚动处理函数
  function scrollFunction() {
    if (document.documentElement.classList.contains("is-page-transitioning")) {
      return;
    }

    const scrollTop = document.documentElement.scrollTop;
    const bannerHeight = window.innerHeight * (BANNER_HEIGHT / 100);
    const navbarElement = document.getElementById("navbar");

    // 根据滚动位置动态更新侧边栏 sticky 间距
    updateSidebarStickySpacing();

    // 使用批量DOM操作优化性能
    const operations: (() => void)[] = [];

    if (backToTopBtn) {
      operations.push(() => {
        if (scrollTop > bannerHeight) {
          backToTopBtn.classList.remove("hide");
        } else {
          backToTopBtn.classList.add("hide");
        }
      });
    }

    if (bannerEnabled && toc) {
      operations.push(() => {
        if (scrollTop > bannerHeight) {
          toc.classList.remove("toc-hide");
        } else {
          toc.classList.add("toc-hide");
        }
      });
    }

    if (stickyNavbar && navbar) {
      operations.push(() => {
        navbar.classList.remove("navbar-hidden");
      });
    } else if (bannerEnabled && navbar) {
      operations.push(() => {
        const threshold = window.innerHeight * (BANNER_HEIGHT_HOME / 100) - 88;

        if (scrollTop >= threshold) {
          navbar.classList.add("navbar-hidden");
        } else {
          navbar.classList.remove("navbar-hidden");
        }
      });
    }

    if (navbarElement) {
      operations.push(() => {
        if (scrollTop > 8) {
          navbarElement.classList.add("navbar-sticky-shadow");
        } else {
          navbarElement.classList.remove("navbar-sticky-shadow");
        }
      });
    }

    // 批量执行DOM操作
    if (operations.length > 0) {
      requestAnimationFrame(() => {
        operations.forEach((op) => op());
      });
    }
  }

  // 使用优化的滚动性能处理
  let scrollTimeout: number;
  window.addEventListener(
    "scroll",
    () => {
      if (scrollTimeout) {
        cancelAnimationFrame(scrollTimeout);
      }
      scrollTimeout = requestAnimationFrame(scrollFunction);
    },
    { passive: true }
  );

  // 初始化滚动状态（例如从历史位置恢复时）
  scrollFunction();

  window.onresize = () => {
    // calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
    let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
    offset = offset - (offset % 4);
    document.documentElement.style.setProperty(
      "--banner-height-extend",
      `${offset}px`
    );
  };

  // 页面加载完成后初始化banner和内容溢出容器
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      showBanner();
      scheduleContentOverflowEnhancements();
    });
  } else {
    showBanner();
    scheduleContentOverflowEnhancements();
  }

  // 检查当前页面是否为文章详情页
  const isCurrentPagePost = () =>
    window.location.pathname.includes("/posts/") || window.location.pathname.includes("/post/");

  // Grid 列类常量
  const GRID_COL_CLASSES = [
    "grid-cols-1",
    "md:grid-cols-[17.5rem_1fr]",
    "md:grid-cols-[1fr_17.5rem]",
    "xl:grid-cols-[17.5rem_1fr_17.5rem]",
  ];

  // 多列布局下的列定位类（需在切换单列时清除）
  const MULTI_COL_POS_CLASSES = [
    "md:col-start-1", "md:col-start-2",
    "xl:col-start-1", "xl:col-start-2", "xl:col-start-3",
    "xl:col-end-3",
    "md:col-span-1", "xl:col-span-1",
  ];

  // 清除元素上的多列定位类
  function clearColPositioning(...elements: (Element | null | undefined)[]) {
    for (const el of elements) {
      if (!el) continue;
      for (const cls of MULTI_COL_POS_CLASSES) el.classList.remove(cls);
    }
  }

  // 设置单列布局：grid 设为 grid-cols-1，清除子元素的多列定位类
  function applySingleColLayout(mainGrid: Element) {
    for (const cls of GRID_COL_CLASSES) mainGrid.classList.remove(cls);
    mainGrid.classList.add("grid-cols-1");
    const swupContainer = document.getElementById("swup-container");
    clearColPositioning(swupContainer, swupContainer?.parentElement, mainGrid.querySelector('.footer'));
  }

  // 更新主网格的网格列数
  function updateMainGridCols() {
    const mainGrid = document.getElementById("main-grid");
    if (!mainGrid) return;

    const sidebarEnabled = mainGrid.getAttribute("data-sidebar-enable") !== "false";
    const sidebarHideOnPost = mainGrid.getAttribute("data-grid-hide-sidebar-on-post") === "true";
    const isPostPage = isCurrentPagePost();
    const sidebarPosition = mainGrid.getAttribute("data-sidebar-position") || "left";
    const tabletSidebar = mainGrid.getAttribute("data-tablet-sidebar") || "left";
    const showBothSidebarsOnPostPage = mainGrid.getAttribute("data-show-both-sidebars-on-post") === "true";

    // 侧边栏禁用 或 文章详情页隐藏侧边栏时，保持单列布局
    if (!sidebarEnabled || (isPostPage && sidebarHideOnPost)) {
      applySingleColLayout(mainGrid);
      return;
    }

    const shouldBothSidebars = isPostPage && sidebarPosition !== "both" && showBothSidebarsOnPostPage;

    let newGridClasses: string;

    if (sidebarPosition === "both" || shouldBothSidebars) {
      const effectiveTabletSidebar = (shouldBothSidebars && sidebarPosition === "right") ? "right" : tabletSidebar;
      newGridClasses = effectiveTabletSidebar === "right"
        ? "grid-cols-1 md:grid-cols-[1fr_17.5rem] xl:grid-cols-[17.5rem_1fr_17.5rem]"
        : "grid-cols-1 md:grid-cols-[17.5rem_1fr] xl:grid-cols-[17.5rem_1fr_17.5rem]";
    } else if (sidebarPosition === "right") {
      newGridClasses = "grid-cols-1 md:grid-cols-[1fr_17.5rem]";
    } else {
      newGridClasses = "grid-cols-1 md:grid-cols-[17.5rem_1fr]";
    }

    for (const cls of GRID_COL_CLASSES) mainGrid.classList.remove(cls);
    for (const cls of newGridClasses.split(" ")) if (cls) mainGrid.classList.add(cls);

    // position为right时，swup导航不会替换静态元素的class，需手动更新列定位
    if (sidebarPosition === "right") {
      const rightSidebar = document.getElementById("right-sidebar");
      const swupContainer = document.getElementById("swup-container");
      const swupWrapper = swupContainer?.parentElement;
      const footer = mainGrid.querySelector('.footer');

      if (shouldBothSidebars) {
        // 文章页临时双侧栏：主内容移到第2列，右侧栏移到第3列，页脚居中
        clearColPositioning(swupContainer, swupWrapper, footer);
        swupContainer?.classList.add("md:col-start-2", "xl:col-start-2", "xl:col-end-3");
        swupWrapper?.classList.add("md:col-start-2");
        rightSidebar?.classList.add("xl:col-start-3");
        footer?.classList.add("md:col-start-2", "xl:col-start-2");
      } else {
        // 非文章页：恢复2列布局定位（右侧栏保持 md:col-start-2 不变）
        clearColPositioning(swupContainer, swupWrapper, footer);
        rightSidebar?.classList.remove("xl:col-start-3");
        swupContainer?.classList.add("md:col-start-1");
        swupWrapper?.classList.add("md:col-start-1");
        footer?.classList.add("md:col-start-1", "xl:col-start-1");
      }
    }
  }

  // 更新侧边栏组件的可见性
  function updateSidebarComponentsVisibility() {
    const isPostPage = isCurrentPagePost();

    // 处理侧边栏级别的 hideSidebarOnPostPage 配置
    document.querySelectorAll<HTMLElement>("[data-hide-sidebar-on-post]").forEach((wrapper) => {
      const hideOnPost = wrapper.getAttribute("data-hide-sidebar-on-post") === "true";
      if (isPostPage && hideOnPost) {
        wrapper.style.setProperty("display", "none", "important");
      } else {
        wrapper.style.removeProperty("display");
      }
    });

    // 处理组件级别的 showOnPostPage 配置
    document.querySelectorAll(".widget-hide-on-post").forEach((widget) => {
      isPostPage ? widget.classList.add("hidden") : widget.classList.remove("hidden");
    });

    // 处理 hideOnNonPostPage === true 的组件
    document.querySelectorAll(".widget-hide-on-non-post").forEach((widget) => {
      !isPostPage ? widget.classList.add("hidden") : widget.classList.remove("hidden");
    });

    // 组件可见性变化后，立即重算 sticky 间距，避免 swup 切页后残留旧间距
    updateSidebarStickySpacing();
  }

  // 根据当前页面实际可见的顶部组件与滚动位置，动态更新侧边栏 sticky 间距
  function updateSidebarStickySpacing() {
    const scrollTop = document.documentElement.scrollTop || window.scrollY || 0;
    const isScrolled = scrollTop > 2;

    (["left", "right"] as const).forEach((side) => {
      const sticky = document.getElementById(`${side}-sidebar-sticky`);
      if (!sticky) return;

      // 结构为：sidebar -> top 容器（可选） + sticky 容器
      const topContainer = sticky.previousElementSibling as HTMLElement | null;
      const hasVisibleTop = !!topContainer && topContainer.offsetHeight > 1;

      // swup 从非文章页切换到文章页时，top 容器可能残留 mb-4，需要按可见性动态修正
      if (topContainer) {
        if (hasVisibleTop !== sidebarStickyState[side].hasVisibleTop) {
          sidebarStickyState[side].hasVisibleTop = hasVisibleTop;
        }

        if (hasVisibleTop) {
          topContainer.classList.add("mb-4");
        } else {
          topContainer.classList.remove("mb-4");
        }
      }

      // 仅切换顶部偏移；组件间距由容器常驻 gap-4 保持
      const nextTopClass: "top-0" | "top-4" =
        hasVisibleTop || isScrolled ? "top-4" : "top-0";

      if (sidebarStickyState[side].topClass !== nextTopClass) {
        sticky.classList.remove(sidebarStickyState[side].topClass);
        sticky.classList.add(nextTopClass);
        sidebarStickyState[side].topClass = nextTopClass;
      }
    });
  }

  // Initialize wallpaper mode
  import { initWallpaperMode, initThemeListener } from "@/utils/setting-utils";
  import { initIconLoader } from "@/utils/icon-loader";
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      updateMainGridCols();
      updateSidebarComponentsVisibility();
      initWallpaperMode();
      initThemeListener();
      initIconLoader();
    });
  } else {
    updateMainGridCols();
    updateSidebarComponentsVisibility();
    initWallpaperMode();
    initThemeListener();
    initIconLoader();
  }

  // LQIP fade-in：图片加载完成后淡出占位渐变
  function initImageLoadFadeIn() {
    const placeholders = document.querySelectorAll<HTMLElement>('.lqip-placeholder');
    placeholders.forEach(placeholder => {
      const container = placeholder.parentElement;
      if (!container) return;
      const img = container.querySelector<HTMLImageElement>('img, picture img');
      if (!img) return;

      if (img.complete && img.naturalWidth > 0) {
        img.style.opacity = '1';
        placeholder.classList.add('loaded');
      } else {
        img.addEventListener('load', () => {
          img.style.opacity = '1';
          placeholder.classList.add('loaded');
        }, { once: true });
        img.addEventListener('error', () => {
          if (!container.classList.contains('cover-image-container')) {
            placeholder.classList.add('loaded');
          }
        }, { once: true });
      }
    });
  }

  initImageLoadFadeIn();
  document.addEventListener('astro:page-load', initImageLoadFadeIn);
  document.addEventListener('swup:contentReplaced', () => {
    requestAnimationFrame(initImageLoadFadeIn);
  });

  /* ========== 全屏壁纸模式导航岛切换 ========== */
  function toggleFullscreenNavbar() {
    const navbarWrapper = document.getElementById("navbar-wrapper");
    const toggleBtn = document.getElementById("fullscreen-navbar-toggle");
    const iconUp = document.getElementById("navbar-toggle-icon-up");
    const iconDown = document.getElementById("navbar-toggle-icon-down");

    if (!navbarWrapper || !toggleBtn) return;

    const isHidden = navbarWrapper.classList.contains("navbar-manual-hidden");

    if (isHidden) {
      // 显示导航岛 - 图标旋转切换
      navbarWrapper.classList.remove("navbar-manual-hidden");
      toggleBtn.classList.remove("navbar-is-hidden");
      toggleBtn.setAttribute("aria-label", "隐藏导航栏");
      if (iconUp) {
        iconUp.style.transform = "rotate(0deg)";
        iconUp.style.opacity = "1";
        setTimeout(() => iconUp.classList.remove("hidden"), 50);
      }
      if (iconDown) {
        iconDown.style.transform = "rotate(-90deg)";
        iconDown.style.opacity = "0";
        setTimeout(() => iconDown.classList.add("hidden"), 200);
      }
    } else {
      // 隐藏导航岛 - 图标旋转切换
      navbarWrapper.classList.add("navbar-manual-hidden");
      toggleBtn.classList.add("navbar-is-hidden");
      toggleBtn.setAttribute("aria-label", "显示导航栏");
      if (iconUp) {
        iconUp.style.transform = "rotate(90deg)";
        iconUp.style.opacity = "0";
        setTimeout(() => iconUp.classList.add("hidden"), 200);
      }
      if (iconDown) {
        iconDown.style.transform = "rotate(0deg)";
        iconDown.style.opacity = "1";
        setTimeout(() => iconDown.classList.remove("hidden"), 50);
      }
    }
  }

  // 将函数暴露到全局，供内联onclick调用
  (window as any).toggleFullscreenNavbar = toggleFullscreenNavbar;

  function resetFullscreenNavbarState() {
    const navbarWrapper = document.getElementById("navbar-wrapper");
    const toggleBtn = document.getElementById("fullscreen-navbar-toggle");
    const iconUp = document.getElementById("navbar-toggle-icon-up");
    const iconDown = document.getElementById("navbar-toggle-icon-down");

    if (navbarWrapper) navbarWrapper.classList.remove("navbar-manual-hidden");
    if (toggleBtn) {
      toggleBtn.classList.remove("navbar-is-hidden");
      toggleBtn.setAttribute("aria-label", "隐藏导航栏");
    }
    if (iconUp) {
      iconUp.classList.remove("hidden");
      iconUp.style.transform = "rotate(0deg)";
      iconUp.style.opacity = "1";
    }
    if (iconDown) {
      iconDown.classList.add("hidden");
      iconDown.style.transform = "rotate(-90deg)";
      iconDown.style.opacity = "0";
    }
  }

  // Swup页面切换后重置导航岛状态
  function bindFullscreenNavbarReset() {
    if (window.swup?.hooks) {
      window.swup.hooks.on("content:replace", resetFullscreenNavbarState);
    }
  }

  if (window.swup?.hooks) {
    bindFullscreenNavbarReset();
  } else {
    document.addEventListener("swup:enable", bindFullscreenNavbarReset);
  }
  document.addEventListener("astro:page-load", resetFullscreenNavbarState);

  /* ========== iOS 风格彩蛋弹窗 ========== */
  function spawnConfetti() {
    const container = document.getElementById("easter-egg-confetti");
    if (!container) return;
    container.innerHTML = "";

    const colors = ["#6366f1", "#ec4899", "#f59e0b", "#10b981", "#3b82f6", "#ef4444", "#8b5cf6", "#f97316"];
    const shapes = ["square", "circle", "triangle"];
    const count = 60;

    for (let i = 0; i < count; i++) {
      const el = document.createElement("div");
      el.className = "easter-confetti";
      const color = colors[Math.floor(Math.random() * colors.length)];
      const shape = shapes[Math.floor(Math.random() * shapes.length)];
      const left = Math.random() * 100;
      const duration = 2 + Math.random() * 3;
      const delay = Math.random() * 0.8;
      const size = 6 + Math.random() * 10;

      el.style.left = left + "%";
      el.style.top = "-20px";
      el.style.width = size + "px";
      el.style.height = size + "px";
      el.style.backgroundColor = color;
      el.style.animationDuration = duration + "s";
      el.style.animationDelay = delay + "s";

      if (shape === "circle") {
        el.style.borderRadius = "50%";
      } else if (shape === "triangle") {
        el.style.width = "0";
        el.style.height = "0";
        el.style.backgroundColor = "transparent";
        el.style.borderLeft = size / 2 + "px solid transparent";
        el.style.borderRight = size / 2 + "px solid transparent";
        el.style.borderBottom = size + "px solid " + color;
      }

      container.appendChild(el);
    }

    // 清理
    setTimeout(() => { if (container) container.innerHTML = ""; }, 6000);
  }

  var easterEggOpen = false;

  function openEasterEgg() {
    const overlay = document.getElementById("easter-egg-overlay");
    const sheet = document.getElementById("easter-egg-sheet");
    if (!overlay || !sheet) return;

    overlay.classList.remove("opacity-0", "pointer-events-none");
    overlay.classList.add("opacity-100", "pointer-events-auto");
    sheet.classList.remove("translate-y-full");
    sheet.classList.add("translate-y-0");

    easterEggOpen = true;

    // 触发动画类
    requestAnimationFrame(() => {
      sheet.classList.add("easter-egg-sheet-open");
    });

    // 撒花效果
    spawnConfetti();

    // 添加 body 滚动锁定
    document.body.style.overflow = "hidden";
  }

  function closeEasterEgg() {
    const overlay = document.getElementById("easter-egg-overlay");
    const sheet = document.getElementById("easter-egg-sheet");
    const confetti = document.getElementById("easter-egg-confetti");
    if (!overlay || !sheet) return;

    easterEggOpen = false;
    sheet.classList.remove("easter-egg-sheet-open");
    overlay.classList.remove("opacity-100", "pointer-events-auto");
    overlay.classList.add("opacity-0", "pointer-events-none");
    sheet.classList.remove("translate-y-0");
    sheet.classList.add("translate-y-full");

    // 清除撒花
    if (confetti) confetti.innerHTML = "";

    // 恢复 body 滚动
    document.body.style.overflow = "";
  }

  // 绑定彩蛋触发按钮
  function bindEasterEggTrigger() {
    const trigger = document.getElementById("easter-egg-trigger");
    if (trigger) {
      trigger.onclick = function(e) {
        e.preventDefault();
        e.stopPropagation();
        openEasterEgg();
      };
    }
  }

  // 暴露到全局
  (window as any).openEasterEgg = openEasterEgg;
  (window as any).closeEasterEgg = closeEasterEgg;

  // 初始化绑定
  bindEasterEggTrigger();
  document.addEventListener("astro:page-load", bindEasterEggTrigger);

  // 全局点击监听：点击 sheet 外部关闭彩蛋
  document.addEventListener("click", function(e) {
    if (!easterEggOpen) return;
    const sheet = document.getElementById("easter-egg-sheet");
    if (!sheet) return;
    // 如果点击不在 sheet 内部，关闭彩蛋
    if (!sheet.contains(e.target as Node)) {
      closeEasterEgg();
    }
  }, true);

  // Swup 页面切换后重新绑定
  if (window.swup?.hooks) {
    window.swup.hooks.on("content:replace", bindEasterEggTrigger);
  } else {
    document.addEventListener("swup:enable", function() {
      if (window.swup?.hooks) {
        window.swup.hooks.on("content:replace", bindEasterEggTrigger);
      }
    });
  }

  // 键盘 ESC 关闭
  document.addEventListener("keydown", function(e) {
    if (e.key === "Escape") closeEasterEgg();
  });

  /* ========== 个人介绍悬浮窗 ========== */
  function initProfileFloat() {
    const float = document.getElementById("profile-float") as HTMLElement | null;
    const trigger = document.getElementById("profile-float-trigger");
    const dragHandle = document.getElementById("profile-float-drag");
    const resizeHandle = document.getElementById("profile-float-resize");
    const closeBtn = document.getElementById("profile-float-close");
    const minimizeBtn = document.getElementById("profile-float-minimize");
    const fullscreenBtn = document.getElementById("profile-float-fullscreen");
    const fsIcon = document.getElementById("profile-float-fs-icon");

    if (!float || !trigger) return;

    // 从 localStorage 恢复位置和大小
    const savedPos = localStorage.getItem("profile-float-pos");
    if (savedPos) {
      try {
        const pos = JSON.parse(savedPos);
        if (pos.left !== undefined) float.style.left = pos.left + "px";
        if (pos.top !== undefined) {
          float.style.top = pos.top + "px";
          float.style.bottom = "auto";
        }
        if (pos.width) float.style.width = pos.width + "px";
        if (pos.height) float.style.height = pos.height + "px";
      } catch (e) {}
    }

    // 显示/隐藏
    function showFloat() {
      float!.style.display = "flex";
      trigger!.style.display = "none";
    }
    function hideFloat() {
      float!.style.display = "none";
      trigger!.style.display = "flex";
    }

    trigger.onclick = function(e) {
      e.stopPropagation();
      showFloat();
    };
    if (closeBtn) {
      closeBtn.onclick = function(e) {
        e.stopPropagation();
        hideFloat();
      };
    }
    if (minimizeBtn) {
      minimizeBtn.onclick = function(e) {
        e.stopPropagation();
        hideFloat();
      };
    }

    // 全屏切换
    let isFullscreen = false;
    let prevRect: { left: number; top: number; width: number; height: number } | null = null;
    if (fullscreenBtn) {
      fullscreenBtn.onclick = function(e) {
        e.stopPropagation();
        if (!isFullscreen) {
          prevRect = {
            left: float.offsetLeft,
            top: float.offsetTop,
            width: float.offsetWidth,
            height: float.offsetHeight,
          };
          float.classList.add("profile-fullscreen");
          isFullscreen = true;
          if (fsIcon) {
            (fsIcon as HTMLElement).setAttribute("data-icon", "material-symbols:fullscreen-exit-rounded");
          }
        } else {
          float.classList.remove("profile-fullscreen");
          isFullscreen = false;
          if (prevRect) {
            float.style.left = prevRect.left + "px";
            float.style.top = prevRect.top + "px";
            float.style.width = prevRect.width + "px";
            float.style.height = prevRect.height + "px";
          }
          if (fsIcon) {
            (fsIcon as HTMLElement).setAttribute("data-icon", "material-symbols:fullscreen-rounded");
          }
        }
      };
    }

    // 拖拽
    if (dragHandle) {
      let isDragging = false;
      let startX = 0, startY = 0;
      let startLeft = 0, startTop = 0;

      const onMouseDown = function(e: MouseEvent | TouchEvent) {
        if (isFullscreen) return;
        // 排除点击控制按钮
        const target = e.target as HTMLElement;
        if (target.closest(".profile-float-btn")) return;

        isDragging = true;
        const point = "touches" in e ? e.touches[0] : e;
        startX = point.clientX;
        startY = point.clientY;
        startLeft = float.offsetLeft;
        startTop = float.offsetTop;
        float.style.bottom = "auto";
        (dragHandle as HTMLElement).style.cursor = "grabbing";
        e.preventDefault();
      };

      const onMouseMove = function(e: MouseEvent | TouchEvent) {
        if (!isDragging) return;
        const point = "touches" in e ? e.touches[0] : e;
        const dx = point.clientX - startX;
        const dy = point.clientY - startY;
        let newLeft = startLeft + dx;
        let newTop = startTop + dy;

        // 边界约束
        const maxLeft = window.innerWidth - 60;
        const maxTop = window.innerHeight - 60;
        const minLeft = -float.offsetWidth + 60;
        const minTop = 0;
        newLeft = Math.max(minLeft, Math.min(maxLeft, newLeft));
        newTop = Math.max(minTop, Math.min(maxTop, newTop));

        float.style.left = newLeft + "px";
        float.style.top = newTop + "px";

        // 保存位置
        localStorage.setItem("profile-float-pos", JSON.stringify({
          left: newLeft,
          top: newTop,
          width: float.offsetWidth,
          height: float.offsetHeight,
        }));
      };

      const onMouseUp = function() {
        isDragging = false;
        (dragHandle as HTMLElement).style.cursor = "grab";
      };

      dragHandle.addEventListener("mousedown", onMouseDown as EventListener);
      dragHandle.addEventListener("touchstart", onMouseDown as EventListener, { passive: false });
      document.addEventListener("mousemove", onMouseMove as EventListener);
      document.addEventListener("touchmove", onMouseMove as EventListener, { passive: false });
      document.addEventListener("mouseup", onMouseUp);
      document.addEventListener("touchend", onMouseUp);
    }

    // 缩放
    if (resizeHandle) {
      let isResizing = false;
      let startX = 0, startY = 0;
      let startWidth = 0, startHeight = 0;

      const onResizeDown = function(e: MouseEvent | TouchEvent) {
        if (isFullscreen) return;
        e.stopPropagation();
        e.preventDefault();

        isResizing = true;
        const point = "touches" in e ? e.touches[0] : e;
        startX = point.clientX;
        startY = point.clientY;
        startWidth = float.offsetWidth;
        startHeight = float.offsetHeight;
      };

      const onResizeMove = function(e: MouseEvent | TouchEvent) {
        if (!isResizing) return;
        const point = "touches" in e ? e.touches[0] : e;
        const dw = point.clientX - startX;
        const dh = point.clientY - startY;

        const newWidth = Math.max(220, Math.min(window.innerWidth - float.offsetLeft - 10, startWidth + dw));
        const newHeight = Math.max(200, Math.min(window.innerHeight - float.offsetTop - 10, startHeight + dh));

        float.style.width = newWidth + "px";
        float.style.height = newHeight + "px";

        localStorage.setItem("profile-float-pos", JSON.stringify({
          left: float.offsetLeft,
          top: float.offsetTop,
          width: newWidth,
          height: newHeight,
        }));
      };

      const onResizeUp = function() {
        isResizing = false;
      };

      resizeHandle.addEventListener("mousedown", onResizeDown as EventListener);
      resizeHandle.addEventListener("touchstart", onResizeDown as EventListener, { passive: false });
      document.addEventListener("mousemove", onResizeMove as EventListener);
      document.addEventListener("touchmove", onResizeMove as EventListener, { passive: false });
      document.addEventListener("mouseup", onResizeUp);
      document.addEventListener("touchend", onResizeUp);
    }
  }

  // 初始化
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initProfileFloat);
  } else {
    initProfileFloat();
  }
  document.addEventListener("astro:page-load", initProfileFloat);
  if (window.swup?.hooks) {
    window.swup.hooks.on("content:replace", initProfileFloat);
  } else {
    document.addEventListener("swup:enable", function() {
      if (window.swup?.hooks) {
        window.swup.hooks.on("content:replace", initProfileFloat);
      }
    });
  }

  /* ========== 通用悬浮窗初始化（公告/音乐） ========== */
  function initGenericFloat(prefix: string) {
    const float = document.getElementById(prefix + "-float") as HTMLElement | null;
    const trigger = document.getElementById(prefix + "-float-trigger");
    const dragHandle = document.getElementById(prefix + "-float-drag");
    const resizeHandle = document.getElementById(prefix + "-float-resize");
    const closeBtn = document.getElementById(prefix + "-float-close");
    const minimizeBtn = document.getElementById(prefix + "-float-minimize");
    const fullscreenBtn = document.getElementById(prefix + "-float-fullscreen");
    const fsIcon = document.getElementById(prefix + "-float-fs-icon");

    if (!float || !trigger) return;

    // 从 localStorage 恢复位置和大小
    const savedPos = localStorage.getItem(prefix + "-float-pos");
    if (savedPos) {
      try {
        const pos = JSON.parse(savedPos);
        if (pos.left !== undefined) float.style.left = pos.left + "px";
        if (pos.top !== undefined) {
          float.style.top = pos.top + "px";
          float.style.bottom = "auto";
        }
        if (pos.width) float.style.width = pos.width + "px";
        if (pos.height) float.style.height = pos.height + "px";
      } catch (e) {}
    }

    function showFloat() {
      float!.style.display = "flex";
      trigger!.style.display = "none";
      // 音乐悬浮窗打开时初始化播放器
      if (prefix === "music" && (window as any).__fireflyMusic) {
        (window as any).__fireflyMusic.init();
      }
    }
    function hideFloat() {
      float!.style.display = "none";
      trigger!.style.display = "flex";
    }

    trigger.onclick = function(e) {
      e.stopPropagation();
      showFloat();
    };
    if (closeBtn) {
      closeBtn.onclick = function(e) {
        e.stopPropagation();
        hideFloat();
      };
    }
    if (minimizeBtn) {
      minimizeBtn.onclick = function(e) {
        e.stopPropagation();
        hideFloat();
      };
    }

    // 全屏切换
    let isFullscreen = false;
    let prevRect: { left: number; top: number; width: number; height: number } | null = null;
    if (fullscreenBtn) {
      fullscreenBtn.onclick = function(e) {
        e.stopPropagation();
        if (!isFullscreen) {
          prevRect = {
            left: float!.offsetLeft,
            top: float!.offsetTop,
            width: float!.offsetWidth,
            height: float!.offsetHeight,
          };
          float!.classList.add("profile-fullscreen");
          isFullscreen = true;
          if (fsIcon) {
            (fsIcon as HTMLElement).setAttribute("data-icon", "material-symbols:fullscreen-exit-rounded");
          }
        } else {
          float!.classList.remove("profile-fullscreen");
          isFullscreen = false;
          if (prevRect) {
            float!.style.left = prevRect.left + "px";
            float!.style.top = prevRect.top + "px";
            float!.style.width = prevRect.width + "px";
            float!.style.height = prevRect.height + "px";
          }
          if (fsIcon) {
            (fsIcon as HTMLElement).setAttribute("data-icon", "material-symbols:fullscreen-rounded");
          }
        }
      };
    }

    // 拖拽
    if (dragHandle) {
      let isDragging = false;
      let startX = 0, startY = 0;
      let startLeft = 0, startTop = 0;

      const onMouseDown = function(e: MouseEvent | TouchEvent) {
        if (isFullscreen) return;
        const target = e.target as HTMLElement;
        if (target.closest(".profile-float-btn")) return;

        isDragging = true;
        const point = "touches" in e ? e.touches[0] : e;
        startX = point.clientX;
        startY = point.clientY;
        startLeft = float!.offsetLeft;
        startTop = float!.offsetTop;
        float!.style.bottom = "auto";
        (dragHandle as HTMLElement).style.cursor = "grabbing";
        e.preventDefault();
      };

      const onMouseMove = function(e: MouseEvent | TouchEvent) {
        if (!isDragging) return;
        const point = "touches" in e ? e.touches[0] : e;
        const dx = point.clientX - startX;
        const dy = point.clientY - startY;
        let newLeft = startLeft + dx;
        let newTop = startTop + dy;

        const maxLeft = window.innerWidth - 60;
        const maxTop = window.innerHeight - 60;
        const minLeft = -float!.offsetWidth + 60;
        const minTop = 0;
        newLeft = Math.max(minLeft, Math.min(maxLeft, newLeft));
        newTop = Math.max(minTop, Math.min(maxTop, newTop));

        float!.style.left = newLeft + "px";
        float!.style.top = newTop + "px";

        localStorage.setItem(prefix + "-float-pos", JSON.stringify({
          left: newLeft,
          top: newTop,
          width: float!.offsetWidth,
          height: float!.offsetHeight,
        }));
      };

      const onMouseUp = function() {
        isDragging = false;
        (dragHandle as HTMLElement).style.cursor = "grab";
      };

      dragHandle.addEventListener("mousedown", onMouseDown as EventListener);
      dragHandle.addEventListener("touchstart", onMouseDown as EventListener, { passive: false });
      document.addEventListener("mousemove", onMouseMove as EventListener);
      document.addEventListener("touchmove", onMouseMove as EventListener, { passive: false });
      document.addEventListener("mouseup", onMouseUp);
      document.addEventListener("touchend", onMouseUp);
    }

    // 缩放
    if (resizeHandle) {
      let isResizing = false;
      let startX = 0, startY = 0;
      let startWidth = 0, startHeight = 0;

      const onResizeDown = function(e: MouseEvent | TouchEvent) {
        if (isFullscreen) return;
        e.stopPropagation();
        e.preventDefault();

        isResizing = true;
        const point = "touches" in e ? e.touches[0] : e;
        startX = point.clientX;
        startY = point.clientY;
        startWidth = float!.offsetWidth;
        startHeight = float!.offsetHeight;
      };

      const onResizeMove = function(e: MouseEvent | TouchEvent) {
        if (!isResizing) return;
        const point = "touches" in e ? e.touches[0] : e;
        const dw = point.clientX - startX;
        const dh = point.clientY - startY;

        const newWidth = Math.max(220, Math.min(window.innerWidth - float!.offsetLeft - 10, startWidth + dw));
        const newHeight = Math.max(200, Math.min(window.innerHeight - float!.offsetTop - 10, startHeight + dh));

        float!.style.width = newWidth + "px";
        float!.style.height = newHeight + "px";

        localStorage.setItem(prefix + "-float-pos", JSON.stringify({
          left: float!.offsetLeft,
          top: float!.offsetTop,
          width: newWidth,
          height: newHeight,
        }));
      };

      const onResizeUp = function() {
        isResizing = false;
      };

      resizeHandle.addEventListener("mousedown", onResizeDown as EventListener);
      resizeHandle.addEventListener("touchstart", onResizeDown as EventListener, { passive: false });
      document.addEventListener("mousemove", onResizeMove as EventListener);
      document.addEventListener("touchmove", onResizeMove as EventListener, { passive: false });
      document.addEventListener("mouseup", onResizeUp);
      document.addEventListener("touchend", onResizeUp);
    }
  }

  function initAllFloats() {
    initGenericFloat("announce");
    initGenericFloat("music");
  }

  /* ========== 液态玻璃鼠标跟随折射光 ========== */
  function initLiquidGlassMouseTracking() {
    const floats = document.querySelectorAll<HTMLElement>(".profile-float");
    floats.forEach(function(floatEl) {
      // 避免重复绑定
      if (floatEl.dataset.liquidGlassBound) return;
      floatEl.dataset.liquidGlassBound = "true";
      floatEl.addEventListener("mousemove", function(e: MouseEvent) {
        const rect = floatEl.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        floatEl.style.setProperty("--mouse-x", x + "px");
        floatEl.style.setProperty("--mouse-y", y + "px");
      });
    });
  }

  function initAllLiquidGlass() {
    initAllFloats();
    initLiquidGlassMouseTracking();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAllLiquidGlass);
  } else {
    initAllLiquidGlass();
  }
  document.addEventListener("astro:page-load", initLiquidGlassMouseTracking);
  if (window.swup?.hooks) {
    window.swup.hooks.on("content:replace", initLiquidGlassMouseTracking);
  } else {
    document.addEventListener("swup:enable", function() {
      if (window.swup?.hooks) {
        window.swup.hooks.on("content:replace", initLiquidGlassMouseTracking);
      }
    });
  }
</script>
