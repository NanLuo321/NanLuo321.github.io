    <script is:inline>
      (function() {
        let devtoolsOpen = false;
        let warningShowing = false;
        function showDevToolsWarning() {
          if (warningShowing) return;
          warningShowing = true;
          const overlay = document.createElement('div');
          overlay.id = 'devtools-warning';
          overlay.style.cssText = 'position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);z-index:99999;background:rgba(0,0,0,0.85);color:#fff;padding:24px 40px;border-radius:16px;backdrop-filter:blur(20px);font-size:18px;font-weight:bold;text-align:center;pointer-events:none;animation:devtoolsFadeIn 0.3s ease;display:flex;align-items:center;gap:12px;';
          overlay.innerHTML = '<span style="display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:50%;background:#facc15;color:#000;font-size:20px;font-weight:900;flex-shrink:0;">!</span><strong style="font-size:20px;letter-spacing:1px;">请合理使用开发者工具！</strong>';
          document.body.appendChild(overlay);
          setTimeout(() => { overlay.style.transition='opacity 0.5s'; overlay.style.opacity='0'; }, 2500);
          setTimeout(() => { if(overlay.parentNode) overlay.parentNode.removeChild(overlay); warningShowing = false; }, 3000);
        }
        const threshold = 160;
        setInterval(function() {
          const widthDiff = window.outerWidth - window.innerWidth;
          const heightDiff = window.outerHeight - window.innerHeight;
          const opened = widthDiff > threshold || heightDiff > threshold;
          if (opened && !devtoolsOpen) {
            devtoolsOpen = true;
            showDevToolsWarning();
          } else if (!opened) {
            devtoolsOpen = false;
          }
        }, 1000);
      })();
