            var contentEl = document.getElementById("content-wrapper");
            if (contentEl && contentEl.style.filter) {
              contentEl.style.filter = "";
            }
          }
        }

        window.scrollBlurHandler = updateScrollBlur;
        window.addEventListener("scroll", updateScrollBlur, { passive: true });
